@model DiamDev.Give.UI.Models.BorradorNcDocumentoPrevioViewModel
@using System
@using System.Globalization
@using System.Linq
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime fecha;
    var fechaTexto = DateTime.TryParseExact(Model.Fecha ?? "", "yyyy-MM-dd",
        CultureInfo.InvariantCulture, DateTimeStyles.None, out fecha)
        ? fecha.ToString("dd/MM/yyyy")
        : (Model.Fecha ?? "—");
    DateTime fechaDocumento;
    var fechaDocumentoTexto = DateTime.TryParseExact(Model.FechaDocumento ?? "", "yyyy-MM-dd",
        CultureInfo.InvariantCulture, DateTimeStyles.None, out fechaDocumento)
        ? fechaDocumento.ToString("dd/MM/yyyy")
        : (Model.FechaDocumento ?? "—");
    var fel = string.Join(" ", new[] { Model.SerieFel, Model.NumeroFel }
        .Where(x => !string.IsNullOrWhiteSpace(x)));
    var accionRegreso = Model.DesdeAutorizaciones ? "Autorizaciones" : "Index";
    var textoRegreso = Model.DesdeAutorizaciones
        ? "Volver a autorizaciones"
        : "Volver a Borradores NC";
    var totalLineas = Model.Productos.Sum(x => x.Total);
    var urlPdf = Url.Action("AbrirDocumentoPrevioSap", "BorradorNc", new
    {
        empresa = Model.Empresa,
        idBorrador = Model.IdBorrador,
        factura = Model.Factura,
        documento = Model.Documento,
        clase = Model.Clase
    });
}

@section styles {
    <link href="@Url.Content("~/Content/borrador-nc.css?v=20260908-documentos-previos")" rel="stylesheet" />
}

<div class="bnc bnc-shell bnc-invoice-detail-page bnc-prior-detail-page">
    <header class="bnc-hero bnc-invoice-detail-hero">
        <div class="bnc-hero-copy">
            <span class="bnc-hero-icon" aria-hidden="true"><i class="@(Model.Clase == "DEVOLUCION" ? "icon-reply" : "icon-file-text")"></i></span>
            <div>
                <span class="bnc-invoice-detail-eyebrow">Documento previo en SAP</span>
                <h2>@Model.ClaseTexto @Model.Documento</h2>
                <p>@Model.Empresa · @fechaTexto · Factura relacionada @Model.Factura</p>
            </div>
        </div>
        <div class="bnc-hero-meta">
            <span class="bnc-hero-chip"><i class="icon-link"></i> Borrador @Model.IdBorrador</span>
            <span class="bnc-hero-chip"><i class="icon-list"></i> @Model.Productos.Count @(Model.Productos.Count == 1 ? "línea" : "líneas")</span>
        </div>
    </header>

    <div class="bnc-invoice-page-actions" aria-label="Acciones del documento previo">
        <a class="bnc-btn bnc-btn-ghost" href="@Url.Action(accionRegreso, "BorradorNc")">
            <i class="icon-arrow-left" aria-hidden="true"></i> @textoRegreso
        </a>
        @if (Model.PdfDisponible)
        {
            <a class="bnc-btn bnc-btn-primary" href="@urlPdf"
               target="_blank" rel="noopener noreferrer"
               title="Abrir el PDF oficial almacenado en SAP en una pestaña nueva">
                <i class="icon-print" aria-hidden="true"></i> Abrir / imprimir documento
                <span class="sr-only"> en una pestaña nueva</span>
            </a>
        }
    </div>

    <section class="bnc-card" aria-labelledby="bncDocumentoPrevioResumenTitulo">
        <div class="bnc-card-head">
            <div class="bnc-card-title">
                <i class="icon-info-sign" aria-hidden="true"></i>
                <div>
                    <h3 id="bncDocumentoPrevioResumenTitulo">Resumen del documento</h3>
                    <small>Información del encabezado consultada directamente en SAP.</small>
                </div>
            </div>
            <span class="bnc-status @(Model.Cancelado ? "bnc-status-rechazado" : "bnc-status-neutral")">
                @Model.EstadoSap
            </span>
        </div>
        <div class="bnc-card-body">
            <div class="bnc-invoice-detail-meta">
                <div><small>Tipo de documento</small><strong>@Model.ClaseTexto</strong></div>
                <div><small>Número SAP</small><strong>@Model.Documento</strong></div>
                <div><small>Factura relacionada</small><strong>@Model.Factura</strong></div>
                <div><small>Clasificación de origen</small><strong>@(string.IsNullOrWhiteSpace(Model.TiposOrigen) ? "—" : Model.TiposOrigen)</strong></div>
                <div><small>Cliente</small><strong>@Model.ClienteId · @Model.ClienteNombre</strong></div>
                <div><small>Fecha de contabilización</small><strong>@fechaTexto</strong></div>
                <div><small>Fecha del documento</small><strong>@fechaDocumentoTexto</strong></div>
                <div><small>Referencia</small><strong>@(string.IsNullOrWhiteSpace(Model.Referencia) ? "—" : Model.Referencia)</strong></div>
                <div><small>Documento FEL</small><strong>@(string.IsNullOrWhiteSpace(fel) ? "Sin información FEL" : fel)</strong></div>
                <div><small>Moneda</small><strong>@Model.Moneda</strong></div>
                <div><small>Tipo de cambio</small><strong>@Model.TipoCambio.ToString("N6")</strong></div>
                <div><small>Total del documento</small><strong>@Model.Moneda @Model.Total.ToString("N2")</strong></div>
            </div>

            <div class="bnc-prior-notes">
                <article>
                    <small>Origen contable</small>
                    <p>@(string.IsNullOrWhiteSpace(Model.Origen) ? "Sin información" : Model.Origen)</p>
                </article>
                <article>
                    <small>Comentarios</small>
                    <p>@(string.IsNullOrWhiteSpace(Model.Comentarios) ? "Sin comentarios" : Model.Comentarios)</p>
                </article>
            </div>
        </div>
    </section>

    <section class="bnc-card" aria-labelledby="bncDocumentoPrevioProductosTitulo">
        <div class="bnc-card-head">
            <div class="bnc-card-title">
                <i class="icon-list" aria-hidden="true"></i>
                <div>
                    <h3 id="bncDocumentoPrevioProductosTitulo">Productos y servicios del documento</h3>
                    <small>Renglones originales de @(Model.Clase == "DEVOLUCION" ? "ORDN/RDN1" : "ORIN/RIN1") en SAP.</small>
                </div>
            </div>
            <span class="bnc-status bnc-status-neutral">@Model.Productos.Count @(Model.Productos.Count == 1 ? "renglón" : "renglones")</span>
        </div>

        @if (Model.Productos.Count == 0)
        {
            <div class="bnc-empty bnc-invoice-detail-empty">
                <i class="icon-info-sign" aria-hidden="true"></i>
                <strong>Sin productos o servicios disponibles</strong>
                <span>SAP no devolvió renglones para este documento.</span>
            </div>
        }
        else
        {
            <div class="bnc-sap-table-shell bnc-invoice-detail-table-shell">
                <div class="bnc-sap-table-region" role="region" tabindex="0"
                     aria-label="Productos y servicios del documento @Model.Documento">
                    <table class="bnc-sap-lines-table">
                        <caption>Detalle de productos y servicios del documento @Model.Documento</caption>
                        <thead>
                            <tr>
                                <th scope="col">Línea</th>
                                <th scope="col">Producto / servicio</th>
                                <th scope="col">Bodega</th>
                                <th scope="col">Cantidad</th>
                                <th scope="col">Precio unitario</th>
                                <th scope="col">Descuento</th>
                                <th scope="col">Subtotal</th>
                                <th scope="col">Impuesto</th>
                                <th scope="col">Total línea</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in Model.Productos)
                            {
                                var monedaLinea = string.IsNullOrWhiteSpace(producto.Moneda) ? Model.Moneda : producto.Moneda;
                                <tr>
                                    <th scope="row" class="bnc-sap-line-number"><span>@(producto.NumeroLinea + 1)</span></th>
                                    <td class="bnc-sap-line-product">
                                        <span class="bnc-sap-line-reference">
                                            <span>@(producto.EsServicio ? "Servicio" : "SKU")</span>
                                            <b>@(producto.EsServicio ? "SERVICIO" : producto.Sku)</b>
                                        </span>
                                        <strong>@(string.IsNullOrWhiteSpace(producto.Descripcion) ? "Sin descripción" : producto.Descripcion)</strong>
                                    </td>
                                    <td class="bnc-sap-line-warehouse">
                                        <span class="bnc-sap-table-tag @(string.IsNullOrWhiteSpace(producto.Bodega) ? "is-muted" : "")">
                                            <i class="icon-archive" aria-hidden="true"></i>
                                            @(string.IsNullOrWhiteSpace(producto.Bodega) ? "Sin bodega" : producto.Bodega)
                                        </span>
                                    </td>
                                    <td class="bnc-sap-line-number-value"><strong>@producto.Cantidad.ToString("N4")</strong><small>@(string.IsNullOrWhiteSpace(producto.UnidadMedida) ? "Sin unidad" : producto.UnidadMedida)</small></td>
                                    <td class="bnc-sap-line-number-value"><strong>@monedaLinea @producto.PrecioUnitario.ToString("N2")</strong></td>
                                    <td class="bnc-sap-line-number-value @(producto.DescuentoPorcentaje == 0 ? "is-muted" : "")"><strong>@(producto.DescuentoPorcentaje == 0 ? "Sin descuento" : producto.DescuentoPorcentaje.ToString("N2") + "%")</strong></td>
                                    <td class="bnc-sap-line-number-value"><strong>@monedaLinea @producto.Subtotal.ToString("N2")</strong></td>
                                    <td class="bnc-sap-line-number-value"><strong>@monedaLinea @producto.Impuesto.ToString("N2")</strong><small>@(producto.ImpuestoPorcentaje.ToString("N2"))%@(string.IsNullOrWhiteSpace(producto.CodigoImpuesto) ? "" : " · " + producto.CodigoImpuesto)</small></td>
                                    <td class="bnc-sap-line-number-value is-total"><strong>@monedaLinea @producto.Total.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <footer class="bnc-invoice-detail-lines-total">
                <span>Total de los renglones</span>
                <strong>@Model.Moneda @totalLineas.ToString("N2")</strong>
            </footer>
        }
    </section>
</div>
