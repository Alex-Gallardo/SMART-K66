            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Resumen
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Recibos</th>
                                <th>Facturas</th>
                                <th>Reservas</th>
                                <th>Abonos Recibos</th>
                                <th>Abonos Facturas</th>
                                <th>Abonos Reservas</th>
                                <th>Gastos</th>
                                <th>Retiros</th>
                                <th>Cierre</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>@(Model.Recibos != null ? string.Format("{0:C4}", Model.Recibos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio))) : "Q0.0000")</th>
                                <th>@(Model.Facturas != null ? string.Format("{0:C4}", Model.Facturas.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio))) : "Q0.0000")</th>
                                <th>@(Model.Reservas != null ? string.Format("{0:C4}", Model.Reservas.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio))) : "Q0.0000")</th>
                                <th>@(Model.Abonos != null ? string.Format("{0:C4}", Model.Abonos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio))) : "Q0.0000")</th>
                                <th>@(Model.FacturaAbonos != null ? string.Format("{0:C4}", Model.FacturaAbonos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio))) : "Q0.0000")</th>
                                <th>@(Model.ReservaAbonos != null ? string.Format("{0:C4}", Model.ReservaAbonos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio))) : "Q0.0000")</th>
                                <th>@(Model.Gastos != null ? string.Format("{0:C4}", Model.Gastos.Sum(y => y.Monto)) : "Q0.0000")</th>
                                <th>@(Model.Cortes != null ? string.Format("{0:C4}", Model.Cortes.Sum(y => y.Monto)) : "Q0.0000")</th>
                                <th>@string.Format("{0:C4}", ((Model.Recibos != null ? Model.Recibos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio)) : 0) + (Model.Facturas != null ? Model.Facturas.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio)) : 0) + (Model.Reservas != null ? Model.Reservas.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio)) : 0) + (Model.Abonos != null ? Model.Abonos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio)) : 0) + (Model.FacturaAbonos != null ? Model.FacturaAbonos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio)) : 0) + (Model.ReservaAbonos != null ? Model.ReservaAbonos.Sum(y => y.Detalles.Sum(z => z.Cantidad * z.Precio)) : 0)) - ((Model.Gastos != null ? Model.Gastos.Sum(y => y.Monto) : 0) + (Model.Cortes != null ? Model.Cortes.Sum(y => y.Monto) : 0)))</th>
                            </tr>
                        </tbody>
