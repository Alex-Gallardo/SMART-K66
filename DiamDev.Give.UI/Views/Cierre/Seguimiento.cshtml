@model DiamDev.Give.Entities.CierreCajaModelxCajero

@{
    ViewBag.Title = "Seguimiento de Cierres de Caja";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Seguimiento de Cierres de Caja
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#Cierre</th>                            
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Cajero</th>
                            <th>Monto Sistema</th>
                            <th>Monto Cajero</th>
                            <th>Faltante</th>
                            <th>Sobrante</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            if (Model.Cierres != null && Model.Cierres.Count() > 0)
                            {
                                foreach (var Cierre in Model.Cierres)
                                {
                                    <tr>
                                        <td>@(Cierre.CierreId)</td>
                                        <td>@Cierre.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@(Cierre.FechaHora == null ? "00:00" : Cierre.FechaHora.ToString("hh:mm tt"))</td>
                                        <td>@(Cierre.Cajero == null ? "No Disponible" : Cierre.Cajero.Nombre)</td>
                                        <td>@(Cierre.Detalles == null ? "Q0.0000" : Cierre.Detalles.Sum(x => x.MontoSistema).ToString("C4"))</td>
                                        <td>@(Cierre.Detalles == null ? "Q0.0000" : Cierre.Detalles.Sum(x => x.MontoCajero).ToString("C4"))</td>
                                        <td>@Cierre.Faltante.ToString("C4")</td>
                                        <td>@Cierre.Sobrante.ToString("C4")</td>
                                        <td class="center">
                                            <div class="visible-md visible-lg hidden-sm hidden-xs">
                                                <a href="javascript:void(0);" onclick="recibir('@Cierre.CierreId');" class="btn btn-teal tooltips" data-placement="top" data-original-title="Recibir"><i class="clip-checkmark"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }                       
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Seguimiento de Cortes de Caja
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#Corte</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Responsable</th>
                            <th>Operador</th>
                            <th>Gastos</th>
                            <th>Monto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            if (Model.Cortes != null && Model.Cortes.Count() > 0)
                            {
                                foreach (var Corte in Model.Cortes)
                                {
                                    <tr>
                                        <td>@(Corte.CorteId)</td>
                                        <td>@Corte.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@(Corte.FechaHora == null ? "00:00" : Corte.FechaHora.ToString("hh:mm tt"))</td>
                                        <td>@(Corte.Responsable == null ? "No Disponible" : Corte.Responsable.Nombre)</td>
                                        <td>@(Corte.Opero == null ? "No Disponible" : Corte.Opero.Nombre)</td>
                                        <td>@Corte.Gasto.ToString("C4")</td>
                                        <td>@Corte.Monto.ToString("C4")</td>
                                        <td class="center">
                                            <div class="visible-md visible-lg hidden-sm hidden-xs">
                                                <a href="javascript:void(0);" onclick="recibirCorte('@Corte.CorteId');" class="btn btn-teal tooltips" data-placement="top" data-original-title="Recibir"><i class="clip-checkmark"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }                        
                    </tbody>
                </table>

            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
               
        function recibir(id)
        {
            if (confirm("¿Desea recibir el cierre de caja?"))
            {
                $.ajax({
                    url: '@Url.Action("ActualizarCierreRecibir", "Cierre")?cierreId=' + encodeURI(id),
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        if (!data.Operacion)
                        {
                            toastr.error('Ocurrió un error, al recibir el cierre de caja');
                            return;
                        }

                        toastr.success('El cierre de caja se recibio exitosamente');
                        window.location = '@Url.Action("Seguimiento", "Cierre")';
                    },
                    fail: function (data)
                    {
                        console.error(data);
                        toastr.error('Ocurrió un error, al recibir el cierre de caja');
                    }
                });
            }
        }

        function recibirCorte(id)
        {
            if (confirm("¿Desea recibir el corte de caja?"))
            {
                $.ajax({
                    url: '@Url.Action("ActualizarCorteRecibir", "Monitoreo")?corteId=' + encodeURI(id),
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        if (!data.Operacion)
                        {
                            toastr.error('Ocurrió un error, al recibir el corte de caja');
                            return;
                        }

                        toastr.success('El corte de caja se recibio exitosamente');
                        window.location = '@Url.Action("Seguimiento", "Cierre")';
                    },
                    fail: function (data)
                    {
                        console.error(data);
                        toastr.error('Ocurrió un error, al recibir el corte de caja');
                    }
                });
            }
        }
    </script>
}



