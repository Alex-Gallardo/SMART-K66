@model DiamDev.Give.Entities.ClienteTipo

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Nombre<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre del Tipo de Cliente", required = "required", autocomplete = "off", autofocus = "autofocus" })
        </div>      
        <div class="form-group">
            <label class="control-label">
                Descripción<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Descripción del Tipo de Cliente", required = "required", autocomplete = "off" })
        </div>   
        <div class="form-group">
            <label class="control-label">
                Motivo<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Motivo, new { @class = "form-control", @placeholder = "Motivo de Creación del Tipo de Cliente", required = "required", autocomplete = "off" })
        </div>        
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                %<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.PorcentajeDescuento, new { @class = "form-control", @placeholder = "% de Descuento", required = "required", autocomplete = "off" })
        </div>    
    </div>
</div>



