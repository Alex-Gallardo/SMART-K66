@model DiamDev.Give.UI.Models.ClienteCrmDashboardViewModel
@using System
@using System.Linq
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles { <link href="@Url.Content("~/Content/clientes-crm.css?v=3")" rel="stylesheet" /> }
<div class="crm crm-dashboard" data-empresa="@Model.Empresa">
    <header class="crm-page-head"><span class="crm-eyebrow">Clientes · Grupo K66</span>
        <div class="crm-head-row"><div><h1>Dashboard de clientes</h1><p>Revise solicitudes, valide fichas y vincule los códigos creados en SAP.</p></div>
            <div class="crm-head-actions">@if (Model.PuedeVerCartera) { <a class="crm-btn crm-btn-outline" href="@Url.Action("Clientes")"><i class="icon-address-book"></i> Cartera CRM</a> }@if (Model.PuedeAdministrar) { <a class="crm-btn crm-btn-primary" href="@Url.Action("NuevoCliente")"><i class="icon-plus"></i> Nuevo cliente</a> }</div></div>
    </header>
    @if (TempData["CrmExito"] != null) { <div class="crm-alert crm-alert-success">@TempData["CrmExito"]</div> }
    @if (TempData["CrmError"] != null) { <div class="crm-alert crm-alert-error">@TempData["CrmError"]</div> }
    <div class="crm-stats">
        <div class="crm-stat"><i class="icon-time"></i><span>Pendientes</span><strong>@Model.Pendientes</strong><small>Por validar</small></div>
        <div class="crm-stat"><i class="icon-ok"></i><span>Aprobadas</span><strong>@Model.Aprobadas</strong><small>Fichas creadas</small></div>
        <div class="crm-stat"><i class="icon-remove"></i><span>Rechazadas</span><strong>@Model.Rechazadas</strong><small>Con motivo registrado</small></div>
        <div class="crm-stat"><i class="icon-briefcase"></i><span>Clientes activos</span><strong>@Model.Clientes.Count</strong><small>En la cartera CRM</small></div>
    </div>
    <div class="crm-card crm-table-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-bar-chart"></i></div><div><h2>Desarrollo comercial por negocio</h2><p>Valores capturados en las fichas CRM, agrupados por empresa y moneda; sin consulta a SAP.</p></div></div>
        <div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Negocio</th><th>Moneda</th><th>Clientes</th><th>Compran actualmente</th><th>Venta últimos 12 meses</th><th>Potencial anual</th><th>Objetivo 12 meses</th></tr></thead><tbody>@foreach (var r in Model.Resumenes) { <tr><td><strong>@(r.Empresa == "FAES" ? "Escocesa" : r.Empresa == "GRACO" ? "Graco Pack" : "Bolik")</strong></td><td>@r.Moneda</td><td>@r.Clientes</td><td>@r.CompranActualmente</td><td>@r.Ventas12Meses.ToString("N2")</td><td>@r.PotencialAnual.ToString("N2")</td><td>@r.Objetivo12Meses.ToString("N2")</td></tr> }</tbody></table></div>
    </div>
    <form class="crm-filter" method="get" action="@Url.Action("Dashboard")">
        <div class="crm-search"><i class="icon-search"></i><input type="search" name="filtro" value="@Model.Filtro" placeholder="Razón social, NIT o número de solicitud" aria-label="Buscar" /></div>
        <select name="empresa" aria-label="Filtrar por empresa"><option value="">Todas las empresas</option><option value="BOLIK" @(Model.Empresa == "BOLIK" ? "selected" : "")>Bolik</option><option value="FAES" @(Model.Empresa == "FAES" ? "selected" : "")>Escocesa</option><option value="GRACO" @(Model.Empresa == "GRACO" ? "selected" : "")>Graco Pack</option></select>
        <select name="estado" aria-label="Filtrar por estado"><option value="">Todos los estados</option>@foreach (var s in new[] { "ENVIADA", "APROBADA", "RECHAZADA" }) { <option value="@s" @(Model.Estado == s ? "selected" : "")>@s</option> }</select>
        <button class="crm-btn crm-btn-outline" type="submit"><i class="icon-filter"></i> Filtrar</button>
    </form>
    <form method="post" action="@Url.Action("Exportar")" id="crmExportForm">
        @Html.AntiForgeryToken()
        <div class="crm-card crm-table-card">
            <div class="crm-card-head"><div class="crm-section-icon"><i class="icon-list"></i></div><div><h2>Solicitudes recibidas</h2><p>Seleccione registros para exportar o abra uno para resolverlo.</p></div><button class="crm-btn crm-btn-outline" type="submit"><i class="icon-download"></i> Exportar Excel</button></div>
            <div class="crm-table-wrap"><table class="crm-table"><thead><tr><th><input id="crmSeleccionarTodos" type="checkbox" aria-label="Seleccionar todas" /></th><th>Solicitud</th><th>Cliente</th><th>Empresa</th><th>Agente</th><th>Fecha</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
                @foreach (var s in Model.Solicitudes) { <tr>
                    <td><input type="checkbox" name="ids" value="@s.Id" aria-label="Seleccionar solicitud @s.Id" /></td>
                    <td><strong>#@s.Id</strong></td><td><strong>@s.Ficha.RazonSocial</strong><small>@s.Ficha.NitDpi</small></td>
                    <td><span class="crm-company crm-company-@s.Empresa.ToLowerInvariant()">@(s.Empresa == "FAES" ? "Escocesa" : s.Empresa == "GRACO" ? "Graco Pack" : "Bolik")</span></td>
                    <td>@s.Agente</td><td>@s.CreadoEn.ToString("dd/MM/yyyy")</td>
                    <td><span class="crm-state crm-state-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                    <td><a class="crm-link" href="@Url.Action("Solicitud", new { id = s.Id })">Revisar <i class="icon-arrow-right"></i></a></td>
                </tr> }
            </tbody></table></div>
            @if (Model.Solicitudes.Count == 0) { <div class="crm-empty"><i class="icon-inbox"></i><strong>No hay solicitudes con estos filtros</strong></div> }
        </div>
    </form>
    <div class="crm-card crm-table-card">
        <div class="crm-card-head"><div class="crm-section-icon"><i class="icon-users"></i></div><div><h2>Clientes recientes</h2><p>Fichas SQL vinculadas por empresa</p></div>@if (Model.PuedeVerCartera) { <a class="crm-link" href="@Url.Action("Clientes")">Ver cartera <i class="icon-arrow-right"></i></a> }</div>
        <div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Cliente</th><th>Empresa</th><th>Código SAP</th><th>Potencial anual</th><th>Última edición</th><th></th></tr></thead><tbody>
            @foreach (var c in Model.Clientes.Take(8)) { <tr><td><strong>@c.Ficha.RazonSocial</strong><small>@c.Ficha.NitDpi</small></td><td>@(c.Empresa == "FAES" ? "Escocesa" : c.Empresa == "GRACO" ? "Graco Pack" : "Bolik")</td><td>@(string.IsNullOrWhiteSpace(c.CodigoSap) ? "Pendiente" : c.CodigoSap)</td><td>@((c.Ficha.PotencialAnual ?? 0).ToString("N2"))</td><td>@c.ActualizadoEn.ToString("dd/MM/yyyy")</td><td>@if (Model.PuedeVerCarteraGlobal) { <a class="crm-link" href="@Url.Action("Ficha", new { id = c.Id, empresa = c.Empresa })">Ver ficha</a> }</td></tr> }
        </tbody></table></div>
    </div>
</div>
@section scripts { <script src="@Url.Content("~/Scripts/clientes-crm.js?v=3")"></script> }
