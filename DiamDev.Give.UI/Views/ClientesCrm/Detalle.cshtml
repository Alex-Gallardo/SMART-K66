@model DiamDev.Give.UI.Models.ClienteCrmDetalleViewModel
@using System
@using System.Linq
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esSolicitud = Model.Solicitud != null;
    var f = esSolicitud ? Model.Solicitud.Ficha : Model.Cliente.Ficha;
    string empresa = esSolicitud ? Model.Solicitud.Empresa : Model.Cliente.Empresa;
    string nombreEmpresa = empresa == "FAES" ? "Escocesa" : empresa == "GRACO" ? "Graco Pack" : "Bolik";
    long entidadId = esSolicitud ? Model.Solicitud.Id : Model.Cliente.Id;
}
@section styles { <link href="@Url.Content("~/Content/clientes-crm.css?v=1")" rel="stylesheet" /> }
<div class="crm crm-detail" data-empresa="@empresa">
    <header class="crm-page-head">
        <a class="crm-back" href="@Url.Action(Model.EsVistaCreditos ? (esSolicitud ? "Dashboard" : "Clientes") : "Index")"><i class="icon-arrow-left"></i> Volver al listado</a>
        <div class="crm-head-row"><div><span class="crm-eyebrow">@(esSolicitud ? "Solicitud #" + entidadId : "Ficha de cliente #" + entidadId) · @nombreEmpresa</span>
            <h1>@f.RazonSocial</h1><p>@f.NombreComercial · @f.NitDpi</p></div>
            <div class="crm-head-actions">
                @if (esSolicitud) { <span class="crm-state crm-state-@Model.Solicitud.Estado.ToLowerInvariant()">@Model.Solicitud.Estado</span> }
                else { <span class="crm-state @(Model.Cliente.Activo ? "crm-state-aprobada" : "crm-state-rechazada")">@(Model.Cliente.Activo ? "Activo" : "Inactivo")</span> }
                @if (Model.PuedeEditar) { <a class="crm-btn crm-btn-primary" href="@(esSolicitud ? Url.Action("EditarSolicitud", new { id = entidadId }) : Url.Action("EditarCliente", new { id = entidadId, empresa = empresa }))"><i class="icon-pencil"></i> Editar</a> }
            </div></div>
    </header>
    @if (TempData["CrmExito"] != null) { <div class="crm-alert crm-alert-success">@TempData["CrmExito"]</div> }
    @if (TempData["CrmError"] != null) { <div class="crm-alert crm-alert-error">@TempData["CrmError"]</div> }
    @if (esSolicitud && Model.Solicitud.Estado == "RECHAZADA") { <div class="crm-alert crm-alert-error"><strong>Motivo del rechazo:</strong> @Model.Solicitud.MotivoRechazo</div> }
    @if (esSolicitud && Model.Solicitud.ClienteId.HasValue) { <div class="crm-alert crm-alert-success">Esta solicitud creó una ficha CRM. <a href="@Url.Action("Ficha", new { id = Model.Solicitud.ClienteId, empresa = empresa })">Abrir ficha de cliente</a></div> }
    @if (!esSolicitud && Model.EmpresasCliente != null && Model.EmpresasCliente.Count > 1) { <nav class="crm-company-tabs" aria-label="Empresas del cliente">@foreach (var e in Model.EmpresasCliente) { <a class="@(e.Empresa == empresa ? "is-active" : "")" href="@Url.Action("Ficha", new { id = entidadId, empresa = e.Empresa })">@(e.Empresa == "FAES" ? "Escocesa" : e.Empresa == "GRACO" ? "Graco Pack" : "Bolik")</a> }</nav> }

    <div class="crm-detail-grid">
        <div class="crm-detail-main">
            <section class="crm-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-user"></i></div><div><h2>Información del cliente</h2><p>Datos fiscales y de facturación</p></div></div>
                <dl class="crm-data-grid"><dt>Razón social</dt><dd>@f.RazonSocial</dd><dt>Nombre comercial</dt><dd>@(f.NombreComercial ?? "—")</dd><dt>NIT o DPI</dt><dd>@f.NitDpi</dd><dt>Tipo de negocio</dt><dd>@(f.TipoNegocio ?? "—")</dd><dt>Dirección fiscal</dt><dd>@(f.DireccionFiscal ?? "—")</dd><dt>Tipo de operación</dt><dd>@(f.TipoOperacion ?? "—")</dd><dt>Correo de factura</dt><dd>@(f.CorreoFactura ?? "—")</dd><dt>Condición de pago</dt><dd>@(f.CondicionPago ?? "—")</dd><dt>Método de pago</dt><dd>@(f.MetodoPago ?? "—")</dd><dt>Temporada de pago</dt><dd>@(f.TemporadaPago ?? "—")</dd><dt>Trámite de contraseña</dt><dd>@(f.TramiteContrasena ?? "—")</dd><dt>Cambio de razón social</dt><dd>@(f.CambioRazonSocial ? "Sí" : "No")</dd></dl>
            </section>
            <section class="crm-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-users"></i></div><div><h2>Contactos</h2><p>Unidad de decisión y comunicación</p></div></div>
                <dl class="crm-data-grid"><dt>Contacto principal</dt><dd>@(f.ContactoPrincipal ?? "—") · @(f.CargoPrincipal ?? "—")</dd><dt>Teléfono / correo</dt><dd>@(f.TelefonoPrincipal ?? "—") · @(f.CorreoPrincipal ?? "—")</dd><dt>Tomador de decisión</dt><dd>@(f.TomadorDecision ?? "—")</dd><dt>Influenciador técnico</dt><dd>@(f.InfluenciadorTecnico ?? "—")</dd><dt>Responsable de compras</dt><dd>@(f.ResponsableCompras ?? "—")</dd><dt>Contacto de pagos</dt><dd>@(f.ContactoPagos ?? "—")</dd><dt>Canal preferido</dt><dd>@(f.CanalPreferido ?? "—")</dd><dt>Relación</dt><dd>@(f.ObservacionesRelacion ?? "—")</dd></dl>
                @if (f.Contactos != null && f.Contactos.Count > 0) { <div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Área</th><th>Nombre</th><th>Puesto</th><th>Teléfono</th><th>Correo</th></tr></thead><tbody>@foreach (var c in f.Contactos) { <tr><td>@c.Area</td><td><strong>@c.Nombre</strong></td><td>@c.Puesto</td><td>@c.Telefono</td><td>@c.Correo</td></tr> }</tbody></table></div> }
            </section>
            <section class="crm-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-map-marker"></i></div><div><h2>Direcciones de entrega</h2><p>Ubicaciones, horarios y modalidades</p></div></div>
                @if (f.Direcciones != null) { foreach (var d in f.Direcciones) { <div class="crm-address-detail"><div><i class="icon-map-marker"></i></div><div><strong>@(d.Nombre ?? "Dirección de entrega")</strong><p>@d.Direccion</p><small>@d.Modalidad · @d.Referencia</small><small>Semana: @(d.HorarioSemana ?? "—") · Fin de semana: @(d.HorarioFinSemana ?? "—")</small><small>@(d.RequiereCita ? "Requiere cita previa" : "Sin cita previa") · @(d.Activa ? "Activa" : "Inactiva")</small></div></div> } }
            </section>
            <section class="crm-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-building"></i></div><div><h2>Perfil del negocio</h2><p>Cobertura y contexto comercial</p></div></div>
                <dl class="crm-data-grid"><dt>Cobertura geográfica</dt><dd>@(f.CoberturaGeografica ?? "—")</dd><dt>Regiones de mayor venta</dt><dd>@(f.RegionesMayorVenta ?? "—")</dd><dt>Sucursales / PDV</dt><dd>@(f.SucursalesMayorVenta ?? "—")</dd><dt>Vendedores de campo</dt><dd>@(f.VendedoresCampo.HasValue ? f.VendedoresCampo.ToString() : "—")</dd><dt>Vendedores de tienda</dt><dd>@(f.VendedoresTienda.HasValue ? f.VendedoresTienda.ToString() : "—")</dd><dt>Canales</dt><dd>@string.Join(", ", new[] { f.Televentas ? "Televentas" : null, f.VentaMostrador ? "Mostrador" : null, f.VentaInstitucional ? "Institucional" : null, f.Ecommerce ? "Comercio electrónico" : null }.Where(x => x != null))</dd><dt>Clientes finales</dt><dd>@(f.ClientesFinales ?? "—")</dd><dt>Temporadas de demanda</dt><dd>@(f.TemporadasDemanda ?? "—")</dd><dt>Proyectos / eventos</dt><dd>@(f.ProyectosEventos ?? "—")</dd></dl>
            </section>
            <section class="crm-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-bar-chart"></i></div><div><h2>Desarrollo comercial · @nombreEmpresa</h2><p>Indicadores capturados para esta empresa</p></div></div>
                <div class="crm-detail-metrics"><div><span>Venta últimos 12 meses · @f.MonedaIndicadores</span><strong>@((f.Venta12Meses ?? 0).ToString("N2"))</strong></div><div><span>Potencial anual · @f.MonedaIndicadores</span><strong>@((f.PotencialAnual ?? 0).ToString("N2"))</strong></div><div><span>Objetivo 12 meses · @f.MonedaIndicadores</span><strong>@((f.Objetivo12Meses ?? 0).ToString("N2"))</strong></div></div>
                <dl class="crm-data-grid"><dt>Compra actualmente</dt><dd>@(f.CompraActualmente ? "Sí" : "No")</dd><dt>Oportunidad principal</dt><dd>@(f.OportunidadCrecimiento ?? "—")</dd><dt>Competidor principal</dt><dd>@(f.CompetidorNegocio ?? "—")</dd><dt>Forecast</dt><dd>@(f.Forecast ?? "—")</dd><dt>Próximo paso</dt><dd>@(f.ProximoPaso ?? "—")</dd><dt>Observaciones</dt><dd>@(f.ObservacionesComerciales ?? "—")</dd></dl>
            </section>
            <section class="crm-card"><div class="crm-card-head"><div class="crm-section-icon"><i class="icon-lightbulb"></i></div><div><h2>Inteligencia comercial</h2></div></div><dl class="crm-data-grid"><dt>Necesidad principal</dt><dd>@(f.NecesidadPrincipal ?? "—")</dd><dt>Valora del proveedor</dt><dd>@(f.ValorProveedor ?? "—")</dd><dt>Motivo de compra</dt><dd>@(f.MotivoCompra ?? "—")</dd><dt>Objeción</dt><dd>@(f.ObjecionPrincipal ?? "—")</dd><dt>Competidor</dt><dd>@(f.CompetidorPrincipal ?? "—")</dd><dt>Fortaleza competidor</dt><dd>@(f.FortalezaCompetidor ?? "—")</dd><dt>Oportunidad frente a competidor</dt><dd>@(f.DebilidadCompetidor ?? "—")</dd><dt>Información de mercado</dt><dd>@(f.InformacionMercado ?? "—")</dd><dt>Riesgo comercial</dt><dd>@(f.RiesgoComercial ?? "—")</dd><dt>Satisfacción</dt><dd>@(f.Satisfaccion ?? "—")</dd></dl></section>
        </div>
        <aside class="crm-detail-aside">
            <section class="crm-card crm-side-card"><h2>Estado de la ficha</h2>
                @if (esSolicitud) { <dl><dt>Empresa</dt><dd>@nombreEmpresa</dd><dt>Agente</dt><dd>@Model.Solicitud.Agente</dd><dt>Creada por</dt><dd>@Model.Solicitud.CreadoPor</dd><dt>Fecha</dt><dd>@Model.Solicitud.CreadoEn.ToString("dd/MM/yyyy HH:mm")</dd><dt>Enviada</dt><dd>@(Model.Solicitud.EnviadoEn.HasValue ? Model.Solicitud.EnviadoEn.Value.ToString("dd/MM/yyyy HH:mm") : "—")</dd></dl> }
                else { <dl><dt>Empresa</dt><dd>@nombreEmpresa</dd><dt>Código SAP</dt><dd><strong>@(string.IsNullOrWhiteSpace(Model.Cliente.CodigoSap) ? "Pendiente de vincular" : Model.Cliente.CodigoSap)</strong></dd><dt>Última actualización</dt><dd>@Model.Cliente.ActualizadoEn.ToString("dd/MM/yyyy HH:mm")</dd></dl> }
            </section>
            @if (Model.PuedeResolver) { <section class="crm-card crm-side-card"><h2>Resolver solicitud</h2><p>La aprobación crea o actualiza la ficha CRM en SQL. El código SAP se registra después.</p>
                <form method="post" action="@Url.Action("ResolverSolicitud")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@entidadId" /><input type="hidden" name="version" value="@Model.Solicitud.Version" /><button class="crm-btn crm-btn-primary crm-btn-full" name="decision" value="APROBAR" type="submit"><i class="icon-ok"></i> Aprobar solicitud</button><label for="crmMotivo">Motivo del rechazo</label><textarea id="crmMotivo" name="motivo" class="form-control" maxlength="1000" rows="3" placeholder="Explique al vendedor qué debe corregir"></textarea><button class="crm-btn crm-btn-danger crm-btn-full" name="decision" value="RECHAZAR" type="submit"><i class="icon-remove"></i> Rechazar solicitud</button></form>
            </section> }
            @if (!esSolicitud && Model.PuedeEditar) { <section class="crm-card crm-side-card"><h2>Administrar cliente</h2><p>La desactivación conserva la ficha y su historial.</p><form method="post" action="@Url.Action("CambiarActivo")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@entidadId" /><input type="hidden" name="empresa" value="@empresa" /><input type="hidden" name="version" value="@Model.Cliente.Version" /><input type="hidden" name="activo" value="@(Model.Cliente.Activo ? "false" : "true")" /><button type="submit" class="crm-btn crm-btn-outline crm-btn-full">@(Model.Cliente.Activo ? "Desactivar cliente" : "Reactivar cliente")</button></form></section> }
            <section class="crm-card crm-side-card"><h2>Documentos</h2>@if (Model.Archivos != null && Model.Archivos.Count > 0) { foreach (var a in Model.Archivos) { <a class="crm-file-link" href="@Url.Action("Archivo", new { id = a.Id, entidadId = entidadId, esSolicitud = esSolicitud, empresa = empresa })"><i class="icon-paper-clip"></i><span><strong>@a.Tipo</strong><small>@a.Nombre</small></span><i class="icon-download"></i></a> } } else { <p class="crm-muted">Sin documentos adjuntos a esta ficha.</p> }</section>
            <section class="crm-card crm-side-card"><h2>Actividad</h2><ol class="crm-timeline">@foreach (var e in Model.Eventos.Take(15)) { <li><span></span><strong>@e.Accion</strong><small>@e.Fecha.ToString("dd/MM/yyyy HH:mm") · @e.Usuario</small>@if (!string.IsNullOrWhiteSpace(e.Detalle)) { <p>@e.Detalle</p> }</li> }</ol></section>
        </aside>
    </div>
</div>
