@model PagedList.IPagedList<DiamDev.Give.Entities.ContrasenaPago>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Contraseña de Pago Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Contrasena_Pago")">
        Nueva
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <form action="" method="get" class="form-inline">
            <div class="input-group well">
                <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                <span class="input-group-btn">
                    <button class="btn btn-primary" type="button">
                        <i class="clip-search-3"></i> Buscar
                    </button>
                </span>
            </div>
        </form>
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Contraseña de Pago
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover">
                    <thead>
                        <tr>              
                            <th>#Contraseña</th>             
                            <th>Fecha</th> 
                            <th>Fecha Pago</th>                                                    
                            <th>Proveedor</th>
                            <th>#Documento</th>
                            <th>Monto</th>                           
                            <th>Responsable</th>    
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Detalle in Model)
                        {
                            <tr>  
                                <td>@Detalle.ContrasenaId</td>                             
                                <td>@Detalle.Fecha.ToString("dd/MM/yyyy")</td>  
                                <td>@Detalle.FechaPago.ToString("dd/MM/yyyy")</td>   
                                <td>@(Detalle.Proveedor == null ? "No Disponible" : Detalle.Proveedor.Nombre)</td>                            
                                <td>@Detalle.Documento</td>
                                <td>@Detalle.Monto.ToString("C4")</td>
                                <td>@(Detalle.UsuarioCreo == null ? "No Disponible" : Detalle.UsuarioCreo.Nombre)</td>  
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                        <a href="@Url.Action("Boleta", "Contrasena_Pago", new { id = Detalle.ContrasenaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Contraseña"><i class="clip-file-pdf"></i></a>
                                        @if (!Detalle.Operado)
                                        {
                                            <a href="javascript:void(0);" onclick="operar('@Detalle.ContrasenaId');" class="operar btn btn-teal tooltips" data-placement="top" data-original-title="Operar Contraseña"><i class="clip-checkmark"></i></a>
                                        }                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { search = ViewBag.Search, page }))

@section Scripts
{
    <script type="text/javascript">
        $(function ()
        {
            if ('@TempData["Contrasena_Pago-Success"]' == "OK")
            {
                toastr.success('La contraseña de pago se guardó exitosamente');
            }
        });

        function operar(id)
        {
            if (confirm("¿Desea operar la contraseña de pago?"))
            {
                $.ajax({
                    url: '@Url.Action("ActualizarEstadoContrasenaPago", "Contrasena_Pago")?id=' + encodeURI(id),
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        if (!data.Operacion)
                        {
                            toastr.error('Ocurrió un error, al operar la contraseña de pago');
                            return;
                        }

                        toastr.success('La contraseña de pago se opero exitosamente');
                        window.location = '@Url.Action("Index", "Contrasena_Pago")';
                    },
                    fail: function (data)
                    {
                        console.error(data);
                        toastr.error('Ocurrió un error, al operar la contraseña de pago');
                    }
                });
            }
        }
    </script>
}




