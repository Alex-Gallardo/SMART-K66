@model DiamDev.Give.Entities.CotizacionEncabezado
@using System.Collections.Generic
@using System.Linq
@{
    Layout = null;
    var empresas = new Dictionary<string, dynamic>(System.StringComparer.OrdinalIgnoreCase)
    {
        { "GRACO", new { Nombre = "GRACOPACK DE CENTROAMÉRICA, S.A.", Nit = "4340248-8", Color = "#15803d", Logo = "LogoGraco.svg" } },
        { "FAES",  new { Nombre = "FÁBRICA ESCOCESA, S.A.", Nit = "4153479-4", Color = "#b91c1c", Logo = "LogoFaes.svg" } },
        { "BOLIK", new { Nombre = "INDUSTRIAS BOLIK, S.A.", Nit = "4050444-1", Color = "#1e3a5f", Logo = "logoBolik.svg" } }
    };
    dynamic emp = empresas.ContainsKey(Model.IdEmpresa ?? "")
        ? empresas[Model.IdEmpresa] : new { Nombre = Model.IdEmpresa, Nit = "", Color = "#2563eb", Logo = "" };
    var detalles = Model.Detalles ?? new List<DiamDev.Give.Entities.CotizacionDetalle>();
}
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Cotización @Model.IdCotizacion</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#edf2f7;color:#1e293b;font:12px/1.4 "Segoe UI",Arial,sans-serif;padding:24px}.actions{display:flex;gap:8px;justify-content:center;margin:0 auto 12px;max-width:960px}.actions button{border:1px solid #cbd5e1;border-radius:7px;background:#fff;padding:8px 14px}.actions .primary{background:@emp.Color;border-color:@emp.Color;color:#fff}.sheet{background:#fff;border:1px solid #dbe3ec;box-shadow:0 18px 50px rgba(15,23,42,.14);margin:auto;max-width:960px;min-height:1120px;padding:38px 42px 70px;position:relative}.accent{height:5px;background:@emp.Color;left:0;right:0;top:0;position:absolute}.header{align-items:flex-start;border-bottom:2px solid @emp.Color;display:flex;justify-content:space-between;padding-bottom:18px}.brand{align-items:center;display:flex;gap:16px}.brand img{height:64px;max-width:190px;object-fit:contain}.brand h1{font-size:17px;margin:0}.brand p{color:#64748b;margin:3px 0}.doc{text-align:right}.doc small,.label{color:#64748b;font-size:8.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.doc strong{display:block;font:700 21px Consolas,monospace;margin-top:3px}.status{border:1px solid @emp.Color;border-radius:999px;color:@emp.Color;display:inline-block;font-size:9px;font-weight:800;margin-top:6px;padding:3px 9px}.meta{display:grid;gap:14px 20px;grid-template-columns:repeat(4,1fr);padding:20px 0}.meta .wide{grid-column:span 2}.value{display:block;font-size:10.5px;font-weight:600;margin-top:3px;overflow-wrap:anywhere}.section-title{align-items:center;display:flex;font-weight:800;gap:8px;margin:8px 0}.section-title:after{background:#dbe3ec;content:"";flex:1;height:1px}table{border-collapse:collapse;table-layout:fixed;width:100%}th{background:#f1f5f9;color:#475569;font-size:8px;letter-spacing:.04em;padding:7px 6px;text-align:left;text-transform:uppercase}td{border-bottom:1px solid #e5eaf0;font-size:9px;padding:8px 6px;vertical-align:top;word-break:break-word}.num{text-align:right}.muted{color:#64748b;display:block;font-size:8px}.summary{display:flex;justify-content:flex-end;margin-top:15px}.summary-box{border:1px solid #dbe3ec;border-radius:8px;min-width:300px;padding:10px 14px}.sum-row{display:flex;justify-content:space-between;padding:3px 0}.sum-row.grand{border-top:1px solid #cbd5e1;color:@emp.Color;font-size:16px;font-weight:800;margin-top:5px;padding-top:7px}.terms{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;display:grid;gap:12px 20px;grid-template-columns:1fr 1fr;margin-top:18px;padding:13px}.terms .wide{grid-column:1/-1}.cancelled{border:4px solid #b91c1c;color:#b91c1c;font-size:54px;font-weight:900;left:50%;opacity:.12;padding:10px 30px;position:absolute;top:48%;transform:translate(-50%,-50%) rotate(-18deg)}.sign{display:grid;gap:70px;grid-template-columns:1fr 1fr;margin-top:70px;text-align:center}.sign div{border-top:1px solid #94a3b8;padding-top:6px}.footer{bottom:25px;color:#94a3b8;display:flex;font-size:8px;justify-content:space-between;left:42px;position:absolute;right:42px}@@page{size:Letter portrait;margin:9mm}@@media print{body{background:#fff;padding:0}.actions{display:none}.sheet{border:0;box-shadow:none;max-width:none;min-height:250mm;padding:9mm 9mm 18mm}.footer{bottom:4mm;left:9mm;right:9mm}}@@media(max-width:700px){body{padding:0}.sheet{border:0;box-shadow:none;min-height:100vh;padding:26px 18px 70px}.header{gap:15px;flex-direction:column}.doc{text-align:left}.meta{grid-template-columns:repeat(2,1fr)}.terms{grid-template-columns:1fr}.terms .wide{grid-column:auto}.table-wrap{overflow:auto}table{min-width:760px}.footer{left:18px;right:18px}}
</style></head><body>
<div class="actions"><button onclick="window.close()">Cerrar</button><button class="primary" onclick="window.print()">Imprimir / Guardar PDF</button></div>
<main class="sheet"><div class="accent"></div>
@if (Model.Estado == "ANULADA") { <div class="cancelled">ANULADA</div> }
<header class="header"><div class="brand">@if (!string.IsNullOrWhiteSpace((string)emp.Logo)) { <img src="@Url.Content("~/Content/img/logos/" + emp.Logo)" alt="@emp.Nombre" /> }<div><h1>@emp.Nombre</h1><p>NIT @emp.Nit</p></div></div><div class="doc"><small>Cotización</small><strong>@Model.IdCotizacion</strong><span class="status">@Model.Estado</span></div></header>
<section class="meta"><div><span class="label">Emisión</span><span class="value">@Model.Fecha.ToString("dd/MM/yyyy")</span></div><div><span class="label">Válida hasta</span><span class="value">@Model.ValidaHasta.ToString("dd/MM/yyyy")</span></div><div><span class="label">Moneda</span><span class="value">@Model.Moneda</span></div><div><span class="label">Agente</span><span class="value">@Model.Agente</span></div><div><span class="label">Código cliente</span><span class="value">@Model.IdCliente</span></div><div class="wide"><span class="label">Cliente</span><span class="value">@Model.NombreCliente</span></div><div><span class="label">NIT</span><span class="value">@Model.Nit</span></div><div class="wide"><span class="label">Dirección</span><span class="value">@Model.Direccion</span></div><div class="wide"><span class="label">Correo</span><span class="value">@Model.Correo</span></div></section>
<div class="section-title">Detalle de productos</div><div class="table-wrap"><table><thead><tr><th style="width:5%">#</th><th style="width:15%">Código</th><th style="width:29%">Descripción</th><th style="width:8%">Unidad</th><th class="num" style="width:9%">Cantidad</th><th class="num" style="width:11%">Precio</th><th class="num" style="width:8%">Desc.</th><th class="num" style="width:15%">Total</th></tr></thead><tbody>@foreach (var d in detalles) { <tr><td>@d.Linea</td><td><strong>@d.ItemCode</strong><span class="muted">@d.Grupo</span></td><td>@d.Descripcion</td><td>@d.Unidad</td><td class="num">@d.Cantidad.ToString("N2")</td><td class="num">@d.PrecioUnitario.ToString("N2")</td><td class="num">@d.DescuentoPorcentaje.ToString("N2")%</td><td class="num"><strong>@d.Total.ToString("N2")</strong><span class="muted">IVA @d.ImpuestoPorcentaje.ToString("N2")%</span></td></tr> }</tbody></table></div>
<div class="summary"><div class="summary-box"><div class="sum-row"><span>Importe bruto</span><strong>@Model.ImporteBruto.ToString("N2")</strong></div><div class="sum-row"><span>Descuento</span><strong>-@Model.DescuentoTotal.ToString("N2")</strong></div><div class="sum-row"><span>Subtotal</span><strong>@Model.Subtotal.ToString("N2")</strong></div><div class="sum-row"><span>IVA</span><strong>@Model.ImpuestoTotal.ToString("N2")</strong></div><div class="sum-row grand"><span>Total @Model.Moneda</span><strong>@Model.Total.ToString("N2")</strong></div></div></div>
<section class="terms"><div><span class="label">Condiciones de pago</span><span class="value">@(string.IsNullOrWhiteSpace(Model.CondicionesPago) ? "—" : Model.CondicionesPago)</span></div><div><span class="label">Tiempo de entrega</span><span class="value">@(string.IsNullOrWhiteSpace(Model.TiempoEntrega) ? "—" : Model.TiempoEntrega)</span></div><div class="wide"><span class="label">Observaciones</span><span class="value">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</span></div></section>
<section class="sign"><div>Agente / asesor comercial</div><div>Aceptación del cliente</div></section><footer class="footer"><span>Smart K66 · Cotizaciones</span><span>Documento generado @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span></footer></main></body></html>
