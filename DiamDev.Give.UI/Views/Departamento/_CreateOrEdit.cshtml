@model DiamDev.Give.Entities.Departamento

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Nombre del Departamento<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre del Departamento", required = "required", autocomplete = "off", autofocus = "autofocus" })
        </div>        
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Activo
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="true" @ViewBag.DepartamentoSi name="departamento" id="DepartamentoSi">
                    Sí
                </label>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="false" @ViewBag.DepartamentoNo name="departamento" id="DepartamentoNo">
                    No
                </label>
            </div>
        </div>
    </div>
</div>


