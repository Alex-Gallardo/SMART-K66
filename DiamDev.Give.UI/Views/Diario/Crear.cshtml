@model DiamDev.Give.Entities.Diario

@{
    ViewBag.Title = "Nuevo Diario";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nuevo Diario
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nuevo Diario</h2>
                <p>
                    Crea un nuevo diario.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                    </div>
                    @Html.Partial("_CreateOrEdit")
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Diario")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="cuenta_tr_template">
        <tr>
            <td>{{cuenta}}</td>
            <td>Q{{debe}}</td>
            <td>Q{{haber}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="cuentaIds" value="{{cuenta_id}}" />
                <input type="hidden" name="debeIds" value="{{debe}}" />
                <input type="hidden" name="haberIds" value="{{haber}}" />              
            </td>
        </tr>
    </script>
    <script type="text/html" id="agencia_tr_template">
        <tr>
            <td>{{nombre}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="agenciasIds" value="{{id}}" />
            </td>
        </tr>
    </script>

    <script type="text/javascript">

        var cuentaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.cuentaIds))');
        var debeSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.debeIds))');
        var haberSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.haberIds))');

        var agenciasSeleccionadas = JSON.parse('@Html.Raw(Json.Encode(ViewBag.AgenciasIds))');

        $(function ()
        {
            function error(texto)
            {
                toastr.error(texto);
            }

            function cargaCuenta(cuenta_id, cuenta, debe, haber)
            {
                var plantilla = $('#cuenta_tr_template').html();

                var modelo =
                {
                    cuenta_id: cuenta_id,
                    cuenta: cuenta,
                    debe: debe,
                    haber: haber
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#cuenta_tbody').append(filaHtml);
            }

            function cargaAgencia(id, nombre)
            {
                var plantilla = $('#agencia_tr_template').html();

                var modelo =
                {
                    id: id,
                    nombre: nombre
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#agencia_tbody').append(filaHtml);
            }

            renderizarCuentasIniciales();
            renderizarAgenciasIniciales();

            $('#btn-agregar').click(function (e)
            {
                e.preventDefault();

                var cuenta_id = $('#CuentaId').val();
                var cuenta = $('#CuentaId option:selected').text();

                if (cuenta_id === "" || cuenta === "")
                {
                    error("Seleccione una cuenta");
                    return;
                }

                var valor = $('#Valor').val();

                if (valor === "")
                {
                    error("El valor de la cuenta no puede ir en blanco");
                    return;
                }

                valor = parseFloat(valor);

                if (valor <= 0)
                {
                    error("El valor de la cuenta no puede ser 0");
                    return;
                }

                var debe = 0;
                var haber = 0;

                var saldoId = $("#SaldoId").val();

                if (saldoId === "1")
                {
                    debe = valor;
                }
                else
                {
                    haber = valor;
                }

                cargaCuenta(cuenta_id, cuenta, debe, haber);
                totalizarCuenta();

                $("#CuentaId").val(0);
                $("#Valor").val(0);
                $("#CuentaId").focus();
            });

            $('#btn-agregar-agencia').click(function (e)
            {
                e.preventDefault();

                var id = $('#AgenciaId').val()
                var nombre = $('#AgenciaId option:selected').text()

                if (id === "")
                {
                    error("Seleccione una agencia");
                    return;
                }

                if (nombre === "")
                {
                    error("Seleccione una agencia");
                    return;
                }

                cargaAgencia(id, nombre);

                $("#AgenciaId").val(0);
                $("#AgenciaId").focus();

            });

            $('#cuenta_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();

                totalizarCuenta();
            });

            $('#agencia_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            function renderizarCuentasIniciales()
            {
                if (cuentaSeleccionados == null)
                {
                    return;
                }

                // recorremos las cuentas que haya ingresado el usuario
                for (var i = 0; i < cuentaSeleccionados.length; i++)
                {
                    var cuenta_id = cuentaSeleccionados[i];
                    var cuenta = $('#CuentaId option[value=' + cuenta_id + ']').text();

                    var debe = debeSeleccionados[i];
                    var haber = haberSeleccionados[i];

                    cargaCuenta(cuenta_id, cuenta, debe, haber);
                }

                totalizarCuenta();
            }

            function renderizarAgenciasIniciales()
            {

                if (agenciasSeleccionadas == null)
                {
                    return;
                }

                // recorremos las agencias que haya ingresado el administrador
                for (var i = 0; i < agenciasSeleccionadas.length; i++)
                {
                    var id = agenciasSeleccionadas[i];
                    var nombre = $('#AgenciaId option[value=' + id + ']').text()

                    cargaAgencia(id, nombre);
                }
            }

            function totalizarCuenta()
            {
                var debeArray = new Array();
                $('input[name=debeIds]').each(function ()
                {
                    debeArray.push(parseFloat($(this).val()));
                });

                var haberArray = new Array();
                $('input[name=haberIds]').each(function ()
                {
                    haberArray.push(parseFloat($(this).val()));
                });

                var debe = 0;
                var haber = 0;

                if (debeArray.length > 0) {
                    for (var i = 0; i < debeArray.length; i++) {
                        debe += debeArray[i];
                    }

                    $('#Total_Debe').html('Q' + debe.toFixed(2));
                    $('#Total_Haber').html('Q' + haber.toFixed(2));
                }
                else
                {
                    $('#Total_Debe').html('Q' + debe.toFixed(2));
                    $('#Total_Haber').html('Q' + haber.toFixed(2));
                }

                if (haberArray.length > 0)
                {
                    for (var i = 0; i < haberArray.length; i++)
                    {
                        haber += haberArray[i];
                    }

                    $('#Total_Debe').html('Q' + debe.toFixed(2));
                    $('#Total_Haber').html('Q' + haber.toFixed(2));
                }
                else
                {
                    $('#Total_Debe').html('Q' + debe.toFixed(2));
                    $('#Total_Haber').html('Q' + haber.toFixed(2));
                }
            }
        });

  </script>
}
