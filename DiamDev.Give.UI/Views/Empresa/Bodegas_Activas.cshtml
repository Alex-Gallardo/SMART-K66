@model DiamDev.Give.Entities.Empresa

@{
    ViewBag.Title = "Agregar Bodegas Activas x Empresa";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Empresa
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="EmpresaId" name="EmpresaId" value="@Html.Raw(Model.EmpresaId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre de la Empresa", required = "required", autocomplete = "off", @readonly = "readonly" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre Comercial<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.NombreComercial, new { @class = "form-control", @placeholder = "Nombre Comercial de la Empresa", required = "required", autocomplete = "off", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>
                    <hr />
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Bodegas Activas
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    WAREHOUSE ID
                                </label>
                                @Html.DropDownList("WarehouseId", (SelectList)ViewBag.Warehouses, "--Seleccione un Warehouse ID--", new { @class = "form-control search-select" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    LOCATION ID
                                </label>
                                <select id="LocationId" name="LocationId" class="form-control search-select">
                                    <option value="">--Seleccione un Location ID--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>WAREHOUSE ID</th>
                                        <th>LOCATION ID</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Bodegas != null && Model.Bodegas.Count() > 0)
                                    {
                                        foreach (var Detalle in Model.Bodegas)
                                        {
                                            <tr>
                                                <td>
                                                    @Detalle.WarehouseId
                                                </td>
                                                <td>
                                                    @Detalle.LocationId
                                                </td>
                                                <td>
                                                    <a onclick="eliminar('@Detalle.BodegaId');" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3">
                                                <strong>No contiene bodegas activas</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-12">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Empresa")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

    var vCodBarra = "";

    $(function ()
    {
        function error(texto)
        {
            toastr.error(texto);
        }

        $("#WarehouseId").change(function (evt)
        {
            evt.preventDefault();
            if ($(this).val() !== "")
            {
                var LocationSelect = $("#LocationId");
                LocationSelect.empty();
                LocationSelect.append('<option value="">--Seleccione un Location ID--</option>');

                $.ajax({
                    url: '@Url.Action("ObtenerBodegaActivaxWarehouse", "Empresa")',
                    data: { 'id': $('#EmpresaId').val(), 'warehouseId': $(this).val() },
                    traditional: true,
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        $.each(data, function (j)
                        {
                            LocationSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                        });
                    }
                });
            }
        });

        $('#btn-agregar').click(function (e)
        {
            e.preventDefault();

            var warehouse_id = $('#WarehouseId').val();
           
            if (warehouse_id === "")
            {
                error("Seleccioner un Warehouse ID");
                return;
            }

            var location_id = $('#LocationId').val();

            if (location_id === "")
            {
                error("Seleccioner un Location ID");
                return;
            }

           var modelo =
           {
               'EmpresaId': $("#EmpresaId").val(),
               'WarehouseId': warehouse_id,
               'LocationId': location_id
           };

            $.ajax({
                url: '@Url.Action("GuardarBodegaActiva", "Empresa")',
                data: { 'modelo': modelo },
                async: false,
                type: 'POST',
                success: function (data)
                {
                    if (data.Operacion)
                    {
                        toastr.success('La bodega activa se guardó exitosamente');
                        window.location.reload();
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al guardar la bodega activa');
                    }
                }
            });
        });
    });

    function eliminar(id)
    {
        if (confirm("¿Desea eliminar la bodega activa seleccionada?"))
        {
            $.ajax({
                url: '@Url.Action("EliminarBodegaActiva", "Empresa")',
                data: { 'id': id },
                async: false,
                type: 'POST',
                success: function (data)
                {
                    if (data.Operacion)
                    {
                        toastr.success('La bodega activa se elimino exitosamente');
                        window.location.reload();
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al eliminar la bodega activa');
                    }
                }
            });
        }
    }

    </script>
}