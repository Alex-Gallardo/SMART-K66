@model DiamDev.Give.Entities.Empresa

@{
    ViewBag.Title = "Agregar Productos Especiales x Empresa";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Empresa
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="EmpresaId" name="EmpresaId" value="@Html.Raw(Model.EmpresaId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre de la Empresa", required = "required", autocomplete = "off", @readonly = "readonly" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre Comercial<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.NombreComercial, new { @class = "form-control", @placeholder = "Nombre Comercial de la Empresa", required = "required", autocomplete = "off", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>
                    <hr />
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Productos Especiales
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Barra
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                                    <span class="input-group-btn">
                                        <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Producto
                                </label>
                                <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" disabled />
                                <input type="hidden" id="ProductoId" name="ProductoId" value="0" />
                                <input type="hidden" id="Codigo" name="Codigo" value="" />
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad de Medida
                                </label>
                                <input type="text" placeholder="Unidad de Medida" class="form-control" id="Unidad" name="Unidad" autocomplete="off" disabled />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Codigo</th>
                                        <th>Producto</th>
                                        <th>Unidad de Medida</th>
                                        <th>Fecha</th>
                                        <th>Responsable</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ProductosEspeciales != null && Model.ProductosEspeciales.Count() > 0)
                                    {
                                        foreach (var Detalle in Model.ProductosEspeciales)
                                        {
                                            <tr>
                                                <td>
                                                    @Detalle.Codigo
                                                </td>
                                                <td>
                                                    @Detalle.Nombre
                                                </td>
                                                <td>
                                                    @Detalle.Unidad
                                                </td>
                                                <td>
                                                    @Detalle.Fecha.ToString("dd/MM/yyyy")
                                                </td>
                                                <td>
                                                    @(Detalle.Responsable == null ? "No Disponible" : Detalle.Responsable.Nombre)
                                                </td>
                                                <td>
                                                    <a onclick="eliminar('@Detalle.EspecialId');" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6">
                                                <strong>No contiene productos especiales</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-12">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Empresa")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="seleccionar-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Producto</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover" id="sample-table-1">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="producto_seleccionado_tbody">
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

    var vCodBarra = "";

    $(function ()
    {
        $('#Barra').focus();

        function error(texto)
        {
            toastr.error(texto);
        }

        $('#btn-agregar').click(function (e)
        {
            e.preventDefault();

            var producto_id = $('#ProductoId').val();
            var producto = $('#Producto').val();

            if (producto_id === "" || producto === "")
            {
                error("Ingrese un producto");
                return;
            }

            var unidad = $('#Unidad').val();

            if (unidad === "")
            {
                error("Ingrese una Unidad de Medida");
                return;
            }

           var modelo =
           {
               'EmpresaId': $("#EmpresaId").val(),
               'Codigo': producto_id,
               'Nombre': producto,
               'Unidad': unidad
           };

            $.ajax({
                url: '@Url.Action("GuardarProductoEspecial", "Empresa")',
                data: { 'modelo': modelo },
                async: false,
                type: 'POST',
                success: function (data)
                {
                    if (data.Operacion)
                    {
                        toastr.success('El producto especial se guardó exitosamente');
                        window.location.reload();
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al guardar el producto especial');
                    }
                }
            });
        });

         $("#Barra").autocomplete({
            source: function (request, response)
            {
                $.ajax({
                    url: '@Url.Action("ConsultaProductoAutocomplementarK66", "Producto")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term, 'clienteId': 0, 'empresaId': $("#EmpresaId").val() },
                    success: function (data)
                    {
                        response($.map(data, function (item)
                        {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
        });

        $('#formaprincipal').keydown(function (evt)
        {
            if ($('#Barra').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                cargaBusquedaProducto(evt)
            }
        });

        /*
        Evento click para el boton de busqueda de productos */
        $('#btnBarra').click(function (evt)
        {
            cargaBusquedaProducto(evt);
        });

        $('#producto_seleccionado_tbody').delegate("a", "click", function (e)
        {
            e.preventDefault();

            $('#btn-close-up-seleccionar-producto').click();
            var productoReferencia = $(this).attr("href");
            var productoActual = productoReferencia.split(",");

            var modelo =
             {
                 'ID': productoActual[0],
                 'Nombre': productoActual[1]
             };

            cargaProductoSeleccionado(modelo);
        });

        /*
        Función para la busqueda de productos */
        function cargaBusquedaProducto(evt)
        {
            evt.preventDefault();

            if ($('#Barra').val() === "")
            {
               // error("Ingresar codigo de barra");
                $('#Barra').focus();
                return;
            }

            if (vCodBarra === $('#Barra').val())
            {
                vAumentaCantidad = parseInt($('#Cantidad').val()) + 1;
                $('#Cantidad').val(vAumentaCantidad);
            }
            else
            {
                $('#Cantidad').val(1);
            }

            var barraActual = $('#Barra').val();
            barraActual = barraActual.replace(" ", "_");

            $.ajax({
                url: '@Url.Action("ObtenerProductoxTextoLibreK66", "Producto")',
                traditional: true,
                data: { 'search': barraActual, 'clienteId': 0, 'empresaId': $("#EmpresaId").val() },
                async: false,
                type: 'GET',
                success: function (resultData)
                {
                    if (resultData !== null)
                    {
                        if (resultData.Operacion)
                        {
                            if (resultData.Data.length === 1)
                            {
                                cargaProductoSeleccionado(resultData.Data[0]);
                            }
                            else if (resultData.Data.length > 1)
                            {
                                var fila = "";
                                for (var i = 0; i < resultData.Data.length; i++)
                                {
                                    fila += "<tr><td>" + resultData.Data[i].ID + "</td>";
                                    fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                    fila += "<td><a href='" + resultData.Data[i].ID + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                }

                                $("#seleccionar-producto-form").modal();
                                $("#seleccionar-producto-form").find("#producto_seleccionado_tbody").html(fila);
                            }
                        }
                        else
                        {
                            toastr.error('La barra del producto ingresada no es correcta');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                        $('#Barra').val("");
                        $('#Barra').focus();
                    }
                }
            });
        }

        function cargaProductoSeleccionado(producto)
        {
            var productoSeleccionado = obtenerProductoxID(producto.ID);

            if (productoSeleccionado !== null)
            {
                $('#Unidad').val(productoSeleccionado.Unidad);
                $('#Producto').val(productoSeleccionado.Descripcion);
                $('#ProductoId').val(productoSeleccionado.ID);
            }

            $('#Barra').focus();
            vCodBarra = $('#Barra').val();
        }

        function obtenerProductoxID(id)
        {
            var producto = null;

            $.ajax({
                url: '@Url.Action("ObtenerPorIDK66", "Producto")',
                data: { 'id': id, 'clienteId': 0, 'empresaId': $("#EmpresaId").val() },
                async: false,
                type: 'GET',
                success: function (data)
                {
                    if (!data.Operacion)
                    {
                        toastr.error('Ocurrió un error, al obtener datos del producto');
                        return;
                    }

                    producto = data.Data;
                },
                fail: function (data)
                {
                    toastr.error('Ocurrió un error, al obtener datos del producto');
                }
            });

            return producto;
        }
    });

        function eliminar(id)
        {
            if (confirm("¿Desea eliminar el producto especial seleccionado?"))
            {
                $.ajax({
                    url: '@Url.Action("EliminarProductoEspecial", "Empresa")',
                    data: { 'id': id },
                    async: false,
                    type: 'POST',
                    success: function (data)
                    {
                        if (data.Operacion)
                        {
                            toastr.success('El producto especial se elimino exitosamente');
                            window.location.reload();
                        }
                        else
                        {
                            toastr.error('Ocurrió un error, al eliminar el producto especial');
                        }
                    }
                });
            }
        }

    </script>
}