@model DiamDev.Give.Entities.Empresa

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Nombre<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre de la Empresa", required = "required", autocomplete = "off" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Nombre Comercial<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.NombreComercial, new { @class = "form-control", @placeholder = "Nombre Comercial de la Empresa", required = "required", autocomplete = "off" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Nombre del Contacto<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.NombreContacto, new { @class = "form-control", @placeholder = "Nombre del Contacto de la Empresa", required = "required", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                #Telefono del Contacto<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.TelefonoContacto, new { @class = "form-control input-mask-phone", @placeholder = "#Telefono del Contacto de la Empresa", required = "required", autocomplete = "off" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                #Telefono del Contacto #2
            </label>
            @Html.TextBoxFor(model => model.TelefonoContacto2, new { @class = "form-control input-mask-phone", @placeholder = "#Telefono del Contacto #2 de la Empresa", autocomplete = "off" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Correo Electronico
            </label>
            @Html.TextBoxFor(model => model.CorreoContacto, new { @class = "form-control", @placeholder = "Correo Electronico del Contacto de la Empresa", autocomplete = "off" })
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
