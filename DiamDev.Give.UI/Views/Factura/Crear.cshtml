        function obtenerCliente(nit) {
            nit = (nit || '').trim();
            if (!nit) return;
            var cliente = null;
            $.ajax({
                url: '@Url.Action("ObtenerPorNit", "Cliente")?nit=' + encodeURI(nit),
                async: false,
                type: 'GET',
                success: function (data) {

                    if (!data.Operacion) {
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                        return;
                    }

                    cliente = data.Data;

                },
                fail: function (data) {
                    toastr.error('Ocurrió un error, al obtener datos del cliente');
                }
            });

            return cliente;
        }

