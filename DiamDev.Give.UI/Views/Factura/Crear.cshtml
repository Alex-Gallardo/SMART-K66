                error("El password es requerido");
                return;
            }

            $.ajax({
                url: '@Url.Action("AutorizarPrecioSupervisor", "Usuario")',
                data: { 'usuario': Usuario, 'password': Password },
                async: false,
                type: 'POST',
                success: function (data)
                {
                    if (data.Operacion)
                    {
                        $('#btn-close-up-autorizar').click();

                        var producto_id = $('#ProductoId').val();
                        var producto = $('#Producto').val();

                        if (producto_id === "" || producto === "") {
                            error("Seleccione un producto");
                            return;
                        }

                        var presentacion_id = $('#PresentacionId').val();
                        var presentacion = $('#PresentacionId option:selected').text();

                        if (presentacion_id === "" || presentacion === "") {
                            error("Seleccione una presentacion");
                            return;
                        }

                        var cantidad_id = $('#Cantidad').val();

                        if (cantidad_id === "") {
                            error("Ingrese la cantidad del producto");
                            return;
                        }

                        var precio_id = $('#PrecioActual').val();
                        precio_id = parseFloat(precio_id);

                        if (precio_id === 0) {
                            error("Ingrese el precio del producto");
                            return;
                        }

                        var existencia_id = parseFloat($('#Existencia').val());
                        cantidad_id = parseFloat(cantidad_id);

                        if (cantidad_id <= 0) {
                            error("La cantidad ingresada no puede ser 0");
                            return;
                        }

                        if (cantidad_id > existencia_id) {
                            error("La cantidad ingresada es mayor a la existencia");
                            return;
                        }

                        var precioVentaFinal_id = $("#DescuentoActual").val();
                        precioVentaFinal_id = parseFloat(precioVentaFinal_id);

                        if (precioVentaFinal_id > 0) {
                            var minimoPrecioVenta = $("#PrecioVentaMinimo").val();
                            minimoPrecioVenta = parseFloat(minimoPrecioVenta);
                        }

                        var precioVentaTotalDescuento = 0;
                        if (precioVentaFinal_id > 0) {
                            precioVentaTotalDescuento = precio_id - precioVentaFinal_id
                        }
                        precioVentaTotalDescuento = parseFloat(precioVentaTotalDescuento);

                        var IDsActual = "";
                        var tieneIds = $("#TieneIDs").val();
                        tieneIds = parseInt(tieneIds);

                        if (tieneIds === 1) {
                            IDsActual = $("#ProductoActualIDs").val();
                            if (IDsActual === "") {
                                error("Seleccionar un IDs");
                                return;
                            }

                            if (IDsActual === "0") {
                                error("Seleccionar un IDs");
                                return;
                            }
                        }

                        cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, IDsActual, precio_id, precioVentaTotalDescuento);
                        totalizarProducto();

                        //Se oculta el boton de visualizar imagen
                        $('#imagen').css("display", "none");

                        //Se asigna la imagen por default
                        $("#visualizar-imagen-producto-form").find("#fotografia").attr("src", "@Url.Content("~/Content/assets/images/producto-sin-foto.jpg")");

                        $("#divEscalaPrecios").html("");
                        $("#divMostrarEscalaPrecios").hide();

                        $("#ProductoId").val(0);
                        $("#TieneIDs").val(0);
                        $("#Cantidad").val(1);
                        $("#Existencia").val(0);
                        $("#PrecioActual").val(0);
                        $("#PrecioVentaMinimo").val(0);
                        $("#DescuentoActual").val(0);
                        $("#Producto").val("");
                        $("#Barra").val("");
                        $("#divOcultarIDs").hide();
                        $("#Barra").focus();

                    }
                    else
                    {
                        toastr.error('Se le informa que no contiene el nivel de autorizacion para aplicar el descuento, verificar sus datos');
                    }
                }
            });

        });

    });

    </script>
}

