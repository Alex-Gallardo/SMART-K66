@model PagedList.IPagedList<DiamDev.Give.Entities.Factura>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Factura Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Factura")">
        Nueva
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<form action="" method="get" class="form-inline">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Inicial<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaInicial" name="FechaInicial" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Final<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaFinal" name="FechaFinal" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="this.form.submit();" required>
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
    </div>
</form>
<br />
<form action="" method="get">
    <div class="row">
      
        <div class="col-md-8">
            <div class="form-group">
                <label class="control-label">
                    Busqueda Factura
                </label>
                <input type="number" placeholder="No. de la Factura" class="form-control" id="factura" name="factura" value="@Html.Raw(ViewBag.factura)" autocomplete="off" />
            </div>
        </div>
        <button class="btn btn-primary" style="margin-bottom: -58px;" type="submit">
            <i class="clip-search-3"></i> Buscar
        </button>       
    </div>
</form>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Factura
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover" id="sample-table-1">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Cliente</th>
                            <th>Productos</th>
                            <th>Total</th>
                            <th>F. Electrónica</th>
                            <th>Certificada</th>
                            <th>Respuesta Cert</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Factura in Model)
                        {
                            <tr>                               
                                <td>@(Factura.SerieId == 20200520001 ? string.Format("{0} - {1}", Factura.SerieFEL, Factura.NumeroFEL) : string.Format("{0} - {1}", Factura.Serie.Nombre, Factura.NoFactura))</td>
                                <td>@Factura.Fecha.ToString("dd/MM/yyyy")</td>                               
                                <td>@(Factura.FechaHoraFactura == null ? "00:00" : Factura.FechaHoraFactura.Value.ToString("hh:mm tt"))</td>                            
                                <td>@(Factura.Cliente == null ? "No Disponible" : Factura.Cliente.Nombre)</td>                            
                                <td>@(Factura.Detalles == null ? 0 : (Factura.Anulada ? 0 : Factura.Detalles.Count()))</td>
                                <td>@(Factura.Detalles == null ? "Q0.00" : (Factura.Anulada ? "Q0.00" : Factura.Detalles.Sum(x => x.Cantidad * x.Precio).ToString("C")))</td>
                                <td>@(Factura.FacturaElectronica ? "Sí" : "No")</td>                               
                                <td>@(Factura.Infile ? "Sí" : "No")</td>
                                 <td>
                                    @(Factura.Anulada ? Factura.DescripcionAnularFEL : Factura.DescripcionFEL)
                                </td>
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                        @if (Factura.FacturaElectronica && Factura.Infile)
                                        {
                                            <a href="@Url.Action("Detalle", "Factura", new { id = Factura.FacturaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle de la Factura"><i class="clip-stack-empty"></i></a>
                                            if (!Factura.Anulada && !Factura.NotaCredito)
                                            {
                                                <a href="@Url.Action("Anular", "Factura", new { id = Factura.FacturaId })" class="btn btn-bricky tooltips" data-placement="top" data-original-title="Anular Factura"><i class="clip-close"></i></a>
                                                <a href="@Url.Action("Nota_Credito", "Factura", new { id = Factura.FacturaId })" class="btn btn-bricky tooltips" data-placement="top" data-original-title="Nota de Credito"><i class="clip-checkmark"></i></a>

                                            }
                                            if (!Factura.Anulada && !Factura.NotaCredito)
                                            {
                                                <a href="https://documento.facturaelectronica.gt/FelGuatemala/Factura?factid=@Factura.FacturaId" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="IMPRESION FEEL"><i class="clip-file-pdf"></i></a>
                                            }
                                            else if (!Factura.Anulada && Factura.NotaCredito)
                                            {
                                                <a href="@Url.Action("Boleta_Nota_Credito", "Factura", new { id = Factura.FacturaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Nota de Credito"><i class="clip-file-pdf"></i></a>
                                            }
                                            <a href="javascript:void(0);" onclick="enviarCorreo(@Factura.FacturaId)" class="btn btn-teal tooltips" data-placement="top" data-original-title="ENVIAR FEL"><i class="clip-paperplane"></i></a>
                                        }
                                        else if (!Factura.FacturaElectronica && !Factura.Infile)
                                        {
                                            if (!Factura.Anulada)
                                            {
                                                <a href="@Url.Action("Anular", "Factura", new { id = Factura.FacturaId })" class="btn btn-bricky tooltips" data-placement="top" data-original-title="Anular Factura"><i class="clip-close"></i></a>
                                            }
                                            <a href="@Url.Action("Detalle", "Factura", new { id = Factura.FacturaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle de la Factura"><i class="clip-stack-empty"></i></a>
                                            if (!Factura.Anulada)
                                            {
                                                <a href="@Url.Action("Boleta", "Factura", new { id = Factura.FacturaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Factura"><i class="clip-file-pdf"></i></a>
                                            }
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Certificar", "Factura", new { id = Factura.FacturaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Certificar Factura"><i class="clip-checkmark-2"></i></a>
                                        }
                                    </div>
                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                        <div class="btn-group">
                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                <i class="icon-cog"></i> <span class="caret"></span>
                                            </a>
                                            <ul role="menu" class="dropdown-menu pull-right">
                                                @if (Factura.FacturaElectronica && Factura.Infile)
                                                {
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Factura", new { id = Factura.FacturaId })">
                                                            <i class="clip-stack-empty"></i> Detalle de la Factura
                                                        </a>
                                                    </li>
                                                    if (!Factura.Anulada && !Factura.NotaCredito)
                                                    {
                                                        <li role="presentation">
                                                            <a role="menuitem" tabindex="-1" href="@Url.Action("Anular", "Factura", new { id = Factura.FacturaId })">
                                                                <i class="clip-close"></i> Anular Factura
                                                            </a>
                                                        </li>
                                                        <li role="presentation">
                                                            <a role="menuitem" tabindex="-1" href="@Url.Action("Nota_Credito", "Factura", new { id = Factura.FacturaId })">
                                                                <i class="clip-checkmark"></i> Nota de Credito
                                                            </a>
                                                        </li>
														
                                                    }
                                                    if (!Factura.Anulada && !Factura.NotaCredito)
                                                    {
                                                        <li role="presentation">
                                                            <a role="menuitem" tabindex="-1" href="@Url.Action("Boleta", "Factura", new { id = Factura.FacturaId })" target="_blank">
                                                                <i class="clip-file-pdf"></i> Ver Factura
                                                            </a>
                                                        </li>
                                                    }
                                                    else if (!Factura.Anulada && Factura.NotaCredito)
                                                    {
                                                        <li role="presentation">
                                                            <a role="menuitem" tabindex="-1" href="@Url.Action("Boleta_Nota_Credito", "Factura", new { id = Factura.FacturaId })" target="_blank">
                                                                <i class="clip-file-pdf"></i> Ver Nota de Credito
                                                            </a>
                                                        </li>
                                                    }
                                                }
                                                else if (!Factura.FacturaElectronica && !Factura.Infile)
                                                {
                                                    if (!Factura.Anulada)
                                                    {
                                                        <li role="presentation">
                                                            <a role="menuitem" tabindex="-1" href="@Url.Action("Anular", "Factura", new { id = Factura.FacturaId })">
                                                                <i class="clip-close"></i> Anular Factura
                                                            </a>
                                                        </li>
														
                                                    }
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Factura", new { id = Factura.FacturaId })">
                                                            <i class="clip-stack-empty"></i> Detalle de la Factura
                                                        </a>
                                                    </li>
                                                    if (!Factura.Anulada)
                                                    {
                                                        <li role="presentation">
                                                            <a role="menuitem" tabindex="-1" href="@Url.Action("Boleta", "Factura", new { id = Factura.FacturaId })" target="_blank">
                                                                <i class="clip-file-pdf"></i> Ver Factura
                                                            </a>
                                                        </li>
                                                    }
                                                }
                                                else
                                                {
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Certificar", "Factura", new { id = Factura.FacturaId })">
                                                            <i class="clip-checkmark-2"></i> Certificar Factura
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { serie = ViewBag.serie, factura = ViewBag.factura, page }))

@section Scripts
{
    <script type="text/javascript">
        var facturaSuccess = '@TempData["Factura-Success"]';
        var facturaAnularSuccess = '@TempData["Factura_Anular-Success"]';


        function boleta() {
            var self = this;

            $.post("http://localhost:10000/api/license", function (guid) {
                console.log("license: " + guid);
                console.log(self);
            }, "json")

            return false;
        }

        $(function ()
        {
            if (facturaSuccess == "OK")
            {
                toastr.success('La factura se guardó exitosamente');
            }
            else if (facturaAnularSuccess == "OK")
            {
                toastr.success('La factura fue anulada exitosamente');
            }
            else if ('@TempData["Factura_Nota_Credito-Success"]' == "OK")
            {
                toastr.success('La nota de credito se genero exitosamente');
            }

            $.post("http://localhost:10000/api/license", function (guid) {
                $('[data-license-required]').show();
            }, "json")
        });

        function enviarCorreo(id)
        {
            $.ajax({
                url: '@Url.Action("EnviarCorreo", "Factura")',
                data: { 'id': id },
                async: false,
                type: 'POST',
                success: function (data)
                {
                    if (data.Operacion)
                    {
                        toastr.success('La factura electronica fue enviada exitosamente');
                    }
                    else
                    {
                        toastr.error('La factura electronica no fue enviada');
                    }
                }
            });
        }

    </script>
}




