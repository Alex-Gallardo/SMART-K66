@model PagedList.IPagedList<DiamDev.Give.Entities.Garantia>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Garantia Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Garantia")">
        Nueva
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <form action="" method="get" class="form-inline">
            <div class="input-group well">
                <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                <span class="input-group-btn">
                    <button class="btn btn-primary" type="button">
                        <i class="clip-search-3"></i> Buscar
                    </button>
                </span>
            </div>
        </form>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Garantia
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Factura o Recibo</th>                           
                            <th>Cliente</th>                           
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Garantia in Model)
                        {
                            <tr>
                                <td>@(Garantia.Documento == null ? "No Disponible" : Garantia.Documento.Nombre)</td> 
                                <td>@Garantia.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@(Garantia.DocumentoId == 1 ? string.Format("{0} - {1}", Garantia.Factura.Serie.Nombre, Garantia.Factura.NoFactura) : Garantia.ReciboId.Value.ToString())</td>                               
                                <td>@(Garantia.DocumentoId == 1 ? Garantia.Factura.Cliente == null ? "No Disponible" : Garantia.Factura.Cliente.Nombre : Garantia.Recibo.Cliente == null ? "No Disponible" : Garantia.Recibo.Cliente.Nombre)</td> 
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">                                                                              
                                        <a href="@Url.Action("Detalle", "Garantia", new { id = Garantia.GarantiaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle de Garantia"><i class="clip-stack-empty"></i></a>  
                                        @if (Garantia.FechaEntrega == null)
                                        {
                                            <a href="@Url.Action("Entrega", "Garantia", new { id = Garantia.GarantiaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Entrega de Garantia"><i class="clip-checkmark"></i></a>
                                            <a href="@Url.Action("Boleta", "Garantia", new { id = Garantia.GarantiaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Garantia"><i class="clip-file-pdf"></i></a>
                                        }                                    
                                    </div>
                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                        <div class="btn-group">
                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                <i class="icon-cog"></i> <span class="caret"></span>
                                            </a>
                                            <ul role="menu" class="dropdown-menu pull-right">                                                                                        
                                                <li role="presentation">
                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Garantia", new { id = Garantia.GarantiaId })">
                                                        <i class="clip-stack-empty"></i> Detalle de Garantia
                                                    </a>
                                                </li>  
                                                @if (Garantia.FechaEntrega == null)
                                                {
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Entrega", "Garantia", new { id = Garantia.GarantiaId })">
                                                            <i class="clip-checkmark"></i> Entrega de Garantia
                                                        </a>
                                                    </li>
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Boleta", "Garantia", new { id = Garantia.GarantiaId })" target="_blank">
                                                            <i class="clip-file-pdf"></i> Ver Garantia
                                                        </a>
                                                    </li>
                                                }                                            
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { search = ViewBag.Search, page }))

@section Scripts
{
    <script type="text/javascript">
    $(document).ready(function () {
        if ('@TempData["Garantia-Success"]' == "OK")
            {
                toastr.success('La garantia se guardó exitosamente');
            }
        });
    </script>
}


