@using System.Linq
@using DiamDev.Give.Entities
@model DiamDev.Give.Entities.GaritaRuta
@{
    Layout = "~/Views/Shared/_GaritaLayout.cshtml";
    ViewBag.Title = "Buscar por placa";
    var encontrada = !string.IsNullOrEmpty(Model.Id);
    var puedeRegistrar = Model.PuedeRegistrarSalida;
    var abierta = Model.Estado == "A";
    var enRuta = Model.Estado == "E";
    var cerrada = Model.Estado == "C";
    var urlInicio = Url.Content("~/Garita/Index");
    var seccion = string.IsNullOrEmpty(Model.Seccion) ? (cerrada ? "regresos" : abierta ? "salidas" : "en-ruta") : Model.Seccion;
    var urlPlaca = Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,seccion=seccion,pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas});
    var totalDocumentos = Model.Documentos == null ? 0 : Model.Documentos.Count;
}
<section class="search-card @(encontrada?"search-card-detail":"")" aria-label="Buscar ruta por placa">
    @if (encontrada)
    {
        <div class="search-detail-row"><a class="search-back-link" href="@urlPlaca" aria-label="Volver a rutas de la placa @Model.PlacaBusqueda">← Rutas</a><strong>Ruta @Model.Id</strong></div>
        <a class="search-other-link" href="@urlInicio">Buscar otra placa</a>
    }
    else
    {
        <span class="step">BUSCAR · CONTROL DE VEHÍCULOS</span>
        <h1 class="visually-hidden">Control de vehículos</h1>
        using (Html.BeginForm("Index", "Garita", FormMethod.Get, new { @class = "search-form", id = "plate-search-form" }))
        {
            <button id="qr-open" class="qr-open-button" type="button"><svg class="ui-icon" aria-hidden="true"><use href="#garita-qr"></use></svg> Escanear QR</button>
            <label for="placa">Placa del vehículo</label>
            <div class="search-row"><input id="placa" name="placa" value="@Model.PlacaBusqueda" maxlength="15" autocomplete="off" autocapitalize="characters" placeholder="Ej. C-123ABC" required /><button type="submit">Buscar</button></div>
        }
    }
</section>
@if (!encontrada)
{
    <div id="qr-dialog" class="qr-dialog" role="dialog" aria-modal="true" aria-labelledby="qr-title" hidden>
        <div class="qr-backdrop"></div><div class="qr-dialog-panel">
            <div class="qr-dialog-head"><h2 id="qr-title">Escanear placa</h2><button id="qr-close" type="button" aria-label="Cerrar lector QR">✕</button></div>
            <p>El QR debe contener solamente la placa del vehículo.</p><video id="qr-video" playsinline muted></video>
            <p id="qr-status" role="status">Listo para abrir la cámara.</p>
            <label class="qr-file-label" for="qr-file">Tomar foto del QR</label><input id="qr-file" type="file" accept="image/*" capture="environment" />
            <label class="qr-file-label qr-gallery-label" for="qr-gallery">Elegir foto guardada</label><input id="qr-gallery" type="file" accept="image/*" />
            <button id="qr-cancel" type="button">Volver a escribir la placa</button>
        </div>
    </div>
}
@if (TempData["Garita.Mensaje"] != null)
{<div class="notice success" role="status">✓ @TempData["Garita.Mensaje"]</div>}
@if (Model.BusquedaRealizada && !encontrada)
{
    <nav class="route-tabs" aria-label="Estado de rutas de esta placa">
        <a class="@(seccion=="salidas"?"active":"")" aria-current="@(seccion=="salidas"?"page":null)" href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,seccion="salidas",pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas})">Por salir <b>@Model.TotalAbiertas</b></a>
        <a class="@(seccion=="en-ruta"?"active":"")" aria-current="@(seccion=="en-ruta"?"page":null)" href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,seccion="en-ruta",pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas})">En ruta <b>@Model.TotalRutas</b></a>
        <a class="@(seccion=="regresos"?"active":"")" aria-current="@(seccion=="regresos"?"page":null)" href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,seccion="regresos",pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas})">Regresos <b>@Model.TotalCerradas</b></a>
    </nav>
    <section class="results-card open-results" aria-label="Rutas abiertas de la placa" hidden="@(seccion=="salidas"?null:"hidden")">
        <div class="section-head"><div><span class="step">POR SALIR</span><h2>Abiertas · @Model.PlacaBusqueda</h2></div><strong>@Model.TotalAbiertas @(Model.TotalAbiertas==1?"ruta":"rutas") pendientes</strong></div>
        @if (Model.TotalAbiertas == 0)
        {<div class="notice info" role="status">No hay rutas Abiertas para esta placa.</div>}
        else
        {
            <p>Revisa la ruta y el cargamento antes de registrar la salida. Esto pondrá la ruta En ruta.</p>
            <div class="route-list">
                @foreach (var ruta in Model.ResultadosAbiertas)
                {
                    <a class="route-option route-option-active" href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,id=ruta.Id,seccion="salidas",pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas})" aria-label="Revisar ruta abierta @ruta.Id, piloto @(ruta.ConductorReal??ruta.Piloto)">
                        <span class="route-option-main"><strong>Ruta @ruta.Id</strong><small>@ruta.Fecha.ToString("dd/MM/yyyy") · @ruta.Centro · @ruta.Placa</small></span>
                        <span class="route-option-pilot"><svg class="ui-icon" aria-hidden="true"><use href="#garita-person"></use></svg> @(ruta.ConductorReal??ruta.Piloto??"Piloto sin dato")</span>
                        <span class="route-option-counts"><span><b>@ruta.Bultos.ToString("0.###")</b> @(ruta.Bultos==1?"bulto":"bultos")</span><span><b>@ruta.Documentos</b> @(ruta.Documentos==1?"documento":"documentos")</span><span><b>@ruta.Clientes</b> @(ruta.Clientes==1?"cliente":"clientes")</span></span>
                        <span class="state @(ruta.DiferenciaPendiente?"state-stop":"state-open")">@(ruta.DiferenciaPendiente?"Diferencia pendiente":"Abierta · pendiente de salida")</span>
                        <span class="route-option-arrow" aria-hidden="true">Revisar salida →</span>
                    </a>
                }
            </div>
            if (Model.TotalAbiertas > 50)
            {<nav class="pager" aria-label="Páginas de rutas abiertas">@if (Model.PaginaAbiertas > 1)
                {<a href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,paginaAbiertas=Model.PaginaAbiertas-1,pagina=Model.Pagina,paginaCerradas=Model.PaginaCerradas,seccion="salidas"})">← Anterior</a>}<span>Página @Model.PaginaAbiertas de @((Model.TotalAbiertas+49)/50)</span>@if (Model.PaginaAbiertas * 50 < Model.TotalAbiertas)
                {<a href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,paginaAbiertas=Model.PaginaAbiertas+1,pagina=Model.Pagina,paginaCerradas=Model.PaginaCerradas,seccion="salidas"})">Siguiente →</a>}</nav>}
        }
    </section>
    <section class="results-card" aria-label="Rutas en ruta de la placa" hidden="@(seccion=="en-ruta"?null:"hidden")">
        <div class="section-head"><div><span class="step">EN RUTA</span><h2>En ruta · @Model.PlacaBusqueda</h2></div><strong>@Model.TotalRutas @(Model.TotalRutas==1?"ruta":"rutas") En ruta</strong></div>
        @if (Model.TotalRutas == 0)
        {<div class="notice info" role="status">No hay rutas para esta placa.</div>}
        else
        {
            <p>Compara el número, la fecha y el piloto antes de abrir una ruta.</p>
            <div class="route-list">
                @foreach (var ruta in Model.Resultados)
                {
                    <a class="route-option route-option-transit" href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,id=ruta.Id,seccion="en-ruta",pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas})" aria-label="Revisar ruta @ruta.Id, piloto @(ruta.ConductorReal??ruta.Piloto)">
                        <span class="route-option-main"><strong>Ruta @ruta.Id</strong><small>@ruta.Fecha.ToString("dd/MM/yyyy") · @ruta.Centro · @ruta.Placa</small></span>
                        <span class="route-option-pilot"><svg class="ui-icon" aria-hidden="true"><use href="#garita-person"></use></svg> @(ruta.ConductorReal??ruta.Piloto??"Piloto sin dato")</span>
                        <span class="route-option-counts"><span><b>@ruta.Bultos.ToString("0.###")</b> @(ruta.Bultos==1?"bulto":"bultos")</span><span><b>@ruta.Documentos</b> @(ruta.Documentos==1?"documento":"documentos")</span><span><b>@ruta.Clientes</b> @(ruta.Clientes==1?"cliente":"clientes")</span></span>
                        <span class="state @(ruta.DiferenciaPendiente?"state-stop":ruta.SalidaRegistrada?"state-done":"state-info")">@(ruta.DiferenciaPendiente?"Diferencia pendiente":ruta.SalidaRegistrada?"Salida registrada":"Sin salida registrada")</span>
                        <span class="route-option-arrow" aria-hidden="true">Ver ruta →</span>
                    </a>
                }
            </div>
            if (Model.TotalRutas > 50)
            {<nav class="pager" aria-label="Páginas de rutas En ruta">@if (Model.Pagina > 1)
                {<a href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,pagina=Model.Pagina-1,paginaCerradas=Model.PaginaCerradas,paginaAbiertas=Model.PaginaAbiertas,seccion="en-ruta"})">← Anterior</a>}<span>Página @Model.Pagina de @((Model.TotalRutas+49)/50)</span>@if (Model.Pagina * 50 < Model.TotalRutas)
                {<a href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,pagina=Model.Pagina+1,paginaCerradas=Model.PaginaCerradas,paginaAbiertas=Model.PaginaAbiertas,seccion="en-ruta"})">Siguiente →</a>}</nav>}
        }
    </section>
    <section class="results-card closed-results" aria-label="Rutas cerradas sin hora de entrada" hidden="@(seccion=="regresos"?null:"hidden")">
        <div class="section-head">
            <div>
                <span class="step">REGRESOS</span><h2>Cerradas sin entrada</h2>
                <!--<p>Rutas de hoy y los 30 días anteriores.</p>-->
            </div><strong>@Model.TotalCerradas @(Model.TotalCerradas==1?"ruta":"rutas") pendientes</strong>
        </div>
        @if (Model.TotalCerradas == 0)
        {<div class="notice info" role="status">No hay rutas cerradas sin hora de entrada.</div>}
        else
        {
            <p>Selecciona la ruta que regresó y verifica la placa y el cargamento antes de registrar la hora.</p>
            <div class="route-list">
                @foreach (var ruta in Model.ResultadosCerradas)
                {
                    <a class="route-option route-option-closed" href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,id=ruta.Id,seccion="regresos",pagina=Model.Pagina,paginaAbiertas=Model.PaginaAbiertas,paginaCerradas=Model.PaginaCerradas})" aria-label="Revisar ruta cerrada @ruta.Id, sin hora de entrada registrada">
                        <span class="route-option-main"><strong>Ruta @ruta.Id</strong><small>@ruta.Fecha.ToString("dd/MM/yyyy") · @ruta.Centro · @ruta.Placa</small></span>
                        <span class="route-option-pilot"><svg class="ui-icon" aria-hidden="true"><use href="#garita-person"></use></svg> @(ruta.ConductorReal??ruta.Piloto??"Piloto sin dato")</span>
                        <span class="route-option-counts"><span><b>@ruta.Bultos.ToString("0.###")</b> @(ruta.Bultos==1?"bulto":"bultos")</span><span><b>@ruta.Documentos</b> @(ruta.Documentos==1?"documento":"documentos")</span><span><b>@ruta.Clientes</b> @(ruta.Clientes==1?"cliente":"clientes")</span></span>
                        <span class="closed-badges"><span class="state state-closed">Cerrada</span><span class="state state-entry-pending">Sin hora de entrada registrada</span>@if (!ruta.SalidaRegistrada)
                        {<small>Sin hora de salida registrada</small>}</span>
                        <span class="route-option-arrow" aria-hidden="true">Revisar regreso →</span>
                    </a>
                }
            </div>
            if (Model.TotalCerradas > 50)
            {<nav class="pager" aria-label="Páginas de rutas cerradas">@if (Model.PaginaCerradas > 1)
                {<a href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,pagina=Model.Pagina,paginaCerradas=Model.PaginaCerradas-1,paginaAbiertas=Model.PaginaAbiertas,seccion="regresos"})">← Anterior</a>}<span>Página @Model.PaginaCerradas de @((Model.TotalCerradas+49)/50)</span>@if (Model.PaginaCerradas * 50 < Model.TotalCerradas)
                {<a href="@Url.Action("Index","Garita",new{placa=Model.PlacaBusqueda,pagina=Model.Pagina,paginaCerradas=Model.PaginaCerradas+1,paginaAbiertas=Model.PaginaAbiertas,seccion="regresos"})">Siguiente →</a>}</nav>}
        }
    </section>
}
@if (encontrada)
{
    <section class="route-header">
        <div class="route-review-intro"><span class="step">@(cerrada?"REVISAR REGRESO":"REVISAR SALIDA")</span><h1>Ruta @Model.Id</h1><p>Comprueba el vehículo y la carga antes de continuar.</p></div>
        <span class="state @(cerrada?(Model.HoraEntradaApk.HasValue?"state-done":"state-entry-pending"):Model.HoraSalidaApk.HasValue||Model.SalidaUtc.HasValue?"state-done":Model.Diferencia!=null?"state-stop":puedeRegistrar?"state-open":"state-stop")">@(cerrada?(Model.HoraEntradaApk.HasValue?"Cerrada · entrada registrada":"Cerrada · sin hora de entrada"):Model.HoraSalidaApk.HasValue||Model.SalidaUtc.HasValue?"En ruta · salida registrada":Model.Diferencia!=null?"Diferencia reportada":puedeRegistrar?(abierta?"Abierta · pendiente de salida":"En ruta · pendiente de salida"):(abierta?"Abierta · revisar datos":"En ruta · revisar datos"))</span>
    </section>
    if (Model.HoraSalidaApk.HasValue || Model.SalidaUtc.HasValue){
        <div class="notice success" role="status">
        <strong>Hora de salida:</strong> @(Model.HoraSalidaApk.HasValue?DateTime.Today.Add(Model.HoraSalidaApk.Value).ToString("hh:mm tt",System.Globalization.CultureInfo.InvariantCulture):"Sin hora") <br/>
        @if (Model.SalidaUtc.HasValue){
            <strong>Fecha:</strong> @Model.SalidaLocal.Value.ToString("dd/MM/yyyy") <br/>
            <strong>Autorización:</strong> @Model.Agente
        } 
        @(string.IsNullOrEmpty(Model.Precinto)?"":" · Precinto: "+Model.Precinto) 
        @if (Model.TieneFotoSalida){
            <a href="@Url.Action("FotoSalida","Garita",new{placa=Model.PlacaBusqueda,id=Model.Id})" target="_blank" rel="noopener">Ver foto de salida</a>}</div>
            }
    else if (cerrada)
    {<div class="notice info" role="status">Esta ruta no tiene hora de salida registrada. Verifica cuidadosamente la placa y el número de ruta antes de marcar el regreso.</div>}
    if (cerrada && Model.HoraEntradaApk.HasValue)
    {<div class="notice success" role="status"><strong>Hora de entrada:</strong> @Model.HoraEntradaApk.Value.ToString("c") @if (Model.EntradaUtc.HasValue)
    {<span>· Fecha: @Model.EntradaUtc.Value.AddHours(-6).ToString("dd/MM/yyyy HH:mm:ss") · Agente: @Model.AgenteEntrada</span>} @if (!string.IsNullOrWhiteSpace(Model.ObservacionEntrada))
    {<span>· Observación: @Model.ObservacionEntrada</span>} @if (Model.TieneFotoEntrada)
    {<a href="@Url.Action("FotoEntrada","Garita",new{placa=Model.PlacaBusqueda,id=Model.Id})" target="_blank" rel="noopener">Ver foto de entrada</a>}</div>}
else if (cerrada && Model.EntradaUtc.HasValue)
{<div class="notice info" role="status"><strong>Entrada pendiente.</strong> Ya tiene una fecha registrada por @Model.AgenteEntrada. Se usará esa misma hora para completar. @if (!string.IsNullOrWhiteSpace(Model.ObservacionEntrada))
{<span>· Observación: @Model.ObservacionEntrada</span>} @if (Model.TieneFotoEntrada)
{<a href="@Url.Action("FotoEntrada","Garita",new{placa=Model.PlacaBusqueda,id=Model.Id})" target="_blank" rel="noopener">Ver foto de entrada</a>}</div>}
else if ((abierta || enRuta) && Model.Diferencia != null)
{<div class="notice stop" role="alert"><strong>Detén la salida.</strong> Se reportó esta diferencia: @Model.Diferencia. Distribución debe resolverla antes de registrar la salida.</div>}
else if ((abierta || enRuta) && !puedeRegistrar && !Model.HoraSalidaApk.HasValue && !Model.SalidaUtc.HasValue)
{<div class="notice stop" role="alert"><strong>No registres la salida todavía.</strong> Revisa piloto, vehículo, facturas, bultos y liquidación. Si algo no coincide, reporta la diferencia y contacta a Distribución.</div>}
else if ((abierta || enRuta) && !Model.HoraSalidaApk.HasValue && !Model.SalidaUtc.HasValue)
{<!--<div class="notice info" role="status"><strong>Lista para verificar.</strong> Compara los datos con el vehículo y el cargamento. Garita registrará la hora de salida@@(abierta?" y pondrá la ruta En ruta":"").</div>-->}
<section class="facts" aria-label="Datos del vehículo y la ruta">
    <h2>Datos del vehículo</h2>
    <div class="vehicle-identity"><span class="plate-number"><svg class="ui-icon" aria-hidden="true"><use href="#garita-truck"></use></svg> @Model.Placa</span>@if (!string.IsNullOrWhiteSpace(Model.Vehiculo)){<span class="vehicle-type">@Model.Vehiculo</span>}</div>
    <div class="vehicle-driver"><svg class="ui-icon" aria-hidden="true"><use href="#garita-person"></use></svg><div><span>Piloto</span><strong>@(Model.EsRutaEmpresa?(Model.ConductorReal??Model.Piloto):Model.Piloto)</strong>@if (Model.EsRutaEmpresa && !string.IsNullOrWhiteSpace(Model.DocumentoConductor)){<small>Documento/licencia: @Model.DocumentoConductor</small>}@if(!string.IsNullOrWhiteSpace(Model.Transporte)){<small>@Model.Transporte</small>}</div></div>
    <div class="vehicle-meta"><span>Centro: <strong>@Model.Centro</strong></span><span>Fecha: <strong>@Model.Fecha.ToString("dd/MM/yyyy")</strong></span></div>
</section>
<section class="cargo-card">
    <div class="section-head"><div><span class="step">CARGAMENTO</span><h2>Carga a verificar</h2></div><div class="totals"><span><strong>@Model.Bultos.ToString("0.###")</strong> @(Model.Bultos==1?"bulto":"bultos")</span><span><strong>@totalDocumentos</strong> @(totalDocumentos==1?"documento":"documentos")</span><span><strong>@Model.Clientes</strong> @(Model.Clientes==1?"cliente":"clientes")</span></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Observacion))
    {<div class="notice info"><strong>Nota de Distribución:</strong> @Model.Observacion</div>}
    @if (totalDocumentos > 0)
    {
    <details class="cargo-expand"><summary><span><strong>@(string.IsNullOrWhiteSpace(Model.Documentos[0].Cliente)?"Cliente sin nombre":Model.Documentos[0].Cliente)</strong><small>@Model.Documentos[0].Direccion · @(string.IsNullOrWhiteSpace(Model.Documentos[0].Documento)?"Documento sin número":Model.Documentos[0].Documento)</small></span><b>Ver detalle ›</b></summary>
    @foreach (var grupo in Model.Documentos.GroupBy(d => new { d.Cliente, d.Direccion }))
    {
        <div class="customer customer-@GaritaReglas.EstadoCliente(grupo)">
            <div class="customer-heading"><span class="customer-icon" aria-hidden="true"><svg class="ui-icon"><use href="#garita-box"></use></svg></span><div><h3>@(string.IsNullOrWhiteSpace(grupo.Key.Cliente)?"Cliente sin nombre":grupo.Key.Cliente)</h3><p>@grupo.Key.Direccion</p></div><span class="customer-count">@grupo.Count() @(grupo.Count()==1?"documento":"documentos")</span></div>
            <ul class="documents">@foreach (var d in grupo)
            {
                var resultado=GaritaReglas.Resultado(d);
                var clase=resultado=="ENTREGADO"?"delivered":string.IsNullOrWhiteSpace(resultado)?"pending":"warning";
                var etiqueta=resultado=="ENTREGADO"?"ENTREGADA":resultado=="NO ENTREGADO"?"NO ENTREGADA":resultado=="INCIDENCIA"?"INCIDENCIA":string.IsNullOrWhiteSpace(resultado)?"PENDIENTE":resultado;
                var visito=d.ResultadoPiloto!=null?d.VisitoPiloto:d.Visito;
                var motivo=d.ResultadoPiloto!=null?d.MotivoPiloto:d.Motivo;
                var observacion=d.ResultadoPiloto!=null?d.ObservacionPiloto:d.Observaciones;
                <li><button type="button" class="cargo-document" aria-label="Ver factura @d.Documento: @etiqueta"
                    data-documento="@d.Documento" data-tipo="@d.Tipo" data-empresa="@d.Empresa" data-cliente="@d.Cliente" data-direccion="@d.Direccion"
                    data-resultado="@etiqueta" data-clase="@clase" data-fuente="@(d.ResultadoPiloto!=null?"POS · pendiente de cierre":string.IsNullOrWhiteSpace(resultado)?"Sin registrar":"APK66")"
                    data-visito="@(visito.HasValue?(visito.Value?"Sí":"No"):"Sin registrar")" data-motivo="@motivo" data-observacion="@observacion"
                    data-bultos="@d.Bultos.ToString("0.###")" data-fecha="@(d.FechaDocumento.HasValue?d.FechaDocumento.Value.ToString("dd/MM/yyyy"):"")"
                    data-fel="@((d.FelSerie??"")+(!string.IsNullOrWhiteSpace(d.FelNumero)?" · "+d.FelNumero:""))" data-monto="@(d.Monto.HasValue?d.Monto.Value.ToString("N2"):"")"
                    data-entrada="@(d.Entrada.HasValue?d.Entrada.Value.ToString(@"hh\:mm\:ss"):"")" data-salida="@(d.Salida.HasValue?d.Salida.Value.ToString(@"hh\:mm\:ss"):"")"
                    data-foto-doc="@(d.TieneImagen?Url.Action("FotoPiloto","Garita",new{placa=Model.PlacaBusqueda,id=Model.Id,rowId=d.RowId}):"")"
                    data-foto-cliente="@(d.TieneImagenCliente?Url.Action("FotoPiloto","Garita",new{placa=Model.PlacaBusqueda,id=Model.Id,rowId=d.PrimerRowIdCliente,cliente=true}):"")">
                    <span class="cargo-document-main"><strong>@(string.IsNullOrWhiteSpace(d.Documento)?"Documento sin número":d.Documento)</strong><small>@d.Tipo · @d.Empresa</small></span>
                    <span class="cargo-document-side"><span class="cargo-result cargo-result-@clase">@etiqueta</span><b>@d.Bultos.ToString("0.###") bultos</b><small>Ver detalle →</small></span>
                </button></li>
            }</ul>
        </div>
    }
    </details>
    }
</section>
<dialog id="cargo-document-dialog" class="cargo-dialog" aria-labelledby="cargo-dialog-title">
    <div class="cargo-dialog-head"><div><span class="step">FACTURA · DETALLE</span><h2 id="cargo-dialog-title">Factura</h2><p id="cargo-dialog-subtitle"></p></div><button type="button" id="cargo-dialog-close" class="cargo-dialog-close" aria-label="Cerrar detalle">×</button></div>
    <span id="cargo-dialog-result" class="cargo-result"></span><p id="cargo-dialog-source" class="cargo-dialog-source"></p>
    <dl class="cargo-dialog-facts"><div><dt>Cliente</dt><dd id="cargo-dialog-cliente"></dd></div><div><dt>Dirección</dt><dd id="cargo-dialog-direccion"></dd></div><div><dt>Bultos</dt><dd id="cargo-dialog-bultos"></dd></div><div><dt>Visitó</dt><dd id="cargo-dialog-visito"></dd></div><div><dt>Fecha del documento</dt><dd id="cargo-dialog-fecha"></dd></div><div><dt>Serie y número FEL</dt><dd id="cargo-dialog-fel"></dd></div><div><dt>Monto</dt><dd id="cargo-dialog-monto"></dd></div><div><dt>Entrada / salida del cliente</dt><dd id="cargo-dialog-horas"></dd></div></dl>
    <div class="cargo-dialog-note"><strong>Motivo</strong><p id="cargo-dialog-motivo"></p></div><div class="cargo-dialog-note"><strong>Observaciones</strong><p id="cargo-dialog-observacion"></p></div>
    <div id="cargo-dialog-photos" class="cargo-dialog-photos"><figure id="cargo-dialog-photo-doc" hidden><img alt="Fotografía de la factura agregada por el piloto" /><figcaption>Foto de la factura</figcaption></figure><figure id="cargo-dialog-photo-client" hidden><img alt="Fotografía del cliente agregada por el piloto" /><figcaption>Foto del cliente</figcaption></figure></div>
    <p id="cargo-dialog-no-photo" class="cargo-dialog-empty">Sin fotografías adjuntas.</p>
</dialog>
if (cerrada && Model.PuedeRegistrarEntrada)
{
    <section class="action-card entry-action">
        <span class="step">REGISTRAR REGRESO</span><h2>¿Es este el vehículo?</h2><p>Verifica placa, ruta y cargamento. El botón guardará @(Model.EntradaUtc.HasValue?"la hora del registro existente":"la hora actual").</p>
        @using (Html.BeginForm("RegistrarEntrada", "Garita", FormMethod.Post, new { id = "register-entry-form", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="RutaId" value="@Model.Id" /><input type="hidden" name="PlacaBusqueda" value="@Model.PlacaBusqueda" /><input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="Solicitud" value="@Guid.NewGuid()" />
            <input type="hidden" name="Seccion" value="@seccion" /><input type="hidden" name="Pagina" value="@Model.Pagina" /><input type="hidden" name="PaginaAbiertas" value="@Model.PaginaAbiertas" /><input type="hidden" name="PaginaCerradas" value="@Model.PaginaCerradas" />
            if (string.IsNullOrWhiteSpace(Model.ObservacionEntrada))
            {<div class="optional"><label for="observacion-entrada">Observación del regreso <small>(opcional)</small></label><textarea id="observacion-entrada" name="Observacion" maxlength="250" rows="2" placeholder="Ej. El vehículo regresó con carga pendiente"></textarea></div>}
            if (!Model.TieneFotoEntrada)
            {<div class="photo-field"><span>Foto de entrada <small>(opcional · JPG, PNG o WebP hasta 10 MB)</small></span><div class="photo-buttons"><button type="button" data-photo-camera="foto-entrada"><svg class="ui-icon" aria-hidden="true"><use href="#garita-camera"></use></svg> Tomar foto</button><button type="button" data-photo-gallery="foto-entrada">Elegir archivo</button></div><input id="foto-entrada" name="foto" type="file" accept="image/jpeg,image/png,image/webp" class="visually-hidden" /><img id="foto-entrada-preview" alt="Vista previa de la foto de entrada" hidden /><button id="foto-entrada-clear" type="button" hidden>Quitar foto</button></div>}
            <button class="confirm-button" type="submit">✓ Registrar entrada</button>
        }
    </section>
}
if (Model.PuedeReportarDiferencia)
{
    <section class="action-card exit-action">
        <span class="step">CONFIRMAR SALIDA</span><h2>¿Todo coincide?</h2><p>@(puedeRegistrar?"Marca ambas verificaciones después de comparar el vehículo y las facturas.":"Hay datos que impiden registrar la salida. Reporta la diferencia a Distribución.") @if(abierta && puedeRegistrar){<span>Al autorizar, la ruta pasará de Abierta a En ruta.</span>}</p>
        @if (puedeRegistrar)
        {
            using (Html.BeginForm("RegistrarSalida", "Garita", FormMethod.Post, new { id = "register-exit-form", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="RutaId" value="@Model.Id" /><input type="hidden" name="PlacaBusqueda" value="@Model.PlacaBusqueda" /><input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="Solicitud" value="@Guid.NewGuid()" />
                <input type="hidden" name="Seccion" value="@seccion" /><input type="hidden" name="Pagina" value="@Model.Pagina" /><input type="hidden" name="PaginaAbiertas" value="@Model.PaginaAbiertas" /><input type="hidden" name="PaginaCerradas" value="@Model.PaginaCerradas" />
                <label class="check"><input type="checkbox" name="IdentidadVerificada" value="true" required /><span>Placa y piloto verificados</span></label>
                <label class="check"><input type="checkbox" name="CargaVerificada" value="true" required /><span>Facturas y @Model.Bultos.ToString("0.###") bultos verificados</span></label>
                <div class="optional"><label for="observacion">Observación <small>(opcional)</small></label><textarea id="observacion" name="Observacion" maxlength="250" rows="2"></textarea></div>
                <div class="photo-field"><span>Foto de salida <small>(opcional · JPG, PNG o WebP hasta 10 MB)</small></span><div class="photo-buttons"><button type="button" data-photo-camera="foto"><svg class="ui-icon" aria-hidden="true"><use href="#garita-camera"></use></svg> Tomar foto</button><button type="button" data-photo-gallery="foto">Elegir archivo</button></div><input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp" class="visually-hidden" /><img id="foto-preview" alt="Vista previa de la foto elegida" hidden /><button id="foto-clear" type="button" hidden>Quitar foto</button></div>
                <button class="confirm-button" type="submit">✓ Autorizar salida</button>
            }
        }
        <button id="difference-open" class="stop-open" type="button">⚠ Detener salida</button>
    </section>
    <dialog id="difference-dialog" class="difference-dialog" aria-labelledby="difference-title">
        <div class="difference-head"><div><span class="step">DIFERENCIA</span><h2 id="difference-title">Detener salida</h2></div><button type="button" id="difference-close" aria-label="Cerrar" class="cargo-dialog-close">×</button></div>
        <p>Elige el motivo. La ruta quedará bloqueada hasta que Distribución lo resuelva.</p>
        @using (Html.BeginForm("Diferencia", "Garita", FormMethod.Post, new{id="difference-form"}))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="RutaId" value="@Model.Id" /><input type="hidden" name="PlacaBusqueda" value="@Model.PlacaBusqueda" /><input type="hidden" name="Version" value="@Model.Version" /><input type="hidden" name="Solicitud" value="@Guid.NewGuid()" />
            <input type="hidden" name="Seccion" value="@seccion" /><input type="hidden" name="Pagina" value="@Model.Pagina" /><input type="hidden" name="PaginaAbiertas" value="@Model.PaginaAbiertas" /><input type="hidden" name="PaginaCerradas" value="@Model.PaginaCerradas" />
            <fieldset class="reason-options"><legend>¿Qué no coincide?</legend>
                <label><input type="radio" name="MotivoRapido" value="BULTOS" required /><span>Bultos no coinciden</span></label>
                <label><input type="radio" name="MotivoRapido" value="PILOTO" /><span>Piloto distinto</span></label>
                <label><input type="radio" name="MotivoRapido" value="FACTURA" /><span>Falta una factura</span></label>
                <label><input type="radio" name="MotivoRapido" value="OTRO" /><span>Otro motivo</span></label>
            </fieldset>
            <label for="descripcion">Detalle adicional <small>(opcional, obligatorio si eliges Otro)</small></label>
            <textarea id="descripcion" name="Descripcion" maxlength="250" rows="2" placeholder="Describe lo que observaste"></textarea>
            <button type="submit" class="stop-button">Confirmar y detener salida</button>
            <button type="button" class="difference-cancel">Cancelar</button>
        }
    </dialog>
}
}
@section scripts {
    <script src="@Url.Content("~/Scripts/qr-scanner/qr-scanner.umd.min.js")"></script>
    <script src="@Url.Content("~/Scripts/garita-qr.js")"></script>
    <script src="@Url.Content("~/Scripts/garita-cargo.js")"></script>
}
