@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewBag.Title = "Gerencia Comercial · Analytics"; }
@section styles { <link href="@Url.Content("~/Content/gerencia-comercial-analytics.css?v=2")" rel="stylesheet" /> }
<div class="gca" id="k66-analytics" data-theme="all" data-panel="@Url.Action("AnalyticsPanel")" data-detail="@Url.Action("AnalyticsDetalle")" data-profile="@Url.Action("AnalyticsPerfil")" data-excel="@Url.Action("AnalyticsExcel")">
<div class="gca-app-shell">
    <div class="gca-navigation"><nav class="gca-section-nav" aria-label="Vistas comerciales"><button class="gca-nav-link active" type="button" data-view="dashboard" aria-current="page"><i class="icon-dashboard" aria-hidden="true"></i>Resumen</button><button class="gca-nav-link" type="button" data-view="general" aria-current="false"><i class="icon-bar-chart" aria-hidden="true"></i>Venta general</button><button class="gca-nav-link" type="button" data-view="agentes" aria-current="false"><i class="icon-group" aria-hidden="true"></i>Agentes</button><button class="gca-nav-link" type="button" data-view="perfil-agente" aria-current="false"><i class="icon-user" aria-hidden="true"></i>Perfil de agente</button><button class="gca-nav-link" type="button" data-view="clientes" aria-current="false"><i class="icon-user" aria-hidden="true"></i>Clientes</button><button class="gca-nav-link" type="button" data-view="productos" aria-current="false"><i class="icon-th-large" aria-hidden="true"></i>Productos</button><button class="gca-nav-link" type="button" data-view="producto-agente" aria-current="false"><i class="icon-exchange" aria-hidden="true"></i>Producto–agente</button></nav><a class="gca-operations-link" href="@Url.Action("Operaciones")"><i class="icon-folder-open" aria-hidden="true"></i> Consultas y reportes</a></div>
    <main class="gca-main-content">
      <header class="gca-topbar">
        <div class="gca-top-title">
          <div>
            <div class="gca-eyebrow">Análisis comercial</div>
            <h2 id="pageTitle">Resumen comercial</h2>
            <p id="pageSubtitle">Análisis de ventas por empresa, agentes, clientes y productos</p>
          </div>
        </div>
        <div class="gca-top-actions">
          <div class="gca-company-tabs" role="group" aria-label="Empresa"><button data-company="all"
              class="selected">Todas</button><button data-company="GRACO">GRACO</button><button
              data-company="FAES">FAES</button><button data-company="BOLIK">BOLIK</button></div><button id="exportBtn"
            class="gca-btn gca-btn-accent"><i class="icon-download-alt" aria-hidden="true"></i> Exportar Excel</button>
        </div>
      </header>
      <div id="printContext" class="gca-print-context"></div>
      <section class="gca-toolbar" aria-label="Filtros de la comparación">
        <div class="gca-filter-main">
          <label class="gca-field">Desde<input type="date" id="startDate" /></label>
          <label class="gca-field">Hasta<input type="date" id="endDate" /></label>
          <label class="gca-field">Moneda<select id="currency"><option>GTQ</option><option>USD</option></select></label>
          <button class="gca-btn gca-btn-primary" id="applyBtn" type="button"><i class="icon-filter" aria-hidden="true"></i> Aplicar filtros</button>
        </div>
        <div class="gca-filter-bottom"><span id="periodLabel" role="status" aria-live="polite">Preparando comparación…</span><div class="gca-filter-tools">
          <details class="gca-criteria"><summary>Criterios de consulta</summary><div><label class="gca-field">Cobertura<select id="coverage"><option value="false">Completa</option><option value="true">Exclusiones Analytics</option></select></label><p>Ventas netas de artículos sin impuesto, por moneda documental. La cobertura Analytics excluye CL0149, OTROS y EMPLEADOS.</p></div></details>
          <button id="printBtn" class="gca-btn gca-btn-outline" type="button"><i class="icon-print" aria-hidden="true"></i> PDF / Imprimir</button>
        </div></div>
      </section>
      <div id="message" class="gca-message" role="alert" aria-live="polite" hidden></div>
      <section id="dashboardView" class="gca-view active">
        <div class="gca-kpi-grid" id="kpis"></div>
        <div class="gca-dash-grid">
          <article class="gca-glass gca-panel gca-trend-panel">
            <div class="gca-panel-heading">
              <div>
                <h2>Tendencia de ventas</h2>
                <p>Comparación mensual · año actual vs. anterior</p>
              </div>
              <div class="gca-legend"><span><i class="gca-dot gca-accent-dot"></i> Actual</span><span><i
                    class="gca-dot gca-previous-dot"></i> Anterior</span></div>
            </div>
            <div id="trendChart" class="gca-chart-container"></div>
          </article>
          <article class="gca-glass gca-panel gca-companies-panel">
            <div class="gca-panel-heading">
              <div>
                <h2>Ventas por empresa</h2>
                <p>Desempeño en el período seleccionado</p>
              </div>
            </div>
            <div id="companyBars"></div>
          </article>
          <article class="gca-glass gca-panel gca-donut-panel">
            <div class="gca-panel-heading">
              <h2>Participación por empresa</h2>
            </div>
            <div id="companyDonut"></div>
          </article>
          <article class="gca-glass gca-panel gca-donut-panel">
            <div class="gca-panel-heading">
              <h2>Ventas por tipo</h2>
            </div>
            <div id="typeDonut"></div>
          </article>
          <article class="gca-glass gca-panel gca-agent-panel">
            <div class="gca-panel-heading">
              <h2>Top 5 agentes</h2><span class="gca-subtle">Ventas del período</span>
            </div>
            <div id="topAgents"></div>
          </article>
          <article class="gca-glass gca-panel gca-overview-panel">
            <div class="gca-panel-heading">
              <h2>Venta general por empresa y tipo</h2><button class="gca-text-button" data-goto="general">Ver detalle
                ↗</button>
            </div>
            <div class="gca-table-scroll">
              <table id="overviewTable"></table>
            </div>
          </article>
          <article class="gca-glass gca-panel gca-products-panel">
            <div class="gca-panel-heading">
              <h2>Top 5 productos</h2><button class="gca-text-button" data-goto="productos">Ver productos ↗</button>
            </div>
            <div id="topProducts"></div>
          </article>
        </div>
      </section>
      <section id="agentProfileView" class="gca-view">
        <div class="gca-glass gca-agent-profile-toolbar">
          <div>
            <div class="gca-eyebrow">PERFIL COMERCIAL</div>
            <h2>Selecciona el agente</h2>
            <p>Consulta sus ventas, clientes y productos del período.</p>
          </div>
          <label class="gca-agent-select-label">Agente con movimientos en los períodos
            <select id="profileAgent" aria-label="Agente para analizar">
              <option value="">Seleccionar agente</option>
            </select>
          </label>
          <button class="gca-btn gca-btn-accent" id="profileExport">⇩ Exportar perfil</button>
        </div>
        <div id="profileEmpty" class="gca-glass gca-empty-profile">Seleccioná un agente para mostrar sus resultados.</div>
        <div id="profileContent" hidden>
          <div class="gca-profile-heading gca-glass">
            <div class="gca-profile-avatar">AG</div>
            <div>
              <div class="gca-eyebrow">RESUMEN POR AGENTE</div>
              <h2 id="profileName">—</h2><span id="profilePeriod" class="gca-subtle"></span>
            </div>
          </div>
          <div id="profileKpis" class="gca-kpi-grid gca-profile-kpis"></div>
          <div class="gca-profile-grid">
            <article class="gca-glass gca-panel gca-profile-trend">
              <div class="gca-panel-heading">
                <div>
                  <h2>Tendencia mensual del agente</h2>
                  <p>Comparación de ventas por mes</p>
                </div>
                <div class="gca-legend"><span><i class="gca-dot gca-accent-dot"></i> Actual</span><span><i
                      class="gca-dot gca-previous-dot"></i> Anterior</span></div>
              </div>
              <div id="profileTrend" class="gca-chart-container"></div>
            </article>
            <article class="gca-glass gca-panel">
              <div class="gca-panel-heading">
                <div>
                  <h2>Ventas por empresa</h2>
                  <p>Contribución del agente</p>
                </div>
              </div>
              <div id="profileCompanies"></div>
            </article>
            <article class="gca-glass gca-panel">
              <div class="gca-panel-heading">
                <div>
                  <h2>Top 10 clientes</h2>
                  <p>Mayor facturación neta del período</p>
                </div>
              </div>
              <div id="profileCustomers"></div>
            </article>
            <article class="gca-glass gca-panel">
              <div class="gca-panel-heading">
                <div>
                  <h2>Top 10 productos</h2>
                  <p>Ventas y unidades por producto</p>
                </div>
              </div>
              <div id="profileProducts"></div>
            </article>
          </div>
          <article class="gca-glass gca-panel gca-profile-detail">
            <div class="gca-panel-heading">
              <div>
                <h2>Detalle de productos del agente</h2>
                <p>Podés ordenar haciendo clic en los encabezados</p>
              </div><span class="gca-subtle" id="profileRowCount"></span><button id="profileDetails" class="gca-text-button" type="button">Explorar todos los productos ↗</button>
            </div>
            <div class="gca-table-scroll">
              <table id="profileProductsTable"></table>
            </div>
          </article>
        </div>
      </section>
      <section id="detailView" class="gca-view">
        <div class="gca-glass gca-detail-wrap">
          <div class="gca-detail-toolbar">
            <div>
              <h2 id="detailTitle">Detalle de ventas</h2>
              <p id="detailDesc">Información comparativa del período seleccionado</p>
            </div>
            <div class="gca-detail-actions">
              <div class="gca-search-box"><i class="icon-search" aria-hidden="true"></i><input id="searchInput" placeholder="Buscar en esta vista..."
                  aria-label="Buscar" /></div><span class="gca-row-count" id="rowCount"></span>
            </div>
          </div>
          <details class="gca-detail-filters" id="detailFilters"><summary><i class="icon-filter" aria-hidden="true"></i> Filtros avanzados y orden</summary><div class="gca-advanced-filters" id="advancedFilters">
            <label>Agente<select id="filterAgent">
                <option value="">Todos los agentes</option>
              </select></label>
            <label>Cliente / razón social<input id="filterClient" placeholder="Nombre o código del cliente" /></label>
            <label>Código de producto<input id="filterCode" placeholder="Ej. PT00470" /></label>
            <label>Nombre de producto<input id="filterProduct" placeholder="Buscar descripción" /></label>
            <label>Ordenar por<select id="sortField"></select></label>
            <label>Dirección<select id="sortDirection">
                <option value="desc">Mayor a menor / Z–A</option>
                <option value="asc">Menor a mayor / A–Z</option>
              </select></label>
            <button class="gca-btn gca-btn-outline" id="clearFilters">Limpiar filtros</button>
          </div>
          </details><div id="filtersHint" class="gca-filters-hint"></div>
          <div class="gca-table-scroll gca-detail-table-wrap">
            <table id="detailTable"></table>
          </div>
          <div class="gca-table-footer"><span id="tableInfo"></span>
            <div class="gca-pagination"><button id="prevPage" class="gca-btn gca-btn-outline">← Anterior</button><span
                id="pageIndicator"></span><button id="nextPage" class="gca-btn gca-btn-outline">Siguiente →</button></div>
          </div>
        </div>
      </section>
      <footer class="gca-page-footer">Las cantidades se mantienen por unidad de venta. Local/Exportación se clasifica por prefijo CL del cliente. Cobertura Analytics excluye CL0149, OTROS y EMPLEADOS. Ventas netas calculadas desde SAP HANA · Uso interno autorizado.</footer>
    </main>
  </div>

</div>
@section scripts { <script src="@Url.Content("~/Scripts/App/gerencia-comercial-analytics.js?v=2")"></script> }
