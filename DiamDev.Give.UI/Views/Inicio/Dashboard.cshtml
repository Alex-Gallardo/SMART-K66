<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script type="text/javascript">
    $(document).ready(function ()
    {
        $.ajax({
            url: '@Url.Action("ObtenerCantidadReservadaPendienteCompra", "Consulta")',
            type: 'GET',
            success: function (resultData)
            {
                if (resultData !== null)
                {
                    if (resultData.Operacion == true)
                    {
                        $("#lblCantidadReservado").html(resultData.Data);
                    }
                }
            }
        });

        $.ajax({
            url: '@Url.Action("ObtenerProductoStockMaximo", "Consulta")',
            type: 'GET',
            success: function (resultData)
            {
                if (resultData !== null)
                {
                    if (resultData.Operacion == true)
                    {
                        $("#lblCantidadStock").html(resultData.Data);
                    }
                }
            }
        });

        $.ajax({
            url: '@Url.Action("ObtenerProductoStockMinimo", "Consulta")',
            type: 'GET',
            success: function (resultData) {
                if (resultData !== null) {
                    if (resultData.Operacion == true) {
                        $("#lblCantidadStockMinimo").html(resultData.Data);
                    }
                }
            }
        });
    });
</script>

