    <script type="text/html" id="producto_tr_template">
        <tr>
            <td>{{producto}}</td>
            <td>{{presentacion}}</td>
            <td>{{cantidad}}</td>
            <td>Q{{precio}}</td>            
            <td>Q{{sub_total}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="productoIds" value="{{producto_id}}" />
                <input type="hidden" name="nombreProductoIds" value="{{producto}}" />
                <input type="hidden" name="presentacionIds" value="{{presentacion_id}}" />
                <input type="hidden" name="nombrePresentacionIds" value="{{presentacion}}" />
                <input type="hidden" name="existenciaIds" value="{{existencia_id}}" />
                <input type="hidden" name="cantidadIds" value="{{cantidad_id}}" />
                <input type="hidden" name="precioIds" value="{{precio_id}}" />                
            </td>
        </tr>
    </script>
    <script type="text/javascript">

        var vCliente = "";
        var vCodBarra = "";

        var vAumentaCantidad = 0;

        var productoIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.productoIds))');
        var productoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombreProductoIds))');
        var presentacionIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.presentacionIds))');
        var presentacionSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombrePresentacionIds))');
        var existenciaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.existenciaIds))');
        var cantidadSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.cantidadIds))');        
        var precioSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioIds))');

        $(function ()
        {
            if ('@TempData["Pedido-Success"]' == "OK")
            {
                toastr.success('El pedido se genero exitosamente');
            }

            $("#formaprincipal").submit(function (e)
            {
                var form = $("#formaprincipal");
                form.validate();
                if (form.valid()) {
                    $("#loading").fadeIn();
                    var opts = {
                        lines: 12, // The number of lines to draw
                        length: 7, // The length of each line
                        width: 4, // The line thickness
                        radius: 10, // The radius of the inner circle
                        color: '#000', // #rgb or #rrggbb
                        speed: 1, // Rounds per second
                        trail: 60, // Afterglow percentage
                        shadow: false, // Whether to render a shadow
                        hwaccel: false // Whether to use hardware acceleration
                    };
                    var target = document.getElementById('loading');
                    var spinner = new Spinner(opts).spin(target);
                }
                else
                {
                    e.preventDefault();
                }
            });

            //Se oculta el boton de visualizar imagen
            $('#imagen').css("display", "none");

            //Se selecciona por default al cliente: Consumidor Final
            $("#ClienteId").val("20170115001").trigger("change");

            $("#_Nit").val("C/F").focus(function ()
            {
                $(this).select();
            }).keydown(function (e) {
                if ($(this).is(":focus") && (e.which || e.keyCode) == 13)
                {
                    e.preventDefault();
                    $('#Descripcion').focus();
                }
            }).change(function ()
            {
                var nit = $(this).val();
                var cliente = obtenerCliente(nit);
                if (!cliente && nit)
                {
                    $(this).val("");
                    $("#ClienteId").val("");
                    $("#_Nombre").val("");                    
                    return;
                }
                $("#ClienteId").val(cliente.ClienteId);
                $("#_Nombre").val(cliente.Nombre);
            }).focus();

            $("#_Nombre").val("Consumidor Final");

            function error(texto)
            {
                toastr.error(texto);
            }

            function cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, precio_id)
            {
                var plantilla = $('#producto_tr_template').html();

                var modelo =
                {
                    producto_id: producto_id,
                    producto: producto,
                    presentacion_id: presentacion_id,
                    presentacion: presentacion,
                    existencia_id: existencia_id,
                    cantidad_id: cantidad_id,
                    cantidad: cantidad_id,
                    precio_id: precio_id,
                    precio: precio_id,                    
                    sub_total: precio_id * cantidad_id
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#producto_tbody').append(filaHtml);
            }

            renderizarProductosIniciales();
       
            $('#btn-agregar').click(function (e)
            {
                e.preventDefault();

                var producto_id = $('#ProductoId').val();
                var producto = $('#Producto').val();

                if (producto_id === "" || producto === "")
                {
                    error("Seleccione un producto");
                    return;
                }

                var presentacion_id = $('#PresentacionId').val();
                var presentacion = $('#PresentacionId option:selected').text();

                if (presentacion_id === "" || presentacion === "")
                {
                    error("Seleccione una presentacion");
                    return;
                }

                var cantidad_id = $('#Cantidad').val();

                if (cantidad_id === "")
                {
                    error("Ingrese la cantidad del producto");
                    return;
                }

                var precio_id = $('#PrecioActual').val();
                precio_id = parseFloat(precio_id);

                if (precio_id === 0)
                {
                    error("Ingrese el precio del producto");
                    return;
                }

                var existencia_id = parseFloat($('#Existencia').val());
                cantidad_id = parseFloat(cantidad_id);

                if (cantidad_id <= 0)
                {
                    error("La cantidad ingresada no puede ser 0");
                    return;
                }

                if (cantidad_id > existencia_id)
                {
                    error("La cantidad ingresada es mayor a la existencia");
                    return;
                }                

                cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, precio_id);
                totalizarProducto();

                //Se oculta el boton de visualizar imagen
                $('#imagen').css("display", "none");

                //Se asigna la imagen por default
                $("#visualizar-imagen-producto-form").find("#fotografia").attr("src", "@Url.Content("~/Content/assets/images/producto-sin-foto.jpg")");

                $("#ProductoId").val(0);
                $("#Cantidad").val(1);
                $("#Existencia").val(0);
                $("#PrecioActual").val(0);
                $("#Producto").val("");
                $("#Barra").val("");                
                $("#Barra").focus();
            });       

            $('#producto_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();

                totalizarProducto();
            });
      
            function renderizarProductosIniciales()
            {
                if (productoIdSeleccionados == null)
                {
                    return;
                }

                // recorremos los productos que haya ingresado el usuario
                for (var i = 0; i < productoIdSeleccionados.length; i++)
                {
                    var producto_id = productoIdSeleccionados[i];
                    var producto = productoSeleccionados[i];

                    var presentacion_id = presentacionIdSeleccionados[i];
                    var presentacion = presentacionSeleccionados[i];

                    var existencia_id = existenciaSeleccionados[i];
                    var cantidad_id = cantidadSeleccionados[i];                    
                    var precio_id = precioSeleccionados[i];

                    cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, precio_id);
                }

                totalizarProducto();
            }

            function totalizarProducto()
            {
                var cantidadArray = new Array();
                $('input[name=cantidadIds]').each(function ()
                {
                    cantidadArray.push(parseFloat($(this).val()));
                });

                var precioArray = new Array();
                $('input[name=precioIds]').each(function ()
                {
                    precioArray.push(parseFloat($(this).val()));
                });

                var total = 0;

                if (cantidadArray.length > 0 && precioArray.length > 0)
                {
                    for (var i = 0; i < cantidadArray.length; i++)
                    { 
                        total += cantidadArray[i] * precioArray[i];
                    }

                    $('#Total').html('Q' + total.toFixed(2));                
                }
                else {
                    $('#Total').html('Q' + total.toFixed(2));               
                }
            }

            function obtenerCliente(nit)
            {
                nit = (nit || '').trim();
                if (!nit) return;
                var cliente = null;
                $.ajax({
                    url: '@Url.Action("ObtenerPorNit", "Inicio")?nit=' + encodeURI(nit),
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        if (!data.Operacion)
                        {
                            toastr.error('Ocurrió un error, al obtener datos del cliente');
                            return;
                        }

                        cliente = data.Data;

                    },
                    fail: function (data)
                    {
                        console.error(data);
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                    }
                });

                return cliente;
            }

            $('#PresentacionId').change(function (evt)
            {
                if ($('#AgenciaId').val() === "")
                {
                    error("Seleccionar una agencia");
                    return;
                }

                if ($('#ProductoId').val() === "")
                {
                    error("Seleccionar un producto");
                    return;
                }

                if ($('#PresentacionId').val() === "")
                {
                    error("Seleccionar una presentacion");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ObtenerProducto", "Inicio")',
                    traditional: true,
                    async: false,
                    data: { 'agenciaId': $('#AgenciaId').val(), 'productoId': $('#ProductoId').val(), 'presentacionId': $('#PresentacionId').val(), 'empleado': false },
                    type: 'GET',
                    success: function (resultData)
                    {
                        if (resultData !== null)
                        {
                            if (resultData.Operacion)
                            {
                                $('#Existencia').val(resultData.Data.Existencia);
                                $('#PrecioActual').val(resultData.Data.PrecioActual);
                                $('#Cantidad').focus();
                                if (parseFloat(resultData.Data.Existencia) === 0)
                                {
                                    document.getElementById('Existencia').style.backgroundColor = "#F78181";
                                }
                                else
                                {
                                    document.getElementById('Existencia').removeAttribute("style");
                                }
                            }
                            else
                            {
                                toastr.error('Ocurrió un error, al visualizar el producto');
                            }
                        }
                        else
                        {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                        }
                    }
                });
            });

            $("#Barra").autocomplete({
                source: function (request, response)
                {
                    $.ajax({
                        url: '@Url.Action("ConsultaProductoAutocomplementar", "Inicio")',
                        type: "POST",
                        dataType: "json",
                        data: { search: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Nombre, value: item.Nombre };
                            }))
                        }
                    })
                },
                messages:
                {
                    noResults: "", results: ""
                }
            });

            $('#formaprincipal').keydown(function (evt)
            {
                if ($('#Barra').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    cargaBusquedaProducto(evt)
                }
                else if ($('#Cantidad').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    if ($('#Cantidad').val() === "") {
                        error("Ingresar cantidad de producto");
                        $('#Cantidad').focus();
                        return;
                    }
                    $('#PrecioActual').focus();
                }
                else if ($('#PrecioActual').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    if ($('#PrecioActual').val() === "") {
                        error("Ingresar precio del producto");
                        $('#PrecioActual').focus();
                        return;
                    }
                    $('#btn-agregar').focus();
                }
            });

            /*
            Evento click para el boton de busqueda de productos */
            $('#btnBarra').click(function (evt)
            {
                cargaBusquedaProducto(evt);
            });

            /*
         Evento click para el boton de visualizar imagen de productos */
            $('#btn-visualizar').click(function (evt)
            {
                if ($('#ProductoId').val() === "")
                {
                    error("Ingresar codigo de barra");
                    $('#Barra').focus();

                    return;
                }

                $.ajax({
                    url: '@Url.Action("ObtenerFotografiaProducto", "Inicio")',
                    traditional: true,
                    data: { 'productoId': $('#ProductoId').val() },
                    async: false,
                    type: 'GET',
                    success: function (resultData)
                    {
                        if (resultData !== null)
                        {
                            if (resultData.Operacion)
                            {
                                $("#visualizar-imagen-producto-form").find("#fotografia").attr("src", resultData.Data);
                            }
                        }
                    }
                });

            });

            $('#producto_seleccionado_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();

                $('#btn-close-up-seleccionar-producto').click();
                var productoReferencia = $(this).attr("href");
                var productoActual = productoReferencia.split(",");

                var modelo =
                 {
                     'ProductoId': productoActual[0],
                     'Nombre': productoActual[1]
                 };

                cargaProductoSeleccionado(modelo);
            });

            /*
            Función para la busqueda de productos */
            function cargaBusquedaProducto(evt)
            {
                evt.preventDefault();

                if ($('#Barra').val() === "") {
                    error("Ingresar codigo de barra");
                    $('#Barra').focus();
                    return;
                }

                if (vCodBarra === $('#Barra').val()) {
                    vAumentaCantidad = parseInt($('#Cantidad').val()) + 1;
                    $('#Cantidad').val(vAumentaCantidad);
                }
                else {
                    $('#Cantidad').val(1);
                }

                var barraActual = $('#Barra').val();
                barraActual = barraActual.replace(" ", "_");

                $.ajax({
                    url: '@Url.Action("ObtenerProductoxTextoLibre", "Inicio")',
                    traditional: true,
                    data: { 'search': barraActual },
                    async: false,
                    type: 'GET',
                    success: function (resultData) {
                        if (resultData !== null) {
                            if (resultData.Operacion) {
                                if (resultData.Data.length === 1) {
                                    cargaProductoSeleccionado(resultData.Data[0]);
                                }
                                else if (resultData.Data.length > 1) {
                                    var fila = "";
                                    for (var i = 0; i < resultData.Data.length; i++) {
                                        fila += "<tr><td>" + resultData.Data[i].ProductoId + "</td>";
                                        fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                        fila += "<td><a href='" + resultData.Data[i].ProductoId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                    }

                                    $("#seleccionar-producto-form").modal();
                                    $("#seleccionar-producto-form").find("#producto_seleccionado_tbody").html(fila);
                                }
                            }
                            else {
                                toastr.error('La barra del producto ingresada no es correcta');
                                $('#Barra').val("");
                                $('#Barra').focus();
                            }
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                });
            }

            function cargaProductoSeleccionado(producto)
            {
                //Se activa el boton de visualizar fotografia
                $('#imagen').css("display", "block");

                $('#Producto').val(producto.Nombre);
                $('#ProductoId').val(producto.ProductoId);

                var PresentacionSelect = $("#PresentacionId");
                PresentacionSelect.empty();
                PresentacionSelect.append('<option value="0">--Seleccione una Unidad--</option>');

                $.ajax({
                    url: '@Url.Action("ObtenerPresentacionPorProducto", "Inicio")',
                    data: { 'id': $('#ProductoId').val() },
                    traditional: true,
                    async: false,
                    type: 'GET',
                    success: function (data) {
                        var unidadActual = 0;
                        $.each(data, function (j) {
                            unidadActual = data[j]['Value'];
                            PresentacionSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                        });

                        //Se selecciona por default a la unidad de medida
                        $("#PresentacionId").val(unidadActual).trigger("change");
                    }
                });

                $('#Barra').focus();
                vCodBarra = $('#Barra').val();
            }

        });
    </script>
    <!--Fin del Inicio de Script-->

    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner">
                Validando...
            </p>
        </div>
    </div>

</body>
</html>

