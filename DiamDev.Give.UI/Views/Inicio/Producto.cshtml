    <link href="~/Content/assets/plugins/iCheck/skins/all.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/perfect-scrollbar/src/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/Content/assets/css/theme_dark.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/jquery-ui/jquery-ui-1.10.1.custom.min.css" rel="stylesheet" />   
    <link href="~/Content/assets/plugins/bootstrap-modal/css/bootstrap-modal-bs3patch.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/plugins/bootstrap-modal/css/bootstrap-modal.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/css/jquery.bootstrap-touchspin.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-fileupload/bootstrap-fileupload.min.css" rel="stylesheet" />     
    <link href="~/Content/assets/plugins/fullcalendar/fullcalendar/fullcalendar.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/bootstrap-social-buttons/social-buttons-3.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Content/fancybox/source/jquery.fancybox.css?v=2.1.5" media="screen" />
    <link rel="stylesheet" type="text/css" href="~/Content/fancybox/source/helpers/jquery.fancybox-buttons.css?v=1.0.5" />
    <link rel="stylesheet" type="text/css" href="~/Content/fancybox/source/helpers/jquery.fancybox-thumbs.css?v=1.0.7" />
    <link href="~/Content/toastr.min.css" rel="stylesheet" />
    <link href="~/content/Site.css" rel="stylesheet" />

    <!--[if IE 7]>
    <link rel="stylesheet" href="assets/plugins/font-awesome/css/font-awesome-ie7.min.css">
    <![endif]-->
    <!--Fin de Plantillas CSS-->

    <link rel="shortcut icon" href="~/favicon.ico" />
</head>
<body class="login example1">
    <div class="main-login col-md-12 col-md-offset-12">
        <div class="logo">
            Producto x Codigo<i class="clip-key-2"></i>
        </div>
        <!-- start: LOGIN BOX -->
        <div class="box-login">
            <div class="row">
                <form action="" method="get">
                    <div class="col-md-12">
                        <div class="input-group well">
                            <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                            <span class="input-group-btn">
                                <button class="btn btn-primary" type="submit">
                                    <i class="clip-search-3"></i> Buscar
                                </button>
                            </span>
                        </div>
                    </div>
                </form>
            </div>
            @if (Model != null)
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label">
                                Codigo
                            </label>
                            <br />
                            <strong>
                                @(Model == null ? "No Disponible" : (string.IsNullOrWhiteSpace(Model.Codigo) ? "No Disponible" : Model.Codigo))
                            </strong>
                        </div>
                        <div class="form-group">
                            <label class="control-label">
                                Nombre
                            </label>
                            <br />
                            <strong>
                                @(Model == null ? "No Disponible" : (string.IsNullOrWhiteSpace(Model.Nombre) ? "No Disponible" : Model.Nombre))
                            </strong>
                        </div>
                        <div class="form-group">
                            <label class="control-label">
                                Nombre Alternativo #1
                            </label>
                            <br />
                            <strong>
                                @(Model == null ? "No Disponible" : (string.IsNullOrWhiteSpace(Model.NombreAlternativo1) ? "No Disponible" : Model.NombreAlternativo1))
                            </strong>
                        </div>
                        <div class="form-group">
                            <label class="control-label">
                                Nombre Alternativo #1
                            </label>
                            <br />
                            <strong>
                                @(Model == null ? "No Disponible" : (string.IsNullOrWhiteSpace(Model.NombreAlternativo2) ? "No Disponible" : Model.NombreAlternativo2))
                            </strong>
                        </div>
                        <div class="form-group">
                            <label class="control-label">
                                Precio de Venta
                            </label>
                            <br />
                            <strong>
                                @(Model == null ? "No Disponible" : Model.PrecioActual.ToString("C"))
                            </strong>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (string.IsNullOrWhiteSpace(Model.FotografiaApp))
                            {
                                <img style="height: 350px; width: 350px;" src="~/Content/assets/images/producto-sin-foto.jpg" />
                            }
                            else
                            {
                                if (Model.FotografiaApp.Contains("http"))
                                {
                                    <img style="height: 350px; width: 350px;" src="@Model.FotografiaApp" />
                                }
                                else
                                {
                                    <img style="height: 350px; width: 350px;" src="~/Content/assets/images/producto-sin-foto.jpg" />
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- end: LOGIN BOX -->
        <!-- start: COPYRIGHT -->
        <div class="copyright">
            @DateTime.Now.Year © - RAGATEC
        </div>
        <!-- end: COPYRIGHT -->
    </div>

    <!--Inicio de Script-->
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Content/assets/js/form-elements.js"></script>
    <script src="~/Scripts/jquery-ui-1.11.4.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/blockUI/jquery.blockUI.js"></script>
    <script src="~/Content/assets/plugins/iCheck/jquery.icheck.min.js"></script>
    <script src="~/Content/assets/plugins/perfect-scrollbar/src/jquery.mousewheel.js"></script>
    <script src="~/Content/assets/plugins/perfect-scrollbar/src/perfect-scrollbar.js"></script>
    <script src="~/Content/assets/js/main.js"></script>
    <script src="~/Content/assets/plugins/jquery-inputlimiter/jquery.inputlimiter.1.3.1.min.js"></script>
    <script src="~/Content/assets/plugins/autosize/jquery.autosize.min.js"></script>
    <script src="~/Content/assets/plugins/select2/select2.min.js"></script>
    <script src="~/Content/assets/plugins/jquery.maskedinput/src/jquery.maskedinput.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-daterangepicker/moment.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-daterangepicker/daterangepicker.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-colorpicker/js/bootstrap-colorpicker.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-colorpicker/js/commits.js"></script>
    <script src="~/Content/assets/plugins/jQuery-Tags-Input/jquery.tagsinput.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-fileupload/bootstrap-fileupload.min.js"></script>
    <script src="~/Content/assets/plugins/summernote/build/summernote.min.js"></script>
    <script src="~/Content/assets/plugins/ckeditor/ckeditor.js"></script>
    <script src="~/Content/assets/plugins/ckeditor/adapters/jquery.js"></script>
    <script src="~/Content/assets/plugins/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/Content/assets/js/form-validation.js"></script>
    <script src="~/Content/assets/plugins/ladda-bootstrap/dist/spin.min.js"></script>
    <script src="~/Content/assets/plugins/ladda-bootstrap/dist/ladda.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-switch/static/js/bootstrap-switch.min.js"></script>
    <script src="~/Content/assets/js/ui-buttons.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-modal/js/bootstrap-modal.js"></script>
    <script src="~/Content/assets/plugins/bootstrap-modal/js/bootstrap-modalmanager.js"></script>
    <script src="~/Content/assets/js/ui-modals.js"></script>
    <script src="~/Content/assets/js/jquery.bootstrap-touchspin.js"></script>
    <script src="~/Scripts/highcharts.js"></script>
    <script src="~/Scripts/data.js"></script>
    <script src="~/Scripts/exporting.js"></script>
    <script src="~/Content/assets/plugins/fullcalendar/fullcalendar/fullcalendar.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/jquery.numeric.js"></script>
    <script type="text/javascript" src="~/Content/fancybox/lib/jquery.mousewheel-3.0.6.pack.js"></script>
    <script type="text/javascript" src="~/Content/fancybox/source/jquery.fancybox.js?v=2.1.5"></script>
    <script type="text/javascript" src="~/Content/fancybox/source/helpers/jquery.fancybox-buttons.js?v=1.0.5"></script>
    <script type="text/javascript" src="~/Content/fancybox/source/helpers/jquery.fancybox-thumbs.js?v=1.0.7"></script>
    <script type="text/javascript" src="~/Content/fancybox/source/helpers/jquery.fancybox-media.js?v=1.0.6"></script>
    <script src="~/Content/assets/js/login.js"></script>
    <!-- end: JAVASCRIPTS REQUIRED FOR THIS PAGE ONLY -->
    <script type="text/javascript">
        $(function ()
        {
            Main.init();
            FormElements.init();

            Login.init();
        });
    </script>
    <script src="~/Scripts/ladda.min.js"></script>
    <script src="~/Scripts/spin.min.js"></script>
    <script src="~/Scripts/mustache.js"></script>
    <!--Fin del Inicio de Script-->

    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner">
                Validando...
            </p>
        </div>
    </div>
</body>
</html>

