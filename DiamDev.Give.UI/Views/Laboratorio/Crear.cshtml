@model DiamDev.Give.Entities.Laboratorio

@{
    ViewBag.Title = "Nuevo Laboratorio";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nuevo Laboratorio
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nuevo Laboratorio</h2>
                <p>
                    Crea un nuevo laboratorio.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="AgenciaId" name="AgenciaId" value="@Html.Raw(DiamDev.Give.UI.App_Start.CustomHelper.getAgenciaId())" />
                    </div>
                    @Html.Partial("_CreateOrEdit")
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Laboratorio")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<div id="seleccionar-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Producto</h4>
    </div>
    <div class="modal-body">      
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>                        
                        <th></th>
                    </tr>
                </thead>
                <tbody id="producto_seleccionado_tbody">
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

<div id="seleccionar-producto-destino-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Producto</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="producto_seleccionado_destino_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-producto-destino" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
          
    var vCodBarra = "";
    var vCodBarraDestino = "";

    $(function () 
    {
        function error(texto)
        {
            toastr.error(texto);
        }

        $('#PresentacionId').change(function (evt)
        {
            if ($('#ProductoBaseId').val() === "")
            {
                error("Seleccionar un producto");
                return;
            }

            if ($('#PresentacionId').val() === "")
            {
                error("Seleccionar una presentacion");
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerProducto", "Producto")',
                traditional: true,
                async: false,
                data: { 'agenciaId': $('#AgenciaId').val(), 'productoId': $('#ProductoBaseId').val(), 'presentacionId': $('#PresentacionId').val(), 'empleado': false },
                type: 'GET',
                success: function (resultData)
                {
                    if (resultData !== null)
                    {
                        if (resultData.Operacion)
                        {
                            $('#Existencia').val(resultData.Data.Existencia);
                            $('#Cantidad').focus();
                            if (parseFloat(resultData.Data.Existencia) === 0)
                            {
                                document.getElementById('Existencia').style.backgroundColor = "#F78181";
                            }
                            else
                            {
                                document.getElementById('Existencia').removeAttribute("style");
                            }
                        }
                        else
                        {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                        }
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                    }
                }
            });
        });

        $("#Barra").autocomplete({
            source: function (request, response)
            {
                $.ajax({
                    url: '@Url.Action("ConsultaProductoAutocomplementar", "Producto")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term },
                    success: function (data)
                    {
                        response($.map(data, function (item)
                        {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
        });

        $("#BarraDestino").autocomplete({
            source: function (request, response)
            {
                $.ajax({
                    url: '@Url.Action("ConsultaProductoAutocomplementar", "Producto")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
        });

        $('#formaprincipal').keydown(function (evt)
        {
            if ($('#Barra').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                cargaBusquedaProducto(evt)
            }
            else if ($('#Cantidad').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                evt.preventDefault();
                if ($('#Cantidad').val() === "")
                {
                    error("Ingresar cantidad de producto");
                    $('#Cantidad').focus();
                    return;
                }
                $('#BarraDestino').focus();
            }
            else if ($('#BarraDestino').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                cargaBusquedaProductoDestino(evt)
            }            
        });

        /*
        Evento click para el boton de busqueda de productos */
        $('#btnBarra').click(function (evt)
        {
            cargaBusquedaProducto(evt);
        });

        $('#btnBarraDestino').click(function (evt)
        {
            cargaBusquedaProductoDestino(evt);
        });
      
        $('#producto_seleccionado_tbody').delegate("a", "click", function (e)
        {
            e.preventDefault();

            $('#btn-close-up-seleccionar-producto').click();
            var productoReferencia = $(this).attr("href");
            var productoActual = productoReferencia.split(",");

            var modelo =
             {
                 'ProductoId': productoActual[0],
                 'Nombre': productoActual[1]
             };

            cargaProductoSeleccionado(modelo);
        });

        $('#producto_seleccionado_destino_tbody').delegate("a", "click", function (e)
        {
            e.preventDefault();

            $('#btn-close-up-seleccionar-producto-destino').click();
            var productoReferencia = $(this).attr("href");
            var productoActual = productoReferencia.split(",");

            var modelo =
             {
                 'ProductoId': productoActual[0],
                 'Nombre': productoActual[1]
             };

            cargaProductoSeleccionadoDestino(modelo);
        });

        /*
        Función para la busqueda de productos */
        function cargaBusquedaProducto(evt)
        {
            evt.preventDefault();

            if ($('#Barra').val() === "") {
                error("Ingresar codigo de barra");
                $('#Barra').focus();
                return;
            }

            if (vCodBarra === $('#Barra').val()) {
                vAumentaCantidad = parseInt($('#Cantidad').val()) + 1;
                $('#Cantidad').val(vAumentaCantidad);
            }
            else {
                $('#Cantidad').val(1);
            }

            var barraActual = $('#Barra').val();
            barraActual = barraActual.replace(" ", "_");

            $.ajax({
                url: '@Url.Action("ObtenerProductoxTextoLibre", "Producto")',
                traditional: true,
                data: { 'search': barraActual },
                async: false,
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            if (resultData.Data.length === 1) {
                                cargaProductoSeleccionado(resultData.Data[0]);
                            }
                            else if (resultData.Data.length > 1) {
                                var fila = "";
                                for (var i = 0; i < resultData.Data.length; i++) {
                                    fila += "<tr><td>" + resultData.Data[i].ProductoId + "</td>";
                                    fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                    fila += "<td><a href='" + resultData.Data[i].ProductoId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                }

                                $("#seleccionar-producto-form").modal();
                                $("#seleccionar-producto-form").find("#producto_seleccionado_tbody").html(fila);
                            }
                        }
                        else {
                            toastr.error('La barra del producto ingresada no es correcta');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                        $('#Barra').val("");
                        $('#Barra').focus();
                    }
                }
            });
        }

        function cargaBusquedaProductoDestino(evt)
        {
            evt.preventDefault();

            if ($('#BarraDestino').val() === "")
            {
                error("Ingresar codigo de barra");
                $('#BarraDestino').focus();
                return;
            }

            var barraActual = $('#BarraDestino').val();
            barraActual = barraActual.replace(" ", "_");

            $.ajax({
                url: '@Url.Action("ObtenerProductoxTextoLibre", "Producto")',
                traditional: true,
                data: { 'search': barraActual },
                async: false,
                type: 'GET',
                success: function (resultData)
                {
                    if (resultData !== null)
                    {
                        if (resultData.Operacion)
                        {
                            if (resultData.Data.length === 1)
                            {
                                cargaProductoSeleccionadoDestino(resultData.Data[0]);
                            }
                            else if (resultData.Data.length > 1)
                            {
                                var fila = "";
                                for (var i = 0; i < resultData.Data.length; i++)
                                {
                                    fila += "<tr><td>" + resultData.Data[i].ProductoId + "</td>";
                                    fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                    fila += "<td><a href='" + resultData.Data[i].ProductoId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                }

                                $("#seleccionar-producto-destino-form").modal();
                                $("#seleccionar-producto-destino-form").find("#producto_seleccionado_destino_tbody").html(fila);
                            }
                        }
                        else
                        {
                            toastr.error('La barra del producto ingresada no es correcta');
                            $('#BarraDestino').val("");
                            $('#BarraDestino').focus();
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                        $('#BarraDestino').val("");
                        $('#BarraDestino').focus();
                    }
                }
            });
        }

        function cargaProductoSeleccionado(producto)
        {            
            $('#Producto').val(producto.Nombre);
            $('#ProductoBaseId').val(producto.ProductoId);

            var PresentacionSelect = $("#PresentacionId");
            PresentacionSelect.empty();
            PresentacionSelect.append('<option value="0">--Seleccione una Unidad--</option>');

            $.ajax({
                url: '@Url.Action("ObtenerPresentacionPorProducto", "Producto_Ingreso")',
                data: { 'id': $('#ProductoBaseId').val() },
                traditional: true,
                async: false,
                type: 'GET',
                success: function (data)
                {
                    var presentacionBaseId = 0;
                    $.each(data, function (j)
                    {
                        presentacionBaseId = data[j]['Value'];
                        PresentacionSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                    });

                    //Se selecciona por default a la unidad de medida
                    $("#PresentacionId").val(presentacionBaseId).trigger("change");
                }
            });

            $('#Barra').focus();
            vCodBarra = $('#Barra').val();
        }

        function cargaProductoSeleccionadoDestino(producto)
        {
            $('#ProductoDestino').val(producto.Nombre);
            $('#ProductoDestinoId').val(producto.ProductoId);

            var PresentacionSelect = $("#PresentacionDestinoId");
            PresentacionSelect.empty();
            PresentacionSelect.append('<option value="0">--Seleccione una Unidad--</option>');

            $.ajax({
                url: '@Url.Action("ObtenerPresentacionPorProducto", "Producto_Ingreso")',
                data: { 'id': $('#ProductoDestinoId').val() },
                traditional: true,
                async: false,
                type: 'GET',
                success: function (data)
                {
                    var presentacionDestinoId = 0;
                    $.each(data, function (j) {
                        presentacionDestinoId = data[j]['Value'];
                        PresentacionSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                    });

                    //Se selecciona por default a la unidad de medida
                    $("#PresentacionDestinoId").val(presentacionDestinoId).trigger("change");
                }
            });

            $('#BarraDestino').focus();
            vCodBarraDestino = $('#BarraDestino').val();
        }
    });

    </script>
}

