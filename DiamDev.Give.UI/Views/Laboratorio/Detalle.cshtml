@model DiamDev.Give.Entities.Laboratorio

@{
    ViewBag.Title = "Detalle del Laboratorio";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Laboratorio
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">              
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="LaboratorioId" name="LaboratorioId" value="@Html.Raw(Model.LaboratorioId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Agencia
                                </label>
                                <br />
                                <strong>
                                    @(Model.Agencia == null ? "No Disponible" : Model.Agencia.Nombre)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Producto Base
                                </label>
                                <br />
                                <strong>
                                    @(Model.ProductoBase == null ? "No Disponible" : Model.ProductoBase.Nombre)
                                </strong>
                            </div>    
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad Base
                                </label>
                                <br />
                                <strong>
                                    @(Model.ProductoBase == null ? "No Disponible" : (Model.ProductoBase.Unidad == null ? "No Disponible" : Model.ProductoBase.Unidad.Nombre))
                                </strong>
                            </div>                           
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad Base
                                </label>
                                <br />
                                <strong>
                                    @Model.CantidadBase
                                </strong>
                            </div>   
                        </div>
                    </div>
                    <hr /> 
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Producto Destino
                                </label>
                                <br />
                                <strong>
                                    @(Model.ProductoDestino == null ? "No Disponible" : Model.ProductoDestino.Nombre)
                                </strong>
                            </div> 
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad Destino
                                </label>
                                <br />
                                <strong>
                                    @(Model.ProductoDestino == null ? "No Disponible" : (Model.ProductoDestino.Unidad == null ? "No Disponible" : Model.ProductoDestino.Unidad.Nombre))
                                </strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad Destino
                                </label>
                                <br />
                                <strong>
                                    @Model.CantidadDestino
                                </strong>
                            </div> 
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha
                                </label>
                                <br />
                                <strong>
                                    @Model.Fecha.ToString("dd/MM/yyyy")
                                </strong>
                            </div>
                        </div>
                    </div>
                    <hr /> 
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Responsable
                                </label>
                                <br />
                                <strong>
                                    @(Model.UsuarioCreo == null ? "No Disponible" : Model.UsuarioCreo.Nombre)
                                </strong>
                            </div>
                        </div>
                    </div>
                     <div class="row">
                        <p>
                            <div class="col-md-6">
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Laboratorio")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

