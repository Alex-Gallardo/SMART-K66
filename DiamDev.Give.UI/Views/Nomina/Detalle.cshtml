@model DiamDev.Give.Entities.Nomina

@{
    ViewBag.Title = "Detalle Nomina";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nomina
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">              
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="NominaId" name="NominaId" value="@Html.Raw(Model.NominaId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Tipo
                                </label>
                                <br />
                                <strong>
                                    @(Model.Tipo == null ? "No Disponible" : Model.Tipo.Nombre)
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Inicial
                                </label>
                                <br />
                                <strong>
                                    @Model.FechaInicial.ToString("dd/MM/yyyy")
                                </strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Final
                                </label>
                                <br />
                                <strong>
                                    @Model.FechaFinal.ToString("dd/MM/yyyy")
                                </strong>
                            </div>
                        </div>  
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Descripci&oacute;n
                                </label>
                                <br />
                                <strong>
                                    @Model.Descripcion
                                </strong>
                            </div>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Personal
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th>
                                            <th>Puesto</th>
                                            <th>Dias</th>
                                            <th>Sueldo</th>
                                            <th>Bonificacion</th>
                                            <th>Otros Ingresos</th>
                                            <th>IGSS</th>
                                            <th>Otros Descuentos</th>
                                            <th>Sub Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Detalles != null && Model.Detalles.Count() > 0)
                                        {
                                            foreach (var Detalle in Model.Detalles)
                                            {
                                                <tr>
                                                    <td>
                                                        @(Detalle.Personal == null ? "No Disponible" : Detalle.Personal.Nombre)
                                                    </td>
                                                    <td>
                                                        @Detalle.Puesto
                                                    </td>
                                                    <td>
                                                        @Detalle.Dias
                                                    </td>
                                                    <td>
                                                        @Detalle.Sueldo.ToString("C")
                                                    </td>
                                                    <td>
                                                        @Detalle.Bonificacion.ToString("C")
                                                    </td>
                                                    <td>
                                                        @Detalle.OtrosIngresos.ToString("C")
                                                    </td>
                                                    <td>
                                                        @Detalle.IGSS.ToString("C")
                                                    </td>
                                                    <td>
                                                        @Detalle.OtrosDescuentos.ToString("C")
                                                    </td>
                                                    <td>
                                                        @string.Format("{0:C}", (Detalle.Sueldo + Detalle.Bonificacion + Detalle.OtrosIngresos) - (Detalle.IGSS + Detalle.OtrosDescuentos))
                                                    </td>
                                                </tr>
                                            }
                                            <tr>
                                                <td>
                                                    <div style="text-align:left; font-size:large; font-weight:bold;">
                                                        Total:
                                                    </div>
                                                </td>
                                                <td colspan="9">
                                                    <div style="text-align: right;font-size:large; font-weight:bold;">
                                                        @string.Format("{0:C}", Model.Detalles.Sum(x => (x.Sueldo + x.Bonificacion + x.OtrosIngresos) - (x.IGSS + x.OtrosDescuentos)))
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="9">
                                                    <strong>No contiene personal</strong>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>                            
                        </div>
                    </div>
                    <div class="row">                       
                        <p>
                            <div class="col-md-12">
                                <a class="btn btn-med-grey btn-block" href="javascript:window.history.back();">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

