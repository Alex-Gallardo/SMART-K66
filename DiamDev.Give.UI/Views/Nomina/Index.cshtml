@model IEnumerable<DiamDev.Give.Entities.Nomina>

@{
    ViewBag.Title = "Nomina Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Nomina")">
        Nueva
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<form action="" method="get" class="form-inline">  
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Inicial<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaInicial" name="FechaInicial" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Final<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaFinal" name="FechaFinal" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="this.form.submit();" required>
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
    </div>
</form>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nomina
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>F. Inicial</th>
                                <th>F. Final</th>
                                <th>Descripci&oacute;n</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Nomina in Model)
                            {
                                <tr>
                                    <td>@(Nomina.Tipo == null ? "No Disponible" : Nomina.Tipo.Nombre)</td>
                                    <td>@Nomina.FechaInicial.ToString("dd/MM/yyyy")</td>
                                    <td>@Nomina.FechaFinal.ToString("dd/MM/yyyy")</td>
                                    <td>@Nomina.Descripcion</td>
                                    <td class="center">
                                        <div class="visible-md visible-lg hidden-sm hidden-xs">
                                            <a href="@Url.Action("Detalle", "Nomina", new { id = Nomina.NominaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle de Nomina"><i class="clip-stack-empty"></i></a>
                                            <a href="@Url.Action("Boleta", "Nomina", new { id = Nomina.NominaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Boleta"><i class="clip-file-pdf"></i></a>
                                            <a href="@Url.Action("Comprobante", "Nomina", new { id = Nomina.NominaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Comprobante"><i class="clip-file-pdf"></i></a>
                                        </div>
                                        <div class="visible-xs visible-sm hidden-md hidden-lg">
                                            <div class="btn-group">
                                                <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                    <i class="icon-cog"></i> <span class="caret"></span>
                                                </a>
                                                <ul role="menu" class="dropdown-menu pull-right">
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Nomina", new { id = Nomina.NominaId })">
                                                            <i class="clip-stack-empty"></i> Detalle de Nomina
                                                        </a>
                                                    </li>
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Boleta", "Nomina", new { id = Nomina.NominaId })" target="_blank">
                                                            <i class="clip-file-pdf"></i> Ver Boleta
                                                        </a>
                                                    </li>
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Comprobante", "Nomina", new { id = Nomina.NominaId })" target="_blank">
                                                            <i class="clip-file-pdf"></i> Ver Comprobante
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>                
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
    $(document).ready(function () {
            if ('@TempData["Nomina-Success"]' == "OK")
            {
                toastr.success('La nomina se guardó exitosamente');
            }       
        });
    </script>
}


