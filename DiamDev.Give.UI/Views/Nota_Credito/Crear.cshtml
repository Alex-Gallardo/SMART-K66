@model DiamDev.Give.Entities.NotaCredito

@{
    ViewBag.Title = "Nueva Nota Credito";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nueva Nota Credito
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nueva Nota Credito</h2>
                <p>
                    Crea una nueva nota credito.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>                        
                    </div>
                    @Html.Partial("_CreateOrEdit")
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Nota_Credito")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<div id="new-cliente-form" class="modal fade" tabindex="-1" data-width="760" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Nuevo Cliente</h4>
    </div>
    <div class="modal-body">
        @Html.Partial("~/Views/Cliente/_CreateOrEdit.cshtml", new DiamDev.Give.Entities.Cliente() { Direccion = "CIUDAD", EmailCliente = "sincorreo@cbp.com" })
    </div>
    <div class="modal-footer">
        <button id="btn-save-up-cliente" class="btn btn-primary">Guardar</button>
        <button id="btn-close-up-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

<div id="seleccionar-cliente-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Cliente</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cliente_seleccionado_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>    
    <script type="text/html" id="forma_tr_template">
        <tr>
            <td>{{forma}}</td>
            <td>Q{{pagar}}</td>
            <td>{{nota}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="formaIds" value="{{forma_id}}" />
                <input type="hidden" name="pagarIds" value="{{pagar_id}}" />
                <input type="hidden" name="notaIds" value="{{nota_id}}" />
            </td>
        </tr>
    </script>    

    <script type="text/javascript">

        var vCliente = "";

        var formaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.formaIds))');
        var pagarSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.pagarIds))');
        var notaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.notaIds))');

        var clienteIds = "@Html.Raw(ViewBag.ClienteIds)";

        $(function ()
        {
            $('#BuscarCliente').focus();

            //Se oculta la informacion de la factura
            $('#VisualizarFactura').css("display", "none");

            //Se oculta la informacion de la factura
            $('#DatosFactura').css("display", "none");

            //Se oculta la informacion de las formas de pago
            $('#ControlPago').css("display", "none");

            //Se selecciona por default al cliente: Consumidor Final
            $("#ClienteId").val("20170115001").trigger("change");
            $("#NombreCliente").val("Consumidor Final");
            $("#DireccionCliente").val("Ciudad");
            $("#TelefonoCliente").val("");
            $("#DescuentoGeneralCliente").val("0");

            //Se indentifica el tipo de nota de credito
            IdentificarTipo($('#TipoId').val());

            //Se carga la informacion de la factura
            obtenerInformacionFactura($('#SerieId').val(), $('#NoFactura').val());
                 
            if (clienteIds !== "0") {
                var modelo =
                {
                    'ClienteId': clienteIds
                };

                cargaClienteSeleccionado(modelo);
            }

            $("#BuscarCliente").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("ConsultaCliente", "Cliente")',
                        type: "POST",
                        dataType: "json",
                        data: { search: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Nombre, value: item.Nombre };
                            }))
                        }
                    })
                },
                messages:
                {
                    noResults: "", results: ""
                }
            });

            $('#formaprincipal').keydown(function (evt) {
                if ($('#BuscarCliente').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    cargaBusquedaCliente(evt)
                }
            });

            $('#btnBuscarCliente').click(function (evt) {
                cargaBusquedaCliente(evt);
            });

            function cargaBusquedaCliente(evt) {
                evt.preventDefault();

                if ($('#BuscarCliente').val() === "") {
                    error("Ingresar Nit o Nombre del Cliente");
                    $('#BuscarCliente').focus();
                    return;
                }

                var clienteActual = $('#BuscarCliente').val();
                clienteActual = clienteActual.replace(" ", "_");

                $.ajax({
                    url: '@Url.Action("ObtenerClientexTextoLibre", "Cliente")',
                    traditional: true,
                    data: { 'search': clienteActual },
                    async: false,
                    type: 'GET',
                    success: function (resultData) {
                        if (resultData !== null) {
                            if (resultData.Operacion) {
                                if (resultData.Data.length === 1) {
                                    cargaClienteSeleccionado(resultData.Data[0]);
                                }
                                else if (resultData.Data.length > 1) {
                                    var fila = "";
                                    for (var i = 0; i < resultData.Data.length; i++) {
                                        fila += "<tr><td>" + resultData.Data[i].ClienteId + "</td>";
                                        fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                        fila += "<td><a href='" + resultData.Data[i].ClienteId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                    }

                                    $("#seleccionar-cliente-form").modal();
                                    $("#seleccionar-cliente-form").find("#cliente_seleccionado_tbody").html(fila);
                                }
                            }
                            else {
                                toastr.error('El cliente ingresado no es correcto');

                                $("#new-cliente-form").modal();
                                $("#new-cliente-form").find("#Nit").val($('#BuscarCliente').val());
                                $("#new-cliente-form").find("#Nombre").focus();
                            }
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar al cliente');
                            $('#BuscarCliente').val("");
                            $('#BuscarCliente').focus();
                        }
                    }
                });
            }

            $('#cliente_seleccionado_tbody').delegate("a", "click", function (e) {
                e.preventDefault();

                $('#btn-close-up-seleccionar-cliente').click();
                var clienteReferencia = $(this).attr("href");
                var clienteActual = clienteReferencia.split(",");

                var modelo =
                 {
                     'ClienteId': clienteActual[0],
                     'Nombre': clienteActual[1]
                 };

                cargaClienteSeleccionado(modelo);
            });

            function cargaClienteSeleccionado(cliente) {
                var clienteSeleccionado = obtenerClientexID(cliente.ClienteId);

                $('#NombreCliente').val(clienteSeleccionado.Nombre);
                $("#DireccionCliente").val(clienteSeleccionado.Direccion);
                $("#TelefonoCliente").val(clienteSeleccionado.NoTelefono);
                $("#DescuentoGeneralCliente").val(clienteSeleccionado.DescuentoGeneral);
                $('#ClienteId').val(clienteSeleccionado.ClienteId);

                //Se valida el vendedor
                if (clienteSeleccionado.VendedorId == null) {
                    $("#VendedorId").val("20180925001").trigger("change");
                }
                else {
                    $("#VendedorId").val(clienteSeleccionado.VendedorId).trigger("change");
                }

                //Se valida si el cliente es VIP
                if (clienteSeleccionado.Vip == true) {
                    $("#mensajeVIP").html("PAPELERIA COMPLETA");
                }
                else {
                    $("#mensajeVIP").html("PAPELERIA NO COMPLETA");
                }

                vCliente = $('#BuscarCliente').val();
                $('#Barra').focus();
            }

            function obtenerClientexID(id) {
                var cliente = null;
                $.ajax({
                    url: '@Url.Action("ObtenerPorID", "Cliente")?id=' + id,
                    async: false,
                    type: 'GET',
                    success: function (data) {

                        if (!data.Operacion) {
                            toastr.error('Ocurrió un error, al obtener datos del cliente');
                            return;
                        }

                        cliente = data.Data;

                    },
                    fail: function (data) {
                        console.error(data);
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                    }
                });

                return cliente;
            }

            $("#new-cliente-form").find("#Nit").change(function ()
            {
                var nit = $(this).val();
                var cliente = obtenerCliente(nit);
                if (!cliente) return;

                var vipChk = cliente.Vip ? "Si" : "No";
                var activoChk = cliente.Activo ? "Si" : "No";

                var frm = $("#new-cliente-form");

                frm.find("#Nombre").val(cliente.Nombre);
                frm.find("#Direccion").val(cliente.Direccion);
                frm.find("#DPI").val(cliente.DPI);
                frm.find("#NoTelefono").val(cliente.NoTelefono);
                frm.find("#EmailCliente").val(cliente.EmailCliente);
                frm.find('#vip' + vipChk).iCheck('check');
                frm.find('#activo' + activoChk).iCheck('check');
            });

            function obtenerCliente(nit)
            {
                nit = (nit || '').trim();
                if (!nit) return;
                var cliente = null;
                $.ajax({
                    url: '@Url.Action("ObtenerPorNit", "Cliente")?nit=' + encodeURI(nit),
                    async: false,
                    type: 'GET',
                    success: function (data) {

                        if (!data.Operacion) {
                            toastr.error('Ocurrió un error, al obtener datos del cliente');
                            return;
                        }

                        cliente = data.Data;

                    },
                    fail: function (data) {
                        console.error(data);
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                    }
                });

                return cliente;
            }

            $("#btn-save-up-cliente").click(function ()
            {
                var Nit = $("#new-cliente-form").find("#Nit").val();
                var Nombre = $("#new-cliente-form").find("#Nombre").val();
                var Direccion = $("#new-cliente-form").find("#Direccion").val();
                var DPI = $("#new-cliente-form").find("#DPI").val();
                var NoTelefono = $("#new-cliente-form").find("#NoTelefono").val();
                var EmailCliente = $("#new-cliente-form").find("#EmailCliente").val();
                var Vip = false;
                var Activo = true;

                if (Nit === "") {
                    error("El nit es requerido");
                    return;
                }

                if (Nombre === "") {
                    error("El nombre es requerido");
                    return;
                }

                if (Direccion === "") {
                    error("La dirección es requerida");
                    return;
                }

                if (EmailCliente === "") {
                    error("El correo electrónico es requerido");
                    return;
                }

                var modelo =
               {
                   'Nit': Nit,
                   'Nombre': Nombre,
                   'Direccion': Direccion,
                   'DPI': DPI,
                   'NoTelefono': NoTelefono,
                   'EmailCliente': EmailCliente,
                   'Descuento': 0,
                   'Vip': Vip,
                   'Activo': Activo
               };

                $.ajax({
                    url: '@Url.Action("NuevoCliente", "Cliente")',
                    data: { 'modelo': modelo },
                    async: false,
                    type: 'POST',
                    success: function (data)
                    {
                        if (data.Operacion)
                        {
                            $('#btn-close-up-cliente').click();
                            toastr.success('El nuevo cliente se guardó exitosamente');


                            //Selecciona el ultimo cliente ingresado
                            $("#ClienteId").val(data.Cliente).trigger("change");
                            $("#_Nit").val(Nit);
                            $("#_Nombre").val(Nombre);
                        }
                        else {
                            toastr.error('Ocurrió un error, al guardar al nuevo cliente');
                        }
                    }
                });

            });

            $('#new-cliente-form').keydown(function (evt)
            {
                if ($('#Nit').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    $('#Nombre').focus();
                }
                else if ($('#Nombre').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    $('#Direccion').focus();
                }
                else if ($('#Direccion').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    $('#DPI').focus();
                }
                else if ($('#DPI').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    $('#NoTelefono').focus();
                }
                else if ($('#NoTelefono').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    $('#EmailCliente').focus();
                }
                else if ($('#EmailCliente').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    $("#new-cliente-form").find("#btn-save-up-cliente").focus();
                }
            });

            function error(texto)
            {
                toastr.error(texto);
            }
          
            $('#TipoId').change(function (evt)
            {
                IdentificarTipo($('#TipoId').val());
            });

            $("#btnBuscar").click(function (evt)
            {
                evt.preventDefault();

                var serie_id = $('#SerieId').val();
             
                if (serie_id === "")
                {
                    error("Seleccione la serie de la factura");
                    return;
                }

                var factura_id = $('#NoFactura').val();
               
                if (factura_id === "")
                {
                    error("Ingrese el numero de la factura");
                    return;
                }

                obtenerInformacionFactura(serie_id, factura_id);                
            });

            function cargaForma(forma_id, forma, pagar_id, nota_id)
            {
                var plantilla = $('#forma_tr_template').html();

                var modelo =
                {
                    forma_id: forma_id,
                    forma: forma,
                    pagar_id: pagar_id,
                    pagar: pagar_id,
                    nota_id: nota_id,
                    nota: nota_id
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#forma_tbody').append(filaHtml);
            }
                       
            renderizarFormasIniciales();           

            $('#btn-agregar-forma').click(function (e)
            {
                e.preventDefault();

                var forma_id = $('#PagoId').val();
                var forma = $('#PagoId option:selected').text();

                if (forma_id === "" || forma === "")
                {
                    error("Seleccione una forma de pago");
                    return;
                }

                var cantidad_id = $('#Cantidad_Pagar').val();

                if (cantidad_id === "")
                {
                    error("Ingrese la cantidad a cancelar");
                    return;
                }

                var nota_id = $('#NotaP').val();

                cargaForma(forma_id, forma, cantidad_id, nota_id);
                totalizarPagar();

                $("#PagoId").val(0);
                $("#Cantidad_Pagar").val(0);
                $("#PagoId").focus();
            });
        
            $('#forma_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();

                totalizarPagar();
            });          

            function renderizarFormasIniciales()
            {
                if (formaSeleccionados == null)
                {
                    return;
                }

                // recorremos las formas de pago que haya ingresado el usuario
                for (var i = 0; i < formaSeleccionados.length; i++)
                {
                    var forma_id = formaSeleccionados[i];
                    var forma = $('#PagoId option[value=' + forma_id + ']').text();

                    var cantidad_id = pagarSeleccionados[i];
                    var nota_id = notaSeleccionados[i];

                    cargaForma(forma_id, forma, cantidad_id, nota_id);
                }

                totalizarPagar();
            }           

            function totalizarPagar()
            {
                var pagarArray = new Array();
                $('input[name=pagarIds]').each(function ()
                {
                    pagarArray.push(parseFloat($(this).val()));
                });

                var total = 0;
             
                if (pagarArray.length > 0)
                {
                    if (pagarArray.length > 0)
                    {
                        for (var i = 0; i < pagarArray.length; i++)
                        {
                            total += pagarArray[i];
                        }                      

                        $('#Total_Pagar').html('Q' + parseFloat(total).toFixed(2));
                    }
                    else
                    {
                        $('#Total_Pagar').html('Q' + parseFloat(total).toFixed(2));
                    }
                }
                else
                {
                    $('#Total_Pagar').html('Q' + parseFloat(total).toFixed(2));
                }
            }

            function IdentificarTipo(tipoId)
            {
                if (tipoId === "1")
                {
                    $('#VisualizarFactura').css("display", "block");
                    $('#ControlPago').css("display", "none");

                    $("#SerieId").select2({
                        closeOnSelect: false
                    });
                    $("#SerieId").on('select2:open', function () {
                        $(document.activeElement).blur()
                    });
                    $('#SerieId').select2('open');
                }
                else if (tipoId === "2")
                {
                    $('#VisualizarFactura').css("display", "none");
                    $('#ControlPago').css("display", "block");
                    $('#Serie').focus();
                }
            }

            function obtenerInformacionFactura(serieId , facturaId)
            {
                if (serieId !== null && facturaId !== null)
                {
                    $.ajax({
                        url: '@Url.Action("ObtenerFacturaxSerie", "Factura")',
                        traditional: true,
                        async: false,
                        data: { 'serieId': serieId, 'factura': facturaId },
                        type: 'GET',
                        success: function (resultData)
                        {
                            if (resultData !== null)
                            {
                                if (resultData.Operacion)
                                {                               
                                    $('#DatosFactura').css("display", "block");

                                    $("#FacturaId").val(resultData.Data.FacturaId);
                                    $("#NCliente").val(resultData.Data.Nombre);
                                    $("#NAgencia").val(resultData.Data.Agencia);
                                    $("#NDocumento").val(resultData.Data.Documento);
                                    $("#NTotal").val(resultData.Data.TotalLiquido);
                                }
                                else
                                {
                                    toastr.error('Ocurrió un error, al visualizar los datos de la factura');
                                }
                            }
                            else
                            {
                                toastr.error('Ocurrió un error, al visualizar los datos de la factura');
                            }
                        }
                    });
                }
            }
     });

    </script>
}



