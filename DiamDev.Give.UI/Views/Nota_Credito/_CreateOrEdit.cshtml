@model DiamDev.Give.Entities.NotaCredito

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="BuscarCliente" name="BuscarCliente" autocomplete="off" placeholder="Buscar Cliente...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBuscarCliente">Buscar</button>
                    <a href="#new-cliente-form" data-toggle="modal" class="demo btn btn-blue" style="margin-bottom: -1px;">
                        <i class="clip-plus-circle"></i>
                    </a>
                </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente<span class="symbol required"></span>
            </label>
            <input type="text" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" autocomplete="off" disabled="disabled" required />
            <input type="hidden" id="ClienteId" name="ClienteId" value="0" />
            <input type="hidden" id="DescuentoGeneralCliente" value="0" />
        </div>
        <div class="form-group">
            <label class="control-label">
                Dirección
            </label>
            <input type="text" placeholder="Dirección" class="form-control" id="DireccionCliente" name="DireccionCliente" autocomplete="off" disabled="disabled" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                #Telefono
            </label>
            <input type="text" placeholder="#Telefono" class="form-control" id="TelefonoCliente" name="TelefonoCliente" autocomplete="off" disabled="disabled" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div id="mensajeVIP" style="text-align:center; font-weight:bold; color:red;"></div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Tipo de Nota Credito</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Tipo<span class="symbol required"></span>
            </label>
            @Html.DropDownList("TipoId", (SelectList)ViewBag.Tipos, "--Seleccione un Tipo--", new { @class = "form-control search-select required" })
        </div>
    </div>
</div>
<div id="VisualizarFactura">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Serie
                </label>
                @Html.DropDownList("SerieId", (SelectList)ViewBag.Series, "--Seleccione una Serie--", new { @class = "form-control search-select" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">
                    No. Factura
                </label>
                @Html.TextBoxFor(model => model.NoFactura, new { @class = "form-control", @placeholder = "No. Factura", autocomplete = "off" })
            </div>
        </div>
        <button class="btn btn-primary" style="margin-bottom: -58px;" id="btnBuscar" type="button">
            <i class="clip-search-3"></i> Buscar
        </button>
    </div>
</div>
<div id="DatosFactura">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="icon-edit-sign teal"></i>Factura</h2>
            <hr>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">
                    Cliente
                </label>
                <input type="text" placeholder="Cliente" class="form-control" id="NCliente" name="NCliente" autocomplete="off" disabled="disabled" />
                <input type="hidden" id="FacturaId" name="FacturaId" />
            </div>
            <div class="form-group">
                <label class="control-label">
                    Agencia
                </label>
                <input type="text" placeholder="Agencia" class="form-control" id="NAgencia" name="NAgencia" autocomplete="off" disabled="disabled" />                
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Documento
                </label>
                <input type="text" placeholder="Documento" class="form-control" id="NDocumento" name="NDocumento" autocomplete="off" disabled="disabled" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Total
                </label>
                <div class="input-group">
                    <span class="input-group-addon">Q</span>
                    <input type="text" placeholder="Total" class="form-control" id="NTotal" name="NTotal" autocomplete="off" disabled="disabled" />
                </div>                
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Nota Credito</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Serie Nota Credito<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Serie, new { @class = "form-control", @placeholder = "Serie Nota Credito", required = "required", autocomplete = "off" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                No. Nota Credito<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.NoNotaCredito, new { @class = "form-control", @placeholder = "No. Nota Credito", required = "required", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Descripción</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Descripción
            </label>
            @Html.TextAreaFor(model => model.Nota, new { @class = "form-control", @placeholder = "Descripción", autocomplete = "off" })
        </div>                 
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Monto Nota Credito
</h2>
<hr>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Monto<span class="symbol required"></span>
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                @Html.TextBoxFor(model => model.Monto, new { @class = "form-control", @placeholder = "Monto Nota Credito", required = "required", autocomplete = "off" })
            </div>
        </div>
    </div>
</div>
<div id="ControlPago">
    <h2>
        <i class="icon-edit-sign teal"></i> Forma de Pago
    </h2>
    <hr>
    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                <label class="control-label">
                    Forma
                </label>
                @Html.DropDownList("PagoId", (SelectList)ViewBag.Formas, "--Seleccione una Forma de Pago--", new { @class = "form-control search-select" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">
                    Cantidad
                </label>
                <div class="input-group">
                    <span class="input-group-addon">Q</span>
                    <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad_Pagar" name="Cantidad_Pagar" autocomplete="off" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">
                    Nota
                </label>
                <input type="text" placeholder="Nota" class="form-control" id="NotaP" name="NotaP" autocomplete="off" />
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-forma">Agregar</button></p>
            <table class="table table-hover" id="sample-table-1">
                <thead>
                    <tr>
                        <th>Forma</th>
                        <th>Cantidad</th>
                        <th>Nota</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="forma_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-4">
                <div style="text-align:left; font-size:large; font-weight:bold;">
                    Total:
                </div>
            </div>
            <div class="col-md-8">
                <div id="Total_Pagar" style="text-align: right;font-size:large; font-weight:bold;">
                    Q0.00
                </div>
            </div>
        </div>
    </div>
</div>

