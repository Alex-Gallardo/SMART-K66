@model PagedList.IPagedList<DiamDev.Give.Entities.Paquete>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Paquete Listado";
}


 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">



 <center>  <h1>Pedidos Pendientes Despacho</h1></center>
    <div class="container" id="grande">


    </div>
  

    <!-- Modal -->
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Referencia</h4>
                </div>
                <div class="modal-body">
                    <p id="cuerpote"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>

        </div>
    </div>


@section Scripts
{
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function Ponerla(viene) {

            document.getElementById("cuerpote").innerHTML = viene;

        }
        function Cargar() {

            $.getJSON("/Servicios/Servicios/ObtenerPedidosPendientes?p1=a&p2=a&p3=a", function (result) {
                var total = result.length;
                //alert(total);
                var armado = "";
                $.each(result, function (i, field) {
                    var este = (i + 1) % 4;

                    if (este == 1) {
                        armado = armado + '<div class="card-deck">';
                        armado = armado + '<div class="card bg-warning"><div class="card-body text-center"><h2>' + field.ID + '</h2><h3>' + field.EMPRESA + '</h3><p class="card-text">' + field.NAME + '</p>' + FechaLegible1(field.ORDER_DATE) + '<br/>Vendedor:' + field.e3 + '<br/>Creo:' + field.e2 +'</div> <a type="button" href="/Servicios/BoletaPedido?pedido=' + field.ID + '"  target="_blank" class="btn btn-primary">Imprimir</a><br/><a type="button" href="/Servicios/BoletaPedido?pedido=' + field.ID + '"  target="_blank" class="btn btn-primary">Imprimir Orden Compra</a> <br/> <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#myModal"  onclick="Ponerla(\'referenc\');">Ver Detalle</button><br/></div>';
                    }
                    if (este == 2 || este == 3) {
                        armado = armado + '<div class="card bg-warning"><div class="card-body text-center"><h2>' + field.ID + '</h2><h3>' + field.EMPRESA + '</h3><p class="card-text">' + field.NAME + '</p>' + FechaLegible1(field.ORDER_DATE) + '<br/>Vendedor:' + field.e3 + '<br/>Creo:' + field.e2 + '</div> <a type="button" href="/Servicios/BoletaPedido?pedido=' + field.ID + '"  target="_blank" class="btn btn-primary">Imprimir</a><br/><a type="button" href="/Servicios/BoletaPedido?pedido=' + field.ID + '"  target="_blank" class="btn btn-primary">Imprimir Orden Compra</a> <br/> <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#myModal"  onclick="Ponerla(\'referenc\');">Ver Detalle</button><br/></div>';
                    }

                    if (este == 0) {
                        armado = armado + '<div class="card bg-warning"><div class="card-body text-center"><h2>' + field.ID + '</h2><h3>' + field.EMPRESA + '</h3><p class="card-text">' + field.NAME + '</p>' + FechaLegible1(field.ORDER_DATE) + '<br/>Vendedor:' + field.e3 + '<br/>Creo:' + field.e2 + '</div> <a type="button" href="/Servicios/BoletaPedido?pedido=' + field.ID + '"  target="_blank" class="btn btn-primary">Imprimir</a><br/><a type="button" href="/Servicios/BoletaPedido?pedido=' + field.ID + '"  target="_blank" class="btn btn-primary">Imprimir Orden Compra</a> <br/> <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#myModal"  onclick="Ponerla(\'referenc\');">Ver Detalle</button><br/></div>';
                        armado = armado + '</div> <br/>';
                    }

                    //if (i == (total - 1)&&este!=4) {
                    //    armado = armado + '</div>';
                    //}
                });
                document.getElementById("grande").innerHTML = armado;

            });

            setTimeout(function () {
                Cargar();
            }, 2000);
        }
        Cargar();
        $(function () {


        });
        function FechaLegible1(fechaserver) {
            var fechita = new Date(parseInt(fechaserver.substr(6)));
            return fechita.toLocaleDateString();

        }
    </script>

 }
    