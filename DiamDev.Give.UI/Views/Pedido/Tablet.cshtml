@model DiamDev.Give.Entities.Pedido

@{
    ViewBag.Title = "Nuevo Pedido Tablet";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nuevo Pedido Tablet
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nuevo Pedido Tablet</h2>
                <p>
                    Crea un nuevo pedido tablet.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="AgenciaId" name="AgenciaId" value="@Html.Raw(DiamDev.Give.UI.App_Start.CustomHelper.getAgenciaId())" />
                        <input type="hidden" id="ClienteId" name="ClienteId" value="20170115001" />
                        <input type="hidden" id="DescuentoGeneralCliente" name="DescuentoGeneralCliente" value="0" />
                        <input type="hidden" id="VendedorId" name="VendedorId" value="20180925001" />
                        <input type="hidden" id="FormaPago" name="FormaPago" value="NA" />
                        <input type="hidden" id="TiempoEntrega" name="TiempoEntrega" value="NA" />
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i> Productos
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Barra
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto..." autofocus>
                                    <span class="input-group-btn">
                                        <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="imagen">
                        <div class="row">
                            <div class="col-md-12">
                                <button type="button" class="btn btn-med-grey btn-block ladda-button" data-toggle="modal" data-target="#visualizar-imagen-producto-form" id="btn-visualizar">Visualizar Fotografía</button>
                            </div>
                        </div>
                        <br />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Producto
                                </label>
                                <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" />
                                <input type="hidden" id="ProductoId" name="ProductoId" value="0" />
                            </div>
                            <div class="form-group" hidden>
                                <label class="control-label">
                                    Unidad
                                </label>
                                <select id="PresentacionId" name="PresentacionId" class="form-control search-select">
                                    <option value="0">--SELECCIONE UNA UNIDAD--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad
                                </label>
                                <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Existencia
                                </label>
                                <input type="number" placeholder="Existencia" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon">Q</span>
                                    <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio Negociado
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon">Q</span>
                                    <input type="number" placeholder="Descuento" class="form-control" id="DescuentoActual" name="DescuentoActual" value="0" autocomplete="off" />
                                    <input type="hidden" value="0" id="PrecioVentaMinimo" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
                            <table class="table table-hover" id="sample-table-1">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="hidden-xs hidden-sm">Unidad</th>
                                        <th>Cantidad</th>
                                        <th>Precio</th>
                                        <th>Descuento</th>
                                        <th>Sub-Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="producto_tbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div style="text-align:left; font-size:large; font-weight:bold;">
                                    Total:
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                                    Q0.0000
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="divMostrarEscalaPrecios">
                        <div class="row">
                            <div class="col-md-12">
                                <hr />
                                <div id="divEscalaPrecios"></div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Descripci&oacute;n</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Descripci&oacute;n<span class="symbol required"></span>
                                </label>
                                @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Descripción del Pedido", required = "required", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Tablet", "Pedido")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<div id="new-cliente-form" class="modal fade" tabindex="-1" data-width="760" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Nuevo Cliente</h4>
    </div>
    <div class="modal-body">
        @Html.Partial("~/Views/Cliente/_CreateOrEdit.cshtml", new DiamDev.Give.Entities.Cliente() { Direccion = "CIUDAD", EmailCliente = "sincorreo@cbp.com" })
    </div>
    <div class="modal-footer">
        <button id="btn-save-up-cliente" class="btn btn-primary">Guardar</button>
        <button id="btn-close-up-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

<div id="seleccionar-cliente-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Cliente</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cliente_seleccionado_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>
<div id="visualizar-imagen-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Fotografia</h4>
    </div>
    <div class="modal-body">
        <center>
            <img alt="" id="fotografia" src="@Url.Content("~/Content/assets/images/producto-sin-foto.jpg")" style="height:50%; width:50%" class="img-responsive" />
        </center>       
    </div>
    <div class="modal-footer">       
        <button id="btn-close-up-imagen-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

<div id="seleccionar-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Producto</h4>
    </div>
    <div class="modal-body">      
        <div class="row">
            <table class="table table-hover" id="sample-table-1">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>                        
                        <th></th>
                    </tr>
                </thead>
                <tbody id="producto_seleccionado_tbody">
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="producto_tr_template">
        <tr>
            <td>{{producto}}</td>
            <td class="hidden-xs hidden-sm">{{presentacion}}</td>
            <td>{{cantidad}}</td>
            <td>Q{{precio}}</td>
            <td>Q{{descuento}}</td>
            <td>Q{{sub_total}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="productoIds" value="{{producto_id}}" />
                <input type="hidden" name="nombreProductoIds" value="{{producto}}" />
                <input type="hidden" name="presentacionIds" value="{{presentacion_id}}" />
                <input type="hidden" name="nombrePresentacionIds" value="{{presentacion}}" />
                <input type="hidden" name="existenciaIds" value="{{existencia_id}}" />
                <input type="hidden" name="cantidadIds" value="{{cantidad_id}}" />
                <input type="hidden" name="precioIds" value="{{precio_id}}" />
                <input type="hidden" name="descuentoIds" value="{{descuento_id}}" />
            </td>
        </tr>
    </script>
  
    <script type="text/javascript">

    var vCliente = "";
    var vCodBarra = "";   

    var productoIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.productoIds))');
    var productoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombreProductoIds))');
    var presentacionIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.presentacionIds))');
    var presentacionSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombrePresentacionIds))');
    var existenciaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.existenciaIds))');
    var cantidadSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.cantidadIds))');
    var descuentoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.descuentoIds))');
    var precioSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioIds))');

    var clienteIds = "@Html.Raw(ViewBag.ClienteIds)";

    $(function ()
    {
        $('#Descripcion').val('Sin Comentarios.');

        //Se oculta el boton de visualizar imagen
        $('#imagen').css("display", "none");

        //Se selecciona por default al vendedor: Principal
        $("#VendedorId").val("20180925001");

        //Se selecciona por default al cliente: Consumidor Final
        $("#ClienteId").val("20170115001");

        $("#divMostrarEscalaPrecios").hide();

        $("#BuscarCliente").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("ConsultaCliente", "Cliente")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
        });

        $('#formaprincipal').keypress(function (evt) {
            if ($('#BuscarCliente').is(":focus") && (evt.which || evt.keyCode) == 13) {
                cargaBusquedaCliente(evt)
            }
        });

        $('#btnBuscarCliente').click(function (evt) {
            cargaBusquedaCliente(evt);
        });

        function cargaBusquedaCliente(evt) {
            evt.preventDefault();

            if ($('#BuscarCliente').val() === "") {
                error("Ingresar Nit o Nombre del Cliente");
                $('#BuscarCliente').focus();
                return;
            }

            var clienteActual = $('#BuscarCliente').val();
            clienteActual = clienteActual.replace(" ", "_");

            $.ajax({
                url: '@Url.Action("ObtenerClientexTextoLibre", "Cliente")',
                traditional: true,
                data: { 'search': clienteActual },
                async: false,
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            if (resultData.Data.length === 1) {
                                cargaClienteSeleccionado(resultData.Data[0]);
                            }
                            else if (resultData.Data.length > 1) {
                                var fila = "";
                                for (var i = 0; i < resultData.Data.length; i++) {
                                    fila += "<tr><td>" + resultData.Data[i].ClienteId + "</td>";
                                    fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                    fila += "<td><a href='" + resultData.Data[i].ClienteId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                }

                                $("#seleccionar-cliente-form").modal();
                                $("#seleccionar-cliente-form").find("#cliente_seleccionado_tbody").html(fila);
                            }
                        }
                        else {
                            toastr.error('El cliente ingresado no es correcto');

                            $("#new-cliente-form").modal();
                            $("#new-cliente-form").find("#Nit").val($('#BuscarCliente').val());
                            $("#new-cliente-form").find("#Nombre").focus();
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar al cliente');
                        $('#BuscarCliente').val("");
                        $('#BuscarCliente').focus();
                    }
                }
            });
        }

        $('#cliente_seleccionado_tbody').delegate("a", "click", function (e) {
            e.preventDefault();

            $('#btn-close-up-seleccionar-cliente').click();
            var clienteReferencia = $(this).attr("href");
            var clienteActual = clienteReferencia.split(",");

            var modelo =
             {
                 'ClienteId': clienteActual[0],
                 'Nombre': clienteActual[1]
             };

            cargaClienteSeleccionado(modelo);
        });

        function cargaClienteSeleccionado(cliente) {
            var clienteSeleccionado = obtenerClientexID(cliente.ClienteId);

            $('#NombreCliente').val(clienteSeleccionado.Nombre);
            $("#DireccionCliente").val(clienteSeleccionado.Direccion);
            $("#TelefonoCliente").val(clienteSeleccionado.NoTelefono);
            $("#DescuentoGeneralCliente").val(clienteSeleccionado.DescuentoGeneral);
            $('#ClienteId').val(clienteSeleccionado.ClienteId);

            //Se valida si el cliente es VIP
            if (clienteSeleccionado.Vip == true) {
                $("#mensajeVIP").html("PAPELERIA COMPLETA");
            }
            else {
                $("#mensajeVIP").html("PAPELERIA NO COMPLETA");
            }

            vCliente = $('#BuscarCliente').val();
            
            $('#FormaPago').focus();
        }

        function obtenerClientexID(id) {
            var cliente = null;
            $.ajax({
                url: '@Url.Action("ObtenerPorID", "Cliente")?id=' + id,
                async: false,
                type: 'GET',
                success: function (data) {

                    if (!data.Operacion) {
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                        return;
                    }

                    cliente = data.Data;

                },
                fail: function (data) {
                    console.error(data);
                    toastr.error('Ocurrió un error, al obtener datos del cliente');
                }
            });

            return cliente;
        }

        function error(texto) {
            toastr.error(texto);
        }

        function cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, precio_id, descuento_id)
        {
            var plantilla = $('#producto_tr_template').html();

            var descId = parseFloat(descuento_id);
            var precioDescuento = precio_id - descId;

            var modelo =
            {
                producto_id: producto_id,
                producto: producto,
                presentacion_id: presentacion_id,
                presentacion: presentacion,
                existencia_id: existencia_id,
                cantidad_id: cantidad_id,
                cantidad: cantidad_id,
                precio_id: precio_id.toFixed(2),
                precio: precio_id.toFixed(2),
                descuento: descId.toFixed(2),
                descuento_id: descId.toFixed(2),
                sub_total: (precioDescuento * cantidad_id).toFixed(2)
            };

            var filaHtml = Mustache.render(plantilla, modelo);

            // agregamos la nueva fila a la tabla.
            $('#producto_tbody').append(filaHtml);
        }

        renderizarProductosIniciales();

        $('#btn-agregar').click(function (e) {
            e.preventDefault();

            var producto_id = $('#ProductoId').val();
            var producto = $('#Producto').val();

            if (producto_id === "" || producto === "") {
                error("Seleccione un producto");
                return;
            }

            var presentacion_id = $('#PresentacionId').val();
            var presentacion = $('#PresentacionId option:selected').text();

            if (presentacion_id === "" || presentacion === "") {
                error("Seleccione una presentacion");
                return;
            }

            var cantidad_id = $('#Cantidad').val();

            if (cantidad_id === "") {
                error("Ingrese la cantidad del producto");
                return;
            }

            var precio_id = $('#PrecioActual').val();
            precio_id = parseFloat(precio_id);

            if (precio_id === 0) {
                error("Ingrese el precio del producto");
                return;
            }

            var existencia_id = parseFloat($('#Existencia').val());
            cantidad_id = parseFloat(cantidad_id);
          
            var precioVentaFinal_id = $("#DescuentoActual").val();
            precioVentaFinal_id = parseFloat(precioVentaFinal_id);

            if (precioVentaFinal_id > 0)
            {
                var minimoPrecioVenta = $("#PrecioVentaMinimo").val();
                minimoPrecioVenta = parseFloat(minimoPrecioVenta);

                if (precioVentaFinal_id >= minimoPrecioVenta)
                { }
                else
                {
                    error("El precio de venta del producto no puede ser menor a Q." + minimoPrecioVenta.toFixed(2));
                    return;
                }
            }

            var precioVentaTotalDescuento = 0;
            if (precioVentaFinal_id > 0)
            {
                precioVentaTotalDescuento = precio_id - precioVentaFinal_id
            }

            precioVentaTotalDescuento = parseFloat(precioVentaTotalDescuento);

            cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, precio_id, precioVentaTotalDescuento);
            totalizarProducto();

            //Se oculta el boton de visualizar imagen
            $('#imagen').css("display", "none");

            //Se asigna la imagen por default
            $("#visualizar-imagen-producto-form").find("#fotografia").attr("src", "@Url.Content("~/Content/assets/images/producto-sin-foto.jpg")");

            $("#divEscalaPrecios").html("");
            $("#divMostrarEscalaPrecios").hide();

            $("#ProductoId").val(0);
            $("#Cantidad").val(1);
            $("#Existencia").val(0);
            $("#PrecioActual").val(0);
            $("#PrecioVentaMinimo").val(0);
            $("#DescuentoActual").val(0);
            $("#Producto").val("");
            $("#Barra").val("");
            $("#Descuento").val("0");
            $("#Barra").focus();
        });

        $('#producto_tbody').delegate("a", "click", function (e) {
            e.preventDefault();
            $(this).parent().parent().remove();

            totalizarProducto();
        });

        function renderizarProductosIniciales() {
            if (productoIdSeleccionados == null) {
                return;
            }

            // recorremos los productos que haya ingresado el usuario
            for (var i = 0; i < productoIdSeleccionados.length; i++) {
                var producto_id = productoIdSeleccionados[i];
                var producto = productoSeleccionados[i];

                var presentacion_id = presentacionIdSeleccionados[i];
                var presentacion = presentacionSeleccionados[i];

                var existencia_id = existenciaSeleccionados[i];
                var cantidad_id = cantidadSeleccionados[i];
                var descuento_id = descuentoSeleccionados[i];
                var precio_id = precioSeleccionados[i];

                cargaProducto(producto_id, producto, presentacion_id, presentacion, existencia_id, cantidad_id, precio_id, descuento_id);
            }

            totalizarProducto();
        }

        function totalizarProducto() {
            var cantidadArray = new Array();
            $('input[name=cantidadIds]').each(function () {
                cantidadArray.push(parseFloat($(this).val()));
            });

            var precioArray = new Array();
            $('input[name=precioIds]').each(function () {
                precioArray.push(parseFloat($(this).val()));
            });

            var descuentoArray = new Array();
            $('input[name=descuentoIds]').each(function () {
                descuentoArray.push(parseFloat($(this).val(), 10));
            });

            var total = 0;

            if (cantidadArray.length > 0 && precioArray.length > 0)
            {
                for (var i = 0; i < cantidadArray.length; i++)
                {
                    var p = precioArray[i];
                    var d = descuentoArray[i];

                    var precioDescuento = p - d;
                    total += cantidadArray[i] * precioDescuento;
                }

                $('#Total').html('Q' + total.toFixed(4));
            }
            else {
                $('#Total').html('Q' + total.toFixed(4));
            }
        }

        $("#new-cliente-form").find("#Nit").change(function () {
            var nit = $(this).val();
            var cliente = obtenerCliente(nit);
            if (!cliente) return;

            var vipChk = cliente.Vip ? "Si" : "No";
            var activoChk = cliente.Activo ? "Si" : "No";

            var frm = $("#new-cliente-form");

            frm.find("#Nombre").val(cliente.Nombre);
            frm.find("#Direccion").val(cliente.Direccion);
            frm.find("#DPI").val(cliente.DPI);
            frm.find("#NoTelefono").val(cliente.NoTelefono);
            frm.find("#EmailCliente").val(cliente.EmailCliente);
            frm.find('#vip' + vipChk).iCheck('check');
            frm.find('#activo' + activoChk).iCheck('check');
        });

        function obtenerCliente(nit) {
            nit = (nit || '').trim();
            if (!nit) return;
            var cliente = null;
            $.ajax({
                url: '@Url.Action("ObtenerPorNit", "Cliente")?nit=' + encodeURI(nit),
                async: false,
                type: 'GET',
                success: function (data) {

                    if (!data.Operacion) {
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                        return;
                    }

                    cliente = data.Data;

                },
                fail: function (data) {
                    console.error(data);
                    toastr.error('Ocurrió un error, al obtener datos del cliente');
                }
            });

            return cliente;
        }

        $("#btn-save-up-cliente").click(function () {
            var Nit = $("#new-cliente-form").find("#Nit").val();
            var Nombre = $("#new-cliente-form").find("#Nombre").val();
            var Direccion = $("#new-cliente-form").find("#Direccion").val();
            var DPI = $("#new-cliente-form").find("#DPI").val();
            var NoTelefono = $("#new-cliente-form").find("#NoTelefono").val();
            var EmailCliente = $("#new-cliente-form").find("#EmailCliente").val();
            var Vip = false;
            var Activo = true;

            if (Nit === "") {
                error("El nit es requerido");
                return;
            }

            if (Nombre === "") {
                error("El nombre es requerido");
                return;
            }

            if (Direccion === "") {
                error("La dirección es requerida");
                return;
            }

            if (EmailCliente === "") {
                error("El correo electrónico es requerido");
                return;
            }

            //Se verifica que no exista NIT
            var existeNit = 0;

            $.ajax({
                url: '@Url.Action("ExisteNIT", "Cliente")?nit=' + encodeURI(Nit),
                async: false,
                type: 'POST',
                success: function (data)
                {
                    if (data.Operacion)
                    {
                        existeNit = 1;
                    }
                }
            });

            if (existeNit === 1)
            {
                toastr.error('Se le informa que el nit que esta ingresado ya se encuentra registrado en el sistema');
                return;
            }

            var modelo =
           {
               'Nit': Nit,
               'Nombre': Nombre,
               'Direccion': Direccion,
               'DPI': DPI,
               'NoTelefono': NoTelefono,
               'EmailCliente': EmailCliente,
               'Descuento': 0,
               'Vip': Vip,
               'Activo': Activo
           };

            $.ajax({
                url: '@Url.Action("NuevoCliente", "Cliente")',
                data: { 'modelo': modelo },
                async: false,
                type: 'POST',
                success: function (data) {
                    if (data.Operacion) {
                        $('#btn-close-up-cliente').click();
                        toastr.success('El nuevo cliente se guardó exitosamente');


                        var modelo =
                         {
                             'ClienteId': data.Cliente
                         };

                        cargaClienteSeleccionado(modelo);
                    }
                    else {
                        toastr.error('Ocurrió un error, al guardar al nuevo cliente');
                    }
                }
            });

        });

        $('#PresentacionId').change(function (evt) {
            if ($('#ProductoId').val() === "") {
                error("Seleccionar un producto");
                return;
            }

            if ($('#PresentacionId').val() === "") {
                error("Seleccionar una presentacion");
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerProducto", "Producto")',
                traditional: true,
                async: false,
                data: { 'agenciaId': $('#AgenciaId').val(), 'productoId': $('#ProductoId').val(), 'presentacionId': $('#PresentacionId').val(), 'empleado': false },
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion)
                        {
                            $('#Existencia').val(resultData.Data.Existencia);

                            var descuentoGeneralCliente = 0;
                            var descuentoClienteActual = 0;
                            var precioActualCliente = resultData.Data.PrecioActual;
                            var precioFinalCliente = resultData.Data.PrecioActual;

                            if ($("#DescuentoGeneralCliente").val() !== "") {
                                descuentoGeneralCliente = parseInt($("#DescuentoGeneralCliente").val());
                                if (descuentoGeneralCliente !== 0) {
                                    descuentoClienteActual = descuentoGeneralCliente / 100;
                                    precioFinalCliente = precioActualCliente - (precioActualCliente * descuentoClienteActual);
                                }
                            }

                            $('#PrecioActual').val(parseFloat(precioFinalCliente).toFixed(4));
                            $("#PrecioVentaMinimo").val(resultData.Data.PrecioCostoDescuento);

                            $("#divEscalaPrecios").load('@Url.Action("GetEscalaPreciosxProducto", "Pedido")?id=' + $('#ProductoId').val());
                            $("#divMostrarEscalaPrecios").show();

                            $('#Cantidad').focus();

                            if (parseFloat(resultData.Data.Existencia) === 0) {

                                document.getElementById('Existencia').style.backgroundColor = "#F78181";
                            }
                            else {
                                document.getElementById('Existencia').removeAttribute("style");
                            }
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                    }
                }
            });
        });

        $('#new-cliente-form').keydown(function (evt) {
            if ($('#Nit').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#Nombre').focus();
            }
            else if ($('#Nombre').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#Direccion').focus();
            }
            else if ($('#Direccion').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#DPI').focus();
            }
            else if ($('#DPI').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#NoTelefono').focus();
            }
            else if ($('#NoTelefono').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#EmailCliente').focus();
            }
            else if ($('#EmailCliente').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $("#new-cliente-form").find("#btn-save-up-cliente").focus();
            }
        });

        $("#Barra").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("ConsultaProductoAutocomplementar", "Producto")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
        });

        $('#formaprincipal').keydown(function (evt) {
            if ($('#Barra').is(":focus") && (evt.which || evt.keyCode) == 13) {
                cargaBusquedaProducto(evt)
            }            
        });

        $('#formaprincipal').keydown(function (evt) {
            if ($('#Cantidad').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                //cargaBusquedaProducto(evt)
                evt.preventDefault();
                if ($('#Cantidad').val() === "")
                {
                    error("Ingresar cantidad del producto");
                    $('#Cantidad').focus();
                    return;
                }

                $('#DescuentoActual').focus();
            }
            else if ($('#DescuentoActual').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                if ($('#DescuentoActual').val() === "") {
                    error("Ingresar descuento del producto");
                    $('#DescuentoActual').focus();
                    return;
                }

                $('#btn-agregar').focus();
            }
        });

        /*
        Evento click para el boton de busqueda de productos */
        $('#btnBarra').click(function (evt) {
            cargaBusquedaProducto(evt);
        });

        /*
     Evento click para el boton de visualizar imagen de productos */
        $('#btn-visualizar').click(function (evt) {
            if ($('#ProductoId').val() === "") {

                error("Ingresar codigo de barra");
                $('#Barra').focus();

                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerFotografiaProducto", "Producto")',
                traditional: true,
                data: { 'productoId': $('#ProductoId').val() },
                async: false,
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            $("#visualizar-imagen-producto-form").find("#fotografia").attr("src", resultData.Data);
                        }
                    }
                }
            });

        });

        $('#producto_seleccionado_tbody').delegate("a", "click", function (e) {
            e.preventDefault();

            $('#btn-close-up-seleccionar-producto').click();
            var productoReferencia = $(this).attr("href");
            var productoActual = productoReferencia.split(",");

            var modelo =
             {
                 'ProductoId': productoActual[0],
                 'Nombre': productoActual[1]
             };

            cargaProductoSeleccionado(modelo);
        });

        /*
        Función para la busqueda de productos */
        function cargaBusquedaProducto(evt) {
            evt.preventDefault();

            if ($('#Barra').val() === "") {
                error("Ingresar codigo de barra");
                $('#Barra').focus();
                return;
            }

            if (vCodBarra === $('#Barra').val()) {
                vAumentaCantidad = parseInt($('#Cantidad').val()) + 1;
                $('#Cantidad').val(vAumentaCantidad);
            }
            else {
                $('#Cantidad').val(1);
            }

            var barraActual = $('#Barra').val();
            barraActual = barraActual.replace(" ", "_");

            $.ajax({
                url: '@Url.Action("ObtenerProductoxTextoLibre", "Producto")',
                traditional: true,
                data: { 'search': barraActual },
                async: false,
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            if (resultData.Data.length === 1) {
                                cargaProductoSeleccionado(resultData.Data[0]);
                            }
                            else if (resultData.Data.length > 1) {
                                var fila = "";
                                for (var i = 0; i < resultData.Data.length; i++) {
                                    fila += "<tr><td>" + resultData.Data[i].ProductoId + "</td>";
                                    fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                    fila += "<td><a href='" + resultData.Data[i].ProductoId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                }

                                $("#seleccionar-producto-form").modal();
                                $("#seleccionar-producto-form").find("#producto_seleccionado_tbody").html(fila);
                            }
                        }
                        else {
                            toastr.error('La barra del producto ingresada no es correcta');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                        $('#Barra').val("");
                        $('#Barra').focus();
                    }
                }
            });
        }

        function cargaBusquedaProductoNuevoPrecio(evt) {
            evt.preventDefault();

            if ($('#ProductoId').val() === "") {
                error("Seleccionar un producto");
                return;
            }

            if ($('#PresentacionId').val() === "") {
                error("Seleccionar una presentacion");
                return;
            }

            if ($('#Cantidad').val() === "") {
                error("Ingrese una cantidad valida");
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerProductoxEscalaPrecio", "Producto")',               
                traditional: true,
                async: false,
                data: { 'agenciaId': $('#AgenciaId').val(), 'productoId': $('#ProductoId').val(), 'presentacionId': $('#PresentacionId').val(), 'cantidad': $('#Cantidad').val(), 'empleado': false },               
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            var descuentoGeneralCliente = 0;
                            var descuentoClienteActual = 0;
                            var precioActualCliente = resultData.Data.PrecioActual;
                            var precioFinalCliente = resultData.Data.PrecioActual;

                            if ($("#DescuentoGeneralCliente").val() !== "") {
                                descuentoGeneralCliente = parseInt($("#DescuentoGeneralCliente").val());
                                if (descuentoGeneralCliente !== 0) {
                                    descuentoClienteActual = descuentoGeneralCliente / 100;
                                    precioFinalCliente = precioActualCliente - (precioActualCliente * descuentoClienteActual);
                                }
                            }

                            $('#PrecioActual').val(parseFloat(precioFinalCliente).toFixed(4));
                            $("#PrecioVentaMinimo").val(resultData.Data.PrecioCostoDescuento);

                            $('#DescuentoActual').focus();
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                    }
                }
            });
        }

        function cargaProductoSeleccionado(producto) {
            //Se activa el boton de visualizar fotografia
            $('#imagen').css("display", "block");

            $('#Producto').val(producto.Nombre);
            $('#ProductoId').val(producto.ProductoId);

            var PresentacionSelect = $("#PresentacionId");
            PresentacionSelect.empty();
            PresentacionSelect.append('<option value="0">--Seleccione una Unidad--</option>');

            $.ajax({
                url: '@Url.Action("ObtenerPresentacionPorProducto", "Producto_Ingreso")',
                data: { 'id': $('#ProductoId').val() },
                traditional: true,
                async: false,
                type: 'GET',
                success: function (data) {
                    var unidadActual = 0;
                    $.each(data, function (j) {
                        unidadActual = data[j]['Value'];
                        PresentacionSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                    });

                    //Se selecciona por default a la unidad de medida
                    $("#PresentacionId").val(unidadActual).trigger("change");
                }
            });

            $('#Barra').focus();
            vCodBarra = $('#Barra').val();
        }
    });

    </script>
}

