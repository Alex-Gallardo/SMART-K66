@model DiamDev.Give.Entities.Pedido

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="BuscarCliente" name="BuscarCliente" autocomplete="off" placeholder="Buscar Cliente...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBuscarCliente">Buscar</button>
                    <a href="#new-cliente-form" data-toggle="modal" class="demo btn btn-blue" style="margin-bottom: -1px;">
                        <i class="clip-plus-circle"></i>
                    </a>
                </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente<span class="symbol required"></span>
            </label>
            <input type="text" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" autocomplete="off" disabled="disabled" required />
            <input type="hidden" id="ClienteId" name="ClienteId" value="0" />
            <input type="hidden" id="DescuentoGeneralCliente" value="0" />
        </div>
        <div class="form-group">
            <label class="control-label">
                Dirección
            </label>
            <input type="text" placeholder="Dirección" class="form-control" id="DireccionCliente" name="DireccionCliente" autocomplete="off" disabled="disabled" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                #Telefono
            </label>
            <input type="text" placeholder="#Telefono" class="form-control" id="TelefonoCliente" name="TelefonoCliente" autocomplete="off" disabled="disabled" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div id="mensajeVIP" style="text-align:center; font-weight:bold; color:red;"></div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Vendedor<span class="symbol required"></span>
            </label>
            @Html.DropDownList("VendedorId", (SelectList)ViewBag.Vendedores, "--SELECCIONE UN VENDEDOR--", new { @class = "form-control search-select required" })
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Forma de Pago<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.FormaPago, new { @class = "form-control", @placeholder = "Forma de Pago", required = "required", autocomplete = "off" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Tiempo de Entrega<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.TiempoEntrega, new { @class = "form-control", @placeholder = "Tiempo de Entrega", required = "required", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Fotografia</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="fileupload fileupload-new" data-provides="fileupload">
            <div class="input-group">
                <div class="form-control uneditable-input">
                    <i class="icon-file fileupload-exists"></i>
                    <span class="fileupload-preview"></span>
                </div>
                <div class="input-group-btn">
                    <div class="btn btn-light-grey btn-file">
                        <span class="fileupload-new"><i class="icon-folder-open-alt"></i>Seleccionar Fotografia</span>
                        <span class="fileupload-exists"><i class="icon-folder-open-alt"></i>Cambiar</span>
                        <input type="file" class="file-input" id="fotografiaApp" name="fotografiaApp">
                    </div>
                    <a href="#" class="btn btn-light-grey fileupload-exists" data-dismiss="fileupload">
                        <i class="icon-remove"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<hr />
<h2>
    <i class="icon-edit-sign teal"></i> Productos
</h2>
<hr>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Barra
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                </span>
            </div>
        </div>
    </div>
</div>
<div id="imagen">
    <div class="row">
        <div class="col-md-12">
            <button type="button" class="btn btn-med-grey btn-block ladda-button" data-toggle="modal" data-target="#visualizar-imagen-producto-form" id="btn-visualizar">Visualizar Fotografía</button>
        </div>
    </div>
    <br />
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Producto
            </label>
            <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" />
            <input type="hidden" id="ProductoId" name="ProductoId" value="0" />
        </div>
        <div class="form-group" hidden>
            <label class="control-label">
                Unidad
            </label>
            <select id="PresentacionId" name="PresentacionId" class="form-control search-select">
                <option value="0">--SELECCIONE UNA UNIDAD--</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Existencia
            </label>
            <input type="number" placeholder="Existencia" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Precio
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" disabled="disabled" />
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Precio Negociado
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="number" placeholder="Descuento" class="form-control" id="DescuentoActual" name="DescuentoActual" value="0" autocomplete="off" />
                <input type="hidden" value="0" id="PrecioVentaMinimo" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="hidden-xs hidden-sm">Unidad</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Descuento</th>
                    <th>Sub-Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="producto_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.0000
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Descripci&oacute;n</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Descripci&oacute;n<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Descripción del Pedido", required = "required", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Tipo
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="true" @ViewBag.cotizacionSi name="cotizacion" id="cotizacionSi">
                    Cotizacion
                </label>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="false" @ViewBag.cotizacionNo name="cotizacion" id="cotizacionNo">
                    Pedido
                </label>
            </div>
        </div>
    </div>
</div>