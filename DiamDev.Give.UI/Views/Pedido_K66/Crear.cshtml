        function cargaTipoPedidoxEmpresa(id)
        {
            var TipoPedidoSelect = $("#TipoPedidoId");
            TipoPedidoSelect.empty();
            TipoPedidoSelect.append('<option value="">--Seleccione un Tipo de Pedido--</option>');

            $.ajax({
                url: '@Url.Action("ObtenerTipoPedidoxEmpresa", "Pedido_K66")',
                data: { 'id': id },
                traditional: true,
                async: false,
                type: 'GET',
                success: function (data)
                {

                    $.each(data, function (j)
                    {
                        TipoPedidoSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                    });
                }
            });

            if (tipoPedidoIds !== "0")
            {
