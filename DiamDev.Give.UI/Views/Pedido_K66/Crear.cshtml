        /*
        Función para la busqueda de productos */
        function cargaBusquedaProducto(evt)
        {
            evt.preventDefault();

            if ($('#Barra').val() === "")
            {
               // error("Ingresar codigo de barra");
                $('#Barra').focus();
                return;
            }

            if (vCodBarra === $('#Barra').val())
            {
                vAumentaCantidad = parseInt($('#Cantidad').val()) + 1;
                $('#Cantidad').val(vAumentaCantidad);
            }
            else
            {
                $('#Cantidad').val(1);
            }

            var barraActual = $('#Barra').val();

            $.ajax({
                url: '@Url.Action("ObtenerProductoxTextoLibreK66", "Producto")',
                traditional: true,
                data: { 'search': barraActual, 'clienteId': $("#IDK66").val(), 'empresaId': $("#EmpresaId").val() },
                async: false,
                type: 'GET',
                success: function (resultData)
                {
                    if (resultData !== null)
                    {
                        if (resultData.Operacion)
                        {
                            if (resultData.Data.length === 1)
                            {
                                cargaProductoSeleccionado(resultData.Data[0]);
                            }
                            else if (resultData.Data.length > 1)
                            {
                                var fila = "";
                                for (var i = 0; i < resultData.Data.length; i++)
                                {
                                    fila += "<tr><td>" + resultData.Data[i].ID + "</td>";
                                    fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                    fila += "<td><a href='" + resultData.Data[i].ID + "," + resultData.Data[i].Unidad + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                }

                                $("#seleccionar-producto-form").modal();
                                $("#seleccionar-producto-form").find("#producto_seleccionado_tbody").html(fila);
                            }
                        }
                        else
                        {
                            toastr.error('La barra del producto ingresada no es correcta');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                        $('#Barra').val("");
                        $('#Barra').focus();
                    }
                }
            });
        }

        function cargaPrecioxCantidad(evt)
        {
            evt.preventDefault();

            if ($('#Cantidad').val() === "")
            {
                error("Ingresar cantidad de producto");
                $('#Cantidad').focus();
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerPrecioxCantidad", "Producto")',
                data: { 'id': $('#ProductoId').val(), 'clienteId': $("#IDK66").val(), 'cantidad': $("#Cantidad").val(), 'empresaId': $("#EmpresaId").val() },
                async: false,
                type: 'GET',
                success: function (data)
                {
                    if (!data.Operacion)
                    {
                        toastr.error('Ocurrió un error, al obtener el precio del producto');
                        return;
                    }

                    if (data.Data.Precio > 0)
                    {
                        $("#PrecioActual").val(data.Data.Precio);
                    }
                },
                fail: function (data)
                {
                    toastr.error('Ocurrió un error, al obtener el precio del producto');
                }
            });
        }

