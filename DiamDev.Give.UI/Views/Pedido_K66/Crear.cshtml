        function obtenerProductoxID(id, unidad)
        {
            var producto = null;

            $.ajax({
                url: '@Url.Action("ObtenerPorIDK66", "Producto")',
                data: { 'id': id, 'unidad': unidad, 'clienteId': $("#IDK66").val(), 'direccionId': $("#DireccionId").val(), 'empresaId': $("#EmpresaId").val(), 'cantidad': $("#Cantidad").val() },
                async: false,
                type: 'GET',
                success: function (data)
                {
                    if (!data.Operacion)
                    {
                        toastr.error('Ocurrió un error, al obtener datos del producto');
                        return;
                    }

                    producto = data.Data;
                },
                fail: function (data)
                {
                    toastr.error('Ocurrió un error, al obtener datos del producto');
                }
            });

            return producto;
        }

