@model DiamDev.Give.Entities.PedidoK66

@{
    ViewBag.Title = "Detalle del Pedido K66";
}

<div class="row">
    <div class="col-md-12">        
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Pedido
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">              
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="PedidoId" name="PedidoId" value="@Html.Raw(Model.PedidoId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    #Pedido
                                </label>
                                <br />
                                <strong>
                                    @Model.PedidoId
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Empresa
                                </label>
                                <br />
                                <strong>
                                    @(Model.Empresa == null ? "No Disponible" : Model.Empresa.Nombre)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Cliente
                                </label>
                                <br />
                                <strong>
                                    @Model.Nombre
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Direccion
                                </label>
                                <br />
                                <strong>
                                    @Model.Direccion
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Tipo de Pedido
                                </label>
                                <br />
                                <strong>
                                    No Disponible
                                    @*@(Model.TipoPedido == null ? "No Disponible" : Model.TipoPedido.Nombre)*@
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Prometida
                                </label>
                                <br />
                                <strong>
                                    @Model.FechaPrometida.Value.ToString("dd/MM/yyyy")
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Observaciones Generales
                                </label>
                                <br />
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.ObservacionesGenerales) ? "No contiene observaciones generales" : Model.ObservacionesGenerales)
                                </strong>
                            </div>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Archivos Importantes
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Archivo</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.DImportantes != null && Model.DImportantes.Count() > 0)
                                        {
                                            foreach (var Detalle in Model.DImportantes)
                                            {
                                                <tr>
                                                    <td>
                                                        @Detalle.Nombre
                                                    </td>
                                                    <td>
                                                        <a href="@Detalle.FotografiaApp" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Archivo"><i class="clip-eye-2"></i></a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="2">
                                                    <strong>No contiene archivos importantes</strong>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>                           
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Productos
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Tipo</th>
                                            <th>Producto</th>
                                            <th>Unidad</th>
                                            <th>Cantidad</th>
                                            <th>Precio Normal</th>
                                            <th>Precio Negociado</th>
                                            <th>Sub-Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Detalles != null && Model.Detalles.Count() > 0)
                                        {
                                            foreach (var Detalle in Model.Detalles)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">CAMBIO DE PRECIO</span>
                                                        }
                                                        else
                                                        {
                                                            <span>PRECIO NORMAL</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">@Detalle.Nombre</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@Detalle.Nombre</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">@Detalle.Unidad</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@Detalle.Unidad</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">@Detalle.Cantidad</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@Detalle.Cantidad</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">@Detalle.PrecioOriginal.ToString("C")</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@Detalle.PrecioOriginal.ToString("C")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">@Detalle.Precio.ToString("C")</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@Detalle.Precio.ToString("C")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (Detalle.PrecioCambiado)
                                                        {
                                                            <span style="color:#ff0000;">@((Detalle.Cantidad * Detalle.Precio).ToString("C"))</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@((Detalle.Cantidad * Detalle.Precio).ToString("C"))</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            <tr>
                                                <td>
                                                    <div style="text-align:left; font-size:large; font-weight:bold;">
                                                        Total:
                                                    </div>
                                                </td>
                                                <td colspan="7">
                                                    <div style="text-align: right;font-size:large; font-weight:bold;">
                                                        @string.Format("{0:C4}", Model.Detalles.Sum(x => x.Cantidad * x.Precio))
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6">
                                                    <strong>No contiene productos</strong>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>                                
                         </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-12">
                                <a class="btn btn-med-grey btn-block" href="javascript:window.history.back();">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>       
    </div>
</div>