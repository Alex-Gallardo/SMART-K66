                $("#Unidad").val($('#UnidadId option:selected').text());

                $.ajax({
                    url: '@Url.Action("ObtenerUnidadxId", "Unidad")',
                    data: { 'id': $("#UnidadId").val(), 'empresaId': $("#EmpresaId").val() },
                    async: false,
                    type: 'GET',
                    success: function (data) {
                        if (!data.Operacion) {
                            toastr.error('Ocurrió un error, al obtener datos del conversion');
                            return;
                        }

                        let conversion = data.Data;
                        if (conversion != null) {
                            if ($("#UnidadOriginal").val() === conversion.FROM_UM) {
                                $('#InventarioTotal').val(($('#InventarioTotalOriginal').val() * conversion.CONVERSION_FACTOR).toFixed(2));
                                $('#InventarioComprometido').val(($('#InventarioComprometidoOriginal').val() * conversion.CONVERSION_FACTOR).toFixed(2));
                                $('#Existencia').val(($('#InventarioDisponibleOriginal').val() * conversion.CONVERSION_FACTOR).toFixed(2));

                                $('#PrecioActual').val(($('#PrecioOriginal').val() / conversion.CONVERSION_FACTOR).toFixed(2));
                            }
                            else if ($("#UnidadOriginal").val() === conversion.TO_UM) {
                                $('#InventarioTotal').val(($('#InventarioTotalOriginal').val() / conversion.CONVERSION_FACTOR).toFixed(2));
                                $('#InventarioComprometido').val(($('#InventarioComprometidoOriginal').val() / conversion.CONVERSION_FACTOR).toFixed(2));
                                $('#Existencia').val(($('#InventarioDisponibleOriginal').val() / conversion.CONVERSION_FACTOR).toFixed(2));

                                $('#PrecioActual').val(($('#PrecioOriginal').val() * conversion.CONVERSION_FACTOR).toFixed(2));
                            }
                        }
                    },
                    fail: function (data) {
                        toastr.error('Ocurrió un error, al obtener datos del conversion');
                    }
                });
            }
            else
            {
                $('#InventarioTotal').val($('#InventarioTotalOriginal').val());
                $('#InventarioComprometido').val($('#InventarioComprometidoOriginal').val());
                $('#Existencia').val($('#InventarioDisponibleOriginal').val());

