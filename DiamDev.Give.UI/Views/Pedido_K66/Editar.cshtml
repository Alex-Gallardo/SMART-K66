@model DiamDev.Give.Entities.PedidoK66

@{
    ViewBag.Title = "Editar Pedido K66";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Editar Pedido K66
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nuevo Pedido K66</h2>
                <p>
                    Crea un nuevo pedido k66.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                            <input type="hidden" id="PedidoId" name="PedidoId" value="@Model.PedidoId" />
                            <input type="hidden" id="EmpresaId" name="EmpresaId" value="@Model.EmpresaId" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Empresas</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Empresa<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("EmpresaId", (SelectList)ViewBag.Empresas, "--Seleccione una Empresa--", new { @class = "form-control search-select required", @disabled = "disabled" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Generales de Pedido</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Tipo de Pedido<span class="symbol required"></span>
                                </label>
                                <select id="TipoPedidoId" name="TipoPedidoId" class="form-control search-select required">
                                    <option value="">--Seleccione un Tipo de Pedido--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Entrega Estimada<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaPrometida" name="FechaPrometida" autocomplete="off" value="@(Model == null ? DateTime.Today.ToString("yyyy-MM-dd") : (Model.FechaPrometida == null ? "" : Model.FechaPrometida.Value.ToString("yyyy-MM-dd")))">
                                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Orden de Compra del Cliente
                                </label>
                                @Html.TextBoxFor(model => model.OrdenCompraCliente, new { @class = "form-control", @placeholder = "Orden de Compra del Cliente", autocomplete = "off" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Observaciones Generales
                                </label>
                                @Html.TextAreaFor(model => model.ObservacionesGenerales, new { @class = "form-control", @placeholder = "Observaciones Generales", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Documento de Respaldo de la Orden de Compra</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="fileupload fileupload-new" data-provides="fileupload">
                                <div class="input-group">
                                    <div class="form-control uneditable-input">
                                        <i class="icon-file fileupload-exists"></i>
                                        <span class="fileupload-preview"></span>
                                    </div>
                                    <div class="input-group-btn">
                                        <div class="btn btn-light-grey btn-file">
                                            <span class="fileupload-new"><i class="icon-folder-open-alt"></i>Seleccionar Documento</span>
                                            <span class="fileupload-exists"><i class="icon-folder-open-alt"></i>Cambiar</span>
                                            <input type="file" class="file-input" id="documentoApp" name="documentoApp">
                                        </div>
                                        <a href="#" class="btn btn-light-grey fileupload-exists" data-dismiss="fileupload">
                                            <i class="icon-remove"></i> Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Cliente<span class="symbol required"></span>
                                </label>
                                <input type="text" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" autocomplete="off" disabled="disabled" value="@Model.Nombre" required />
                                <input type="hidden" id="IDK66" name="IDK66" value="@Model.IDK66" />
                                <input type="hidden" id="Nit" name="Nit" value="@Model.Nit" />
                                <input type="hidden" id="Nombre" name="Nombre" value="@Model.Nombre" />
                                <input type="hidden" id="Direccion" name="Direccion" value="@Model.Direccion" />
                                <input type="hidden" id="DiasCobroSemana" name="DiasCobroSemana" value="" />
                                <input type="hidden" id="DiasCobroFinSemana" name="DiasCobroFinSemana" value="" />
                                <input type="hidden" id="E1" name="E1" value="" />
                                <input type="hidden" id="E2" name="E2" value="" />
                                <input type="hidden" id="E3" name="E3" value="" />
                                <input type="hidden" id="E4" name="E4" value="" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Direccion<span class="symbol required"></span>
                                </label>
                                <select id="DireccionId" name="DireccionId" class="form-control search-select" disabled>
                                    <option value="">--Seleccione una Direccion--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div id="divCredito">ESTADO DEL CREDITO</div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Estado Crediticio
                                </label>
                                <input type="text" class="form-control" id="EstadoCredito" name="EstadoCredito" value="" readonly />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Limite de Credito
                                </label>
                                <input type="text" class="form-control" id="LimiteCredito" name="LimiteCredito" value="0" readonly />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Saldo Actual
                                </label>
                                <input type="text" class="form-control" id="SaldoActual" name="SaldoActual" value="0" readonly />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Disponible
                                </label>
                                <input type="text" class="form-control" id="CreditoDisponible" name="CreditoDisponible" value="0" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Pedidos Pendientes de Despacho
                                </label>
                                <input type="text" class="form-control" id="TotalPedidoPendientes" name="TotalPedidoPendientes" value="" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    LE Pendientes de Facturacion
                                </label>
                                <input type="text" class="form-control" id="TotalListaEmpaque" name="TotalListaEmpaque" value="0" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Productos</h2>
                            <hr>
                        </div>
                    </div>
                    <div id="divMostrarExistencia">
                        <div class="row">
                            <div class="col-md-12">
                                <button data-style="slide-down" class="btn btn-primary btn-block ladda-button" type="button" id="btnExistencia">
                                    <span class="ladda-label"> Ver Existencia </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </div>
                        <hr />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Barra
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                                    <span class="input-group-btn">
                                        <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Producto
                                </label>
                                <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" />
                                <input type="hidden" id="ProductoId" value="0" />
                                <input type="hidden" id="UnidadOriginal" value="" />
                                <input type="hidden" id="Unidad" value="" />
                                <input type="hidden" id="InventarioTotalOriginal" value="0" />
                                <input type="hidden" id="InventarioComprometidoOriginal" value="0" />
                                <input type="hidden" id="InventarioDisponibleOriginal" value="0" />
                                <input type="hidden" id="PrecioOriginal" value="0" />
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad
                                </label>
                                <select id="UnidadId" name="UnidadId" class="form-control search-select">
                                    <option value="">--Seleccione una Unidad--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad
                                </label>
                                <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Inventario Total
                                </label>
                                <input type="number" placeholder="Inventario Total" class="form-control" id="InventarioTotal" name="InventarioTotal" autocomplete="off" disabled="disabled" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Inventario Comprometido
                                </label>
                                <input type="number" placeholder="Inventario Comprometido" class="form-control" id="InventarioComprometido" name="InventarioComprometido" autocomplete="off" disabled="disabled" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Inventario Disponible
                                </label>
                                <input type="number" placeholder="Inventario Disponible" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Opcion de Descuento
                                </label>
                                <select class="form-control" id="DescuentoK66Id">
                                    <option value="0">--Seleccione Opcion de Descuento</option>
                                    <option value="1">Cambio de Precio</option>
                                    <option value="2">Aplicar Descuento</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon">Q</span>
                                    <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div id="divPrecioNegociado">
                                <div class="form-group">
                                    <label class="control-label">
                                        Precio Negociado
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-addon">Q</span>
                                        <input type="text" placeholder="Precio Negociado de Venta" class="form-control" id="PrecioNegociadoActual" name="PrecioNegociadoActual" value="0" autocomplete="off" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div id="divDescuento">
                                <div class="form-group">
                                    <label class="control-label">
                                        Descuento %
                                    </label>
                                    <input type="text" placeholder="Descuento %" class="form-control" id="DescuentoActual" name="DescuentoActual" value="0" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Unidad</th>
                                        <th>Cantidad</th>
                                        <th>Precio</th>
                                        <th>Sub-Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="producto_tbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div style="text-align:left; font-size:large; font-weight:bold;">
                                    Total:
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                                    Q0.0000
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Archivos Importantes</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <input title="Documentos" multiple type="file" id="archivo" name="archivo[]" value="">
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="javascript:window.history.back();">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="seleccionar-cliente-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Cliente</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cliente_seleccionado_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

<div id="seleccionar-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Producto</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="producto_seleccionado_tbody">
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

<div id="existencia-producto-form" class="modal fade" tabindex="-1" data-width="750" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Producto</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-md-12">
                <div id="divExistencias"></div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-existencia-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="producto_tr_template">
        <tr>
            <td>{{producto}}</td>
            <td>{{unidad}}</td>
            <td>{{cantidad}}</td>
            <td>Q{{precio}}</td>
            <td>Q{{sub_total}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="productoIds" value="{{producto_id}}" />
                <input type="hidden" name="nombreProductoIds" value="{{producto}}" />
                <input type="hidden" name="unidadIds" value="{{unidad}}" />
                <input type="hidden" name="existenciaIds" value="{{existencia_id}}" />
                <input type="hidden" name="cantidadIds" value="{{cantidad_id}}" />
                <input type="hidden" name="precioIds" value="{{precio_id}}" />
                <input type="hidden" name="precioOriginalIds" value="{{precio_original_id}}" />
                <input type="hidden" name="precioCambiadoIds" value="{{precio_cambiado_id}}" />
                <input type="hidden" name="descuentoIds" value="{{descuento}}" />
            </td>
        </tr>
    </script>

    <script type="text/javascript">

    var vCliente = "";
    var vCodBarra = "";

    var productoIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.productoIds))');
    var productoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombreProductoIds))');
    var unidadSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.unidadIds))');
    var existenciaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.existenciaIds))');
    var cantidadSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.cantidadIds))');
    var precioSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioIds))');
    var precioOriginalSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioOriginalIds))');
    var precioCambiadoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioCambiadoIds))');
    var descuentoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.descuentoIds))');

    var clienteIds = "@Html.Raw(ViewBag.ClienteIds)";
    var direccionIds = "@Html.Raw(ViewBag.DireccionIds)";
    var tipoPedidoIds = "@Html.Raw(ViewBag.TipoPedidoIds)";

    $(function ()
    {
        $("#divFechaEntrega").hide();

        $("#divCredito").hide();
        $("#divMostrarExistencia").hide();

        $("#DescuentoK66Id").val(0).trigger("change");

        $("#divPrecioNegociado").hide();
        $("#divDescuento").hide();

        $('#InventarioTotal').val("0");
        $('#InventarioComprometido').val("0");
        $("#Existencia").val("0");

        if (clienteIds !== "0")
        {
            var modelo =
            {
                'ID': clienteIds
            };

            cargaClienteSeleccionado(modelo);
        }

         $("#BuscarCliente").autocomplete({
            source: function (request, response)
            {
                $.ajax({
                    url: '@Url.Action("ConsultaClienteK66", "Cliente")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term, 'empresaId': $("#EmpresaId").val() },
                    success: function (data)
                    {
                        response($.map(data, function (item)
                        {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
        });

        $('#formaprincipal').keydown(function (evt)
        {
            if ($('#BuscarCliente').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                cargaBusquedaCliente(evt)
            }
        });

        $('#btnBuscarCliente').click(function (evt)
        {
            cargaBusquedaCliente(evt);
        });

