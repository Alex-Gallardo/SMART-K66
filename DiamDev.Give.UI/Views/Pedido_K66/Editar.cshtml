        {
            evt.preventDefault();

            $("#divExistencias").load('@Url.Action("GetExistenciasxProducto", "Producto")?id=' + $('#ProductoId').val() + '&clienteId=' + $("#IDK66").val() + '&empresaId=' + $("#EmpresaId").val(), function ()
            {
                $("#existencia-producto-form").modal();
            });
        });

        $("#DescuentoK66Id").change(function (evt)
        {
            evt.preventDefault();

            $("#divPrecioNegociado").hide();
            $("#divDescuento").hide();

            if ($("#DescuentoK66Id").val() === "1")
            {
                $("#divPrecioNegociado").show();
                $("#divDescuento").hide();
            }
            else if ($("#DescuentoK66Id").val() === "2")
            {
                $("#divPrecioNegociado").hide();
                $("#divDescuento").show();
            }
        });

        $("#TipoPedidoId").change(function (evt)
        {
            evt.preventDefault();

            if ($("#TipoPedidoId").val() !== "")
            {
                $("#divFechaEntrega").hide();

                $.ajax({
                    url: '@Url.Action("GetPedidoTipoxId", "Pedido_Tipo_K66")',
                    data: { 'id': $("#TipoPedidoId").val() },
                    traditional: true,
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        if (data.Operacion)
                        {
                            if (data.Data !== null)
                            {
                                if (data.Data.CodigoIntregracion1.indexOf("S") !== -1)
                                {
                                    $("#divFechaEntrega").show();
                                }
                            }
                        }
                    }
                });
            }
        });

        $("#FechaEntrega").change(function (evt)
        {
            evt.preventDefault();

            if ($("#FechaEntrega").val() !== "")
            {
                $("#FechaPrometida").val($("#FechaEntrega").val());
            }
        });
    });

    </script>
}