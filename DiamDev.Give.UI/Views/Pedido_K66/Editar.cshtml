        $('#btn-agregar').click(function (e)
        {
            e.preventDefault();

            var producto_id = $('#ProductoId').val();
            var producto = $('#Producto').val();

            if (producto_id === "" || producto === "")
            {
                error("Seleccione un producto");
                return;
            }

            var unidad_id = $('#UnidadId').val();
            var unidad = $('#Unidad').val();

            if (unidad === "")
            {
                error("Seleccione una unidad");
                return;
            }

            var cantidad_id = $('#Cantidad').val();

            if (cantidad_id === "")
            {
                error("Ingrese la cantidad del producto");
                return;
            }

            var precio_id = $('#PrecioActual').val();
            precio_id = parseFloat(precio_id);

            if (precio_id === 0)
            {
                error("Ingrese el precio del producto");
                return;
            }

            var existencia_id = parseFloat($('#Existencia').val());
            cantidad_id = parseFloat(cantidad_id);

            var precioOriginal = precio_id;
            var precioCambio = false;

            var descuentoK66Id = $('#DescuentoK66Id').val();
            descuentoK66Id = parseInt(descuentoK66Id);

            var descuentoGeneral = 0;

            if (descuentoK66Id === 1)
            {
                var descuentoManual = $('#PrecioNegociadoActual').val();
                descuentoManual = parseFloat(descuentoManual);

                precioCambio = true;
                precio_id = descuentoManual;
            }
            else if (descuentoK66Id === 2)
            {
                var descuentoManual = $('#DescuentoActual').val();
                descuentoManual = parseFloat(descuentoManual);

                descuentoGeneral = descuentoManual;

                if (descuentoManual !== 0)
                {
                    descuentoManual = descuentoManual / 100;
                }

                precioCambio = true;
                precio_id = precio_id - (precio_id * descuentoManual);
            }

            cargaProducto(producto_id, producto, unidad, existencia_id, cantidad_id, precio_id, precioOriginal, precioCambio, descuentoGeneral);
            totalizarProducto();

            $("#divMostrarExistencia").hide();

            $("#DescuentoK66Id").val(0).trigger("change");
            $("#divPrecioNegociado").hide();
            $("#divDescuento").hide();

            $("#UnidadId").empty();
            $("#UnidadId").append('<option value="0">--Seleccione una Unidad de Empaque--</option>');
            $("#UnidadId").val(0).trigger("change");

            $("#PrecioNegociadoActual").val("");
            $("#DescuentoActual").val("");

            $("#ProductoId").val(0);
            $("#Cantidad").val("1");
            $('#InventarioTotal').val("0");
            $('#InventarioComprometido').val("0");
            $("#Existencia").val("0");
            $("#PrecioActual").val("");
            $("#Unidad").val("");
            $("#UnidadOriginal").val("");
            $("#Producto").val("");
            $("#Barra").val("");
            $("#Barra").focus();
        });

