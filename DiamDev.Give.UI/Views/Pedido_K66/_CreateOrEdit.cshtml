@model DiamDev.Give.Entities.PedidoK66

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Empresas</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Empresa<span class="symbol required"></span>
            </label>
            @Html.DropDownList("EmpresaId", (SelectList)ViewBag.Empresas, "--Seleccione una Empresa--", new { @class = "form-control search-select required" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Generales de Pedido</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Tipo de Pedido<span class="symbol required"></span>
            </label>
            <select id="TipoPedidoId" name="TipoPedidoId" class="form-control search-select required">
                <option value="">--Seleccione un Tipo de Pedido--</option>
            </select>
        </div>
    </div>
    <div id="divFechaEntrega">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Entrega Estimada<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaEntrega" autocomplete="off" value="@(Model == null ? DateTime.Today.ToString("yyyy-MM-dd") : (Model.FechaPrometida == null ? "" : Model.FechaPrometida.Value.ToString("yyyy-MM-dd")))">
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Orden de Compra del Cliente
            </label>
            @Html.TextBoxFor(model => model.OrdenCompraCliente, new { @class = "form-control", @placeholder = "Orden de Compra del Cliente", autocomplete = "off" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Observaciones Generales
            </label>
            @Html.TextAreaFor(model => model.ObservacionesGenerales, new { @class = "form-control", @placeholder = "Observaciones Generales", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Documento de Respaldo de la Orden de Compra</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="fileupload fileupload-new" data-provides="fileupload">
            <div class="input-group">
                <div class="form-control uneditable-input">
                    <i class="icon-file fileupload-exists"></i>
                    <span class="fileupload-preview"></span>
                </div>
                <div class="input-group-btn">
                    <div class="btn btn-light-grey btn-file">
                        <span class="fileupload-new"><i class="icon-folder-open-alt"></i>Seleccionar Documento</span>
                        <span class="fileupload-exists"><i class="icon-folder-open-alt"></i>Cambiar</span>
                        <input type="file" class="file-input" id="documentoApp" name="documentoApp">
                    </div>
                    <a href="#" class="btn btn-light-grey fileupload-exists" data-dismiss="fileupload">
                        <i class="icon-remove"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="BuscarCliente" name="BuscarCliente" autocomplete="off" placeholder="Buscar Cliente...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBuscarCliente">Buscar</button>
                </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente<span class="symbol required"></span>
            </label>
            <input type="text" placeholder="Cliente" id="Nombre" name="Nombre" class="form-control" autocomplete="off" disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; " required />
            <input type="hidden" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; "  />
            <input type="hidden" id="IDK66" name="IDK66" value="" />
            <label class="control-label">
                Nit<span class="symbol required"></span>
            </label>
            <input type="text" value="" placeholder="Nit" id="Nit" name="Nit" class="form-control"  disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; "  />

            <label class="control-label">
                Dirección<span class="symbol required"></span>
            </label>
            <input type="text" value="" placeholder="Direccion" id="Direccion" name="Direccion" class="form-control"  disabled="disabled" value="" style="background-color: #E2DDDC; color: #000000; font-weight: bold; "  />
            <input type="hidden" id="DireccionEntrega" name="DireccionEntrega" value="" />

            <input type="hidden" id="DiasCobroSemana" name="DiasCobroSemana" value="" />
            <input type="hidden" id="DiasCobroFinSemana" name="DiasCobroFinSemana" value="" />

            <input type="hidden" id="TerminoEntrega" name="TerminoEntrega" value="" />
            <input type="hidden" id="Vendedor" name="Vendedor" value="" />
            <input type="hidden" id="ImpuestoTAX" name="ImpuestoTAX" value="" />
            <input type="hidden" id="Moneda" name="Moneda" value="" />

            <input type="hidden" id="E1" name="E1" value="" />
            <input type="hidden" id="E2" name="E2" value="" />
            <input type="hidden" id="E3" name="E3" value="" />
            <input type="hidden" id="E4" name="E4" value="" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Direccion de Despacho<span class="symbol required"></span>
            </label>
            <select id="DireccionId" name="DireccionId" class="form-control search-select">
                <option value="">--Seleccione una Direccion--</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div id="divCredito">ESTADO DEL CREDITO</div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Estado Crediticio
            </label>
            <input type="text" class="form-control" id="EstadoCredito" name="EstadoCredito" value="" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Limite de Credito
            </label>
            <input type="text" class="form-control" id="LimiteCredito" name="LimiteCredito" value="0" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Saldo Actual
            </label>
            <input type="text" class="form-control" id="SaldoActual" name="SaldoActual" value="0" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Disponible
            </label>
            <input type="text" class="form-control" id="CreditoDisponible" name="CreditoDisponible" value="0" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Pedidos Pendientes de Despacho
            </label>
            <input type="text" class="form-control" id="TotalPedidoPendientes" name="TotalPedidoPendientes" value="" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Despachos Pendientes de Facturacion
            </label>
            <input type="text" class="form-control" id="TotalListaEmpaque" name="TotalListaEmpaque" value="0" readonly style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Productos</h2>
        <hr>
    </div>
</div>
@if (ViewBag.Inventario)
{
    <div id="divMostrarExistencia">
        <div class="row">
            <div class="col-md-12">
                <button data-style="slide-down" class="btn btn-primary btn-block ladda-button" type="button" id="btnExistencia">
                    <span class="ladda-label">Ver Existencia</span>
                    <span class="ladda-spinner"></span>
                    <span class="ladda-progress" style="width: 0px;"></span>
                </button>
            </div>
        </div>
        <hr />
    </div>
}
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Producto
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Descripcion
            </label>
            <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" />
            <input type="hidden" id="ProductoId" value="0" />
            <input type="hidden" id="UnidadOriginal" value="" />
            <input type="hidden" id="Unidad" value="" />
            <input type="hidden" id="InventarioTotalOriginal" value="0" />
            <input type="hidden" id="InventarioComprometidoOriginal" value="0" />
            <input type="hidden" id="InventarioDisponibleOriginal" value="0" />
            <input type="hidden" id="PrecioOriginal" value="0" />
        </div>
        <div class="form-group">
            <label class="control-label">
                Unidad de Empaque
            </label>
            <input type="text" class="form-control" id="empaque" name="empaque" autocomplete="off" disabled>
            @*<select id="UnidadId" name="UnidadId" class="form-control search-select">
                <option value="">--Seleccione una Unidad de Empaque--</option>
            </select>*@
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
            <span class="input-group-btn">
                <button type="button" class="demo btn btn-blue" id="btn-validar-precio">Validar Cantidad</button>
            </span>
        </div>
    </div>  
    @if (ViewBag.Inventario)
    {
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label">
                    Inventario Total
                </label>
                <input type="number" placeholder="Inventario Total" class="form-control" id="InventarioTotal" name="InventarioTotal" autocomplete="off" disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="control-label">
                    Inventario Comprometido
                </label>
                <input type="number" placeholder="Inventario Comprometido" class="form-control" id="InventarioComprometido" name="InventarioComprometido" autocomplete="off" disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
            </div>
        </div>
    }
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Inventario Disponible
            </label>
            <input type="number" placeholder="Inventario Disponible" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Opcion de Descuento
            </label>
            <select class="form-control" id="DescuentoK66Id">
                <option value="0">--Seleccione Opcion de Descuento</option>
                <option value="1">Cambio de Precio</option>
                <option value="2">Aplicar Descuento</option>
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Precio
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" disabled="disabled" style="background-color: #E2DDDC; color: #000000; font-weight: bold; " />
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div id="divPrecioNegociado">
            <div class="form-group">
                <label class="control-label">
                    Precio Negociado
                </label>
                <div class="input-group">
                    <span class="input-group-addon">Q</span>
                    <input type="text" placeholder="Precio Negociado de Venta" class="form-control" id="PrecioNegociadoActual" name="PrecioNegociadoActual" value="0" autocomplete="off" />
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div id="divDescuento">
            <div class="form-group">
                <label class="control-label">
                    Descuento %
                </label>
                <input type="text" placeholder="Descuento %" class="form-control" id="DescuentoActual" name="DescuentoActual" value="0" autocomplete="off" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="control-label">
                Bodega de despacho
            </label>
            <select class="form-control" id="WarehouseId">
                <option value="">--Seleccione Bodega</option>
            </select>
        </div>
    </div>
</div>
    <div class="row">
        <div class="col-md-12">
            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Unidad</th>
                            <th>Bodega</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Sub-Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="producto_tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-4">
                <div style="text-align:left; font-size:large; font-weight:bold;">
                    Total:
                </div>
            </div>
            <div class="col-md-8">
                <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                    Q0.0000
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h2><i class="icon-edit-sign teal"></i>Archivos Importantes</h2>
            <hr>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <input title="Documentos" multiple type="file" id="archivo" name="archivo[]" value="">
        </div>
    </div>
    <hr />
