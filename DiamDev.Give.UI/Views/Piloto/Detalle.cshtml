@model DiamDev.Give.Entities.PilotoRuta
@using System.Linq
@{
    Layout = "~/Views/Shared/_PilotoLayout.cshtml";
    ViewBag.Title = "Ruta " + Model.Id;
    var estadoIcon=Model.Estado=="E" ? "i-truck" : Model.Estado=="C" ? "i-check" : Model.Estado=="X" ? "i-x" : "i-clock";
    var grupos=Model.Documentos.Select((documento,indice)=>new { Documento=documento, Indice=indice })
        .GroupBy(x=>new { Cliente=(x.Documento.Cliente??"").Trim().ToUpperInvariant(), Direccion=(x.Documento.Direccion??"").Trim().ToUpperInvariant() }).ToList();
}
<a class="back-link" href="@Url.Action("Index",new { desde=(string)ViewBag.Desde,hasta=(string)ViewBag.Hasta,pagina=(int?)ViewBag.PaginaRutas ?? 1,vista=(string)ViewBag.Vista })"><svg class="icon" aria-hidden="true"><use href="#i-back" /></svg>Mis rutas</a>
<div class="detail-title"><div><p class="eyebrow">DETALLE DE RUTA</p><h1>@Model.Id</h1></div><span class="status status-@Model.Estado"><svg class="icon" aria-hidden="true"><use href="#@estadoIcon" /></svg>@Model.EstadoNombre</span></div>
@Html.ValidationSummary(false, "Revisa los resultados antes de continuar.", new { role="alert" })
@if (TempData["Piloto.Mensaje"] != null) { <p class="notice success" role="status">@TempData["Piloto.Mensaje"]</p> }
<dl class="route-summary"><div><dt>Fecha</dt><dd>@Model.Fecha.ToString("dd/MM/yyyy")</dd></div><div><dt>Vehículo</dt><dd>@Model.Placa</dd></div><div><dt>Piloto</dt><dd>@Model.Piloto</dd></div><div><dt>Centro</dt><dd>@Model.Centro</dd></div></dl>
@if (!string.IsNullOrWhiteSpace(Model.Transporte) || !string.IsNullOrWhiteSpace(Model.Vehiculo)) {
    <div class="vehicle-panel"><p class="eyebrow">TRANSPORTE ASIGNADO</p><strong>@(Model.Transporte ?? "Vehículo de la ruta")</strong><p class="muted">@Model.Vehiculo <span class="plate">@Model.Placa</span></p></div>
}
<div class="list-heading"><h2>Documentos <span class="count">@Model.TotalDocumentos</span></h2>
    @if (Model.TotalDocumentos>0) { <span class="muted">@((Model.PaginaDocumentos-1)*Model.TamanoPaginaDocumentos+1)–@((Model.PaginaDocumentos-1)*Model.TamanoPaginaDocumentos+Model.Documentos.Count) de @Model.TotalDocumentos</span> }
</div>
@if(Model.TotalDocumentos>DiamDev.Give.Entities.PilotoReglas.MaxDocumentos) { <p class="notice">Puedes consultar todos los documentos por páginas. El cierre de esta ruta corresponde a Distribución por su cantidad de documentos.</p> }
@if (Model.PuedeCerrar)
{
    <p class="intro">Abre cada factura, registra su resultado y guarda el cliente. Los resultados se aplicarán a la ruta al confirmar el cierre.</p>
}
else if (ViewBag.PruebasSoloLectura != true)
{
    <p class="notice">Ruta disponible para consulta. Para cambios, contacta a Distribución.</p>
}
@if(Model.Estado=="E" && !Model.BorradoresDisponibles && ViewBag.PruebasSoloLectura != true) { <p class="notice">El guardado por cliente estará disponible cuando se instale la tabla de borradores en POS.</p> }
@if(Model.Estado=="E" && Model.BorradoresDisponibles && !Model.ClientesCompletadosDisponibles && ViewBag.PruebasSoloLectura != true) { <p class="notice">Para completar clientes y subir fotos finales, instala la migración 22 en POS. Por ahora esta ruta está en consulta.</p> }
@if(Model.Estado=="E" && !Model.ImagenesDisponibles && ViewBag.PruebasSoloLectura != true) { <p class="notice">La carga de imágenes estará disponible cuando se instale la tabla de imágenes en POS.</p> }
@using (Html.BeginForm("Completar", "Piloto", FormMethod.Post, new { id = "complete-route" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="RutaId" value="@Model.Id" />
    <input type="hidden" name="Version" value="@Model.Version" />
    <input type="hidden" name="Solicitud" value="@Model.Solicitud" />
    foreach (var grupo in grupos)
    {
        var primero = grupo.First().Documento;
        var primerRowId=grupo.Min(x=>x.Documento.RowId);
        var borrador=Model.Borradores.FirstOrDefault(x=>x.PrimerRowId==primerRowId);
        <section class="customer-group @(borrador!=null && borrador.Completado ? "is-complete" : "")" data-first-row-id="@primerRowId" data-client-name="@(string.IsNullOrWhiteSpace(primero.Cliente) ? "Cliente sin nombre" : primero.Cliente)" data-saved="@(borrador!=null && borrador.Completado ? "true" : "false")" data-bulk-active="@(borrador!=null && borrador.MasivoActivo ? "true" : "false")" aria-label="Documentos de @(primero.Cliente ?? "Cliente sin nombre")">
            <div class="customer-group-heading">
                <div><p class="eyebrow">CLIENTE · @grupo.Count() @(grupo.Count()==1 ? "documento" : "documentos")</p>
                    <h3>@(string.IsNullOrWhiteSpace(primero.Cliente) ? "Cliente sin nombre" : primero.Cliente)</h3>
                    <p class="address"><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg><span>@(string.IsNullOrWhiteSpace(primero.Direccion) ? "Dirección no registrada" : primero.Direccion)</span></p>
                </div>
                <div class="customer-group-action">
                    @if(Model.PuedeCerrar) { <span class="client-complete-badge" @(borrador==null || !borrador.Completado ? "hidden" : "")>✓ Cliente completado</span> }
                    <button type="button" class="client-toggle button-secondary" aria-expanded="@(borrador!=null ? "true" : "false")" aria-controls="cliente-@primerRowId">@(borrador!=null ? (borrador.Completado ? "Ocultar resumen" : "Ocultar documentos") : "Ver documentos")</button>
                </div>
            </div>
        <div id="cliente-@primerRowId" class="customer-documents" @(borrador==null ? "hidden" : "")>
        @if(Model.PuedeCerrar && borrador!=null && borrador.Completado) {
            <div class="client-compact-summary"><p><strong>Cliente completado.</strong> Los resultados están bloqueados.</p>
                <ul>
                @foreach(var item in grupo) {
                    var d=item.Documento;
                    <li class="completed-document" data-document="@(d.Documento ?? "Sin número")" data-result="@d.Entrega" data-reason="@d.Motivo" data-observation="@d.ObservacionPiloto">
                        <span>@(d.Documento ?? "Sin número")</span><strong>@d.Entrega</strong>
                        @if(d.TieneImagen) { <a href="@Url.Action("Imagen",new { id=Model.Id,rowId=d.RowId })" target="_blank" rel="noopener">Ver foto</a> }
                    </li>
                }
                </ul>
                @foreach(var item in grupo) {
                    var d=item.Documento; var i=item.Indice;
                    <input type="hidden" name="Documentos[@i].RowId" value="@d.RowId" />
                    <input type="hidden" name="Documentos[@i].Visito" value="@(d.Visito==true ? "true" : "false")" />
                    <input type="hidden" name="Documentos[@i].Entrega" value="@d.Entrega" />
                    <input type="hidden" name="Documentos[@i].Motivo" value="@d.Motivo" />
                    <input type="hidden" name="Documentos[@i].Observaciones" value="@d.ObservacionPiloto" />
                }
                @if(Model.ClientesConImagen.Contains(primerRowId) || borrador.TieneImagenCliente) { <a class="client-photo-link" href="@Url.Action("ImagenCliente",new { id=Model.Id,primerRowId=primerRowId })" target="_blank" rel="noopener">Ver foto final del cliente</a> }
            </div>
        } else {
        if(Model.PuedeCerrar) { <p class="client-warning" role="status" aria-live="polite" hidden></p> }
        if(Model.PuedeCerrar) { <label class="bulk-delivered-label"><input type="checkbox" class="bulk-delivered" @(borrador!=null && borrador.MasivoActivo ? "checked" : "") /><span>Todos los documentos entregados</span></label> }
        foreach (var item in grupo)
        {
        var i = item.Indice;
        var d = item.Documento;
        var requiereDetalle = d.Entrega == "NO ENTREGADO" || d.Entrega == "INCIDENCIA";
        <article class="document-card" data-document="@(d.Documento ?? "Sin número")" data-before-visit="@(d.AnteriorMasivo==null || !d.AnteriorMasivo.Visito.HasValue ? "" : d.AnteriorMasivo.Visito.Value ? "true" : "false")" data-before-delivery="@(d.AnteriorMasivo==null ? "" : d.AnteriorMasivo.Entrega)" data-before-reason="@(d.AnteriorMasivo==null ? "" : d.AnteriorMasivo.Motivo)" data-before-observation="@(d.AnteriorMasivo==null ? "" : d.AnteriorMasivo.Observaciones)">
            <div class="document-heading"><span class="document-number">@((Model.PaginaDocumentos-1)*Model.TamanoPaginaDocumentos+i+1)</span><div><p class="eyebrow">@d.Tipo · @d.Empresa</p><h3>@(d.Documento ?? "Sin número")</h3></div><span class="bultos"><svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>@d.Bultos.ToString("0.###") bultos</span></div>
            @if (!string.IsNullOrWhiteSpace(d.Observaciones)) { <p class="observation">Observaciones: @d.Observaciones</p> }
            @if(d.TieneImagen || Model.PuedeAdjuntarImagen) { <p class="document-image-link" @(!d.TieneImagen ? "hidden" : "")><a href="@Url.Action("Imagen",new { id=Model.Id,rowId=d.RowId })" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>Ver imagen adjunta</a></p> }
            @if(Model.PuedeCerrar) { <div class="document-actions"><span class="document-result-label">@(string.IsNullOrWhiteSpace(d.Entrega) ? "Pendiente" : d.Entrega)</span><button type="button" class="document-toggle button-secondary" aria-expanded="false" aria-controls="documento-@d.RowId">@(string.IsNullOrWhiteSpace(d.Entrega) ? "Registrar resultado" : "Editar resultado")</button></div> }
            @if(Model.PuedeCerrar) { <p id="documento-aviso-@d.RowId" class="document-warning" role="status" aria-live="polite" hidden></p> }
            <div id="documento-@d.RowId" class="document-edit" @(Model.PuedeCerrar ? "hidden" : "")>
            @if(Model.PuedeAdjuntarImagen && Model.PuedeCerrar) { <button type="button" class="image-upload-trigger button-secondary" data-row-id="@d.RowId" data-document="@(d.Documento ?? "Sin número")" data-replace="@(d.TieneImagen ? "true" : "false")" @(requiereDetalle ? "" : "hidden")><svg class="icon" aria-hidden="true"><use href="#i-camera" /></svg><span class="image-upload-label">@(d.TieneImagen ? "Reemplazar imagen" : "Subir imagen")</span></button><p class="image-card-status" role="status" aria-live="polite"></p> }
            @if (Model.PuedeCerrar)
            {
                <input type="hidden" name="Documentos[@i].RowId" value="@d.RowId" />
                <div class="result-fields">
                    <fieldset class="outcome-fieldset">
                        <legend>Resultado de la factura</legend>
                        <div class="outcome-options">
                            <label class="outcome-choice outcome-delivered" for="entrega-ok-@i">
                                @Html.RadioButton("Documentos[" + i + "].Entrega", "ENTREGADO", d.Entrega == "ENTREGADO", new { id = "entrega-ok-" + i, required = "required", @class = "delivery-result" })
                                <span><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg><strong>Entregado</strong><small>Pedido recibido correctamente</small></span>
                            </label>
                            <label class="outcome-choice outcome-failed" for="entrega-no-@i">
                                @Html.RadioButton("Documentos[" + i + "].Entrega", "NO ENTREGADO", d.Entrega == "NO ENTREGADO", new { id = "entrega-no-" + i, required = "required", @class = "delivery-result" })
                                <span><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg><strong>No entregado</strong><small>El pedido no pudo entregarse</small></span>
                            </label>
                            <label class="outcome-choice outcome-incident" for="entrega-inc-@i">
                                @Html.RadioButton("Documentos[" + i + "].Entrega", "INCIDENCIA", d.Entrega == "INCIDENCIA", new { id = "entrega-inc-" + i, required = "required", @class = "delivery-result" })
                                <span><svg class="icon" aria-hidden="true"><use href="#i-info" /></svg><strong>Incidencia</strong><small>Requiere seguimiento</small></span>
                            </label>
                        </div>
                    </fieldset>
                    <fieldset class="visit-fieldset">
                        <legend>¿Llegaste al destino?</legend>
                        <div class="visit-options">
                            <label for="visita-si-@i">@Html.RadioButton("Documentos[" + i + "].Visito", "true", d.Visito == true, new { id = "visita-si-" + i, required = "required", @class = "visit-result" })<span>Sí</span></label>
                            <label for="visita-no-@i">@Html.RadioButton("Documentos[" + i + "].Visito", "false", d.Visito == false, new { id = "visita-no-" + i, required = "required", @class = "visit-result" })<span>No</span></label>
                        </div>
                    </fieldset>
                    <div class="exception-fields @(requiereDetalle ? "is-visible" : "")" aria-hidden="@(requiereDetalle ? "false" : "true")">
                        <div class="reason"><label for="motivo-@i">Motivo <small>Obligatorio</small></label>
                            <select id="motivo-@i" class="delivery-reason" name="Documentos[@i].Motivo">
                                <option value="">Selecciona un motivo</option>
                                @foreach (var motivo in DiamDev.Give.Entities.PilotoReglas.MotivosNoEntrega)
                                {
                                    <option value="@motivo" selected="@(d.Motivo == motivo ? "selected" : null)">@motivo</option>
                                }
                            </select>
                        </div>
                        <div class="pilot-observation"><label for="observacion-@i">¿Qué ocurrió? <small>Obligatorio · máximo 500 caracteres</small></label>
                            <textarea id="observacion-@i" class="delivery-observation" name="Documentos[@i].Observaciones" maxlength="500" rows="4" placeholder="Describe brevemente lo ocurrido en el punto de entrega.">@d.ObservacionPiloto</textarea>
                            <span class="character-count" aria-live="polite">0 / 500</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <dl class="read-results"><div><dt>Visita</dt><dd>@(d.Visito.HasValue ? (d.Visito.Value ? "Sí" : "No") : "Pendiente")</dd></div><div><dt>Resultado</dt><dd>@(string.IsNullOrWhiteSpace(d.Entrega) ? "Pendiente" : d.Entrega)</dd></div>
                    @if(d.Entrada.HasValue) { <div><dt>Entrada</dt><dd>@d.Entrada.Value.ToString(@"hh\:mm")</dd></div> }
                    @if(d.Salida.HasValue) { <div><dt>Salida</dt><dd>@d.Salida.Value.ToString(@"hh\:mm")</dd></div> }
                </dl>
                if (!string.IsNullOrWhiteSpace(d.Motivo)) { <p class="document-reason"><strong>Motivo:</strong> @d.Motivo</p> }
            }
            </div>
        </article>
        }
        if(Model.PuedeCerrar) { <div class="client-save-bar"><button type="button" class="save-client"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Guardar cliente</button>@if(Model.PuedeAdjuntarImagen) { <button type="button" class="client-image-upload-trigger button-secondary" data-first-row-id="@primerRowId" data-replace="@(Model.ClientesConImagen.Contains(primerRowId) || borrador!=null && borrador.TieneImagenCliente ? "true" : "false")" disabled><svg class="icon" aria-hidden="true"><use href="#i-camera" /></svg><span class="client-image-label">@(Model.ClientesConImagen.Contains(primerRowId) || borrador!=null && borrador.TieneImagenCliente ? "Reemplazar foto final" : "Subir foto final")</span></button> }<p class="group-status" role="status" aria-live="polite">@(borrador!=null ? "Borrador recuperado. Completa el cliente para bloquearlo." : "Pendiente de completar")</p>
            <p class="client-image-link" @(Model.ClientesConImagen.Contains(primerRowId) || borrador!=null && borrador.TieneImagenCliente ? "" : "hidden")><a href="@Url.Action("ImagenCliente",new { id=Model.Id,primerRowId=primerRowId })" target="_blank" rel="noopener">Ver foto final</a></p></div> }
        else if(Model.ClientesConImagen.Contains(primerRowId)) { <a class="client-photo-link" href="@Url.Action("ImagenCliente",new { id=Model.Id,primerRowId=primerRowId })" target="_blank" rel="noopener">Ver foto final del cliente</a> }
        }
        </div>
        </section>
    }
    if (Model.Documentos.Count == 0) { <p class="empty-state">No hay documentos en esta ruta.</p> }
    if (Model.PuedeCerrar && Model.Documentos.Count > 0)
    {
        <div class="complete-panel"><p><strong>¿Terminaste todas las entregas?</strong><br />Revisa el resumen antes de cerrar la ruta.</p><button type="button" id="review-button"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Revisar y completar ruta</button><p id="submit-status" role="status" aria-live="polite"></p></div>
        <div id="draft-endpoint" data-url="@Url.Action("GuardarCliente","Piloto")" hidden></div>
        <div id="complete-modal" class="confirm-modal" hidden>
            <button type="button" class="modal-backdrop" data-close-modal aria-label="Cerrar confirmación"></button>
            <section class="confirm-sheet" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-help" tabindex="-1">
                <div class="confirm-handle" aria-hidden="true"></div>
                <p class="eyebrow">CONFIRMACIÓN FINAL</p>
                <h2 id="confirm-title">Revisa antes de cerrar</h2>
                <p id="confirm-help">La ruta <strong>@Model.Id</strong> cambiará de En ruta a Cerrada.</p>
                <div class="confirm-counts" aria-live="polite">
                    <div class="delivered"><strong id="summary-delivered">0</strong><span>Entregadas</span></div>
                    <div class="failed"><strong id="summary-failed">0</strong><span>No entregadas</span></div>
                    <div class="incident"><strong id="summary-incidents">0</strong><span>Incidencias</span></div>
                </div>
                <div id="exception-summary" class="exception-summary" hidden><h3>Casos que requieren atención</h3><ul></ul></div>
                <label class="confirm-check" for="confirm-reviewed"><input id="confirm-reviewed" type="checkbox" /><span>Confirmo que revisé los resultados de todas las facturas.</span></label>
                <div class="modal-actions"><button type="button" class="button-secondary" data-close-modal>Volver a revisar</button><button type="submit" id="complete-button" disabled><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Confirmar y cerrar ruta</button></div>
            </section>
        </div>
    }
}
@if(Model.PuedeCerrar && Model.Documentos.Count>0) {
    <div id="client-save-modal" class="confirm-modal" hidden>
        <button type="button" class="modal-backdrop" data-close-client aria-label="Cancelar confirmación de cliente"></button>
        <section class="confirm-sheet client-save-sheet" role="dialog" aria-modal="true" aria-labelledby="client-save-title" aria-describedby="client-save-help" tabindex="-1">
            <div class="confirm-handle" aria-hidden="true"></div>
            <p class="eyebrow">CONFIRMAR CLIENTE</p>
            <h2 id="client-save-title">¿Completar este cliente?</h2>
            <p id="client-save-name" class="client-modal-name"></p>
            <p id="client-save-help">Revisa las respuestas antes de guardar. Después de confirmar, no podrás editar las facturas ni reemplazar la foto final de este cliente.</p>
            <p id="client-save-count" class="client-modal-count"></p>
            <p id="client-save-status" role="alert" aria-live="assertive" hidden></p>
            <div class="modal-actions"><button type="button" class="button-secondary" data-close-client>Volver a revisar</button><button type="button" id="client-save-confirm"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Confirmar y guardar</button></div>
        </section>
    </div>
}
@if(Model.PuedeAdjuntarImagen) {
    <div id="image-modal" class="confirm-modal" hidden>
        <button type="button" class="modal-backdrop" data-close-image aria-label="Cerrar carga de imagen"></button>
        <section class="confirm-sheet image-sheet" role="dialog" aria-modal="true" aria-labelledby="image-title" tabindex="-1">
            <div class="confirm-handle" aria-hidden="true"></div>
            <p id="image-kind" class="eyebrow">FOTO DEL DOCUMENTO</p>
            <h2 id="image-title">Subir imagen</h2>
            <p id="image-document" class="muted"></p>
            @using (Html.BeginForm("SubirImagen", "Piloto", FormMethod.Post, new { id="image-upload-form", enctype="multipart/form-data", data_customer_action=Url.Action("SubirImagenCliente","Piloto") })) {
                @Html.AntiForgeryToken()
                <input type="hidden" name="rutaId" value="@Model.Id" />
                <input type="hidden" name="rowId" value="" />
                <input type="hidden" name="entrega" value="" />
                <input type="hidden" name="primerRowId" value="" />
                <input type="hidden" name="version" value="@Model.Version" />
                <label for="image-file">Selecciona o toma una foto <small>JPG, PNG o WebP · máximo 10 MB</small></label>
                <input id="image-file" type="file" name="archivo" accept="image/jpeg,image/png,image/webp" required />
                <img id="image-preview" class="image-preview" alt="Vista previa de la imagen seleccionada" hidden />
                <p id="image-status" role="status" aria-live="polite"></p>
                <div class="modal-actions"><button type="button" class="button-secondary" data-close-image>Cancelar</button><button id="image-submit" type="submit"><svg class="icon" aria-hidden="true"><use href="#i-camera" /></svg><span id="image-submit-label">Guardar imagen</span></button></div>
            }
        </section>
    </div>
}
@if(Model.PaginaDocumentos>1 || Model.HayMasDocumentos) {
    <nav class="pagination" aria-label="Páginas de documentos">
        @if(Model.PaginaDocumentos>1) { <a href="@Url.Action("Detalle",new { id=Model.Id,pagina=Model.PaginaDocumentos-1,desde=(string)ViewBag.Desde,hasta=(string)ViewBag.Hasta,paginaRutas=(int?)ViewBag.PaginaRutas ?? 1,vista=(string)ViewBag.Vista })">← Anterior</a> }
        <span>Página @Model.PaginaDocumentos</span>
        @if(Model.HayMasDocumentos) { <a href="@Url.Action("Detalle",new { id=Model.Id,pagina=Model.PaginaDocumentos+1,desde=(string)ViewBag.Desde,hasta=(string)ViewBag.Hasta,paginaRutas=(int?)ViewBag.PaginaRutas ?? 1,vista=(string)ViewBag.Vista })">Siguiente →</a> }
    </nav>
}
<div class="detail-footer"><a class="button-link button-secondary" href="@Url.Action("Index",new{desde=(string)ViewBag.Desde,hasta=(string)ViewBag.Hasta,pagina=(int?)ViewBag.PaginaRutas ?? 1,vista=(string)ViewBag.Vista})"><svg class="icon" aria-hidden="true"><use href="#i-back" /></svg>Volver a mis rutas</a></div>
