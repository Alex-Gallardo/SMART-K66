@model DiamDev.Give.Entities.PilotoAdminRutaEdicion
@{
    Layout="~/Views/Shared/_Layout.cshtml";
    ViewBag.Title="Administrar ruta "+Model.Ruta.Id;
    ViewBag.PilotoBackoffice=true;
    var f=Model.Formulario;
}
<div class="pilot-admin-surface route-workspace"><div class="pilot-main">
<a class="back-link" href="@Url.Action("PanelDetalle","Piloto",new{id=Model.Ruta.Id})"><svg class="icon" aria-hidden="true"><use href="#i-back" /></svg>Volver al detalle</a>
<header class="rwe-hero"><span class="rwe-hero-symbol" aria-hidden="true">🚚</span><div><p class="rwe-kicker">DISTRIBUCIÓN · ADMINISTRAR RUTA</p><h1>@Model.Ruta.Id</h1><p>@Model.Ruta.EstadoNombre · @(Model.Liquidada?"Liquidada":"Sin liquidar") · @Model.Documentos documentos</p></div><a class="rwe-btn rwe-btn-light" href="#documentos">📄 Ver documentos</a></header>
@if(TempData["Piloto.AdminMensaje"]!=null){<div class="rwe-feedback" role="status">✅ @TempData["Piloto.AdminMensaje"]</div>}
@Html.ValidationSummary(false,"Revisa los datos de la ruta.",new{role="alert",@class="rwe-error"})
<nav class="rwe-jump" aria-label="Secciones de la ruta"><a href="#datos">🧭 Datos</a><a href="#viaje">🕒 Viaje</a><a href="#documentos">📄 Documentos</a><a href="#historial">📋 Historial</a></nav>
<div class="rwe-summary"><div><span>Estado</span><strong>@Model.Ruta.EstadoNombre</strong></div><div><span>Vehículo</span><strong>@Model.Ruta.Placa</strong></div><div><span>Centro</span><strong>@Model.Ruta.Centro</strong></div><div><span>Documentos</span><strong>@Model.Documentos</strong></div></div>
@using(Html.BeginForm("EditarRuta","Piloto",FormMethod.Post,new{@class="rwe-form",id="route-admin-form"})) {
@Html.AntiForgeryToken()<input type="hidden" name="RutaId" value="@f.RutaId" /><input type="hidden" name="Version" value="@f.Version" />
<section class="rwe-section" id="datos"><div class="rwe-section-head"><span aria-hidden="true">🧭</span><div><h2>Datos de la ruta</h2><p>Identidad, responsables y transporte.</p></div></div><div class="rwe-fields">
<div><label for="Fecha">Fecha</label><input id="Fecha" name="Fecha" type="date" required value="@f.Fecha.ToString("yyyy-MM-dd")" /></div>
<div><label for="TipoRuta">Tipo de ruta</label><input id="TipoRuta" name="TipoRuta" maxlength="50" value="@f.TipoRuta" /></div>
<div><label for="Piloto">Piloto / transporte</label><select id="Piloto" name="Piloto" required><option value="">Seleccionar</option>@foreach(var p in Model.Pilotos){<option value="@p.Nombre" selected="@(f.Piloto==p.Nombre?"selected":null)" disabled="@(!p.Activo&&f.Piloto!=p.Nombre?"disabled":null)">@p.Nombre</option>}</select></div>
<div><label for="Centro">Centro</label><select id="Centro" name="Centro" required><option value="">Seleccionar</option>@foreach(var c in Model.Centros){<option value="@c.Codigo" selected="@(f.Centro==c.Codigo?"selected":null)">@c.Codigo</option>}</select></div>
<div><label for="Placa">Vehículo / placa</label><select id="Placa" name="Placa" required><option value="">Seleccionar</option>@foreach(var v in Model.Vehiculos){<option value="@v.Codigo" selected="@(f.Placa==v.Codigo?"selected":null)" disabled="@(!v.Activo&&f.Placa!=v.Codigo?"disabled":null)">@v.Codigo · @v.Nombre</option>}</select></div>
<div><label for="Estado">Estado</label><select id="Estado" name="Estado" required>@foreach(var estado in new[]{new{Id="B",Nombre="Borrador"},new{Id="A",Nombre="Abierta"},new{Id="E",Nombre="En ruta"},new{Id="C",Nombre="Cerrada"},new{Id="L",Nombre="Liquidada"},new{Id="X",Nombre="Anulada"}}){<option value="@estado.Id" selected="@(f.Estado==estado.Id?"selected":null)" disabled="@((estado.Id=="C"||estado.Id=="L"||estado.Id=="X")&&f.Estado!=estado.Id?"disabled":null)">@estado.Nombre</option>}</select><small>Cierre, anulación y liquidación usan sus procesos específicos.</small></div>
<div><label for="Ayudante">Ayudante</label><input id="Ayudante" name="Ayudante" maxlength="90" required value="@f.Ayudante" /></div>
<div><label for="Ayudante2">Segundo ayudante</label><input id="Ayudante2" name="Ayudante2" maxlength="90" value="@f.Ayudante2" /></div>
<div><label for="Despacho">Responsable de despacho</label><input id="Despacho" name="Despacho" maxlength="90" required value="@f.Despacho" /></div>
<div><label for="Revisor">Revisor</label><input id="Revisor" name="Revisor" maxlength="90" required value="@f.Revisor" /></div>
<div><label for="Custodio">Custodio</label><select id="Custodio" name="Custodio"><option value="false" selected="@(!f.Custodio?"selected":null)">No</option><option value="true" selected="@(f.Custodio?"selected":null)">Sí</option></select></div>
<div><label for="TipoCustodio">Tipo de custodio</label><input id="TipoCustodio" name="TipoCustodio" maxlength="50" value="@f.TipoCustodio" /></div>
<div class="rwe-wide"><label for="PlantaDestino">Planta de destino</label><input id="PlantaDestino" name="PlantaDestino" maxlength="100" value="@f.PlantaDestino" /></div>
</div></section>
<section class="rwe-section" id="viaje"><div class="rwe-section-head"><span aria-hidden="true">🕒</span><div><h2>Horas y observaciones</h2><p>Control operativo de la ruta en APK66.</p></div></div><div class="rwe-fields">
<div><label for="HoraEncendido">Hora de encendido</label><input id="HoraEncendido" name="HoraEncendido" type="time" step="1" value="@(f.HoraEncendido.HasValue?f.HoraEncendido.Value.ToString(@"hh\:mm\:ss"):"")" /></div>
<div><label for="HoraSalida">Hora de salida</label><input id="HoraSalida" name="HoraSalida" type="time" step="1" value="@(f.HoraSalida.HasValue?f.HoraSalida.Value.ToString(@"hh\:mm\:ss"):"")" /></div>
<div><label for="HoraEntrada">Hora de entrada</label><input id="HoraEntrada" name="HoraEntrada" type="time" step="1" value="@(f.HoraEntrada.HasValue?f.HoraEntrada.Value.ToString(@"hh\:mm\:ss"):"")" /></div>
<div class="rwe-wide"><label for="Observaciones">Observaciones operativas</label><textarea id="Observaciones" name="Observaciones" rows="3">@f.Observaciones</textarea></div>
<div class="rwe-wide"><label for="ObservacionGeneral">Observación general</label><textarea id="ObservacionGeneral" name="ObservacionGeneral" rows="3" maxlength="500">@f.ObservacionGeneral</textarea></div>
<div class="rwe-wide"><label for="Motivo">Motivo de este cambio</label><textarea id="Motivo" name="Motivo" rows="2" maxlength="250" required placeholder="Explica por qué se modifica la ruta">@f.Motivo</textarea></div>
</div><div class="rwe-actions"><button type="submit" class="rwe-btn rwe-btn-primary" id="route-admin-submit"><svg class="icon" aria-hidden="true"><use href="#i-save" /></svg>Revisar y guardar ruta</button></div></section>
}
<section class="rwe-section" id="documentos"><div class="rwe-section-head"><span aria-hidden="true">📄</span><div><h2>Documentos <span class="rwe-count">@Model.Documentos</span></h2><p>Edita facturas, entregas y bultos. Al retirar un detalle se conserva el documento original.</p></div></div>
@using(Html.BeginForm("EditarRuta","Piloto",FormMethod.Get,new{@class="rwe-search"})){<input type="hidden" name="id" value="@Model.Ruta.Id" /><label for="buscarDocumento">Buscar en esta ruta</label><input id="buscarDocumento" name="buscarDocumento" type="search" maxlength="80" value="@Model.BuscarDocumento" placeholder="Número, cliente o dirección" /><button type="submit" class="rwe-btn rwe-btn-secondary">Buscar</button><span>@Model.TotalDocumentosFiltrados resultados</span>}
<div class="rwe-documents" id="rwe-document-list">@foreach(var d in Model.Detalles){<article class="rwe-document" data-search="@((d.Documento+" "+d.Cliente+" "+d.Direccion+" "+d.Tipo).ToLowerInvariant())"><span class="rwe-document-icon" aria-hidden="true">@(d.Entrega=="ENTREGADO"?"✅":d.Entrega=="NO ENTREGADO"?"↩️":"📄")</span><div class="rwe-document-copy"><span>@d.Tipo · @d.Empresa · ROWID @d.RowId</span><h3>@(d.Documento??"Sin número")</h3><p>@(d.Cliente??"Cliente sin registrar") · @d.Bultos bultos</p></div><span class="rwe-result">@(d.Entrega??"Pendiente")</span><div class="rwe-document-actions"><a class="rwe-btn rwe-btn-secondary" href="@Url.Action("EditarDocumento","Piloto",new{id=Model.Ruta.Id,rowId=d.RowId})">✏️ Editar</a><button type="button" class="rwe-btn rwe-btn-danger rwe-delete-trigger" data-row="@d.RowId" data-doc="@d.Documento" data-version="@DiamDev.Give.Entities.PilotoAdminDocumentoReglas.Version(d,f.Version)">Retirar</button></div></article>}</div>
<p class="rwe-empty" id="rwe-no-results" hidden>No encontramos documentos con ese texto.</p>@if(Model.Detalles.Count==0){<p class="rwe-empty">No hay documentos en esta página o búsqueda.</p>}
@if(Model.TotalDocumentosFiltrados>50){<nav class="rwe-pages" aria-label="Páginas de documentos"><span>Página @Model.PaginaDocumentos de @((Model.TotalDocumentosFiltrados+49)/50)</span>@if(Model.PaginaDocumentos>1){<a class="rwe-btn rwe-btn-secondary" href="@Url.Action("EditarRuta","Piloto",new{id=Model.Ruta.Id,paginaDocumento=Model.PaginaDocumentos-1,buscarDocumento=Model.BuscarDocumento})#documentos">Anterior</a>}@if(Model.PaginaDocumentos*50<Model.TotalDocumentosFiltrados){<a class="rwe-btn rwe-btn-secondary" href="@Url.Action("EditarRuta","Piloto",new{id=Model.Ruta.Id,paginaDocumento=Model.PaginaDocumentos+1,buscarDocumento=Model.BuscarDocumento})#documentos">Siguiente</a>}</nav>}
</section>
@if(Model.EsRutaEmpresa){<section class="rwe-section"><div class="rwe-section-head"><span aria-hidden="true">👤</span><div><h2>Conductor real</h2><p>Persona que realiza este viaje para la empresa.</p></div></div>@if(!string.IsNullOrWhiteSpace(Model.ConductorReal)){<p class="rwe-feedback">@Model.ConductorReal · @Model.DocumentoConductor</p>}@using(Html.BeginForm("AsignarConductor","Piloto",FormMethod.Post,new{@class="rwe-form"})){@Html.AntiForgeryToken()<input type="hidden" name="RutaId" value="@Model.Ruta.Id" /><input type="hidden" name="EmpresaUsuarioId" value="@Model.EmpresaUsuarioId" /><input type="hidden" name="Version" value="@Model.VersionConductor" /><div class="rwe-fields"><div><label for="conductor-nombre">Nombre completo</label><input id="conductor-nombre" name="Nombre" maxlength="120" required value="@Model.ConductorReal" /></div><div><label for="conductor-documento">Documento o licencia</label><input id="conductor-documento" name="Documento" maxlength="30" required value="@Model.DocumentoConductor" /></div><div class="rwe-wide"><label for="conductor-motivo">Motivo</label><textarea id="conductor-motivo" name="Motivo" maxlength="250" required rows="2"></textarea></div></div><button class="rwe-btn rwe-btn-secondary" type="submit">Guardar conductor</button>}</section>}
<section class="rwe-section" id="historial"><div class="rwe-section-head"><span aria-hidden="true">📋</span><div><h2>Historial y datos técnicos</h2><p>@Model.Historial.Count cambios administrativos registrados.</p></div></div><details class="rwe-technical"><summary>Ver fechas y usuarios del sistema</summary><p>@Model.CamposTecnicos</p></details>@foreach(var cambio in Model.Historial){<details class="rwe-history"><summary><strong>@cambio.FechaUtc.AddHours(-6).ToString("dd/MM/yyyy HH:mm:ss")</strong> · @cambio.Actor · @cambio.Motivo</summary><div class="route-admin-history-data"><div><h3>Antes</h3><pre>@cambio.Antes</pre></div><div><h3>Después</h3><pre>@cambio.Despues</pre></div></div></details>}@if(Model.Historial.Count==0){<p class="rwe-empty">Todavía no hay cambios administrativos.</p>}</section>
<dialog id="route-admin-dialog" class="route-admin-dialog" aria-labelledby="route-admin-dialog-title"><h2 id="route-admin-dialog-title">Confirmar cambios de la ruta</h2><p>Se guardarán los datos y el motivo en el historial.</p><div class="modal-actions"><button type="button" class="button-secondary" id="route-admin-cancel">Volver a revisar</button><button type="button" id="route-admin-confirm">Confirmar y guardar</button></div></dialog>
<dialog id="rwe-delete-dialog" class="route-admin-dialog" aria-labelledby="rwe-delete-title"><h2 id="rwe-delete-title">Retirar documento</h2><p>Se quitará la factura <strong id="rwe-delete-number"></strong> de la ruta. La factura original se conserva.</p>@using(Html.BeginForm("EliminarDocumento","Piloto",FormMethod.Post,new{id="rwe-delete-form"})){@Html.AntiForgeryToken()<input type="hidden" name="rutaId" value="@Model.Ruta.Id" /><input type="hidden" name="rowId" /><input type="hidden" name="version" /><label for="rwe-delete-reason">Motivo de eliminación</label><textarea id="rwe-delete-reason" name="motivo" minlength="5" maxlength="250" required rows="2"></textarea><div class="modal-actions"><button type="button" class="button-secondary" id="rwe-delete-cancel">Cancelar</button><button type="submit" class="rwe-btn-danger" id="rwe-delete-confirm">Retirar de la ruta</button></div>}</dialog>
</div></div>
@section scripts { <script src="@Url.Content("~/Scripts/pilotos-admin-ruta.js")"></script> }
