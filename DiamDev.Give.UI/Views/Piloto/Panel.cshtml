@model DiamDev.Give.Entities.PilotoPanelModelo
@using System.Linq
@using System.Web.Routing
@{
    Layout="~/Views/Shared/_PilotoLayout.cshtml";
    ViewBag.Title="Panel de distribución"; ViewBag.EsPanel=true;
    var f=Model.Filtro;
    var secciones=new[]{"resumen","rutas","pilotos","documentos","actividad","alertas"};
    var titulos=new[]{"Resumen","Rutas","Pilotos","Documentos","Actividad","Alertas"};
}
<section class="panel-heading"><div><p class="eyebrow">CONTROL DE DISTRIBUCIÓN</p><h1>Panel de distribución</h1><p class="intro">Todos los pilotos y centros. Avance guardado y resultados de @Model.Catalogo.</p></div><div class="panel-heading-actions"><button type="button" class="button-secondary" id="panel-refresh"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>Actualizar</button>@if(Model.PuedeAdministrar){<a class="button-link" href="@Url.Action("Administracion","Piloto")">Administrar pilotos<svg class="icon" aria-hidden="true"><use href="#i-settings" /></svg></a>}</div></section>
<div id="panel-message" class="panel-message" role="alert" hidden><span></span><button type="button" aria-label="Cerrar mensaje">×</button></div>
<details class="panel-filter-details" id="panel-filter-details" open><summary><span>Filtros de rutas y pilotos</span><small>@f.Desde — @f.Hasta · @(f.Liquidacion=="no"?"Sin liquidar":f.Liquidacion=="si"?"Liquidadas":"Todas")</small></summary>
<form id="panel-filters" class="panel-filters" action="@Url.Action("Panel","Piloto")" method="get" novalidate>
    <input type="hidden" name="Seccion" value="@f.Seccion" />
    <div class="panel-presets" aria-label="Períodos rápidos"><span>Período de las rutas</span><button type="button" data-period="hoy">Hoy</button><button type="button" data-period="ayer">Ayer</button><button type="button" data-period="semana">Últimos 7 días</button></div>
    <div class="panel-filter-grid">
        <div><label for="panel-desde">Desde</label><input id="panel-desde" type="date" name="Desde" required value="@f.Desde" /></div>
        <div><label for="panel-hasta">Hasta</label><input id="panel-hasta" type="date" name="Hasta" required value="@f.Hasta" /></div>
        <div><label for="panel-estado">Estado</label><select id="panel-estado" name="Estado">@foreach(var e in new[]{"todos","E","A","C","X"}){<option value="@e" selected="@(f.Estado==e)">@(e=="todos"?"Todos":e=="E"?"En ruta":e=="A"?"Abiertas":e=="C"?"Cerradas":"Anuladas")</option>}</select></div>
        <div><label for="panel-liquidacion">Liquidación</label><select id="panel-liquidacion" name="Liquidacion">@foreach(var e in new[]{"no","si","todas"}){<option value="@e" selected="@(f.Liquidacion==e)">@(e=="no"?"Sin liquidar":e=="si"?"Liquidadas":"Todas")</option>}</select></div>
        <div><label for="panel-piloto">Empleado piloto</label><input id="panel-piloto" name="Piloto" value="@f.Piloto" maxlength="90" list="panel-empleados" placeholder="Todos" /><datalist id="panel-empleados">@foreach(var p in Model.NombresPiloto){<option value="@p"></option>}</datalist></div>
        <div><label for="panel-usuario">Usuario POS</label><select id="panel-usuario" name="Usuario"><option value="">Todos</option>@foreach(var p in Model.Pilotos){<option value="@p.Id" selected="@(f.Usuario==p.Id)">@p.Login · @p.Nombre</option>}</select></div>
        <div><label for="panel-centro">Centro</label><input id="panel-centro" name="Centro" value="@f.Centro" maxlength="15" list="panel-centros" placeholder="Todos" /><datalist id="panel-centros">@foreach(var c in Model.Centros){<option value="@c"></option>}</datalist></div>
        <div><label for="panel-placa">Placa</label><input id="panel-placa" name="Placa" value="@f.Placa" maxlength="15" list="panel-placas" placeholder="Todas" /><datalist id="panel-placas">@foreach(var p in Model.Placas){<option value="@p"></option>}</datalist></div>
        <div><label for="panel-avance">Avance de clientes</label><select id="panel-avance" name="Avance">@foreach(var e in new[]{"todos","sin","parcial","listo"}){<option value="@e" selected="@(f.Avance==e)">@(e=="todos"?"Todos":e=="sin"?"Sin clientes completados":e=="parcial"?"Avance parcial":"Pendiente de cerrar")</option>}</select></div>
        <div><label for="panel-resultado">Resultado de documento</label><select id="panel-resultado" name="Resultado">@foreach(var e in new[]{"todos","PENDIENTE","ENTREGADO","NO ENTREGADO","INCIDENCIA"}){<option value="@e" selected="@(f.Resultado==e)">@(e=="todos"?"Todos":e)</option>}</select></div>
        <div><label for="panel-buscar">Ruta, cliente o documento</label><input id="panel-buscar" name="Buscar" value="@f.Buscar" maxlength="100" placeholder="Buscar en el período" /></div>
        <div><label for="panel-evento">Actividad</label><select id="panel-evento" name="Evento">@foreach(var e in new[]{"todos","Cliente","Foto documento","Foto cliente","Cierre POS","Vínculo","Centro","Vehículo"}){<option value="@e" selected="@(f.Evento==e)">@(e=="todos"?"Todos los eventos":e)</option>}</select></div>
    </div>
    <div class="panel-filter-actions"><small>Hasta 31 días. Actividad por fecha del evento, hora Guatemala; avance sobre la ruta completa.</small><a class="button-link button-secondary" href="@Url.Action("Panel","Piloto")">Limpiar filtros</a><button type="submit">Aplicar filtros<svg class="icon" aria-hidden="true"><use href="#i-search" /></svg></button></div>
</form>
</details>
<div class="panel-toolbar"><nav class="panel-tabs" aria-label="Secciones del panel">@for(var i=0;i<secciones.Length;i++){<a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(secciones[i])))" aria-current="@(f.Seccion==secciones[i]?"page":null)">@titulos[i]</a>}</nav><label class="panel-auto"><input type="checkbox" id="panel-auto" />Actualizar cada 60 s</label></div>
<div id="panel-content" data-refresh-url="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:f.Pagina)))" aria-busy="false">@Html.Partial("_PanelContenido",Model)</div>
<div id="panel-toast" class="panel-toast" role="status" aria-live="polite" hidden></div>
@section scripts { <script src="@Url.Content("~/Scripts/pilotos-panel.js")"></script> }
