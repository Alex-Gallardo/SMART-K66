@model DiamDev.Give.Entities.PilotoPanelModelo
@using System.Linq
@using System.Web.Routing
@using DiamDev.Give.Entities
@{
    Layout="~/Views/Shared/_PilotoLayout.cshtml";ViewBag.EsPanel=true;ViewBag.Title="Consulta de ruta";
    var r=Model.Detalle;var f=Model.Filtro;
}
<a class="back-link" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:f.Pagina)))"><svg class="icon" aria-hidden="true"><use href="#i-back" /></svg>Volver al panel con mis filtros</a>
<section class="panel-heading"><div><p class="eyebrow">CONSULTA ADMINISTRATIVA · @Model.Catalogo</p><h1>@r.Datos.Id</h1><p class="intro">@r.Datos.Piloto · @r.Datos.Centro · @r.Datos.Placa</p></div><div><span class="status status-@r.Datos.Estado">@r.Datos.EstadoNombre</span><span class="panel-badge">@(r.Liquidada?"Liquidada":"Sin liquidar")</span></div></section>
<div class="panel-notice"><svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg><p>Esta vista es de consulta. Los resultados POS pendientes se aplican a @Model.Catalogo únicamente cuando el piloto confirma el cierre.</p></div>
<div class="panel-kpis panel-detail-kpis"><div class="panel-kpi"><span>Fecha de ruta</span><strong class="panel-value-small">@r.Datos.Fecha.ToString("dd/MM/yyyy")</strong></div><div class="panel-kpi"><span>Clientes completados</span><strong>@r.Completados <em>/ @r.Clientes.Count</em></strong></div><div class="panel-kpi"><span>Documentos</span><strong>@r.Documentos.Count()</strong></div><div class="panel-kpi"><span>Usuario POS con acceso actual</span><strong class="panel-value-small">@(r.Pilotos.Count==0?"Sin coincidencia":string.Join(" / ",r.Pilotos.Select(p=>p.Login)))</strong></div></div>
@if(r.FechaCierre.HasValue){<p class="panel-notice">Última fecha de monitoreo registrada en @Model.Catalogo: @r.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm:ss") · operador @r.OperadorCierre. Hora del servidor de rutas.</p>}
@foreach(var a in r.Alertas){<div class="panel-notice panel-warning-text" role="status"><p>@a</p></div>}
@if(Model.PuedeAdministrar){<div class="panel-inline-actions">@foreach(var p in r.Pilotos){<a class="button-link button-secondary" href="@Url.Action("Configurar","Piloto",new{id=p.Id})">Configurar @p.Login</a>}</div>}
@foreach(var c in r.Clientes){
<details class="panel-client panel-surface"><summary><div><p class="eyebrow">CLIENTE · @c.Documentos.Count documentos</p><h2>@(c.Nombre??"Sin nombre")</h2><span>@c.Direccion</span></div><div><span class="panel-badge @(c.Completado?"panel-success":"")">@(c.Completado?(r.Datos.Estado=="C"?"Resultados registrados":"Completado en POS"):"Pendiente")</span>@if(c.FechaUtc.HasValue){<small>@PilotoPanelReglas.HoraGuatemala(c.FechaUtc.Value).ToString("dd/MM/yyyy HH:mm") · Guatemala</small>}<span class="panel-expand-label">Ver documentos</span></div></summary>
    <div class="panel-client-body">@if(c.Foto){<a class="button-link button-secondary panel-photo" href="@Url.Action("PanelImagen","Piloto",new{id=r.Datos.Id,rowId=c.Primero,cliente=true})" target="_blank" rel="noopener">Ver foto final en POS</a>}
    @foreach(var d in c.Documentos){<article class="panel-document"><div class="panel-section-heading"><div><p class="eyebrow">@d.Datos.Tipo · @d.Datos.Empresa</p><h3>@d.Datos.Documento</h3></div><span class="panel-badge">@d.Resultado</span></div><dl class="panel-document-data"><div><dt>Visitó</dt><dd>@(d.Datos.Visito.HasValue?(d.Datos.Visito.Value?"Sí":"No"):"Sin registrar")</dd></div><div><dt>Motivo</dt><dd>@(d.Datos.Motivo??"Sin motivo")</dd></div><div><dt>Bultos</dt><dd>@d.Datos.Bultos</dd></div><div><dt>Fuente</dt><dd>@d.Fuente</dd></div></dl>@if(!string.IsNullOrWhiteSpace(d.Datos.ObservacionPiloto)){<p><strong>Observación POS pendiente:</strong> @d.Datos.ObservacionPiloto</p>}@if(!string.IsNullOrWhiteSpace(d.Datos.Observaciones)){<p><strong>Observación registrada:</strong> @d.Datos.Observaciones</p>}@if(d.Foto){<a class="panel-text-link panel-photo" href="@Url.Action("PanelImagen","Piloto",new{id=r.Datos.Id,rowId=d.Datos.RowId})" target="_blank" rel="noopener">Ver fotografía del documento en POS</a>}</article>}
    </div>
</details>}
<section class="panel-surface"><h2>Actividad de esta ruta en el período seleccionado</h2>@foreach(var a in Model.Actividad.Take(100)){<div class="panel-activity-item"><time>@PilotoPanelReglas.HoraGuatemala(a.FechaUtc).ToString("dd/MM/yyyy HH:mm:ss")</time><strong>@a.Tipo · @a.Actor</strong><p>@a.Descripcion</p><small>@a.Clave</small></div>}@if(Model.Actividad.Count==0){<p class="muted">No hay eventos guardados en este período.</p>}@if(Model.Actividad.Count>100){var valores=new RouteValueDictionary(f.Valores("actividad"));valores["Buscar"]=r.Datos.Id;<a href="@Url.Action("Panel","Piloto",valores)">Ver los @Model.Actividad.Count eventos en el listado paginado</a>}</section>
@foreach(var aviso in Model.Avisos){<div class="panel-notice"><p>@aviso</p></div>}
<div id="panel-photo-dialog" class="panel-photo-dialog" role="dialog" aria-modal="true" aria-labelledby="panel-photo-title" hidden><div class="panel-photo-surface"><div class="panel-section-heading"><h2 id="panel-photo-title">Fotografía guardada en POS</h2><button type="button" id="panel-photo-close" class="button-secondary">Cerrar</button></div><p id="panel-photo-state" role="status">Cargando fotografía…</p><img id="panel-photo-image" alt="Fotografía adjunta al documento o cliente" /><a id="panel-photo-original" target="_blank" rel="noopener">Abrir imagen original</a><small>El origen histórico de una imagen POS no incluye el catálogo de rutas.</small></div></div>
@section scripts { <script src="@Url.Content("~/Scripts/pilotos-panel.js")"></script> }
