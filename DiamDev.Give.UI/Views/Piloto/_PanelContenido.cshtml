@model DiamDev.Give.Entities.PilotoPanelModelo
@using System.Linq
@using System.Web.Routing
@using DiamDev.Give.Entities
@{
    var f=Model.Filtro;
    var docs=Model.Rutas.SelectMany(r=>r.Documentos).Where(d=>(f.Resultado=="todos" || d.Resultado==f.Resultado) && (string.IsNullOrEmpty(f.Buscar) || PilotoPanelReglas.Contiene(d.Ruta,f.Buscar) || PilotoPanelReglas.Contiene(d.Datos.Documento,f.Buscar) || PilotoPanelReglas.Contiene(d.Datos.Cliente,f.Buscar))).ToList();
    var alertas=Model.Rutas.SelectMany(r=>r.Alertas.Select(a=>new {Texto=a,Ruta=r.Datos.Id,Usuario=(long?)null})).Concat(Model.Pilotos.SelectMany(p=>p.Alertas.Select(a=>new {Texto=a,Ruta=(string)null,Usuario=(long?)p.Id}))).ToList();
    System.Func<string,string> detalle=id=>{var v=new RouteValueDictionary(f.Valores(pagina:f.Pagina));v["id"]=id;return Url.Action("PanelDetalle","Piloto",v);};
    System.Func<string,string> exportar=tipo=>{var v=new RouteValueDictionary(f.Valores());v["tipo"]=tipo;return Url.Action("PanelExportar","Piloto",v);};
    var total=f.Seccion=="documentos"?docs.Count:f.Seccion=="pilotos"?Model.Pilotos.Count:f.Seccion=="actividad"?Model.Actividad.Count:f.Seccion=="alertas"?alertas.Count:Model.Rutas.Count;
    var paginas=System.Math.Max(1,(total+PilotoPanelReglas.TamanoPagina-1)/PilotoPanelReglas.TamanoPagina);
    var saltar=(f.Pagina-1)*PilotoPanelReglas.TamanoPagina;
}
<div class="panel-update"><span><span class="panel-live-dot" aria-hidden="true"></span>Actualizado <time datetime="@Model.ActualizadoUtc.ToString("o")">@PilotoPanelReglas.HoraGuatemala(Model.ActualizadoUtc).ToString("dd/MM/yyyy HH:mm:ss")</time> · Guatemala</span><span>@Model.Catalogo · consulta global</span></div>
@foreach(var aviso in Model.Avisos){<div class="panel-notice" role="status"><svg class="icon" aria-hidden="true"><use href="#i-info" /></svg><p>@aviso</p></div>}
@if(f.Seccion=="rutas" || f.Seccion=="resumen"){
    <div class="dist-stat-grid" aria-label="Estado de las rutas filtradas">
        <a class="dist-stat" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas")))"><span class="dist-stat-icon dist-stat-blue" aria-hidden="true"><svg class="icon"><use href="#i-route" /></svg></span><span class="dist-stat-copy"><span>Rutas del período</span><strong>@Model.Rutas.Count</strong><small>Ver lista completa</small></span></a>
        <a class="dist-stat" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas",estado:"E")))"><span class="dist-stat-icon dist-stat-blue" aria-hidden="true"><svg class="icon"><use href="#i-truck" /></svg></span><span class="dist-stat-copy"><span>En ruta</span><strong>@Model.Rutas.Count(r=>r.Datos.Estado=="E")</strong><small>Seguimiento activo</small></span></a>
        <a class="dist-stat dist-stat-ready" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas",avance:"listo")))"><span class="dist-stat-icon" aria-hidden="true"><svg class="icon"><use href="#i-check" /></svg></span><span class="dist-stat-copy"><span>Listas para cerrar</span><strong>@Model.Rutas.Count(r=>r.ListaParaCierre)</strong><small>Clientes completados</small></span></a>
        <a class="dist-stat dist-stat-alert" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("alertas")))"><span class="dist-stat-icon" aria-hidden="true"><svg class="icon"><use href="#i-info" /></svg></span><span class="dist-stat-copy"><span>Para revisar</span><strong>@alertas.Count</strong><small>Ver observaciones</small></span></a>
    </div>
}
@if(f.Seccion=="resumen"){
    <div class="dist-summary-grid">
        <section class="dist-surface"><div class="dist-card-head"><span class="dist-icon" aria-hidden="true"><svg class="icon"><use href="#i-box" /></svg></span><div><h2>Resultado de documentos</h2><p>@docs.Count documentos en las rutas filtradas</p></div></div>
            @foreach(var estado in new[]{"ENTREGADO","NO ENTREGADO","INCIDENCIA","PENDIENTE"}){var n=docs.Count(d=>d.Resultado==estado);<a class="panel-chart-row" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("documentos",resultado:estado)))"><span>@estado</span><progress max="@System.Math.Max(1,docs.Count)" value="@n" aria-label="@estado"></progress><strong>@n</strong></a>}
        </section>
        <section class="dist-surface"><div class="dist-card-head"><span class="dist-icon" aria-hidden="true"><svg class="icon"><use href="#i-route" /></svg></span><div><h2>Estado de rutas</h2><p>Distribución dentro del período seleccionado</p></div></div>
            @foreach(var estado in new[]{"E","A","C","X"}){var n=Model.Rutas.Count(r=>r.Datos.Estado==estado);<a class="panel-chart-row" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas",estado:estado)))"><span>@(estado=="E"?"En ruta":estado=="A"?"Abiertas":estado=="C"?"Cerradas":"Anuladas")</span><progress max="@System.Math.Max(1,Model.Rutas.Count)" value="@n" aria-label="Rutas @estado"></progress><strong>@n</strong></a>}
        </section>
    </div>
}
<section class="dist-surface dist-results panel-results">
    <div class="dist-results-head"><div><span class="dist-kicker">Consulta</span><h2>@(f.Seccion=="resumen"?"Rutas del período":f.Seccion=="rutas"?"Rutas":f.Seccion=="pilotos"?"Pilotos y configuración":f.Seccion=="documentos"?"Documentos":f.Seccion=="actividad"?"Actividad guardada":"Observaciones para revisar") <span class="dist-count">@total</span></h2><p>@(f.Seccion=="rutas" || f.Seccion=="resumen"?"Abre una ruta para consultar clientes, facturas y seguimiento.":f.Seccion=="documentos"?"Facturas y documentos de las rutas filtradas.":f.Seccion=="actividad"?"Eventos guardados, en hora Guatemala.":"Información correspondiente a los filtros seleccionados.")</p></div><div class="panel-inline-actions">@if(f.Seccion=="rutas" || f.Seccion=="resumen"){<a class="dist-btn dist-btn-outline panel-export" href="@exportar("rutas")">Exportar rutas CSV</a>}@if(f.Seccion=="documentos"){<a class="dist-btn dist-btn-outline panel-export" href="@exportar("documentos")">Exportar documentos CSV</a>}</div></div>
    @if(total==0){<div class="panel-empty"><span class="dist-empty-icon" aria-hidden="true"><svg class="icon"><use href="#i-search" /></svg></span><h3>No hay resultados con estos filtros</h3><p>Prueba con otro período o limpia los filtros para ver más rutas.</p><a class="dist-btn dist-btn-outline" href="@Url.Action("Panel","Piloto")">Limpiar filtros</a></div>}
    else if(f.Pagina>paginas){<div class="panel-notice" role="status"><p>Esta página ya no tiene registros. <a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores()))">Volver a la primera página</a>.</p></div>}
    else if(f.Seccion=="rutas" || f.Seccion=="resumen"){
        <div class="panel-table-wrap"><table class="panel-table dist-routes-table"><caption class="sr-only">Rutas de todos los pilotos con los filtros seleccionados</caption><thead><tr><th>Ruta</th><th>Piloto y unidad</th><th>Estado</th><th>Avance</th><th>Documentos</th><th><span class="sr-only">Abrir ruta</span></th></tr></thead><tbody>
        @foreach(var r in Model.Rutas.Skip(saltar).Take(PilotoPanelReglas.TamanoPagina)){
            <tr class="@(r.Datos.Estado=="C"?"panel-table-complete":"")">
                <td data-label="Ruta"><a class="dist-route-id" href="@detalle(r.Datos.Id)">@r.Datos.Id</a><small><svg class="icon" aria-hidden="true"><use href="#i-calendar" /></svg>@r.Datos.Fecha.ToString("dd/MM/yyyy")</small></td>
                <td data-label="Piloto y unidad"><strong>@(r.Datos.CuentaEmpresa && r.Datos.ConductorAsignado ? r.Datos.ConductorReal : r.Datos.Piloto??"Sin asignar")</strong><small>@(r.Datos.Centro??"Sin centro") · @(r.Datos.Placa??"Sin placa")</small><small>@(r.Pilotos.Count==0?"Sin acceso POS coincidente":string.Join(" / ",r.Pilotos.Select(p=>p.Login)))</small></td>
                <td data-label="Estado"><span class="dist-status dist-status-@r.Datos.Estado">@r.Datos.EstadoNombre</span><small>@(r.Liquidada?"Liquidada":"Sin liquidar")</small></td>
                <td data-label="Avance"><strong>@r.Completados de @r.Clientes.Count clientes</strong><progress max="100" value="@r.Porcentaje" aria-label="Avance de @r.Datos.Id"></progress>@if(r.ListaParaCierre){<small class="panel-success">Lista para confirmar</small>}</td>
                <td data-label="Documentos"><strong>@r.Documentos.Count()</strong><small>@(r.Alertas.Count>0?r.Alertas.Count+" observaciones":"Sin observaciones")</small><small>@(r.ActividadUtc.HasValue?PilotoPanelReglas.HoraGuatemala(r.ActividadUtc.Value).ToString("dd/MM HH:mm")+" · última actividad":"Sin actividad POS")</small></td>
                <td data-label="Acción"><a class="dist-row-link" href="@detalle(r.Datos.Id)">Ver ruta <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></a></td>
            </tr>
        }
        </tbody></table></div>
    }
    else if(f.Seccion=="pilotos"){
        <div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Usuario POS</th><th>Empleado / operador</th><th>Centros / vehículos</th><th>Configuración</th><th>Rutas</th><th>Acción</th></tr></thead><tbody>
        @foreach(var p in Model.Pilotos.Skip(saltar).Take(PilotoPanelReglas.TamanoPagina)){var v=new RouteValueDictionary(f.Valores("rutas"));v["Usuario"]=p.Id;<tr><td data-label="Usuario POS"><strong>@p.Login</strong><small>@p.Nombre</small></td><td data-label="Empleado / operador">@(p.CuentaEmpresa?"Empresa · acceso por placa":p.Empleado??"Sin empleado")<small>@(p.Operador??"Sin operador")</small></td><td data-label="Centros / vehículos">@(p.CuentaEmpresa?"Centros: no aplican":string.Join(", ",p.Centros))<small>@string.Join(", ",p.Placas)</small></td><td data-label="Configuración"><span class="dist-status @(p.Alertas.Count==0?"dist-status-C":"dist-status-X")">@(p.Alertas.Count==0?"Disponible":p.Alertas.Count+" observaciones")</span>@if(p.Alertas.Count>0){<details><summary>Ver observaciones</summary>@foreach(var a in p.Alertas){<p>@a</p>}</details>}</td><td data-label="Rutas">@p.Rutas</td><td data-label="Acción"><a class="dist-row-link" href="@Url.Action("Panel","Piloto",v)">Ver rutas</a>@if(Model.PuedeAdministrar){<a class="panel-text-link" href="@Url.Action("Configurar","Piloto",new{id=p.Id})">Configurar piloto</a>}</td></tr>}
        </tbody></table></div>
    }
    else if(f.Seccion=="documentos"){
        <div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Documento</th><th>Cliente</th><th>Resultado</th><th>Motivo / observaciones</th><th>Fuente</th><th>Acción</th></tr></thead><tbody>
        @foreach(var d in docs.Skip(saltar).Take(PilotoPanelReglas.TamanoPagina)){<tr><td data-label="Documento"><strong>@d.Datos.Documento</strong><small>@d.Ruta · @d.Datos.Tipo · @d.Datos.Empresa</small></td><td data-label="Cliente">@d.Datos.Cliente<small>@d.Datos.Direccion</small></td><td data-label="Resultado"><span class="dist-status @(d.Resultado=="ENTREGADO"?"dist-status-C":d.Resultado=="INCIDENCIA"?"dist-status-X":"dist-status-A")">@d.Resultado</span><small>Visitó: @(d.Datos.Visito.HasValue?(d.Datos.Visito.Value?"Sí":"No"):"Sin registrar")</small></td><td data-label="Motivo / observaciones">@d.Datos.Motivo<small>@(d.Datos.ObservacionPiloto??d.Datos.Observaciones)</small></td><td data-label="Fuente">@d.Fuente</td><td data-label="Acción"><a class="dist-row-link" href="@detalle(d.Ruta)">Ver ruta</a>@if(d.Foto){<a class="panel-text-link panel-photo" href="@Url.Action("PanelImagen","Piloto",new{id=d.Ruta,rowId=d.Datos.RowId})" target="_blank" rel="noopener">Ver fotografía POS</a>}</td></tr>}
        </tbody></table></div>
    }
    else if(f.Seccion=="actividad"){
        <div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Fecha</th><th>Evento</th><th>Ruta</th><th>Actor / usuario</th><th>Detalle</th></tr></thead><tbody>
        @foreach(var a in Model.Actividad.Skip(saltar).Take(PilotoPanelReglas.TamanoPagina)){<tr><td data-label="Fecha">@PilotoPanelReglas.HoraGuatemala(a.FechaUtc).ToString("dd/MM/yyyy HH:mm:ss")</td><td data-label="Evento"><span class="dist-status dist-status-A">@a.Tipo</span></td><td data-label="Ruta">@if(a.Ruta!=null){<a class="dist-row-link" href="@detalle(a.Ruta)">@a.Ruta</a>}else{<span>Configuración POS</span>}</td><td data-label="Actor / usuario">@a.Actor<small>Usuario @a.Usuario</small></td><td data-label="Detalle">@a.Descripcion<small>@a.Clave</small></td></tr>}
        </tbody></table></div>
    }
    else{
        <div class="dist-alert-list">@foreach(var a in alertas.Skip(saltar).Take(PilotoPanelReglas.TamanoPagina)){<article class="panel-alert"><span class="dist-icon dist-icon-warning" aria-hidden="true"><svg class="icon"><use href="#i-info" /></svg></span><div><strong>@(a.Ruta??"Usuario POS "+a.Usuario)</strong><p>@a.Texto</p></div>@if(a.Ruta!=null){<a class="dist-row-link" href="@detalle(a.Ruta)">Revisar ruta</a>}else if(Model.PuedeAdministrar){<a class="dist-row-link" href="@Url.Action("Configurar","Piloto",new{id=a.Usuario})">Revisar configuración</a>}else{<span class="muted">Solicitar revisión a Administración</span>}</article>}</div>
    }
    @if(total>0 && f.Pagina<=paginas){<p class="panel-page-count">Mostrando @(saltar+1)–@System.Math.Min(total,saltar+PilotoPanelReglas.TamanoPagina) de @total resultados · máximo @PilotoPanelReglas.TamanoPagina por página</p>}
    @if(paginas>1){<nav class="pagination" aria-label="Páginas del panel">@if(f.Pagina>1){<a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:1)))">Primera</a><a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:f.Pagina-1)))">Anterior</a>}<span>Página @f.Pagina de @paginas</span>@if(f.Pagina<paginas){<a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:f.Pagina+1)))">Siguiente</a><a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:paginas)))">Última</a>}</nav>}
</section>
