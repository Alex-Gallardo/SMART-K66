@model DiamDev.Give.Entities.PilotoPanelModelo
@using System.Linq
@using System.Web.Routing
@using DiamDev.Give.Entities
@{
    var f=Model.Filtro;
    var docs=Model.Rutas.SelectMany(r=>r.Documentos).Where(d=>(f.Resultado=="todos" || d.Resultado==f.Resultado) && (string.IsNullOrEmpty(f.Buscar) || PilotoPanelReglas.Contiene(d.Ruta,f.Buscar) || PilotoPanelReglas.Contiene(d.Datos.Documento,f.Buscar) || PilotoPanelReglas.Contiene(d.Datos.Cliente,f.Buscar))).ToList();
    var alertas=Model.Rutas.SelectMany(r=>r.Alertas.Select(a=>new {Texto=a,Ruta=r.Datos.Id,Usuario=(long?)null})).Concat(Model.Pilotos.SelectMany(p=>p.Alertas.Select(a=>new {Texto=a,Ruta=(string)null,Usuario=(long?)p.Id}))).ToList();
    System.Func<string,string> detalle=id=>{var v=new RouteValueDictionary(f.Valores(pagina:f.Pagina));v["id"]=id;return Url.Action("PanelDetalle","Piloto",v);};
    System.Func<string,string> exportar=tipo=>{var v=new RouteValueDictionary(f.Valores());v["tipo"]=tipo;return Url.Action("PanelExportar","Piloto",v);};
    var total=f.Seccion=="documentos"?docs.Count:f.Seccion=="pilotos"?Model.Pilotos.Count:f.Seccion=="actividad"?Model.Actividad.Count:f.Seccion=="alertas"?alertas.Count:Model.Rutas.Count;
    var paginas=System.Math.Max(1,(total+24)/25);var saltar=(f.Pagina-1)*25;
}
<div class="panel-update"><span><span class="panel-live-dot" aria-hidden="true"></span>Actualizado <time datetime="@Model.ActualizadoUtc.ToString("o")">@PilotoPanelReglas.HoraGuatemala(Model.ActualizadoUtc).ToString("dd/MM/yyyy HH:mm:ss")</time> · Guatemala</span><span>@Model.Catalogo · consulta global</span></div>
@foreach(var aviso in Model.Avisos){<div class="panel-notice" role="status"><svg class="icon" aria-hidden="true"><use href="#i-info" /></svg><p>@aviso</p></div>}
@if(f.Seccion=="resumen") {
    <div class="panel-kpis">
        @foreach(var e in new[]{"E","A","C","X"}){<a class="panel-kpi" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas",estado:e)))"><span>@(e=="E"?"En ruta":e=="A"?"Abiertas":e=="C"?"Cerradas":"Anuladas")</span><strong>@Model.Rutas.Count(r=>r.Datos.Estado==e)</strong><small>Ver rutas →</small></a>}
        <a class="panel-kpi" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas",avance:"listo")))"><span>Pendientes de cierre</span><strong>@Model.Rutas.Count(r=>r.ListaParaCierre)</strong><small>Clientes guardados →</small></a>
        <a class="panel-kpi" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("pilotos")))"><span>Pilotos con rutas</span><strong>@Model.Pilotos.Count(p=>p.Rutas>0)</strong><small>Ver pilotos →</small></a>
        <a class="panel-kpi" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas")))"><span>Clientes completados</span><strong>@Model.Rutas.Sum(r=>r.Completados)<em>/ @Model.Rutas.Sum(r=>r.Clientes.Count)</em></strong><small>@Model.Rutas.Sum(r=>r.Clientes.Count-r.Completados) pendientes →</small></a>
        <a class="panel-kpi panel-kpi-warning" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("alertas")))"><span>Observaciones para revisar</span><strong>@alertas.Count</strong><small>Ver alertas →</small></a>
    </div>
    <div class="panel-charts"><section class="panel-surface"><h2>Resultados de documentos</h2><p class="muted">@docs.Count documentos con los filtros actuales.</p>@foreach(var estado in new[]{"ENTREGADO","NO ENTREGADO","INCIDENCIA","PENDIENTE"}){var n=docs.Count(d=>d.Resultado==estado);<a class="panel-chart-row" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("documentos",resultado:estado)))"><span>@estado</span><progress max="@System.Math.Max(1,docs.Count)" value="@n" aria-label="@estado"></progress><strong>@n</strong></a>}</section>
        <section class="panel-surface"><h2>Distribución de rutas</h2><p class="muted">@Model.Rutas.Count rutas · @(f.Liquidacion=="no"?"sin liquidar":f.Liquidacion=="si"?"liquidadas":"todas las liquidaciones").</p>@foreach(var estado in new[]{"E","A","C","X"}){var n=Model.Rutas.Count(r=>r.Datos.Estado==estado);<a class="panel-chart-row" href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores("rutas",estado:estado)))"><span>@(estado=="E"?"En ruta":estado=="A"?"Abiertas":estado=="C"?"Cerradas":"Anuladas")</span><progress max="@System.Math.Max(1,Model.Rutas.Count)" value="@n" aria-label="Rutas @estado"></progress><strong>@n</strong></a>}</section></div>
    <div class="panel-notice"><svg class="icon" aria-hidden="true"><use href="#i-info" /></svg><p>Se muestra actividad guardada. Las respuestas aún sin guardar y la ubicación del piloto no están disponibles. Los clientes se agrupan por nombre y dirección.</p></div>
}
<section class="panel-surface panel-results">
<div class="panel-section-heading"><h2>@(f.Seccion=="resumen"?"Rutas del período":f.Seccion=="rutas"?"Rutas":f.Seccion=="pilotos"?"Pilotos y configuración":f.Seccion=="documentos"?"Documentos":f.Seccion=="actividad"?"Actividad guardada":"Observaciones para revisar") <span class="count">@total</span></h2><div class="panel-inline-actions">@if(f.Seccion=="rutas" || f.Seccion=="resumen"){<a class="button-link button-secondary panel-export" href="@exportar("rutas")">Exportar rutas CSV</a>}@if(f.Seccion=="documentos"){<a class="button-link button-secondary panel-export" href="@exportar("documentos")">Exportar documentos CSV</a>}</div></div>
@if(total==0){<div class="panel-empty"><svg class="icon" aria-hidden="true"><use href="#i-search" /></svg><h3>No hay registros con estos filtros</h3><p>Revisa el período, estado, liquidación y asignaciones.</p></div>}
else if(f.Pagina>paginas){<div class="panel-notice" role="status"><p>Esta página ya no tiene registros. <a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores()))">Volver a la primera página</a>.</p></div>}
else if(f.Seccion=="rutas" || f.Seccion=="resumen"){
<div class="panel-table-wrap"><table class="panel-table"><caption class="sr-only">Rutas de todos los pilotos con los filtros seleccionados</caption><thead><tr><th>Ruta / fecha</th><th>Estado</th><th>Piloto / usuario POS</th><th>Centro / placa</th><th>Avance clientes</th><th>Documentos</th><th>Actividad guardada</th><th>Acción</th></tr></thead><tbody>
@foreach(var r in Model.Rutas.Skip(saltar).Take(25)){<tr><td data-label="Ruta / fecha"><strong>@r.Datos.Id</strong><small>@r.Datos.Fecha.ToString("dd/MM/yyyy")</small></td><td data-label="Estado"><span class="status status-@r.Datos.Estado">@r.Datos.EstadoNombre</span><small>@(r.Liquidada?"Liquidada":"Sin liquidar")</small></td><td data-label="Piloto / usuario"><strong>@r.Datos.Piloto</strong><small>@(r.Pilotos.Count==0?"Sin acceso POS coincidente":string.Join(" / ",r.Pilotos.Select(p=>p.Login)))</small></td><td data-label="Centro / placa">@r.Datos.Centro<small>@r.Datos.Placa</small></td><td data-label="Avance clientes"><span>@r.Completados / @r.Clientes.Count</span><progress max="100" value="@r.Porcentaje" aria-label="Avance de @r.Datos.Id"></progress>@if(r.ListaParaCierre){<small class="panel-success">Pendiente de confirmar cierre</small>}</td><td data-label="Documentos">@r.Documentos.Count()@if(r.Alertas.Count>0){<small class="panel-warning-text">@r.Alertas.Count observaciones</small>}</td><td data-label="Actividad guardada">@(r.ActividadUtc.HasValue?PilotoPanelReglas.HoraGuatemala(r.ActividadUtc.Value).ToString("dd/MM HH:mm"):"Sin actividad POS")</td><td data-label="Acción"><a class="button-link button-secondary" href="@detalle(r.Datos.Id)">Ver detalle</a></td></tr>}
</tbody></table></div>
}
else if(f.Seccion=="pilotos"){
<p class="muted">Configuración de los usuarios seleccionados; el número de rutas responde al período y filtros de rutas.</p><div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Usuario POS</th><th>Empleado / operador</th><th>Centros / vehículos</th><th>Configuración</th><th>Rutas</th><th>Acción</th></tr></thead><tbody>
@foreach(var p in Model.Pilotos.Skip(saltar).Take(25)){var v=new RouteValueDictionary(f.Valores("rutas"));v["Usuario"]=p.Id;<tr><td data-label="Usuario POS"><strong>@p.Login</strong><small>@p.Nombre</small></td><td data-label="Empleado / operador">@(p.Empleado??"Sin empleado")<small>@(p.Operador??"Sin operador")</small></td><td data-label="Centros / vehículos">@string.Join(", ",p.Centros)<small>@string.Join(", ",p.Placas)</small></td><td data-label="Configuración"><span class="panel-badge @(p.Alertas.Count==0?"panel-success":"panel-warning-text")">@(p.Alertas.Count==0?"Disponible":p.Alertas.Count+" observaciones")</span><details><summary>Ver configuración</summary>@foreach(var a in p.Alertas){<p>@a</p>}</details></td><td data-label="Rutas">@p.Rutas</td><td data-label="Acción"><a class="button-link button-secondary" href="@Url.Action("Panel","Piloto",v)">Ver rutas</a>@if(Model.PuedeAdministrar){<a class="panel-text-link" href="@Url.Action("Configurar","Piloto",new{id=p.Id})">Configurar piloto</a>}</td></tr>}
</tbody></table></div>
}
else if(f.Seccion=="documentos"){
<div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Ruta / documento</th><th>Cliente</th><th>Resultado</th><th>Motivo / observaciones</th><th>Fuente</th><th>Acción</th></tr></thead><tbody>
@foreach(var d in docs.Skip(saltar).Take(25)){<tr><td data-label="Ruta / documento"><strong>@d.Ruta</strong><small>@d.Datos.Tipo · @d.Datos.Documento · @d.Datos.Empresa</small></td><td data-label="Cliente">@d.Datos.Cliente<small>@d.Datos.Direccion</small></td><td data-label="Resultado"><span class="panel-badge">@d.Resultado</span><small>Visitó: @(d.Datos.Visito.HasValue?(d.Datos.Visito.Value?"Sí":"No"):"Sin registrar")</small></td><td data-label="Motivo / observaciones">@d.Datos.Motivo<small>@(d.Datos.ObservacionPiloto??d.Datos.Observaciones)</small></td><td data-label="Fuente">@d.Fuente</td><td data-label="Acción"><a class="button-link button-secondary" href="@detalle(d.Ruta)">Ver ruta</a>@if(d.Foto){<a class="panel-text-link panel-photo" href="@Url.Action("PanelImagen","Piloto",new{id=d.Ruta,rowId=d.Datos.RowId})" target="_blank" rel="noopener">Ver fotografía POS</a>}</td></tr>}
</tbody></table></div>
}
else if(f.Seccion=="actividad"){
<p class="muted">Eventos guardados en el período seleccionado, hora Guatemala. Las respuestas en pantalla sin guardar no generan eventos.</p><div class="panel-table-wrap"><table class="panel-table"><thead><tr><th>Fecha</th><th>Evento</th><th>Ruta</th><th>Actor / usuario</th><th>Detalle</th></tr></thead><tbody>
@foreach(var a in Model.Actividad.Skip(saltar).Take(25)){<tr><td data-label="Fecha">@PilotoPanelReglas.HoraGuatemala(a.FechaUtc).ToString("dd/MM/yyyy HH:mm:ss")</td><td data-label="Evento"><span class="panel-badge">@a.Tipo</span></td><td data-label="Ruta">@if(a.Ruta!=null){<a href="@detalle(a.Ruta)">@a.Ruta</a>}else{<span>Configuración POS</span>}</td><td data-label="Actor / usuario">@a.Actor<small>Usuario @a.Usuario</small></td><td data-label="Detalle">@a.Descripcion<small>@a.Clave</small></td></tr>}
</tbody></table></div>
}
else if(f.Seccion=="alertas"){
<div class="panel-alert-list">@foreach(var a in alertas.Skip(saltar).Take(25)){<article class="panel-alert"><svg class="icon" aria-hidden="true"><use href="#i-info" /></svg><div><strong>@(a.Ruta??"Usuario POS "+a.Usuario)</strong><p>@a.Texto</p></div>@if(a.Ruta!=null){<a class="button-link button-secondary" href="@detalle(a.Ruta)">Revisar ruta</a>}else if(Model.PuedeAdministrar){<a class="button-link button-secondary" href="@Url.Action("Configurar","Piloto",new{id=a.Usuario})">Revisar configuración</a>}else{<span class="muted">Solicitar revisión a Administración</span>}</article>}</div>
}
@if(paginas>1){<nav class="pagination" aria-label="Páginas del panel">@if(f.Pagina>1){<a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:f.Pagina-1)))">Anterior</a>}<span>Página @f.Pagina de @paginas</span>@if(f.Pagina<paginas){<a href="@Url.Action("Panel","Piloto",new RouteValueDictionary(f.Valores(pagina:f.Pagina+1)))">Siguiente</a>}</nav>}
</section>
