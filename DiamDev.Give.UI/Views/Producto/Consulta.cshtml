@model PagedList.IPagedList<DiamDev.Give.Entities.InventarioModel>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Producto Consulta";
}

<div class="row">
    <div class="col-md-12">
        <form action="" method="get" class="form-inline">            
            <div class="input-group well">
                <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                <span class="input-group-btn">
                    <button class="btn btn-primary" type="button">
                        Buscar
                    </button>
                </span>
            </div>
        </form>
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover" id="sample-table-1">
                    <thead>
                        <tr>           
                            <th>Agencia</th>               
                            <th class="hidden-xs hidden-sm">ID</th>
                            <th class="hidden-xs ">Codigo</th>
                            <th>Nombre</th>                            
                            <th class="hidden-xs hidden-sm">Marca</th>
                            <th>Existencia</th>
                            <th>P. Venta</th>
                            <th class="hidden-xs hidden-sm">Valorar En</th>
                            <th class="hidden-xs hidden-sm">Activo</th>     
                            <th></th>                       
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Producto in Model)
                        {
                            <tr>                             
                                <td>@Producto.Agencia</td> 
                                <td class="hidden-xs hidden-sm">@Producto.ProductoId</td>
                                <td class="hidden-xs ">@Producto.Codigo</td>
                                <td>@Producto.Nombre</td>                               
                                <td class="hidden-xs hidden-sm">@Producto.Marca</td>
                                <td>@Producto.Existencia</td>
                                <td>@Producto.PrecioVenta.ToString("C")</td>
                                <td class="hidden-xs hidden-sm">@Producto.PrecioValidar.ToString("C")</td>
                                <td class="hidden-xs hidden-sm">@(Producto.Activo ? "Sí" : "No")</td>  
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                        @if (Producto.TieneLote)
                                        {
                                            <a href="javascript:void(0);" onclick="verLote('@Producto.ProductoId');" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Lotes"><i class="clip-checkmark"></i></a>
                                        }                                      
                                    </div>
                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                        <div class="btn-group">
                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                <i class="icon-cog"></i> <span class="caret"></span>
                                            </a>
                                            <ul role="menu" class="dropdown-menu pull-right">
                                                @if (Producto.TieneLote)
                                                {
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="javascript:void(0);" onclick="verLote('@Producto.ProductoId');">
                                                            <i class="clip-checkmark"></i> Ver Lotes
                                                        </a>
                                                    </li>
                                                }                                                                                         
                                            </ul>
                                        </div>
                                    </div>
                                </td>                              
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

<div id="seleccionar-lote-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Lotes</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#Lote</th>
                        <th>F. Vencimiento</th>
                        <th>Cantidad</th>                       
                    </tr>
                </thead>
                <tbody id="producto_lote_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-lote" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Consulta", new { search = ViewBag.Search, page }))

@section Scripts
{
    <script type="text/javascript">
        $(function ()
        {
            $("#search").autocomplete({
                source: function (request, response)
                {
                    $.ajax({
                        url: '@Url.Action("ConsultaProductoAutocomplementar", "Producto")',
                        type: "POST",
                        dataType: "json",
                        data: { search: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Nombre, value: item.Nombre };
                            }))
                        }
                    })
                },
                messages:
                {
                    noResults: "", results: ""
                }
            });
        });

        function verLote(id)
        {
            $.ajax({
                url: '@Url.Action("ObtenerLotes", "Producto")',
                traditional: true,
                data: { 'id': id },
                async: false,
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null)
                    {
                        if (resultData.Operacion)
                        {
                            $("#seleccionar-lote-form").modal();
                            $("#seleccionar-lote-form").find("#producto_lote_tbody").html("");
                            $("#seleccionar-lote-form").find("#producto_lote_tbody").html(resultData.Data);
                        }
                        else
                        {
                            toastr.error('Los lotes no se pueden visualizar');
                        }
                    }
                    else
                    {
                        toastr.error('Ocurrió un error, al visualizar los lotes');                       
                    }
                }
            });
        }
    </script>
}

