@model PagedList.IPagedList<DiamDev.Give.Entities.InventarioModel>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Producto Consulta Administrativa";
}

<div class="row">
    <div class="col-md-12">
        <form action="" method="get" class="form-inline">            
            <div class="input-group well">
                <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                <span class="input-group-btn">
                    <button class="btn btn-primary" type="button">
                        Buscar
                    </button>
                </span>
            </div>
        </form>
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover" id="sample-table-1">
                    <thead>
                        <tr>           
                            <th>Agencia</th>               
                            <th class="hidden-xs hidden-sm">ID</th>
                            <th class="hidden-xs ">Codigo</th>
                            <th>Nombre</th>                            
                            <th class="hidden-xs hidden-sm">Marca</th>
                            <th>Existencia</th>
                            <th>P. Costo</th>
                            <th>P. Venta</th>
                            <th class="hidden-xs hidden-sm">Proveedor</th>
                            <th class="hidden-xs hidden-sm">Activo</th>                            
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Producto in Model)
                        {
                            <tr>                             
                                <td>@Producto.Agencia</td> 
                                <td class="hidden-xs hidden-sm">@Producto.ProductoId</td>
                                <td class="hidden-xs ">@Producto.Codigo</td>
                                <td>@Producto.Nombre</td>                               
                                <td class="hidden-xs hidden-sm">@Producto.Marca</td>
                                <td>@Producto.Existencia</td>
                                <td>@Producto.PrecioCosto.ToString("C4")</td>
                                <td>@Producto.PrecioVenta.ToString("C4")</td>
                                <td class="hidden-xs hidden-sm">@Producto.Proveedor</td>
                                <td class="hidden-xs hidden-sm">@(Producto.Activo ? "Sí" : "No")</td>                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Consulta_Administrativa", new { search = ViewBag.Search, page }))

@section Scripts
{
    <script type="text/javascript">
        $(function ()
        {
            $("#search").autocomplete({
                source: function (request, response)
                {
                    $.ajax({
                        url: '@Url.Action("ConsultaProductoAutocomplementar", "Producto")',
                        type: "POST",
                        dataType: "json",
                        data: { search: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Nombre, value: item.Nombre };
                            }))
                        }
                    })
                },
                messages:
                {
                    noResults: "", results: ""
                }
            });
        });
    </script>
}




