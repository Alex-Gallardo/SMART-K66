@model DiamDev.Give.Entities.Producto

@{
    ViewBag.Title = "Editar Producto";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Editar Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Editar Producto</h2>
                <p>
                    Editar un producto.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="ProductoId" name="ProductoId" value="@Html.Raw(Model.ProductoId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Categor&iacute;a
                                </label>
                                <br />
                                <strong>
                                    @(Model.Categoria == null ? "No Disponible" : Model.Categoria.Nombre)
                                </strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Marca
                                </label>
                                <br />
                                <strong>
                                    @(Model.Marca == null ? "No Disponible" : Model.Marca.Nombre)
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad de Medida
                                </label>
                                <br />
                                <strong>
                                    @(Model.Unidad == null ? "No Disponible" : Model.Unidad.Nombre)
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Codigo<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Codigo, new { @class = "form-control", @placeholder = "Codigo del Producto", required = "required", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre del Producto", required = "required", autocomplete = "off" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Descripci&oacute;n
                                </label>
                                @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Descripción del Producto", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Minimo de Producto<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Minimo, new { @class = "form-control", @placeholder = "Minimo de Producto", required = "required", autocomplete = "off" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Cantidad, new { @class = "form-control", @placeholder = "Cantidad Equivalente", required = "required", autocomplete = "off" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Maximo de Producto<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.Maximo, new { @class = "form-control", @placeholder = "Maximo de Producto", required = "required", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Activo
                                </label>
                                <div>
                                    <label class="radio-inline">
                                        <input type="radio" class="grey" value="true" @ViewBag.activoSi name="activo" id="activoSi">
                                        Sí
                                    </label>
                                    <label class="radio-inline">
                                        <input type="radio" class="grey" value="false" @ViewBag.activoNo name="activo" id="activoNo">
                                        No
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Precios</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio
                                </label>
                                @Html.DropDownList("PrecioId", (SelectList)ViewBag.Precios, "--Seleccione un Precio--", new { @class = "form-control search-select" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon">Q</span>
                                    <input type="number" placeholder="Precio" class="form-control" id="Precio" name="Precio" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
                            <table class="table table-hover" id="sample-table-1">
                                <thead>
                                    <tr>
                                        <th>Descripci&oacute;n</th>
                                        <th>Precio</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="precio_tbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Imagenes</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-imagen">Agregar</button></p>
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Archivo</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbl-archivos">
                                    @if (Model != null)
                                    {
                                        if (Model.Imagenes != null && Model.Imagenes.Count() > 0)
                                        {
                                            foreach (var Detalle in Model.Imagenes)
                                            {
                                                <tr>
                                                    <td colspan="2">
                                                        @Detalle.Nombre
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Producto")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="precio_tr_template">
        <tr>
            <td>{{precio}}</td>
            <td>Q{{valor_id}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="precioIds" value="{{precio_id}}" />
                <input type="hidden" name="valorIds" value="{{valor_id}}" />
            </td>
        </tr>
    </script>

    <script type="text/javascript">

        var precioSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioIds))');
        var valorSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.valorIds))');

        $(function ()
        {
            function error(texto)
            {
                toastr.error(texto);
            }

            function cargaPrecio(precio_id, precio, valor_id)
            {
                var plantilla = $('#precio_tr_template').html();

                var modelo =
                {
                    precio_id: precio_id,
                    precio: precio,
                    valor_id: valor_id
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#precio_tbody').append(filaHtml);
            }

            renderizarPreciosIniciales();

            $('#btn-agregar').click(function (e)
            {
                e.preventDefault();

                var precio_id = $('#PrecioId').val();
                var precio = $('#PrecioId option:selected').text();

                if (precio_id === "" || precio === "")
                {
                    error("Seleccione un precio");
                    return;
                }

                var valor_id = $('#Precio').val();

                if (valor_id === "")
                {
                    error("Ingrese el precio del producto seleccionado");
                    return;
                }

                cargaPrecio(precio_id, precio, valor_id);

                $("#PrecioId").val(0);
                $("#Precio").val(0);
                $("#PrecioId").focus();
            });

            $('#precio_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            function renderizarPreciosIniciales()
            {
                if (precioSeleccionados == null)
                {
                    return;
                }

                // recorremos los precios que haya ingresado el usuario
                for (var i = 0; i < precioSeleccionados.length; i++)
                {
                    var precio_id = precioSeleccionados[i];
                    var precio = $('#PrecioId option[value=' + precio_id + ']').text();

                    var valor_id = valorSeleccionados[i];

                    cargaPrecio(precio_id, precio, valor_id);
                }
            }

            var correlativo = 0;

            $('#btn-agregar-imagen').click(function (e)
            {
                e.preventDefault();

                var $fila = $('<tr/>');
                var $celdaA = $('<td />');
                var $celdaB = $('<td />');

                var prefijo = 'archivos[' + correlativo + ']';

                var $hidden = $('<input />', { type: 'hidden', value: correlativo, name: 'archivos.Crear' });
                var $inputFile = $('<input />', { name: prefijo + '.archivo', type: 'file', class: 'file-input' });
                var $delete = $('<button />', { type: 'button', class: 'btn btn-danger' }).text('Eliminar');

                $celdaB.append($delete);
                $celdaA.append($inputFile);

                $fila.append([$celdaA, $celdaB]);

                $('#tbl-archivos').append($fila);

                $delete.click(function (_e)
                {
                    _e.preventDefault();
                    $fila.remove();
                })

                correlativo++;
                $inputFile.click();
            });
        });

    </script>
}
