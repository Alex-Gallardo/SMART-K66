@model DiamDev.Give.Entities.Producto

@{
    ViewBag.Title = "Eliminar Producto";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">              
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="ProductoId" name="ProductoId" value="@Html.Raw(Model.ProductoId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Codigo
                                </label>
                                <br />
                                <strong>
                                    @Model.Codigo
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre
                                </label>
                                <br />
                                <strong>
                                    @Model.Nombre
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre Alternativo #1
                                </label>
                                <br />
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.NombreAlternativo1) ? "Sin nombre alternativo #1" : Model.NombreAlternativo1)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Nombre Alternativo #2
                                </label>
                                <br />
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.NombreAlternativo2) ? "Sin nombre alternativo #2" : Model.NombreAlternativo2)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Descripci&oacute;n
                                </label>
                                <br />
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Categor&iacute;a
                                </label>
                                <br />
                                <strong>
                                    @(Model.Categoria == null ? "No Disponible" : Model.Categoria.Nombre)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad de Medida
                                </label>
                                <br />
                                <strong>
                                    @(Model.Unidad == null ? "No Disponible" : Model.Unidad.Nombre)
                                </strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Marca
                                </label>
                                <br />
                                <strong>
                                    @(Model.Marca == null ? "No Disponible" : Model.Marca.Nombre)
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Minimo de Producto
                                </label>
                                <br />
                                <strong>
                                    @Model.Minimo
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad
                                </label>
                                <br />
                                <strong>
                                    @(Model.Cantidad == 0 ? "Producto Principal" : Model.Cantidad.ToString())
                                </strong>
                            </div>
                        </div>          
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Maximo de Producto
                                </label>
                                <br />
                                <strong>
                                    @Model.Maximo
                                </strong>
                            </div>
                        </div>                      
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Imagenes
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            @if (Model.Imagenes != null && Model.Imagenes.Count() > 0)
                            {
                                <strong>
                                    Click sobre cualquier imagen para Zoom(+)
                                </strong>
                                <p>
                                    @foreach (var Imagen in Model.Imagenes.Where(x => x.ContentType.Contains("image")))
                                    {
                                        <a class="fancybox" href="@Url.Action("Imagen", new { id = Imagen.FotografiaId, documentoId = Imagen.ProductoId })" rel="thumbs" title="">
                                            <img alt="" src="@Url.Action("Preview", new { id = Imagen.FotografiaId, documentoId = Imagen.ProductoId })" style=" height:100px; width:75px;" />
                                        </a>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Presentaciones
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Categoria</th>
                                        <th>Marca</th>
                                        <th>Unidad</th>
                                        <th>Cantidad</th>                                       
                                        <th>Activo</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Productos != null && Model.Productos.Count() > 0)
                                    {
                                        foreach (var Producto in Model.Productos)
                                        {
                                            <tr>
                                                <td>@Producto.Nombre</td>
                                                <td>@(Producto.Categoria == null ? "No Disponible" : Producto.Categoria.Nombre)</td>
                                                <td>@(Producto.Marca == null ? "No Disponible" : Producto.Marca.Nombre)</td>
                                                <td>@(Producto.Unidad == null ? "No Disponible" : Producto.Unidad.Nombre)</td>
                                                <td>@string.Format("{0} - ({1})", Producto.Cantidad, Model.Unidad.Nombre)</td>                                             
                                                <td>@(Producto.Activo ? "Sí" : "No")</td>
                                                <td class="center">
                                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                                        <a href="@Url.Action("Editar", "Producto", new { id = Producto.ProductoId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Editar"><i class="icon-edit"></i></a>                                                        
                                                    </div>
                                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                                        <div class="btn-group">
                                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                                <i class="icon-cog"></i> <span class="caret"></span>
                                                            </a>
                                                            <ul role="menu" class="dropdown-menu pull-right">
                                                                <li role="presentation">
                                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Editar", "Producto", new { id = Producto.ProductoId })">
                                                                        <i class="icon-edit"></i> Editar
                                                                    </a>
                                                                </li>                                                              
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6">
                                                <strong>No contiene presentaciones</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Producto")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>

            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>
@section Scripts
{
    <script type="text/javascript">
        $(function () {
            $("a[rel='thumbs']").fancybox(
            {
                type: "image"
            });

        });
    </script>
}
