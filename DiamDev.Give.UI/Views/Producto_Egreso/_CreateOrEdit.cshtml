@model DiamDev.Give.Entities.Movimiento

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="form-group">
    <label class="control-label">
        Cliente<span class="symbol required"></span>
    </label>
    <div class="input-group">
        @Html.DropDownList("ClienteId", (SelectList)ViewBag.Clientes, "--Seleccione un Cliente--", new { @class = "form-control search-select required", autofocus = "autofocus" })
        <div class="input-group-btn">
            <a href="#new-cliente-form" data-toggle="modal" class="demo btn btn-blue" style="margin-bottom: -3px;">
                <i class="clip-plus-circle"></i>
            </a>
        </div>
    </div>    
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Categorias</h2>
        <hr>
    </div>
</div>
<div class="form-group">
    <label class="control-label">
        Categoria<span class="symbol required"></span>
    </label>
    @Html.DropDownList("MovimientoCategoriaId", (SelectList)ViewBag.Categorias, "--Seleccione una Categoria--", new { @class = "form-control search-select required" })
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Descripci&oacute;n</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Descripci&oacute;n<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Descripción del Egreso", required = "required", autocomplete = "off" })
        </div>                 
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Productos
</h2>
<hr>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Producto
            </label>
            @Html.DropDownList("ProductoId", (SelectList)ViewBag.Productos, "--Seleccione un Producto--", new { @class = "form-control search-select" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Unidad
            </label>
            <select id="PresentacionId" name="PresentacionId" class="form-control search-select">
                <option value="0">--Seleccione una Unidad--</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" autocomplete="off" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Existencia
            </label>
            <input type="number" placeholder="Existencia" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Precio
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="number" placeholder="Precio" class="form-control" id="Precio" name="Precio" autocomplete="off" />
            </div>
        </div>
    </div>        
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Unidad</th>
                    <th>Cantidad</th>                   
                    <th>Precio</th>
                    <th>Sub-Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="producto_tbody"></tbody>
        </table>       
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Sub-Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Sub_Total" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Descuento:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Descuento" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Forma de Pago
</h2>
<hr>
<div class="row">
    <div class="col-md-8">
        <div class="form-group">
            <label class="control-label">
                Forma
            </label>
            @Html.DropDownList("PagoId", (SelectList)ViewBag.Formas, "--Seleccione una Forma de Pago--", new { @class = "form-control search-select" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad_Pagar" name="Cantidad_Pagar" autocomplete="off" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Nota
            </label>
            <input type="text" placeholder="Nota" class="form-control" id="Nota" name="Nota" autocomplete="off" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-forma">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Forma</th>
                    <th>Cantidad</th>
                    <th>Nota</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="forma_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Total_Pagar" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
</div>

