        $('#formaprincipal').keydown(function (evt) {
            if ($('#Documento').is(":focus") && (evt.which || evt.keyCode) == 13) {
                cargaBusquedaDocumento(evt)
            }
        });

        function cargaBusquedaDocumento(evt) {
            evt.preventDefault();

            if ($('#Documento').val() === "") {
                error("Ingresar #Documento");
                $('#Documento').focus();
                return;
            }

            if ($('#ProveedorId').val() === "") {
                error("Seleccione Proveedor");
                $('#ProveedorId').focus();
                return;
            }


            $.ajax({
                url: '@Url.Action("ValidarDocumentoxProveedor", "Producto_Ingreso")',
                traditional: true,
                data: { 'proveedorId': $('#ProveedorId').val(), 'documento': $('#Documento').val() },
                async: false,
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            toastr.error('Se le informa que el documento ingresado ya se encuentra registrado en el sistema');
                            $('#Documento').val("");
                            $('#Documento').focus();
                        }
                        else {
                            $('#Descripcion').focus();
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al validar el documento');
                        $('#Documento').val("");
                        $('#Documento').focus();
                    }
                }
            });
        }

    });

    </script>  
