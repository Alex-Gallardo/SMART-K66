@model PagedList.IPagedList<DiamDev.Give.Entities.Proveedor>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Proveedor Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Proveedor")">
        Nuevo
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <form action="" method="get" class="form-inline">
            <div class="input-group well">
                <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                <span class="input-group-btn">
                    <button class="btn btn-primary" type="button">
                        <i class="clip-search-3"></i> Buscar
                    </button>
                </span>
            </div>
        </form>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Proveedor
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover" id="sample-table-1">
                    <thead>
                        <tr>
                            <th>Nit</th>
                            <th>Nombre</th>
                            <th>Contacto</th>
                            <th>Productos</th>
                            <th>Activo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var Proveedor in Model)
                        {

                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(Proveedor.Nit) ? "No Disponible" : Proveedor.Nit)</td>
                                <td>@Proveedor.Nombre</td>
                                <td>@(string.IsNullOrWhiteSpace(Proveedor.Contacto) ? "No Disponible" : Proveedor.Contacto)</td>
                                <td>@(Proveedor.Productos == null ? 0 : Proveedor.Productos.Count())</td>
                                <td>@(Proveedor.Activo == true ? "Sí" : "No")</td>
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                        <a href="@Url.Action("Editar", "Proveedor", new { id = Proveedor.ProveedorId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Editar"><i class="icon-edit"></i></a>
                                        <a href="@Url.Action("Detalle", "Proveedor", new { id = Proveedor.ProveedorId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle del Proveedor"><i class="clip-stack-empty"></i></a>
                                    </div>
                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                        <div class="btn-group">
                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                <i class="icon-cog"></i> <span class="caret"></span>
                                            </a>
                                            <ul role="menu" class="dropdown-menu pull-right">
                                                <li role="presentation">
                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Editar", "Proveedor", new { id = Proveedor.ProveedorId })">
                                                        <i class="icon-edit"></i> Editar
                                                    </a>
                                                </li>
                                                <li role="presentation">
                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Proveedor", new { id = Proveedor.ProveedorId })">
                                                        <i class="clip-stack-empty"></i> Detalle del Proveedor
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                        }

                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { search = ViewBag.Search, page }))

@section Scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            if ('@TempData["Proveedor-Success"]' == "OK")
            {
                toastr.success('El proveedor se guardó exitosamente');
            }
        });
    </script>
}



