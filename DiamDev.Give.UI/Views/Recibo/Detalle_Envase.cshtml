@model DiamDev.Give.Entities.ReciboEnvase

@{
    ViewBag.Title = "Detalle de Envases en Recibo";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Envases x Recibir
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">              
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="ReciboEnvaseId" name="ReciboEnvaseId" value="@Html.Raw(Model.ReciboEnvaseId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Agencia
                                </label>
                                <br />
                                <strong>
                                    @(Model.Agencia == null ? "No Disponible" : Model.Agencia.Nombre)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Cliente
                                </label>
                                <br />
                                <strong>
                                    @(Model.Recibo.Cliente == null ? "No Disponible" : Model.Recibo.Cliente.Nombre)
                                </strong>
                            </div>        
                            <div class="form-group">
                                <label class="control-label">
                                    Transporte
                                </label>
                                <br />
                                <strong>
                                    @(Model.Recibo.Transporte == null ? "No Disponible" : Model.Recibo.Transporte.Nombre)
                                </strong>
                            </div>                                 
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha
                                </label>
                                <br />
                                <strong>
                                    @Model.Fecha.ToString("dd/MM/yyyy")
                                </strong>
                            </div>   
                        </div>
                    </div>                   
                    <div class="row">                      
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    No. Recibo
                                </label>
                                <br />
                                <strong>
                                    @Model.ReciboId
                                </strong>
                            </div>
                        </div>
                    </div>                    
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Productos
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Unidad</th>
                                        <th>Cantidad</th>
                                        <th>Cantidad Envases</th>                                      
                                        <th>Sub-Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Detalles != null && Model.Detalles.Count() > 0)
                                    {
                                        foreach (var Detalle in Model.Detalles)
                                        {
                                            <tr>
                                                <td>
                                                    @(Detalle.Producto == null ? "No Disponible" : string.Format("{0} - {1}", Detalle.Producto.Codigo, Detalle.Producto.Nombre))
                                                </td>
                                                <td>
                                                    @(Detalle.Unidad == null ? "No Disponible" : Detalle.Unidad.Nombre)
                                                </td>
                                                <td>
                                                    @Detalle.Cantidad
                                                </td>
                                                <td>
                                                    @Detalle.CantidadEnvase
                                                </td> 
                                                <td>
                                                    @(Detalle.Cantidad * Detalle.CantidadEnvase)
                                                </td>                                               
                                            </tr>
                                        }
                                        <tr>
                                            <td>
                                                <div style="text-align:left; font-size:large; font-weight:bold;">
                                                    Total:
                                                </div>
                                            </td>
                                            <td colspan="6">
                                                <div style="text-align: right;font-size:large; font-weight:bold;">
                                                    @string.Format("{0:N}", Model.Detalles.Sum(x => x.Cantidad * x.CantidadEnvase))
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6">
                                                <strong>No contiene productos</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="javascript:window.history.back();">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

