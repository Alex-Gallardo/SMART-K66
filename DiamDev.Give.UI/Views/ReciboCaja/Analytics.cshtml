// Resolver geolocalización: acción explícita, nunca automática.
$("#btnResolverGeo").on("click", function(){
    var $b = $(this).prop("disabled", true)
                    .html('<i class="icon-spinner icon-spin"></i> Resolviendo...');
    $.post(URL_GEO, {}, function(r){
        if (r.ok){
            toastr.success(r.msg);
            Cargar();
        } else {
            toastr.error(r.msg, "", { timeOut: 12000 });
        }
    }).fail(function(){
        toastr.error("No se pudo ejecutar la resolución de ubicaciones.");
    }).always(function(){
        $b.prop("disabled", false).html('<i class="icon-map-marker"></i> Resolver ubicaciones');
    });
});

