// EXPORTAR EXCEL (HTML → .xls, mismo patrón del Dashboard)
// Tres bloques en una sola hoja: usuarios, anulaciones, accesos.
// ════════════════════════════════════════════════════════════
$("#btnExportExcel").on("click", function(){
    if (!_data){ toastr.info("Todavía no hay datos cargados."); return; }

    var r = _data.Resumen;
    var per = $("#grpPeriodo button.activa").text();
    var emp = Filtro.empresa || "Todas";

    var html =
    '<html xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><style>' +
      'td, th { font-family: Calibri, Arial, sans-serif; font-size: 11pt; vertical-align: middle; }' +
      '.titulo { font-size:16pt; font-weight:bold; color:#6C3483; }' +
      '.subt   { font-size:9pt; color:#7F8C8D; }' +
      '.sec    { font-size:12pt; font-weight:bold; color:#2C3E50; }' +
      '.hdr    { background:#2C3E50; color:#FFFFFF; font-weight:bold; font-size:9pt;' +
                ' border:.5pt solid #1A252F; text-align:center; }' +
      '.c      { border:.5pt solid #D5DBDB; }' +
      '.mono   { font-family:Consolas, monospace; font-weight:bold; }' +
      '.num    { text-align:right; mso-number-format:"#,##0.00"; }' +
      '.ent    { text-align:center; mso-number-format:"0"; }' +
      '.txt    { mso-number-format:"\\@@"; }' +
      '.total  { background:#ECF0F1; font-weight:bold; border:.5pt solid #BDC3C7; }' +
      '.alerta { color:#A93226; font-weight:bold; }' +
    '</style></head><body><table>' +
    '<tr><td colspan="8" class="titulo">Analytics de Recibos de Caja</td></tr>' +
    '<tr><td colspan="8" class="subt">Empresa: ' + Esc(emp) + '   |   Periodo: ' + Esc(per) +
        '   |   ' + Esc($("#lblRango").text()) + '</td></tr>' +
    '<tr><td colspan="8" class="subt">Generado: ' + new Date().toLocaleString() + '</td></tr>' +
    '<tr><td colspan="8"></td></tr>' +

    /* Resumen */
    '<tr><td colspan="8" class="sec">Resumen</td></tr>' +
    '<tr><td class="c txt">Recibos creados</td><td class="c ent">' + r.Creados + '</td>' +
        '<td class="c txt">Monto registrado (Q)</td><td class="c num">' + r.MontoCreado + '</td>' +
        '<td class="c txt">Ticket promedio (Q)</td><td class="c num">' + r.TicketPromedio + '</td>' +
        '<td class="c txt">Usuarios activos</td><td class="c ent">' + r.UsuariosActivos + '</td></tr>' +
    '<tr><td class="c txt">Anulaciones</td><td class="c ent">' + r.Anulados + '</td>' +
        '<td class="c txt">Monto anulado (Q)</td><td class="c num">' + r.MontoAnulado + '</td>' +
        '<td class="c txt">Tasa de anulación (%)</td><td class="c num">' + r.TasaAnulacion + '</td>' +
        '<td class="c txt">IPs distintas</td><td class="c ent">' + r.IpsDistintas + '</td></tr>' +
    (r.MonedaRara > 0
        ? '<tr><td colspan="8" class="c txt alerta">ATENCION: ' + r.MonedaRara +
          ' recibo(s) con moneda no reconocida por Q ' + Fm(r.MontoMonedaRara) + '</td></tr>'
        : '') +
    '<tr><td colspan="8"></td></tr>';

    /* Usuarios */
    html += '<tr><td colspan="8" class="sec">Detalle por usuario</td></tr>' +
    '<tr><td class="hdr" width="110">Usuario</td><td class="hdr" width="110">Depto</td>' +
        '<td class="hdr" width="70">Recibos</td><td class="hdr" width="110">Monto (Q)</td>' +
        '<td class="hdr" width="100">Ticket (Q)</td><td class="hdr" width="70">Anulados</td>' +
        '<td class="hdr" width="70">Empresas</td><td class="hdr" width="130">Ultima actividad</td></tr>';
    var totMonto = 0;
    $.each(_data.Usuarios, function(_, u){
        totMonto += parseFloat(u.MontoCreado) || 0;
        html += '<tr>' +
            '<td class="c txt mono">' + Esc(u.UsuarioLogin) + '</td>' +
            '<td class="c txt">' + Esc(u.Depto) + '</td>' +
            '<td class="c ent">' + u.Creados + '</td>' +
            '<td class="c num">' + (parseFloat(u.MontoCreado)||0) + '</td>' +
            '<td class="c num">' + (parseFloat(u.Ticket)||0) + '</td>' +
            '<td class="c ent">' + (u.Anulados||0) + '</td>' +
            '<td class="c ent">' + u.Empresas + '</td>' +
            '<td class="c txt">' + FmFecha(u.Ultimo, true) + '</td></tr>';
    });
    html += '<tr><td class="total" colspan="3" style="text-align:right;">TOTAL</td>' +
            '<td class="total num">' + totMonto + '</td>' +
            '<td class="total" colspan="4"></td></tr><tr><td colspan="8"></td></tr>';

    /* Anulaciones */
    html += '<tr><td colspan="8" class="sec">Anulaciones</td></tr>' +
    '<tr><td class="hdr" width="110">Recibo</td><td class="hdr" width="70">Empresa</td>' +
        '<td class="hdr" width="110">Usuario</td><td class="hdr" width="110">Monto (Q)</td>' +
        '<td class="hdr" width="110">Estado al anular</td><td class="hdr" width="320">Motivo</td>' +
        '<td class="hdr" width="130">Fecha</td><td class="hdr" width="20"></td></tr>';
    if (!_data.Anulaciones.length)
        html += '<tr><td class="c txt" colspan="8">Sin anulaciones en el periodo.</td></tr>';
    $.each(_data.Anulaciones, function(_, a){
        html += '<tr>' +
            '<td class="c txt mono">' + Esc(a.IdRecibo) + '</td>' +
            '<td class="c txt" style="text-align:center;">' + Esc(a.IdEmpresa) + '</td>' +
            '<td class="c txt">' + Esc(a.UsuarioLogin) + '</td>' +
            '<td class="c num">' + (parseFloat(a.MontoGtq)||0) + '</td>' +
            '<td class="c txt">' + Esc(a.EstadoAlAnular || "") + '</td>' +
            '<td class="c txt">' + Esc(a.Motivo || "(sin motivo)") + '</td>' +
            '<td class="c txt">' + FmFecha(a.FechaEvento, true) + '</td><td class="c"></td></tr>';
    });
    html += '<tr><td colspan="8"></td></tr>';

    /* Accesos */
    html += '<tr><td colspan="8" class="sec">Accesos y ubicacion</td></tr>' +
    '<tr><td colspan="8" class="subt">La ubicacion proviene del proveedor de internet. ' +
        'En conexiones moviles apunta al nodo del operador, no al lugar fisico del usuario.</td></tr>' +
    '<tr><td class="hdr" width="120">IP</td><td class="hdr" width="110">Pais</td>' +
        '<td class="hdr" width="110">Region</td><td class="hdr" width="110">Ciudad</td>' +
        '<td class="hdr" width="180">Proveedor</td><td class="hdr" width="180">Usuarios</td>' +
        '<td class="hdr" width="70">Eventos</td><td class="hdr" width="130">Ultimo acceso</td></tr>';
    $.each(_data.Accesos, function(_, a){
        html += '<tr>' +
            '<td class="c txt mono">' + Esc(a.Ip) + '</td>' +
            '<td class="c txt">' + Esc(a.Pais || "") + '</td>' +
            '<td class="c txt">' + Esc(a.Region || "") + '</td>' +
            '<td class="c txt">' + Esc(a.Ciudad || "") + '</td>' +
            '<td class="c txt">' + Esc(a.Isp || "") + '</td>' +
            '<td class="c txt">' + Esc(a.ListaUsuarios || "") + '</td>' +
            '<td class="c ent">' + a.Eventos + '</td>' +
            '<td class="c txt">' + FmFecha(a.Ultimo, true) + '</td></tr>';
    });

    html += '</table></body></html>';

    var blob = new Blob(["\uFEFF" + html], { type:"application/vnd.ms-excel" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "analytics_recibos_" + FechaISO(new Date()) + ".xls";
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    toastr.success("Analytics exportado a Excel.");
});

Cargar();
    </script>
}