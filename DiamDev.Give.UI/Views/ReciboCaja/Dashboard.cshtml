function FmtMoneda(n) {
    return parseFloat(n || 0).toLocaleString("en-US",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function Esc(t) { return $("<span>").text(t || "").html(); }
function FechaISO(d) {
    return d.getFullYear() + "-" +
        ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
        ("0" + d.getDate()).slice(-2);
}

// ════════════════════════════════════════════════════════
// RESUMEN (cards): solo responde a empresa — foto actual
// ════════════════════════════════════════════════════════
function CargarResumen() {
    $.get(URL_RESUMEN, { empresa: Filtro.empresa }, function (resp) {
        if (!resp.ok) { toastr.error(resp.msg); return; }
        var d = resp.data;
        $("#cardDescuadres").text(d.Descuadres);
        $("#cardDescuadresMonto").text(d.Descuadres > 0
            ? "Q " + FmtMoneda(d.DescuadresMontoGtq) + " en conflicto" : "Sin conflictos 🎉");
        $("#cardEnvejecidos").text(d.PendientesEnvejecidos);
        $("#cardAnulados").text(d.PendientesAnulados);
        $("#cardPendientes").text(d.PendientesTotal);
        $("#cardAnuladosWeb").text(d.AnuladosMes);
        $("#cardAnuladosWebMonto").text(d.AnuladosMes > 0
            ? "Q " + FmtMoneda(d.AnuladosMesMontoGtq) + " anulados" : "Sin anulaciones este mes");
        $("#cardOperadosHoy").text(d.OperadosHoy);
        $("#cardOperadosSemana").text(d.OperadosSemana + " en los últimos 7 días");
        $("#lblActualizado").text("Actualizado: " + new Date().toLocaleTimeString());
        PintarAlcance(resp);
    });
        }

        // ════════════════════════════════════════════════════════
        // ALCANCE: badge + botones de empresa según Usuario_Empresa
        // ════════════════════════════════════════════════════════
        // Los botones se pintan UNA sola vez (_alcancePintado). CargarResumen corre
        // cada 60s, y re-pintarlos en cada ciclo borraría la empresa activa del
        // usuario a media revisión. El badge sí se actualiza siempre: es solo texto.
        var _alcancePintado = false;

        function PintarAlcance(resp) {
            // Badge
            var $b = $("#badgeAlcance").removeClass("global sin-acceso");
            if (resp.global) {
                $b.addClass("global").text("👁 Global")
                    .attr("title", "Ve todos los recibos de las 3 empresas");
            } else if (resp.sinAcceso) {
                $b.addClass("sin-acceso").text("⚠ Sin operadores")
                    .attr("title", "Su usuario no tiene registros en Usuario_Empresa");
            } else {
                $b.text("👤 " + resp.operadores + " operador(es)")
                    .attr("title", "Solo ve los recibos emitidos con sus códigos de Usuario_Empresa");
            }

            $("#avisoSinAcceso").toggle(!!resp.sinAcceso);

            // Botones de empresa (una sola vez)
            if (_alcancePintado) return;
            _alcancePintado = true;

            var NOMBRES = { GRACO: "Graco", FAES: "Faes", BOLIK: "Bolik" };
            var emps = resp.empresas || [];

            // Con una sola empresa, "Todas" y esa empresa muestran lo mismo:
            // dos botones idénticos solo generan dudas. Se deja únicamente "Todas".
            if (emps.length <= 1) return;

            var $g = $("#grpEmpresa");
            $.each(emps, function (_, e) {
