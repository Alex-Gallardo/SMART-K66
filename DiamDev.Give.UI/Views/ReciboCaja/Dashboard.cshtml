@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Tarjetas de resumen ── */
    .dash-cards {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .dash-card {
        flex: 1 1 180px;
        min-width: 160px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e5e8ea;
        border-top: 4px solid #bdc3c7;
        padding: 14px 16px;
        cursor: pointer;
        transition: box-shadow .15s, transform .15s;
    }

        .dash-card:hover {
            box-shadow: 0 6px 18px rgba(0,0,0,.10);
            transform: translateY(-2px);
        }

        .dash-card.activa {
            box-shadow: 0 0 0 2px #2980b9;
        }

        .dash-card .num {
            font-size: 30px;
            font-weight: 700;
            line-height: 1;
        }

        .dash-card .lbl {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #95a5a6;
            font-weight: 700;
            margin-top: 4px;
        }

        .dash-card .sub {
            font-size: 11px;
            color: #7f8c8d;
            margin-top: 2px;
        }

        .dash-card.c-descuadre {
            border-top-color: #e74c3c;
        }

            .dash-card.c-descuadre .num {
                color: #a93226;
            }

        .dash-card.c-envejecido {
            border-top-color: #e67e22;
        }

            .dash-card.c-envejecido .num {
                color: #ba4a00;
            }

        .dash-card.c-anulado {
            border-top-color: #f1c40f;
        }

            .dash-card.c-anulado .num {
                color: #b9770e;
            }

        .dash-card.c-pendiente {
            border-top-color: #3498db;
        }

            .dash-card.c-pendiente .num {
                color: #2471a3;
            }

        .dash-card.c-ok {
            border-top-color: #27ae60;
            cursor: default;
        }

            .dash-card.c-ok .num {
                color: #1e8449;
            }

    /* ── Badges de situación en el grid ── */
    .sit-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        white-space: nowrap;
    }

    .sit-DESCUADRE {
        background: #fadbd8;
        color: #a93226;
        border: 1px solid #e74c3c;
    }

    .sit-ANULADO_SAP {
        background: #fef9e7;
        color: #b9770e;
        border: 1px solid #f1c40f;
    }

    .sit-ENVEJECIDO {
        background: #fdebd0;
        color: #ba4a00;
        border: 1px solid #e67e22;
    }

    .sit-PENDIENTE {
        background: #eaf4fb;
        color: #2471a3;
        border: 1px solid #3498db;
    }

    .emp-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        color: #fff;
        background: #95a5a6;
    }

    .emp-GRACO {
        background: #27ae60;
    }

    .emp-FAES {
        background: #c0392b;
    }

    .emp-BOLIK {
        background: #2c3e50;
    }

    #tablaDash td {
        vertical-align: middle !important;
        font-size: 12.5px;
    }

    #tablaDash th {
        background: #2c3e50;
        color: #ecf0f1;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    /* ── Observación traducida (lenguaje de negocio, no técnico) ── */
    #tablaDash .obs {
        max-width: 380px;
        white-space: normal; /* ahora envuelve: el mensaje corto cabe en 1-2 líneas */
        font-size: 12px;
        line-height: 1.35;
        color: #2c3e50;
        cursor: help;
    }

        #tablaDash .obs .obs-msg {
            display: block;
            font-weight: 600;
        }

        #tablaDash .obs .obs-accion {
            display: block;
            font-size: 11px;
            color: #7f8c8d;
            margin-top: 2px;
        }

        /* Texto original: solo aparece si el traductor NO reconoció el mensaje */
        #tablaDash .obs .obs-tecnico {
            display: block;
            font-family: monospace;
            font-size: 10px;
            color: #95a5a6;
            margin-top: 2px;
        }

        #tablaDash .obs.obs-alerta .obs-msg {
            color: #a93226;
        }

        #tablaDash .obs.obs-aviso .obs-msg {
            color: #ba4a00;
        }

        #tablaDash .obs.obs-ok .obs-msg {
            color: #1e8449;
        }

        #tablaDash .obs.obs-info .obs-msg {
            color: #2471a3;
        }

        #tablaDash .obs.obs-neutro .obs-msg {
            color: #7f8c8d;
            font-weight: 400;
        }

    #tablaDash .dias-alto {
        color: #a93226;
        font-weight: 700;
    }

    .dash-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }

    @@media (max-width:767px) {
        .dash-card .num {
            font-size: 24px;
        }
    }

    /* ── Barra de filtros (entre cards y grid) ── */
    .dash-filtros {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        align-items: flex-start;
        background: #f7f9fa;
        border: 1px solid #e5e8ea;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 12px;
    }

        .dash-filtros .flt {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .dash-filtros .flt-lbl {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #95a5a6;
            font-weight: 700;
        }

        .dash-filtros input[type=text] {
            height: 30px;
            font-size: 12px;
        }

        .dash-filtros .flt-fecha input {
            max-width: 120px;
        }

        .dash-filtros .flt-buscar input {
            min-width: 200px;
        }

    .presets-fecha .btn {
        padding: 3px 9px;
        font-size: 11px;
    }

        .presets-fecha .btn.activa {
            background: #2c3e50;
            color: #fff;
            border-color: #2c3e50;
        }

    .chk-operados {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #5d6d7e;
        cursor: pointer;
        user-select: none;
        height: 30px;
        margin: 0;
        font-weight: 400;
    }

        .chk-operados input {
            margin: 0;
            cursor: pointer;
        }

    #lblConteo {
        font-size: 11px;
        color: #7f8c8d;
    }

        #lblConteo .tope {
            color: #ba4a00;
            font-weight: 700;
        }

    .sit-OPERADO {
        background: #d5f5e3;
        color: #1e8449;
        border: 1px solid #27ae60;
    }

    /* ── MEJORAS UI/UX · Recibos anulados (STATUS = 'X') ── */
    .sit-ANULADO {
        background: #eaecee;
        color: #566573;
        border: 1px solid #909497;
        text-decoration: line-through;
    }

    .dash-card.c-anulweb {
        border-top-color: #566573;
    }

    .dash-card.c-anulweb .num {
        color: #566573;
    }

    #tablaDash tr.row-anulado td {
        background: #fbfcfc;
        color: #909497;
    }

    #tablaDash tr.row-anulado td strong {
        text-decoration: line-through;
    }

    /* ── MEJORAS UI/UX · Badge de alcance del usuario ── */
    .badge-alcance {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .3px;
        color: #fff;
        background: #7f8c8d;
        white-space: nowrap;
    }

        .badge-alcance.global {
            background: #2c3e50;
        }

        .badge-alcance.sin-acceso {
            background: #e74c3c;
        }

    #avisoSinAcceso {
        display: none;
        background: #fdf2f0;
        border: 1px solid #e74c3c;
        border-left-width: 4px;
        border-radius: 5px;
        padding: 10px 14px;
        margin-bottom: 12px;
        font-size: 12.5px;
        color: #a93226;
    }

    /* ── Selección para impresión masiva ── */
    #tablaDash .chk-imp, #chkTodosImp {
        width: 15px;
        height: 15px;
        cursor: pointer;
    }

        #tablaDash .chk-imp:disabled {
            cursor: not-allowed;
        }

    #tablaDash td.td-chk {
        text-align: center;
    }

    #tablaDash tr.row-imp-sel td {
        background: #eaf4fb !important;
    }

    #badgeImpSel {
        background: #fff;
        color: #1e8449;
        border-radius: 10px;
        padding: 1px 7px;
        font-size: 10px;
        font-weight: 700;
        margin-left: 3px;
    }
</style>

<div class="panel panel-default" style="border-top:4px solid #2c3e50;">
    <div class="panel-heading" style="background:#f7f9fa; border-bottom:1px solid #eee;">
        <h4 class="panel-title" style="display:flex; align-items:center; flex-wrap:wrap; gap:8px; color:#5d6d7e; font-size:13px;">
            <i class="clip-stats"></i>
            <span style="font-weight:700;">Supervisión de Recibos</span>
            <small style="color:#95a5a6;">Salud del módulo frente a SAP</small>
            <span style="margin-left:auto; display:flex; gap:6px;">
                <a href="@Url.Action("Series","ReciboCaja")" class="btn btn-default btn-xs" title="Mantenimiento de series de numeración">
                    <i class="icon-cogs"></i> Series
                </a>
                <a href="@Url.Action("Index","ReciboCaja")" class="btn btn-default btn-xs">
                    <i class="icon-file-text"></i> Nuevo Recibo
                </a>
                <button id="btnRefrescar" class="btn btn-primary btn-xs">
                    <i class="icon-refresh"></i> Actualizar
                </button>
            </span>
        </h4>
    </div>
    <div class="panel-body">

        <!-- Filtro empresa -->
        <div class="dash-toolbar">
            <span class="flabel" style="margin:0; font-size:10px; text-transform:uppercase; color:#95a5a6; font-weight:700;">Empresa:</span>
            <div class="btn-group" id="grpEmpresa">
                <button class="btn btn-default btn-sm activa" data-emp="">Todas</button>
            </div>
            <span id="badgeAlcance" class="badge-alcance" title="Alcance de datos de su usuario">…</span>
            <span id="lblActualizado" style="font-size:11px; color:#95a5a6; margin-left:auto;"></span>
        </div>

        <div id="avisoSinAcceso">
            <strong>⚠ Sin operadores asignados.</strong>
            Su usuario no tiene registros en <em>Usuario_Empresa</em>, por lo que el dashboard
            no muestra recibos. Solicite al administrador que le asigne al menos un operador.
        </div>

        <!-- ── FILTROS DEL GRID (las cards no se filtran por fecha: son la foto actual) ── -->
        <div class="dash-filtros">

            <div class="flt">
                <span class="flt-lbl">Rápido</span>
                <div class="btn-group presets-fecha" id="grpPresets">
                    <button class="btn btn-default" data-preset="hoy">Hoy</button>
                    <button class="btn btn-default" data-preset="7d">7 días</button>
                    <button class="btn btn-default" data-preset="mes">Este mes</button>
                    <button class="btn btn-default activa" data-preset="todo">Todo</button>
                </div>
            </div>

            <div class="flt flt-fecha">
                <span class="flt-lbl"><i class="icon-calendar"></i> Desde</span>
                <input type="text" id="fltFechaIni" class="form-control date-picker"
                       data-date-format="yyyy-mm-dd" placeholder="—" autocomplete="off" />
            </div>
            <div class="flt flt-fecha">
                <span class="flt-lbl"><i class="icon-calendar"></i> Hasta</span>
                <input type="text" id="fltFechaFin" class="form-control date-picker"
                       data-date-format="yyyy-mm-dd" placeholder="—" autocomplete="off" />
            </div>

            <div class="flt flt-buscar">
                <span class="flt-lbl"><i class="icon-search"></i> Buscar</span>
                <input type="text" id="fltTexto" class="form-control"
                       placeholder="Recibo, cliente o usuario..." autocomplete="off" />
            </div>

            <div class="flt">
                <span class="flt-lbl">&nbsp;</span>
                <label class="chk-operados" title="Incluir recibos ya operados en SAP (para auditar un rango de fechas)">
                    <input type="checkbox" id="chkOperados" />
                    Incluir operados ✓
                </label>
            </div>

            <div class="flt">
                <span class="flt-lbl">&nbsp;</span>
                <label class="chk-operados" title="Incluir recibos anulados desde la web (STATUS = X). Las fechas se aplican sobre la fecha de anulación.">
                    <input type="checkbox" id="chkAnulados" />
                    Incluir anulados 🚫
                </label>
            </div>

            <div class="flt" style="margin-left:auto;">
                <span class="flt-lbl">&nbsp;</span>
                <div style="display:flex; gap:6px; align-items:center;">
                    <span id="lblConteo"></span>
                    <button id="btnLimpiarFiltros" class="btn btn-default btn-xs" title="Quitar todos los filtros">
                        <i class="icon-remove"></i> Limpiar
                    </button>
                    <button id="btnImprimirSel" class="btn btn-primary btn-xs" disabled
                            title="Imprimir los recibos seleccionados en un solo documento">
                        <i class="icon-print"></i> Imprimir<span id="badgeImpSel">0</span>
                    </button>
                    <button id="btnExportExcel" class="btn btn-success btn-xs" title="Exportar con formato para créditos">
                        <i class="icon-table"></i> Excel
                    </button>
                    <!-- <button id="btnExportCsv" class="btn btn-default btn-xs" title="Exportar lo visible a CSV">
                    <i class="icon-download-alt"></i> CSV
                </button> -->
                </div>
            </div>

        </div>

        <!-- Tarjetas (click = filtrar el grid) -->
        <div class="dash-cards">
            <div class="dash-card c-descuadre" data-sit="DESCUADRE" title="Anulaciones parciales en SAP: montos que no cuadran">
                <div class="num" id="cardDescuadres">—</div>
                <div class="lbl">⚠ Descuadres</div>
                <div class="sub" id="cardDescuadresMonto"></div>
            </div>
            <div class="dash-card c-envejecido" data-sit="ANTIGUO" title="Pendientes con más días de lo normal sin operar">
                <div class="num" id="cardEnvejecidos">—</div>
                <div class="lbl">⏰ Antiguos (@ViewBag.DiasUmbral+ días)</div>
                <div class="sub">Créditos aún no opera</div>
            </div>
            <div class="dash-card c-anulado" data-sit="ANULADO_SAP" title="Regresados a PENDIENTE por anulación total en SAP">
                <div class="num" id="cardAnulados">—</div>
                <div class="lbl">↩ Anulados en SAP</div>
                <div class="sub">Esperan re-operación</div>
            </div>
            <div class="dash-card c-anulweb" data-sit="ANULADO" title="Recibos anulados desde la web este mes (STATUS = X). No se sincronizan.">
                <div class="num" id="cardAnuladosWeb">—</div>
                <div class="lbl">🚫 Anulados (mes)</div>
                <div class="sub" id="cardAnuladosWebMonto"></div>
            </div>
            <div class="dash-card c-pendiente" data-sit="TODOS" title="Ver todo lo que está en tránsito">
                <div class="num" id="cardPendientes">—</div>
                <div class="lbl">⏳ Pendientes (total)</div>
                <div class="sub">En tránsito hacia SAP</div>
            </div>
            <div class="dash-card c-ok">
                <div class="num" id="cardOperadosHoy">—</div>
                <div class="lbl">✓ Operados hoy</div>
                <div class="sub" id="cardOperadosSemana"></div>
            </div>
        </div>


        <!-- Grid de detalle -->
        <div style="overflow-x:auto; border:1px solid #e6e6e6; border-radius:6px;">
            <table class="table table-condensed" id="tablaDash" style="margin-bottom:0;">
                <thead>
                    <tr>
                        <th style="width:34px; text-align:center;">
                            <input type="checkbox" id="chkTodosImp" title="Seleccionar todos los imprimibles" />
                        </th>
                        <th>Situación</th>
                        <th>Recibo</th>
                        <th>Empresa</th>
                        <th>Cliente</th>
                        <th class="text-right">Monto (Q)</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th class="text-right">Días</th>
                        <th>Observación</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbodyDash">
                    <tr><td colspan="11" class="text-center" style="padding:24px; color:#aaa;">Cargando...</td></tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts{
    <script>
var URL_RESUMEN = "@Url.Action("GetDashboardResumen","ReciboCaja")";
var URL_DETALLE = "@Url.Action("GetDashboardDetalle","ReciboCaja")";
var URL_INDEX   = "@Url.Action("Index","ReciboCaja")";
var DIAS_UMBRAL = parseInt("@@ViewBag.DiasUmbral") || 3;
var TOPE_FILAS = 500;   // espejo del TOP 500 del backend
var URL_IMPRIMIR_LOTE = "@Url.Action("ImprimirLote","ReciboCaja")";

// ── Etiqueta legible por situación ────────────────────────────
// NO derivamos la etiqueta con .replace("_"," "): "ANULADO_SAP" daría
// "ANULADO SAP" pero "ANULADO" (web) daría "ANULADO" a secas, y en pantalla
// serían casi la misma palabra para dos cosas MUY distintas:
//   ANULADO SAP → el pago se revirtió en SAP, el recibo sigue vivo.
//   ANULADO WEB → el recibo está muerto, solo se audita.
var ETIQUETA_SIT = {
    "ANULADO": "ANULADO WEB",
    "ANULADO_SAP": "ANULADO SAP"
};
function LabelSit(s) {
    return ETIQUETA_SIT[s] || (s || "").replace("_", " ");
        }

// ════════════════════════════════════════════════════════
// TRADUCTOR DE OBSERVACIONES  (técnico → lenguaje de Créditos)
//
// La BD guarda el mensaje TÉCNICO completo (auditoría: montos, DocNum,
// timestamps). Aquí solo lo INTERPRETAMOS para pantalla. El dato crudo
// nunca se toca.
//
// ⚠ CONTRATO: los patrones que se buscan abajo los genera
//   ReciboCajaSyncBL (métodos RevisarAnulaciones / ConciliarRecibo).
//   Si allá cambia el formato del mensaje, hay que ajustar aquí.
//   Diseño defensivo: si NADA matchea, se muestra el texto original
//   (nunca se oculta información ni se inventa un mensaje).
//
// Devuelve: { clase, corto, detalle, accion, tecnico }
//   corto   → lo que se ve en la celda
//   accion  → "qué hacer" (se muestra inline solo si es accionable)
//   detalle → tooltip completo
//   tecnico → texto crudo (solo cuando no se reconoció el patrón)
// ════════════════════════════════════════════════════════

// "12,275.25" → 12275.25   (parseFloat("12,275.25") daría 12: la coma corta)
function ObsNum(s) {
    var v = parseFloat(String(s == null ? "" : s).replace(/,/g, ""));
    return isNaN(v) ? 0 : v;
}

// Monto con el símbolo de LA moneda del mensaje (¡no siempre es Q!)
function ObsMonto(v, moneda) {
    return ((moneda || "GTQ").toUpperCase() === "USD" ? "$ " : "Q ") + FmtMoneda(v);
}

// Primer grupo de captura de una regex, o "" si no matchea
function ObsCap(txt, re) {
    var m = (txt || "").match(re);
    return (m && m[1]) ? m[1].trim() : "";
}

function ObsCorta(s, n) {
    s = s || "";
    return s.length > n ? s.substring(0, n - 1) + "…" : s;
}

function InterpretarObservacion(f) {
    var raw = (f.SyncObservacion || "").trim();
    var sit = (f.Situacion || "").toUpperCase();
    var dias = parseInt(f.DiasAntiguedad, 10) || 0;
    var obs = raw.replace(/^\[(DESC|CONCIL)\]\s*/i, "");   // marcadores internos fuera

    // ── 1. ANULADO EN LA WEB: manda la auditoría, no el sync ──
    if (sit === "ANULADO") {
        return {
            clase: "obs-neutro",
            corto: "Recibo anulado" + (f.AnuladoPor ? " por " + f.AnuladoPor : "") +
                (f.MotivoAnulacion ? " — " + ObsCorta(f.MotivoAnulacion, 60) : ""),
            detalle: "Este recibo fue anulado desde el sistema" +
                (f.AnuladoPor ? " por " + f.AnuladoPor : "") +
                (f.FechaAnulacion ? " el " + f.FechaAnulacion : "") + ". " +
                (f.MotivoAnulacion ? "Motivo: " + f.MotivoAnulacion + ". " : "") +
                "Ya no se envía a SAP y no debe operarse.",
            accion: "", tecnico: ""
        };
    }

    // ── 2. DIFERENCIA RESUELTA (el sync se sanó solo) ──
    if (/descuadre resuelto/i.test(obs) && sit !== "DESCUADRE") {
        return {
            clase: "obs-ok",
            corto: "Diferencia resuelta: ya cuadra con SAP",
            detalle: "El monto del recibo volvió a coincidir con lo aplicado en SAP. " +
                "El recibo quedó operado y ya no lleva sello de conciliación.",
            accion: "", tecnico: ""
        };
    }

    // ── 3. DESCUADRE: lo más accionable del dashboard ──
    if (sit === "DESCUADRE" || /descuadre\s*\((usd|gtq)\)/i.test(obs)) {
        var mon = ObsCap(obs, /descuadre\s*\((usd|gtq)\)/i) || "GTQ";
        var falta = ObsNum(ObsCap(obs, /dif\s*=\s*([\d.,]+)/i));
        var totRec = ObsNum(ObsCap(obs, /SQL\s*=\s*([\d.,]+)/i));
        var enSap = ObsNum(ObsCap(obs, /SAP\s+activo\s*=\s*([\d.,]+)/i));
        var anulados = ObsCap(obs, /anulado\(s\)\s+en\s+SAP:\s*([^.]+)\./i);
        var docs = (!anulados || /ninguno/i.test(anulados))
            ? "" : anulados.replace(/DocNum/ig, "No.");

        return {
            clase: "obs-alerta",
            corto: falta > 0
                ? "Faltan " + ObsMonto(falta, mon) + " por aplicar en SAP"
                : "El monto del recibo no coincide con SAP",
            detalle: "Se anuló un pago de este recibo en SAP. " +
                "El recibo es por " + ObsMonto(totRec, mon) +
                " y en SAP solo hay " + ObsMonto(enSap, mon) + " aplicados: " +
                "faltan " + ObsMonto(falta, mon) + "." +
                (docs ? " Pago(s) anulado(s) en SAP: " + docs + "." : "") +
                " El recibo puede imprimirse: sale con un sello de conciliación.",
            accion: "Volver a aplicar el monto faltante en SAP con el mismo número de recibo.",
            tecnico: ""
        };
    }

    // ── 4. PAGO ANULADO EN SAP (el recibo volvió a pendientes) ──
    if (/anulado en sap/i.test(obs)) {
        var docAnul = ObsCap(obs, /Era\s+DocNum\s*(\d+)/i);
        return {
            clase: "obs-aviso",
            corto: "El pago fue anulado en SAP",
            detalle: "El pago que ya estaba aplicado se anuló en SAP" +
                (docAnul ? " (pago No. " + docAnul + ")" : "") + ". " +
                "El recibo regresó a la lista de pendientes y espera que se vuelva a operar.",
            accion: "Si el cobro sigue siendo válido, aplíquelo de nuevo en SAP con el mismo número de recibo.",
            tecnico: ""
        };
    }

    // ── 5. PAGO REHECHO EN SAP (anuló + volvió a crear) ──
    if (/re-?apuntado/i.test(obs)) {
        var docNuevo = ObsCap(obs, /DocNum\s*\d+\s*->\s*(\d+)/i);
        return {
            clase: "obs-info",
            corto: "El pago se rehízo en SAP" + (docNuevo ? " (ahora No. " + docNuevo + ")" : ""),
            detalle: "El pago original fue anulado y se registró uno nuevo en SAP. " +
                "El sistema ya quedó enlazado al pago vigente.",
            accion: "", tecnico: ""
        };
    }

    // ── 6. Sin mensaje del sync: hablamos por la situación ──
    if (sit === "OPERADO") {
        return {
            clase: "obs-ok", corto: "Pago aplicado en SAP",
            detalle: "Créditos ya aplicó el pago de este recibo en SAP. Nada pendiente.",
            accion: "", tecnico: ""
        };
    }
    if (sit === "ENVEJECIDO" || (sit === "PENDIENTE" && dias >= DIAS_UMBRAL)) {
        return {
            clase: "obs-aviso",
            corto: "Lleva " + dias + " día(s) esperando aplicación en SAP",
            detalle: "Este recibo se capturó hace " + dias + " día(s) y todavía no se " +
                "aplica el pago en SAP. Lo normal son menos de " + DIAS_UMBRAL + " día(s).",
            accion: "Verifique el cobro y aplíquelo en SAP.",
            tecnico: ""
        };
    }
    if (sit === "PENDIENTE" || !raw) {
        return {
            clase: "obs-neutro",
            corto: "Esperando que se aplique en SAP" + (dias > 0 ? " (hace " + dias + " día(s))" : ""),
            detalle: "El recibo está capturado y en espera de que Créditos aplique el pago en SAP.",
            accion: "", tecnico: ""
        };
    }

    // ── 7. FALLBACK: no reconocimos el patrón → mostramos el original ──
    // (pasa si cambió el formato en ReciboCajaSyncBL: preferimos texto feo
    //  y verdadero antes que ocultar información)
    return {
        clase: "obs-neutro",
        corto: ObsCorta(obs, 90),
        detalle: raw,
        accion: "",
        tecnico: obs.length > 90 ? "" : ""
    };
}


var Filtro = {
    empresa: "", situacion: "TODOS",
