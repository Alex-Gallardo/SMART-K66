@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Tarjetas de resumen ── */
    .dash-cards {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .dash-card {
        flex: 1 1 180px;
        min-width: 160px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e5e8ea;
        border-top: 4px solid #bdc3c7;
        padding: 14px 16px;
        cursor: pointer;
        transition: box-shadow .15s, transform .15s;
    }

        .dash-card:hover {
            box-shadow: 0 6px 18px rgba(0,0,0,.10);
            transform: translateY(-2px);
        }

        .dash-card.activa {
            box-shadow: 0 0 0 2px #2980b9;
        }

        .dash-card .num {
            font-size: 30px;
            font-weight: 700;
            line-height: 1;
        }

        .dash-card .lbl {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #95a5a6;
            font-weight: 700;
            margin-top: 4px;
        }

        .dash-card .sub {
            font-size: 11px;
            color: #7f8c8d;
            margin-top: 2px;
        }

        .dash-card.c-descuadre {
            border-top-color: #e74c3c;
        }

            .dash-card.c-descuadre .num {
                color: #a93226;
            }

        .dash-card.c-envejecido {
            border-top-color: #e67e22;
        }

            .dash-card.c-envejecido .num {
                color: #ba4a00;
            }

        .dash-card.c-anulado {
            border-top-color: #f1c40f;
        }

            .dash-card.c-anulado .num {
                color: #b9770e;
            }

        .dash-card.c-pendiente {
            border-top-color: #3498db;
        }

            .dash-card.c-pendiente .num {
                color: #2471a3;
            }

        .dash-card.c-ok {
            border-top-color: #27ae60;
            cursor: default;
        }

            .dash-card.c-ok .num {
                color: #1e8449;
            }

    /* ── Badges de situación en el grid ── */
    .sit-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        white-space: nowrap;
    }

    .sit-DESCUADRE {
        background: #fadbd8;
        color: #a93226;
        border: 1px solid #e74c3c;
    }

    .sit-ANULADO_SAP {
        background: #fef9e7;
        color: #b9770e;
        border: 1px solid #f1c40f;
    }

    .sit-ENVEJECIDO {
        background: #fdebd0;
        color: #ba4a00;
        border: 1px solid #e67e22;
    }

    .sit-PENDIENTE {
        background: #eaf4fb;
        color: #2471a3;
        border: 1px solid #3498db;
    }

    .emp-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        color: #fff;
        background: #95a5a6;
    }

    .emp-GRACO {
        background: #27ae60;
    }

    .emp-FAES {
        background: #c0392b;
    }

    .emp-BOLIK {
        background: #2c3e50;
    }

    #tablaDash td {
        vertical-align: middle !important;
        font-size: 12.5px;
    }

    #tablaDash th {
        background: #2c3e50;
        color: #ecf0f1;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    #tablaDash .obs {
        font-family: monospace;
        font-size: 11px;
        color: #7f8c8d;
        max-width: 340px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: help;
    }

    #tablaDash .dias-alto {
        color: #a93226;
        font-weight: 700;
    }

    .dash-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }

    @@media (max-width:767px) {
        .dash-card .num {
            font-size: 24px;
        }
    }
</style>

<div class="panel panel-default" style="border-top:4px solid #2c3e50;">
    <div class="panel-heading" style="background:#f7f9fa; border-bottom:1px solid #eee;">
        <h4 class="panel-title" style="display:flex; align-items:center; flex-wrap:wrap; gap:8px; color:#5d6d7e; font-size:13px;">
            <i class="clip-stats"></i>
            <span style="font-weight:700;">Supervisión de Recibos</span>
            <small style="color:#95a5a6;">Salud del módulo frente a SAP</small>
            <span style="margin-left:auto; display:flex; gap:6px;">
                <a href="@Url.Action("Series","ReciboCaja")" class="btn btn-default btn-xs" title="Mantenimiento de series de numeración">
                    <i class="icon-cogs"></i> Series
                </a>
                <a href="@Url.Action("Index","ReciboCaja")" class="btn btn-default btn-xs">
                    <i class="icon-file-text"></i> Ingreso
                </a>
                <button id="btnRefrescar" class="btn btn-primary btn-xs">
                    <i class="icon-refresh"></i> Actualizar
                </button>
            </span>
        </h4>
    </div>
    <div class="panel-body">

        <!-- Filtro empresa -->
        <div class="dash-toolbar">
            <span class="flabel" style="margin:0; font-size:10px; text-transform:uppercase; color:#95a5a6; font-weight:700;">Empresa:</span>
            <div class="btn-group" id="grpEmpresa">
                <button class="btn btn-default btn-sm activa" data-emp="">Todas</button>
                <button class="btn btn-default btn-sm" data-emp="GRACO">Graco</button>
                <button class="btn btn-default btn-sm" data-emp="FAES">Faes</button>
                <button class="btn btn-default btn-sm" data-emp="BOLIK">Bolik</button>
            </div>
            <span id="lblActualizado" style="font-size:11px; color:#95a5a6; margin-left:auto;"></span>
        </div>

        <!-- Tarjetas (click = filtrar el grid) -->
        <div class="dash-cards">
            <div class="dash-card c-descuadre" data-sit="DESCUADRE" title="Anulaciones parciales en SAP: montos que no cuadran">
                <div class="num" id="cardDescuadres">—</div>
                <div class="lbl">⚠ Descuadres</div>
                <div class="sub" id="cardDescuadresMonto"></div>
            </div>
            <div class="dash-card c-envejecido" data-sit="ENVEJECIDO" title="Pendientes con más días de lo normal sin operar">
                <div class="num" id="cardEnvejecidos">—</div>
                <div class="lbl">⏰ Envejecidos (@ViewBag.DiasUmbral+ días)</div>
                <div class="sub">Créditos aún no opera</div>
            </div>
            <div class="dash-card c-anulado" data-sit="ANULADO_SAP" title="Regresados a PENDIENTE por anulación total en SAP">
                <div class="num" id="cardAnulados">—</div>
                <div class="lbl">↩ Anulados en SAP</div>
                <div class="sub">Esperan re-operación</div>
            </div>
            <div class="dash-card c-pendiente" data-sit="TODOS" title="Ver todo lo que está en tránsito">
                <div class="num" id="cardPendientes">—</div>
                <div class="lbl">⏳ Pendientes (total)</div>
                <div class="sub">En tránsito hacia SAP</div>
            </div>
            <div class="dash-card c-ok">
                <div class="num" id="cardOperadosHoy">—</div>
                <div class="lbl">✓ Operados hoy</div>
                <div class="sub" id="cardOperadosSemana"></div>
            </div>
        </div>

        <!-- Grid de detalle -->
        <div style="overflow-x:auto; border:1px solid #e6e6e6; border-radius:6px;">
            <table class="table table-condensed" id="tablaDash" style="margin-bottom:0;">
                <thead>
                    <tr>
                        <th>Situación</th>
                        <th>Recibo</th>
                        <th>Empresa</th>
                        <th>Cliente</th>
                        <th class="text-right">Monto (Q)</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th class="text-right">Días</th>
                        <th>Observación</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbodyDash">
                    <tr><td colspan="10" class="text-center" style="padding:24px; color:#aaa;">Cargando...</td></tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts{
    <script>
var URL_RESUMEN = "@Url.Action("GetDashboardResumen","ReciboCaja")";
var URL_DETALLE = "@Url.Action("GetDashboardDetalle","ReciboCaja")";
var URL_INDEX   = "@Url.Action("Index","ReciboCaja")";
var DIAS_UMBRAL = parseInt("@ViewBag.DiasUmbral") || 3;

var Filtro = { empresa: "", situacion: "TODOS" };

function FmtMoneda(n) {
    return parseFloat(n || 0).toLocaleString("en-US",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function Esc(t) { return $("<span>").text(t || "").html(); }

function CargarResumen() {
    $.get(URL_RESUMEN, { empresa: Filtro.empresa }, function (resp) {
        if (!resp.ok) { toastr.error(resp.msg); return; }
        var d = resp.data;
        $("#cardDescuadres").text(d.Descuadres);
        $("#cardDescuadresMonto").text(d.Descuadres > 0
            ? "Q " + FmtMoneda(d.DescuadresMontoGtq) + " en conflicto" : "Sin conflictos 🎉");
        $("#cardEnvejecidos").text(d.PendientesEnvejecidos);
        $("#cardAnulados").text(d.PendientesAnulados);
        $("#cardPendientes").text(d.PendientesTotal);
        $("#cardOperadosHoy").text(d.OperadosHoy);
        $("#cardOperadosSemana").text(d.OperadosSemana + " en los últimos 7 días");
        $("#lblActualizado").text("Actualizado: " + new Date().toLocaleTimeString());
    });
}

function CargarDetalle() {
    $("#tbodyDash").html('<tr><td colspan="10" class="text-center" style="padding:20px;">' +
        '<i class="icon-spinner icon-spin"></i> Consultando...</td></tr>');

    $.get(URL_DETALLE, { empresa: Filtro.empresa, situacion: Filtro.situacion }, function (resp) {
        var tbody = $("#tbodyDash").empty();
        if (!resp.ok) {
            tbody.html('<tr><td colspan="10" class="text-center text-danger" style="padding:20px;">' + Esc(resp.msg) + '</td></tr>');
            return;
        }
        if (!resp.data || !resp.data.length) {
            tbody.html('<tr><td colspan="10" class="text-center" style="padding:24px; color:#27ae60;">' +
                '<i class="icon-ok-circle"></i> Nada que revisar con este filtro.</td></tr>');
            return;
        }
        $.each(resp.data, function (_, f) {
            var urlAbrir = URL_INDEX +
                "?idRecibo=" + encodeURIComponent(f.IdRecibo) +
                "&empresa="  + encodeURIComponent(f.IdEmpresa);
            tbody.append(
                '<tr>' +
                '<td><span class="sit-badge sit-' + f.Situacion + '">' + f.Situacion.replace("_", " ") + '</span></td>' +
                '<td><strong style="font-family:monospace;">' + Esc(f.IdRecibo) + '</strong></td>' +
                '<td><span class="emp-badge emp-' + f.IdEmpresa + '">' + f.IdEmpresa + '</span></td>' +
                '<td>' + Esc(f.NombreCliente) + '</td>' +
                '<td class="text-right"><strong>' + FmtMoneda(f.MontoGtq) + '</strong></td>' +
                '<td>' + Esc(f.Usuario) + '</td>' +
                '<td>' + Esc(f.FechaRegistro) + '</td>' +
                '<td class="text-right' + (f.DiasAntiguedad >= DIAS_UMBRAL ? ' dias-alto' : '') + '">' +
                    f.DiasAntiguedad + '</td>' +
                '<td class="obs" title="' + Esc(f.SyncObservacion) + '">' + Esc(f.SyncObservacion) + '</td>' +
                '<td><a class="btn btn-xs btn-info" target="_blank" href="' + urlAbrir + '" title="Abrir en la vista de recibos">' +
                    '<i class="icon-external-link"></i></a></td>' +
                '</tr>');
        });
    });
}

function CargarTodo() { CargarResumen(); CargarDetalle(); }

// Filtro empresa
$("#grpEmpresa button").on("click", function () {
    $("#grpEmpresa button").removeClass("activa btn-primary").addClass("btn-default");
    $(this).addClass("activa");
    Filtro.empresa = $(this).data("emp");
    CargarTodo();
});

// Click en tarjeta = filtrar situación
$(".dash-card[data-sit]").on("click", function () {
    $(".dash-card").removeClass("activa");
    $(this).addClass("activa");
    Filtro.situacion = $(this).data("sit");
    CargarDetalle();
});

$("#btnRefrescar").on("click", CargarTodo);

// Auto-refresh cada 60s (solo si la pestaña está visible)
setInterval(function () { if (!document.hidden) CargarTodo(); }, 60000);

CargarTodo();
    </script>
}