// ════════════════════════════════════════════════════════
// DETALLE: servidor (empresa/situación/fechas/operados)
//          + cliente (texto libre sobre el buffer)
// ════════════════════════════════════════════════════════
function CargarDetalle() {
    $("#tbodyDash").html('<tr><td colspan="11" class="text-center" style="padding:20px;">' +
        '<i class="icon-spinner icon-spin"></i> Consultando...</td></tr>');

    $.get(URL_DETALLE, {
        empresa: Filtro.empresa,
        situacion: Filtro.situacion,
        fechaIni: Filtro.fechaIni,
        fechaFin: Filtro.fechaFin,
        incluirOperados: Filtro.incluirOperados,
        incluirAnulados: Filtro.incluirAnulados
    }, function (resp) {
        if (!resp.ok) {
            $("#tbodyDash").html('<tr><td colspan="11" class="text-center text-danger" style="padding:20px;">' +
                Esc(resp.msg) + '</td></tr>');
            return;
        }
        _filas = resp.data || [];
        // Poda: des-seleccionar lo que ya no está en el resultado del servidor
        var validas = {};
        $.each(_filas, function (_, f) { validas[KeySel(f)] = true; });
        Object.keys(_sel).forEach(function (k) { if (!validas[k]) delete _sel[k]; });
        ActualizarBotonImprimir();
        PintarDetalle();
    });
}

function PintarDetalle() {
    var tbody = $("#tbodyDash").empty();
    var txt = (Filtro.texto || "").toUpperCase();

    var visibles = _filas.filter(function (f) {
        if (!txt) return true;
        return (f.IdRecibo || "").toUpperCase().indexOf(txt) !== -1 ||
            (f.NombreCliente || "").toUpperCase().indexOf(txt) !== -1 ||
            (f.Usuario || "").toUpperCase().indexOf(txt) !== -1;
    });

    // Contador "mostrando X de Y" + aviso de tope del servidor
    var conteo = "Mostrando " + visibles.length + " de " + _filas.length;
    if (_filas.length >= TOPE_FILAS)
        conteo += ' <span class="tope" title="El servidor limita a ' + TOPE_FILAS +
            ' filas: acote el rango de fechas para ver todo">(tope alcanzado ⚠)</span>';
    $("#lblConteo").html(conteo);

    if (!visibles.length) {
        tbody.html('<tr><td colspan="11" class="text-center" style="padding:24px; color:#27ae60;">' +
            '<i class="icon-ok-circle"></i> Nada que revisar con este filtro.</td></tr>');
        return;
    }

    $.each(visibles, function (_, f) {
        var urlAbrir = URL_INDEX +
            "?idRecibo=" + encodeURIComponent(f.IdRecibo) +
            "&empresa=" + encodeURIComponent(f.IdEmpresa);

        var esAnulado = (f.Situacion === "ANULADO");
        var esDescuadre = (f.Situacion === "DESCUADRE");

        // ★ CAMBIO: TODO recibo es imprimible.
        // Antes el DESCUADRE quedaba fuera del lote (checkbox disabled),
        // espejando un bloqueo del servidor que YA NO EXISTE. Bloquear la
        // reimpresión no protegía nada —el recibo se imprime solo al
        // guardarse, mucho antes de que el sincronizador detecte el
        // descuadre— y le quitaba la copia justo a Créditos, que es quien
        // debe investigar. Ahora los DESCUADRE salen con banda ámbar de
        // conciliación y los ANULADO con su marca de agua: el papel se
        // auto-explica, y cada impresión queda registrada en analytics.
        var key = KeySel(f);
        var sel = !!_sel[key];

        var clases = (sel ? "row-imp-sel " : "") + (esAnulado ? "row-anulado" : "");

        // Un anulado nunca es "atrasado": está muerto, nadie lo está esperando.
        var diasAlto = (!esAnulado && f.Situacion !== "OPERADO" &&
            f.DiasAntiguedad >= DIAS_UMBRAL);

        // Aviso —no bloqueo— de lo que va a salir en el papel.
        var tipChk = esDescuadre
            ? "Se imprimirá con un sello de \u0022en conciliaci\u00f3n con SAP\u0022"
            : (esAnulado ? "Se imprimir\u00e1 con la marca de agua ANULADO"
                : "Incluir en el lote de impresi\u00f3n");

        // ── Observación traducida a lenguaje de negocio ──
        var info = InterpretarObservacion(f);
        // Tooltip = explicación completa + qué hacer (el title respeta \n)
        var tip = info.detalle + (info.accion ? "\n\n👉 Qué hacer: " + info.accion : "");
        // La acción se muestra inline SOLO cuando hay algo que hacer:
        // así el grid no se llena de "No requiere acción".
        var mostrarAccion = info.accion &&
            (info.clase === "obs-alerta" || info.clase === "obs-aviso");

        tbody.append(
            '<tr class="' + clases + '">' +
            '<td class="td-chk">' +
            '<input type="checkbox" class="chk-imp" data-key="' + key + '"' +
            ' title="' + tipChk + '"' +
            (sel ? ' checked' : '') + ' /></td>' +
            '<td><span class="sit-badge sit-' + f.Situacion + '">' + LabelSit(f.Situacion) + '</span></td>' +
            '<td><strong style="font-family:monospace;">' + Esc(f.IdRecibo) + '</strong></td>' +
            '<td><span class="emp-badge emp-' + f.IdEmpresa + '">' + f.IdEmpresa + '</span></td>' +
            '<td>' + Esc(f.NombreCliente) + '</td>' +
            '<td class="text-right"><strong>' + FmtMoneda(f.MontoGtq) + '</strong></td>' +
            '<td>' + Esc(f.Usuario) + '</td>' +
            '<td>' + Esc(f.FechaRegistro) + '</td>' +
            '<td class="text-right' + (diasAlto ? ' dias-alto' : '') + '"' +
            (diasAlto ? ' title="Lleva más de ' + DIAS_UMBRAL + ' días sin aplicarse en SAP"' : '') + '>' +
            f.DiasAntiguedad + '</td>' +
            '<td class="obs ' + info.clase + '" title="' + Esc(tip) + '">' +
            '<span class="obs-msg">' + Esc(info.corto) + '</span>' +
            (mostrarAccion ? '<span class="obs-accion">' + Esc(info.accion) + '</span>' : '') +
            (info.tecnico ? '<span class="obs-tecnico">' + Esc(info.tecnico) + '</span>' : '') +
            '</td>' +
            '<td><a class="btn btn-xs btn-info" target="_blank" href="' + urlAbrir + '" title="Abrir este recibo">' +
            '<i class="icon-external-link"></i></a></td>' +
            '</tr>');
    });

    SincronizarChkTodosImp();
    ActualizarBotonImprimir();
}

