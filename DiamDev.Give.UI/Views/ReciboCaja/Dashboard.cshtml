@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Tarjetas de resumen ── */
    .dash-cards {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .dash-card {
        flex: 1 1 180px;
        min-width: 160px;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e5e8ea;
        border-top: 4px solid #bdc3c7;
        padding: 14px 16px;
        cursor: pointer;
        transition: box-shadow .15s, transform .15s;
    }

        .dash-card:hover {
            box-shadow: 0 6px 18px rgba(0,0,0,.10);
            transform: translateY(-2px);
        }

        .dash-card.activa {
            box-shadow: 0 0 0 2px #2980b9;
        }

        .dash-card .num {
            font-size: 30px;
            font-weight: 700;
            line-height: 1;
        }

        .dash-card .lbl {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #95a5a6;
            font-weight: 700;
            margin-top: 4px;
        }

        .dash-card .sub {
            font-size: 11px;
            color: #7f8c8d;
            margin-top: 2px;
        }

        .dash-card.c-descuadre {
            border-top-color: #e74c3c;
        }

            .dash-card.c-descuadre .num {
                color: #a93226;
            }

        .dash-card.c-envejecido {
            border-top-color: #e67e22;
        }

            .dash-card.c-envejecido .num {
                color: #ba4a00;
            }

        .dash-card.c-anulado {
            border-top-color: #f1c40f;
        }

            .dash-card.c-anulado .num {
                color: #b9770e;
            }

        .dash-card.c-pendiente {
            border-top-color: #3498db;
        }

            .dash-card.c-pendiente .num {
                color: #2471a3;
            }

        .dash-card.c-ok {
            border-top-color: #27ae60;
            cursor: default;
        }

            .dash-card.c-ok .num {
                color: #1e8449;
            }

    /* ── Badges de situación en el grid ── */
    .sit-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        white-space: nowrap;
    }

    .sit-DESCUADRE {
        background: #fadbd8;
        color: #a93226;
        border: 1px solid #e74c3c;
    }

    .sit-ANULADO_SAP {
        background: #fef9e7;
        color: #b9770e;
        border: 1px solid #f1c40f;
    }

    .sit-ENVEJECIDO {
        background: #fdebd0;
        color: #ba4a00;
        border: 1px solid #e67e22;
    }

    .sit-PENDIENTE {
        background: #eaf4fb;
        color: #2471a3;
        border: 1px solid #3498db;
    }

    .emp-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        color: #fff;
        background: #95a5a6;
    }

    .emp-GRACO {
        background: #27ae60;
    }

    .emp-FAES {
        background: #c0392b;
    }

    .emp-BOLIK {
        background: #2c3e50;
    }

    #tablaDash td {
        vertical-align: middle !important;
        font-size: 12.5px;
    }

    #tablaDash th {
        background: #2c3e50;
        color: #ecf0f1;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    #tablaDash .obs {
        font-family: monospace;
        font-size: 11px;
        color: #7f8c8d;
        max-width: 340px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: help;
    }

    #tablaDash .dias-alto {
        color: #a93226;
        font-weight: 700;
    }

    .dash-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
    }

    @@media (max-width:767px) {
        .dash-card .num {
            font-size: 24px;
        }
    }

    /* ── Barra de filtros (entre cards y grid) ── */
    .dash-filtros {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        align-items: flex-start;
        background: #f7f9fa;
        border: 1px solid #e5e8ea;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 12px;
    }

        .dash-filtros .flt {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .dash-filtros .flt-lbl {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #95a5a6;
            font-weight: 700;
        }

        .dash-filtros input[type=text] {
            height: 30px;
            font-size: 12px;
        }

        .dash-filtros .flt-fecha input {
            max-width: 120px;
        }

        .dash-filtros .flt-buscar input {
            min-width: 200px;
        }

    .presets-fecha .btn {
        padding: 3px 9px;
        font-size: 11px;
    }

        .presets-fecha .btn.activa {
            background: #2c3e50;
            color: #fff;
            border-color: #2c3e50;
        }

    .chk-operados {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #5d6d7e;
        cursor: pointer;
        user-select: none;
        height: 30px;
        margin: 0;
        font-weight: 400;
    }

        .chk-operados input {
            margin: 0;
            cursor: pointer;
        }

    #lblConteo {
        font-size: 11px;
        color: #7f8c8d;
    }

        #lblConteo .tope {
            color: #ba4a00;
            font-weight: 700;
        }

    .sit-OPERADO {
        background: #d5f5e3;
        color: #1e8449;
        border: 1px solid #27ae60;
    }

    /* ── Selección para impresión masiva ── */
    #tablaDash .chk-imp, #chkTodosImp {
        width: 15px;
        height: 15px;
        cursor: pointer;
    }

        #tablaDash .chk-imp:disabled {
            cursor: not-allowed;
        }

    #tablaDash td.td-chk {
        text-align: center;
    }

    #tablaDash tr.row-imp-sel td {
        background: #eaf4fb !important;
    }

    #badgeImpSel {
        background: #fff;
        color: #1e8449;
        border-radius: 10px;
        padding: 1px 7px;
        font-size: 10px;
        font-weight: 700;
        margin-left: 3px;
    }
</style>

<div class="panel panel-default" style="border-top:4px solid #2c3e50;">
    <div class="panel-heading" style="background:#f7f9fa; border-bottom:1px solid #eee;">
        <h4 class="panel-title" style="display:flex; align-items:center; flex-wrap:wrap; gap:8px; color:#5d6d7e; font-size:13px;">
            <i class="clip-stats"></i>
            <span style="font-weight:700;">Supervisión de Recibos</span>
            <small style="color:#95a5a6;">Salud del módulo frente a SAP</small>
            <span style="margin-left:auto; display:flex; gap:6px;">
                <a href="@Url.Action("Series","ReciboCaja")" class="btn btn-default btn-xs" title="Mantenimiento de series de numeración">
                    <i class="icon-cogs"></i> Series
                </a>
                <a href="@Url.Action("Index","ReciboCaja")" class="btn btn-default btn-xs">
                    <i class="icon-file-text"></i> Nuevo Recibo
                </a>
                <button id="btnRefrescar" class="btn btn-primary btn-xs">
                    <i class="icon-refresh"></i> Actualizar
                </button>
            </span>
        </h4>
    </div>
    <div class="panel-body">

        <!-- Filtro empresa -->
        <div class="dash-toolbar">
            <span class="flabel" style="margin:0; font-size:10px; text-transform:uppercase; color:#95a5a6; font-weight:700;">Empresa:</span>
            <div class="btn-group" id="grpEmpresa">
                <button class="btn btn-default btn-sm activa" data-emp="">Todas</button>
                <button class="btn btn-default btn-sm" data-emp="GRACO">Graco</button>
                <button class="btn btn-default btn-sm" data-emp="FAES">Faes</button>
                <button class="btn btn-default btn-sm" data-emp="BOLIK">Bolik</button>
            </div>
            <span id="lblActualizado" style="font-size:11px; color:#95a5a6; margin-left:auto;"></span>
        </div>

        <!-- ── FILTROS DEL GRID (las cards no se filtran por fecha: son la foto actual) ── -->
        <div class="dash-filtros">

            <div class="flt">
                <span class="flt-lbl">Rápido</span>
                <div class="btn-group presets-fecha" id="grpPresets">
                    <button class="btn btn-default" data-preset="hoy">Hoy</button>
                    <button class="btn btn-default" data-preset="7d">7 días</button>
                    <button class="btn btn-default" data-preset="mes">Este mes</button>
                    <button class="btn btn-default activa" data-preset="todo">Todo</button>
                </div>
            </div>

            <div class="flt flt-fecha">
                <span class="flt-lbl"><i class="icon-calendar"></i> Desde</span>
                <input type="text" id="fltFechaIni" class="form-control date-picker"
                       data-date-format="yyyy-mm-dd" placeholder="—" autocomplete="off" />
            </div>
            <div class="flt flt-fecha">
                <span class="flt-lbl"><i class="icon-calendar"></i> Hasta</span>
                <input type="text" id="fltFechaFin" class="form-control date-picker"
                       data-date-format="yyyy-mm-dd" placeholder="—" autocomplete="off" />
            </div>

            <div class="flt flt-buscar">
                <span class="flt-lbl"><i class="icon-search"></i> Buscar</span>
                <input type="text" id="fltTexto" class="form-control"
                       placeholder="Recibo, cliente o usuario..." autocomplete="off" />
            </div>

            <div class="flt">
                <span class="flt-lbl">&nbsp;</span>
                <label class="chk-operados" title="Incluir recibos ya operados en SAP (para auditar un rango de fechas)">
                    <input type="checkbox" id="chkOperados" />
                    Incluir operados ✓
                </label>
            </div>

            <div class="flt" style="margin-left:auto;">
                <span class="flt-lbl">&nbsp;</span>
                <div style="display:flex; gap:6px; align-items:center;">
                    <span id="lblConteo"></span>
                    <button id="btnLimpiarFiltros" class="btn btn-default btn-xs" title="Quitar todos los filtros">
                        <i class="icon-remove"></i> Limpiar
                    </button>
                    <button id="btnImprimirSel" class="btn btn-primary btn-xs" disabled
                            title="Imprimir los recibos seleccionados en un solo documento">
                        <i class="icon-print"></i> Imprimir<span id="badgeImpSel">0</span>
                    </button>
                    <button id="btnExportExcel" class="btn btn-success btn-xs" title="Exportar con formato para créditos">
                        <i class="icon-table"></i> Excel
                    </button>
                    <!-- <button id="btnExportCsv" class="btn btn-default btn-xs" title="Exportar lo visible a CSV">
        <i class="icon-download-alt"></i> CSV
    </button> -->
                </div>
            </div>

        </div>

        <!-- Tarjetas (click = filtrar el grid) -->
        <div class="dash-cards">
            <div class="dash-card c-descuadre" data-sit="DESCUADRE" title="Anulaciones parciales en SAP: montos que no cuadran">
                <div class="num" id="cardDescuadres">—</div>
                <div class="lbl">⚠ Descuadres</div>
                <div class="sub" id="cardDescuadresMonto"></div>
            </div>
            <div class="dash-card c-envejecido" data-sit="ENVEJECIDO" title="Pendientes con más días de lo normal sin operar">
                <div class="num" id="cardEnvejecidos">—</div>
                <div class="lbl">⏰ Envejecidos (@ViewBag.DiasUmbral+ días)</div>
                <div class="sub">Créditos aún no opera</div>
            </div>
            <div class="dash-card c-anulado" data-sit="ANULADO_SAP" title="Regresados a PENDIENTE por anulación total en SAP">
                <div class="num" id="cardAnulados">—</div>
                <div class="lbl">↩ Anulados en SAP</div>
                <div class="sub">Esperan re-operación</div>
            </div>
            <div class="dash-card c-pendiente" data-sit="TODOS" title="Ver todo lo que está en tránsito">
                <div class="num" id="cardPendientes">—</div>
                <div class="lbl">⏳ Pendientes (total)</div>
                <div class="sub">En tránsito hacia SAP</div>
            </div>
            <div class="dash-card c-ok">
                <div class="num" id="cardOperadosHoy">—</div>
                <div class="lbl">✓ Operados hoy</div>
                <div class="sub" id="cardOperadosSemana"></div>
            </div>
        </div>


        <!-- Grid de detalle -->
        <div style="overflow-x:auto; border:1px solid #e6e6e6; border-radius:6px;">
            <table class="table table-condensed" id="tablaDash" style="margin-bottom:0;">
                <thead>
                    <tr>
                        <th style="width:34px; text-align:center;">
                            <input type="checkbox" id="chkTodosImp" title="Seleccionar todos los imprimibles" />
                        </th>
                        <th>Situación</th>
                        <th>Recibo</th>
                        <th>Empresa</th>
                        <th>Cliente</th>
                        <th class="text-right">Monto (Q)</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th class="text-right">Días</th>
                        <th>Observación</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbodyDash">
                    <tr><td colspan="11" class="text-center" style="padding:24px; color:#aaa;">Cargando...</td></tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts{
    <script>
var URL_RESUMEN = "@Url.Action("GetDashboardResumen","ReciboCaja")";
var URL_DETALLE = "@Url.Action("GetDashboardDetalle","ReciboCaja")";
var URL_INDEX   = "@Url.Action("Index","ReciboCaja")";
var DIAS_UMBRAL = parseInt("@@ViewBag.DiasUmbral") || 3;
var TOPE_FILAS = 500;   // espejo del TOP 500 del backend
var URL_IMPRIMIR_LOTE = "@Url.Action("ImprimirLote","ReciboCaja")";

var Filtro = {
    empresa: "", situacion: "TODOS",
    fechaIni: "", fechaFin: "",
    incluirOperados: false,
    texto: ""
};

    var _filas = [];   // buffer de la última respuesta del servidor

    // ── Selección para impresión: clave "ID|EMPRESA" ────────
    // Vive fuera del DOM (como estado en React): sobrevive a los
    // re-render del filtro de texto y al auto-refresh de 60s.
    var _sel = {};

    function KeySel(f) { return f.IdRecibo + "|" + f.IdEmpresa; }

    function ActualizarBotonImprimir() {
        var n = Object.keys(_sel).length;
        $("#btnImprimirSel").prop("disabled", n === 0);
        $("#badgeImpSel").text(n);
    }

    function SincronizarChkTodosImp() {
        var total = $("#tbodyDash .chk-imp:not(:disabled)").length;
        var marcados = $("#tbodyDash .chk-imp:checked").length;
        $("#chkTodosImp").prop("checked", total > 0 && marcados === total);
    }

function FmtMoneda(n) {
    return parseFloat(n || 0).toLocaleString("en-US",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function Esc(t) { return $("<span>").text(t || "").html(); }
function FechaISO(d) {
    return d.getFullYear() + "-" +
        ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
        ("0" + d.getDate()).slice(-2);
}

// ════════════════════════════════════════════════════════
// RESUMEN (cards): solo responde a empresa — foto actual
// ════════════════════════════════════════════════════════
function CargarResumen() {
    $.get(URL_RESUMEN, { empresa: Filtro.empresa }, function (resp) {
        if (!resp.ok) { toastr.error(resp.msg); return; }
        var d = resp.data;
        $("#cardDescuadres").text(d.Descuadres);
        $("#cardDescuadresMonto").text(d.Descuadres > 0
            ? "Q " + FmtMoneda(d.DescuadresMontoGtq) + " en conflicto" : "Sin conflictos 🎉");
        $("#cardEnvejecidos").text(d.PendientesEnvejecidos);
        $("#cardAnulados").text(d.PendientesAnulados);
        $("#cardPendientes").text(d.PendientesTotal);
        $("#cardOperadosHoy").text(d.OperadosHoy);
        $("#cardOperadosSemana").text(d.OperadosSemana + " en los últimos 7 días");
        $("#lblActualizado").text("Actualizado: " + new Date().toLocaleTimeString());
    });
}

// ════════════════════════════════════════════════════════
// DETALLE: servidor (empresa/situación/fechas/operados)
//          + cliente (texto libre sobre el buffer)
// ════════════════════════════════════════════════════════
function CargarDetalle() {
    $("#tbodyDash").html('<tr><td colspan="11" class="text-center" style="padding:20px;">' +
        '<i class="icon-spinner icon-spin"></i> Consultando...</td></tr>');

    $.get(URL_DETALLE, {
        empresa: Filtro.empresa,
        situacion: Filtro.situacion,
        fechaIni: Filtro.fechaIni,
        fechaFin: Filtro.fechaFin,
        incluirOperados: Filtro.incluirOperados
    }, function (resp) {
        if (!resp.ok) {
            $("#tbodyDash").html('<tr><td colspan="11" class="text-center text-danger" style="padding:20px;">' +
                Esc(resp.msg) + '</td></tr>');
            return;
        }
        _filas = resp.data || [];
        // Poda: des-seleccionar lo que ya no está en el resultado del servidor
        var validas = {};
        $.each(_filas, function (_, f) { validas[KeySel(f)] = true; });
        Object.keys(_sel).forEach(function (k) { if (!validas[k]) delete _sel[k]; });
        ActualizarBotonImprimir();
        PintarDetalle();
    });
}

function PintarDetalle() {
    var tbody = $("#tbodyDash").empty();
    var txt = (Filtro.texto || "").toUpperCase();

    var visibles = _filas.filter(function (f) {
        if (!txt) return true;
        return (f.IdRecibo || "").toUpperCase().indexOf(txt) !== -1 ||
               (f.NombreCliente || "").toUpperCase().indexOf(txt) !== -1 ||
               (f.Usuario || "").toUpperCase().indexOf(txt) !== -1;
    });

    // Contador "mostrando X de Y" + aviso de tope del servidor
    var conteo = "Mostrando " + visibles.length + " de " + _filas.length;
    if (_filas.length >= TOPE_FILAS)
        conteo += ' <span class="tope" title="El servidor limita a ' + TOPE_FILAS +
                  ' filas: acote el rango de fechas para ver todo">(tope alcanzado ⚠)</span>';
    $("#lblConteo").html(conteo);

    if (!visibles.length) {
        tbody.html('<tr><td colspan="11" class="text-center" style="padding:24px; color:#27ae60;">' +
            '<i class="icon-ok-circle"></i> Nada que revisar con este filtro.</td></tr>');
        return;
    }

    $.each(visibles, function (_, f) {
        var urlAbrir = URL_INDEX +
            "?idRecibo=" + encodeURIComponent(f.IdRecibo) +
            "&empresa="  + encodeURIComponent(f.IdEmpresa);
        var esImprimible = (f.Situacion !== "DESCUADRE");
        var key = KeySel(f);
        var sel = esImprimible && _sel[key];
        tbody.append(
            '<tr class="' + (sel ? 'row-imp-sel' : '') + '">' +
            '<td class="td-chk">' +
            '<input type="checkbox" class="chk-imp" data-key="' + key + '"' +
            (esImprimible ? '' : ' disabled title="Bloqueado: recibo con descuadre frente a SAP"') +
            (sel ? ' checked' : '') + ' /></td>' +
            '<td><span class="sit-badge sit-' + f.Situacion + '">' + f.Situacion.replace("_", " ") + '</span></td>' +
            '<td><strong style="font-family:monospace;">' + Esc(f.IdRecibo) + '</strong></td>' +
            '<td><span class="emp-badge emp-' + f.IdEmpresa + '">' + f.IdEmpresa + '</span></td>' +
            '<td>' + Esc(f.NombreCliente) + '</td>' +
            '<td class="text-right"><strong>' + FmtMoneda(f.MontoGtq) + '</strong></td>' +
            '<td>' + Esc(f.Usuario) + '</td>' +
            '<td>' + Esc(f.FechaRegistro) + '</td>' +
            '<td class="text-right' +
                ((f.Situacion !== "OPERADO" && f.DiasAntiguedad >= DIAS_UMBRAL) ? ' dias-alto' : '') + '">' +
                f.DiasAntiguedad + '</td>' +
            '<td class="obs" title="' + Esc(f.SyncObservacion) + '">' + Esc(f.SyncObservacion) + '</td>' +
            '<td><a class="btn btn-xs btn-info" target="_blank" href="' + urlAbrir + '" title="Abrir en la vista de recibos">' +
                '<i class="icon-external-link"></i></a></td>' +
            '</tr>');
    });

    SincronizarChkTodosImp();
    ActualizarBotonImprimir();
}

function CargarTodo() { CargarResumen(); CargarDetalle(); }

// ════════════════════════════════════════════════════════
// FILTROS
// ════════════════════════════════════════════════════════

// Empresa (afecta cards + grid)
$("#grpEmpresa button").on("click", function () {
    $("#grpEmpresa button").removeClass("activa btn-primary").addClass("btn-default");
    $(this).addClass("activa");
    Filtro.empresa = $(this).data("emp");
    CargarTodo();
});

// Cards = filtro de situación del grid
$(".dash-card[data-sit]").on("click", function () {
    $(".dash-card").removeClass("activa");
    $(this).addClass("activa");
    Filtro.situacion = $(this).data("sit");
    CargarDetalle();
});

// Presets rápidos de fecha
$("#grpPresets button").on("click", function () {
    $("#grpPresets button").removeClass("activa");
    $(this).addClass("activa");

    var hoy = new Date(), ini = "", fin = "";
    switch ($(this).data("preset")) {
        case "hoy":
            ini = fin = FechaISO(hoy); break;
        case "7d":
            var h7 = new Date(); h7.setDate(h7.getDate() - 6);
            ini = FechaISO(h7); fin = FechaISO(hoy); break;
        case "mes":
            ini = FechaISO(new Date(hoy.getFullYear(), hoy.getMonth(), 1));
            fin = FechaISO(hoy); break;
        case "todo":
            ini = ""; fin = ""; break;
    }
    $("#fltFechaIni").val(ini);
    $("#fltFechaFin").val(fin);
    Filtro.fechaIni = ini; Filtro.fechaFin = fin;
    CargarDetalle();
});

// Fechas manuales (datepicker del theme dispara 'change' o 'changeDate' según versión)
$("#fltFechaIni, #fltFechaFin").on("change changeDate", function () {
    // Fecha manual = ya no aplica ningún preset
    $("#grpPresets button").removeClass("activa");
    Filtro.fechaIni = $("#fltFechaIni").val();
    Filtro.fechaFin = $("#fltFechaFin").val();
    CargarDetalle();
});

// Incluir operados
$("#chkOperados").on("change", function () {
    Filtro.incluirOperados = $(this).is(":checked");
    CargarDetalle();
});

// Texto libre: cliente-side sobre el buffer, con debounce corto
var timerTxt = null;
$("#fltTexto").on("input", function () {
    clearTimeout(timerTxt);
    var v = $(this).val();
    timerTxt = setTimeout(function () {
        Filtro.texto = v.trim();
        PintarDetalle();       // sin viaje al servidor: filtra el buffer
    }, 250);
});

// Limpiar todo
$("#btnLimpiarFiltros").on("click", function () {
    Filtro.situacion = "TODOS"; Filtro.fechaIni = ""; Filtro.fechaFin = "";
    Filtro.incluirOperados = false; Filtro.texto = "";
    $(".dash-card").removeClass("activa");
    $("#grpPresets button").removeClass("activa")
        .filter("[data-preset='todo']").addClass("activa");
    $("#fltFechaIni, #fltFechaFin, #fltTexto").val("");
    $("#chkOperados").prop("checked", false);
    CargarDetalle();
});

// ════════════════════════════════════════════════════════
// EXPORTAR CSV (lo visible: respeta todos los filtros)
// ════════════════════════════════════════════════════════
$("#btnExportCsv").on("click", function () {
    var txt = (Filtro.texto || "").toUpperCase();
    var visibles = _filas.filter(function (f) {
        if (!txt) return true;
        return (f.IdRecibo || "").toUpperCase().indexOf(txt) !== -1 ||
               (f.NombreCliente || "").toUpperCase().indexOf(txt) !== -1 ||
               (f.Usuario || "").toUpperCase().indexOf(txt) !== -1;
    });
    if (!visibles.length) { toastr.info("No hay filas para exportar."); return; }

    // Campo CSV seguro: comillas dobladas + campo entre comillas (RFC 4180)
    function Csv(v) { return '"' + String(v == null ? "" : v).replace(/"/g, '""') + '"'; }

    var filas = ["Situacion,Recibo,Empresa,Cliente,MontoGTQ,Usuario,Fecha,Dias,Observacion"];
    $.each(visibles, function (_, f) {
        filas.push([
            Csv(f.Situacion), Csv(f.IdRecibo), Csv(f.IdEmpresa), Csv(f.NombreCliente),
            Csv(f.MontoGtq), Csv(f.Usuario), Csv(f.FechaRegistro),
            Csv(f.DiasAntiguedad), Csv(f.SyncObservacion)
        ].join(","));
    });

    // "sep=," en la primera línea le dice a Excel qué separador usar,
    // sin importar la configuración regional de Windows del usuario.
    var blob = new Blob(["\uFEFF" + "sep=,\r\n" + filas.join("\r\n")],
        { type: "text/csv;charset=utf-8;" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "supervision_recibos_" + FechaISO(new Date()) + ".csv";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    toastr.success(visibles.length + " fila(s) exportada(s).");
});

// ════════════════════════════════════════════════════════
// EXPORTAR EXCEL CON FORMATO (HTML → .xls)
// Excel abre tablas HTML respetando estilos: colores, anchos,
// negritas y formatos numéricos (mso-number-format).
// Exporta LO VISIBLE: respeta todos los filtros activos.
// ════════════════════════════════════════════════════════
$("#btnExportExcel").on("click", function () {
    var txt = (Filtro.texto || "").toUpperCase();
    var visibles = _filas.filter(function (f) {
        if (!txt) return true;
        return (f.IdRecibo || "").toUpperCase().indexOf(txt) !== -1 ||
               (f.NombreCliente || "").toUpperCase().indexOf(txt) !== -1 ||
               (f.Usuario || "").toUpperCase().indexOf(txt) !== -1;
    });
    if (!visibles.length) { toastr.info("No hay filas para exportar."); return; }

    // ── Colores por situación (espejo de los badges del dashboard) ──
    var COLORES_SIT = {
        "DESCUADRE":   { bg: "#FADBD8", fg: "#A93226" },
        "ANULADO_SAP": { bg: "#FEF9E7", fg: "#B9770E" },
        "ENVEJECIDO":  { bg: "#FDEBD0", fg: "#BA4A00" },
        "PENDIENTE":   { bg: "#EAF4FB", fg: "#2471A3" },
        "OPERADO":     { bg: "#D5F5E3", fg: "#1E8449" }
    };

    // ── Resumen de filtros aplicados (para que el Excel sea auto-explicativo) ──
    var partes = [];
    partes.push("Empresa: " + (Filtro.empresa || "Todas"));
    partes.push("Situación: " + (Filtro.situacion === "TODOS" ? "Todas" : Filtro.situacion));
    if (Filtro.fechaIni || Filtro.fechaFin)
        partes.push("Rango: " + (Filtro.fechaIni || "inicio") + " → " + (Filtro.fechaFin || "hoy"));
    if (Filtro.incluirOperados) partes.push("Incluye operados");
    if (Filtro.texto) partes.push("Búsqueda: \"" + Filtro.texto + "\"");
    var filtrosTexto = partes.join("   |   ");

    var totalMonto = visibles.reduce(function (s, f) { return s + (parseFloat(f.MontoGtq) || 0); }, 0);

    // ── Construcción del documento ──
    // mso-number-format:'\@@'       → fuerza TEXTO (protege IDs de recibo)
    // mso-number-format:'#,##0.00' → número con miles y 2 decimales REAL
    //   (el valor viaja crudo en la celda: se puede sumar/filtrar en Excel)
    var html =
    '<html xmlns:x="urn:schemas-microsoft-com:office:excel">' +
    '<head><meta charset="utf-8" />' +
    '<style>' +
        'td, th { font-family: Calibri, Arial, sans-serif; font-size: 11pt; vertical-align: middle; }' +
        '.titulo   { font-size: 16pt; font-weight: bold; color: #2C3E50; }' +
        '.subt     { font-size: 9pt; color: #7F8C8D; }' +
        '.hdr      { background: #2C3E50; color: #FFFFFF; font-weight: bold; font-size: 9pt;' +
                    ' border: .5pt solid #1A252F; text-align: center; }' +
        '.c        { border: .5pt solid #D5DBDB; }' +
        '.mono     { font-family: Consolas, monospace; font-weight: bold; }' +
        '.num      { text-align: right; mso-number-format: "#,##0.00"; }' +
        '.entero   { text-align: center; mso-number-format: "0"; }' +
        '.txt      { mso-number-format: "\\@@"; }' +
        '.total    { background: #ECF0F1; font-weight: bold; border: .5pt solid #BDC3C7; }' +
        '.diasAlto { color: #A93226; font-weight: bold; }' +
    '</style></head><body>' +
    '<table>' +
    '<tr><td colspan="9" class="titulo">Supervisi&oacute;n de Recibos de Caja</td></tr>' +
    '<tr><td colspan="9" class="subt">' + Esc(filtrosTexto) + '</td></tr>' +
    '<tr><td colspan="9" class="subt">Generado: ' + new Date().toLocaleString() +
        ' &nbsp;&mdash;&nbsp; ' + visibles.length + ' recibo(s)</td></tr>' +
    '<tr><td colspan="9"></td></tr>' +
    '<tr>' +
        '<td class="hdr" width="110">Situaci&oacute;n</td>' +
        '<td class="hdr" width="110">Recibo</td>' +
        '<td class="hdr" width="70">Empresa</td>' +
        '<td class="hdr" width="260">Cliente</td>' +
        '<td class="hdr" width="100">Monto (Q)</td>' +
        '<td class="hdr" width="90">Usuario</td>' +
        '<td class="hdr" width="85">Fecha</td>' +
        '<td class="hdr" width="45">D&iacute;as</td>' +
        '<td class="hdr" width="420">Observaci&oacute;n</td>' +
    '</tr>';

    $.each(visibles, function (_, f) {
        var col = COLORES_SIT[f.Situacion] || { bg: "#FFFFFF", fg: "#000000" };
        var diasAlto = (f.Situacion !== "OPERADO" && f.DiasAntiguedad >= DIAS_UMBRAL);
        html +=
        '<tr>' +
            '<td class="c txt" style="background:' + col.bg + '; color:' + col.fg +
                '; font-weight:bold; text-align:center;">' + f.Situacion.replace("_", " ") + '</td>' +
            '<td class="c txt mono">' + Esc(f.IdRecibo) + '</td>' +
            '<td class="c txt" style="text-align:center;">' + Esc(f.IdEmpresa) + '</td>' +
            '<td class="c txt">' + Esc(f.NombreCliente) + '</td>' +
            '<td class="c num">' + (parseFloat(f.MontoGtq) || 0) + '</td>' +
            '<td class="c txt">' + Esc(f.Usuario) + '</td>' +
            '<td class="c txt" style="text-align:center;">' + Esc(f.FechaRegistro) + '</td>' +
            '<td class="c entero' + (diasAlto ? ' diasAlto' : '') + '">' + f.DiasAntiguedad + '</td>' +
            '<td class="c txt">' + Esc(f.SyncObservacion) + '</td>' +
        '</tr>';
    });

    html +=
    '<tr>' +
        '<td class="total" colspan="4" style="text-align:right;">TOTAL (' + visibles.length + ' recibos)</td>' +
        '<td class="total num">' + totalMonto + '</td>' +
        '<td class="total" colspan="4"></td>' +
    '</tr>' +
    '</table></body></html>';

    var blob = new Blob(["\uFEFF" + html], { type: "application/vnd.ms-excel" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "supervision_recibos_" + FechaISO(new Date()) + ".xls";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    toastr.success(visibles.length + " fila(s) exportada(s) a Excel.");
});

// ════════════════════════════════════════════════════════
// IMPRESIÓN MASIVA
// ════════════════════════════════════════════════════════
$(document).on("change", "#tbodyDash .chk-imp", function () {
    var key = $(this).data("key");
    if ($(this).prop("checked")) _sel[key] = true;
    else delete _sel[key];
    $(this).closest("tr").toggleClass("row-imp-sel", $(this).prop("checked"));
    ActualizarBotonImprimir();
    SincronizarChkTodosImp();
});

$("#chkTodosImp").on("change", function () {
    var marcar = $(this).prop("checked");
    $("#tbodyDash .chk-imp:not(:disabled)").each(function () {
        var key = $(this).data("key");
        if (marcar) _sel[key] = true; else delete _sel[key];
        $(this).prop("checked", marcar)
            .closest("tr").toggleClass("row-imp-sel", marcar);
    });
    ActualizarBotonImprimir();
});

$("#btnImprimirSel").on("click", function () {
    var keys = Object.keys(_sel);
    if (!keys.length) return;
    if (keys.length > 50) {
        toastr.warning("Máximo 50 recibos por lote. Tiene " + keys.length + " seleccionados.");
        return;
    }
    window.open(URL_IMPRIMIR_LOTE + "?ids=" + encodeURIComponent(keys.join(",")), "_blank");
});

