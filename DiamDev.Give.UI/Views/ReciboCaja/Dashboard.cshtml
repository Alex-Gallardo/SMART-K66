};

    var _filas = [];   // buffer de la última respuesta del servidor

    // ── Selección para impresión: clave "ID|EMPRESA" ────────
    // Vive fuera del DOM (como estado en React): sobrevive a los
    // re-render del filtro de texto y al auto-refresh de 60s.
    var _sel = {};

    function KeySel(f) { return f.IdRecibo + "|" + f.IdEmpresa; }

    function ActualizarBotonImprimir() {
        var n = Object.keys(_sel).length;
        $("#btnImprimirSel").prop("disabled", n === 0);
