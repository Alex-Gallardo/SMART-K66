// ════════════════════════════════════════════════════════
// BADGE DE SINCRONIZACIÓN (Fase 4)
// Pinta el estado del recibo frente a SAP, con contexto:
//   OPERADO            → verde + "SAP #DocNum"
//   OPERADO + [CONCIL] → verde con halo ámbar ⚠ + tooltip del descuadre
//   PENDIENTE          → ámbar
//   PENDIENTE anulado  → ámbar + tooltip con la huella de anulación
// Sin estado (recibo en captura) → se oculta.
// ════════════════════════════════════════════════════════
function PintarBadgeSync(syncEstado, syncObs, sapDocNum) {
var $b = $("#badgeSync");
var estado = (syncEstado || "").toUpperCase();
var obs = syncObs || "";

// Alerta de descuadre: visible SOLO en estado DESCUADRE
if (estado === "DESCUADRE") {
    $("#alertaDescuadreDetalle").text(obs ||
        "Los montos del recibo no coinciden con los pagos activos en SAP.");
    $("#alertaDescuadre").slideDown(200);
} else {
    $("#alertaDescuadre").hide();
}

if (!estado) {
    $b.hide().text("—")
        .removeClass("operado pendiente anulado concil descuadre")
        .attr("title", "");
    return;
}

var clase, texto, tip;

switch (estado) {
    case "OPERADO":
        clase = "operado";
        texto = "✓ OPERADO" + (sapDocNum ? " — SAP #" + sapDocNum : "");
        tip = "Operado en SAP por Créditos." +
            (sapDocNum ? " Pago recibido No. " + sapDocNum + "." : "");
        if (obs.indexOf("[CONCIL]") === 0) {
            clase = "operado concil";
            texto += " ⚠";
            tip = obs;
        }
        break;

    case "DESCUADRE":
        clase = "descuadre";
        texto = "⚠ DESCUADRE CON SAP";
        tip = obs || "Parte del pago fue anulado en SAP; el monto no cuadra.";
        break;

    case "PENDIENTE":
        clase = "pendiente";
        texto = "⏳ PENDIENTE EN SAP";
        tip = "Aún no ha sido operado por Créditos en SAP.";
        if (obs.indexOf("Anulado en SAP") !== -1) {
            texto = "⏳ PENDIENTE (ANULADO EN SAP)";
            tip = obs;
        }
        break;

    case "ANULADO":
        clase = "anulado";
        texto = "ANULADO EN SAP";
        tip = obs || "El pago fue anulado en SAP.";
        break;

    default:
        clase = "pendiente";
        texto = estado;
        tip = obs;
        break;
}

$b.removeClass("operado pendiente anulado concil descuadre")
    .addClass(clase)
    .text(texto)
    .attr("title", tip)
    .show();
}

// ════════════════════════════════════════════════════════
// BADGE DE STATUS DEL RECIBO (estado del documento en sí)
// A = Activo, X = Anulado. Muestra texto claro + tooltip explicativo.
// Es distinto del badge de SINCRONIZACIÓN (ese refleja el estado en SAP).
// ════════════════════════════════════════════════════════
function PintarBadgeStatus(status) {
    var $b = $("#badgeStatus");
    var s = (status || "").toUpperCase();

    var cfg;
    switch (s) {
        case "A":
            cfg = {
                clase: "guardado", texto: "ACTIVO",
                tip: "Recibo activo y válido."
            };
            break;
        case "X":
            cfg = {
                clase: "anulado", texto: "ANULADO",
                tip: "Recibo anulado. Ya no es válido."
            };
            break;
        case "":
        case "NUEVO":
            cfg = {
                clase: "nuevo", texto: "NUEVO",
                tip: "Recibo en captura, aún no guardado."
            };
            break;
        default:
            cfg = {
                clase: "nuevo", texto: s,
                tip: "Estado: " + s
            };
            break;
    }

    $b.removeClass("nuevo guardado anulado")
        .addClass(cfg.clase)
        .text(cfg.texto)
        .attr("title", cfg.tip);
}

// ════════════════════════════════════════════════════════
// UTILIDADES
// ════════════════════════════════════════════════════════
function FmtNum(n) {
    var v = parseFloat(n || 0);
    // Residuo de redondeo (|v| < medio centavo): es CERO. Mata el "-0.00",
    // que a dos decimales se mostraría igual que 0.00 pero con signo.
    if (Math.abs(v) < 0.005) v = 0;
    return v.toFixed(2);
}

// Convierte un monto entre GTQ y USD usando el TC del día.
// Devuelve null si no hay nada que convertir (sin valor, sin TC, misma moneda).
function ConvertirMonto(valor, de, a, tc) {
    valor = parseFloat(valor);
    tc = parseFloat(tc) || 0;
    if (isNaN(valor) || !de || !a || de === a || tc <= 0) return null;
    if (de === "GTQ" && a === "USD") return Math.round((valor / tc) * 100) / 100;
    if (de === "USD" && a === "GTQ") return Math.round((valor * tc) * 100) / 100;
    return null;
}

// ════════════════════════════════════════════════════════
// CÁLCULO DUAL (espejo de CalcularMontosDuales del BLL)
// original = exacto, equivalente = derivado
// ════════════════════════════════════════════════════════
function MontosDuales(monto, moneda, tc) {
    monto = parseFloat(monto) || 0;
    tc = parseFloat(tc) || 0;
    if (tc <= 0) return { gtq: 0, usd: 0 };  // sin TC no derivamos
    if ((moneda || "").toUpperCase() === "USD") {
        return { gtq: Math.round(monto * tc * 100) / 100, usd: monto };
    } else {
        return { gtq: monto, usd: Math.round((monto / tc) * 100) / 100 };
    }
}

// ════════════════════════════════════════════════════════
// BARRA DE ANTICIPOS EN TRÁNSITO (modal de documentos)
// Muestra los totales duales (Q y $) de los anticipos del
// cliente que aún no fueron operados en SAP. Solo informativa:
// NO altera saldos ni disponibles de las facturas.
// ════════════════════════════════════════════════════════
function PintarBarAnticipos(a) {
    var $bar = $("#barAnticipos");
    if (!a || !(a.Cantidad > 0)) { $bar.hide(); return; }

    $("#antMonto").text("Q " + FmtMoneda(a.Gtq) + "  ($ " + FmtMoneda(a.Usd) + ")");
    $("#antRecibos").text(a.Recibos || "");
    $bar.show();
}

// Igual que FmtNum pero con separador de miles (para MOSTRAR dinero).
// Ej: 832216.62 → "832,216.62". NO usar su salida para volver a parsear
// (parseFloat("1,000.00") === 1: la coma corta el número).
function FmtMoneda(n) {
    var num = parseFloat(n || 0);
    if (Math.abs(num) < 0.005) num = 0;   // mismo clamp que FmtNum: mata el "-0.00"
    return num.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}

function FmtFecha(iso) {
    if (!iso) return "";
    if (typeof iso === "string" && iso.indexOf("/Date(") === 0) {
        var ms = parseInt(iso.replace(/\/Date\((\d+).*/, "$1"));
        var d  = new Date(ms);
        return d.getFullYear() + "-" +
               ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
               ("0" + d.getDate()).slice(-2);
    }
    return iso.substring(0, 10);
}

// ════════════════════════════════════════════════════════
// FIX ANCHO MODAL DOCUMENTOS (PC)
// El plugin de modales del theme pone un width inline fijo sobre el
// .modal exterior (estilo BS2). Lo neutralizamos en cada apertura para
// que el .modal-dialog pueda expandirse al 95%/1200px del CSS.
// Solo actúa en pantallas anchas; en mobile no toca nada.
// ════════════════════════════════════════════════════════
$(document).on("show.bs.modal shown.bs.modal", "#modalBuscarDoc", function () {
    if (window.innerWidth < 992) return;   // mobile/tablet: comportamiento actual
    this.style.setProperty("width", "auto", "important");
    this.style.setProperty("left", "0", "important");
    this.style.setProperty("right", "0", "important");
    this.style.setProperty("margin-left", "0", "important");
});

