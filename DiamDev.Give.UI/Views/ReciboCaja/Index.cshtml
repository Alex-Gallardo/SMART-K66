<!-- ══════════════════════════════════════════════
     JAVASCRIPT — al final del .cshtml
     (NO en per project convention)
══════════════════════════════════════════════ -->
@section Scripts{
    <script>
// ─── Mapa de colores por empresa ─────────────────────────────────────
var EMPRESA_COLORES = {
    GRACO: { clase: "graco", color: "#27ae60", nombre: "Graco Pack"       },
    FAES:  { clase: "faes",  color: "#c0392b", nombre: "Fabrica Escocesa" },
    BOLIK: { clase: "bolik", color: "#2c3e50", nombre: "Industrias Bolik" }
};

// ─── Estado global ────────────────────────────────────────────────────
var Estado = {
    empresa:          "",
    agente:           "",
    clienteId:        "",
    monedaCobro:      "",
    monedaDoc:        "",
    idReciboGuardado: "",
    modoActivo:       false,
    cobros:           [],
    documentos:       []
};

// ─── URLs base ────────────────────────────────────────────────────────
var URL_CLIENTES = "@Url.Action("BuscarClientes",   "ReciboCaja")";
var URL_DOCS     = "@Url.Action("ObtenerDocumentos","ReciboCaja")";
var URL_GUARDAR  = "@Url.Action("Guardar",          "ReciboCaja")";
var URL_BUSCAR   = "@Url.Action("BuscarRecibo",     "ReciboCaja")";
var URL_IMPRIMIR = "@Url.Action("Imprimir",         "ReciboCaja")";

// ════════════════════════════════════════════════════════
// 1. SELECCIÓN DE EMPRESA (select en lugar de botones)
// ════════════════════════════════════════════════════════
$("#selEmpresa").on("change", function () {
    var emp = $(this).val();

    // Limpiar clases de color del addon
    var $addon = $("#empresaAddon");
    $addon.removeClass("graco faes bolik");

    // Limpiar clases de color de todos los panels
    $(".panel-empresa").removeClass("graco faes bolik");

    if (!emp) {
        // Sin empresa: ocultar formulario
        $("#panelRecibo").slideUp(200);
        Estado.empresa = "";
        return;
    }

    var cfg = EMPRESA_COLORES[emp];
    if (!cfg) return;

    // Aplicar color al addon
    $addon.addClass(cfg.clase);

    // Aplicar color a los panels
    $(".panel-empresa").addClass(cfg.clase);

    // Actualizar badge en el encabezado
    $("#badgeEmpresa").text(cfg.nombre).removeClass("graco faes bolik").addClass(cfg.clase);

    // Guardar estado
    Estado.empresa    = emp;
    Estado.modoActivo = false;

    // Mostrar el formulario con animación
    $("#panelRecibo").slideDown(300);

    LimpiarFormulario();
    SetBotonesInicio();
    AplicarColorSaldo();
});

// ════════════════════════════════════════════════════════
// 2. BÚSQUEDA DE CLIENTE (typeahead con debounce)
// ════════════════════════════════════════════════════════
var timerCliente = null;

$("#txtBuscarCliente").on("input", function () {
    clearTimeout(timerCliente);
    var texto = $(this).val().trim();

    if (texto.length < 2) {
        $("#dropdownClientes").hide().empty();
        return;
    }

    timerCliente = setTimeout(function () {
        $.get(URL_CLIENTES, {
            empresa: Estado.empresa,
            agente:  Estado.agente,
            filtro:  texto
        }, function (resp) {
            if (!resp.ok) { toastr.error(resp.msg); return; }

            var dd = $("#dropdownClientes").empty();
            if (!resp.data || resp.data.length === 0) {
                dd.append('<div class="item-cliente" style="color:#aaa; font-style:italic;">Sin resultados</div>');
            } else {
                $.each(resp.data, function (_, c) {
                    dd.append(
                        $('<div class="item-cliente"></div>')
                            .html('<span class="codigo">' + c.CardCode + '</span><span>' + c.CardName + '</span>')
                            .data("cliente", c)
                    );
                });
            }
            dd.show();
        });
    }, 350);
});

// Seleccionar cliente del dropdown
$(document).on("click", "#dropdownClientes .item-cliente", function () {
    var c = $(this).data("cliente");
    if (!c) return;

    $("#txtBuscarCliente").val(c.CardCode + "  —  " + c.CardName);
    $("#txtNombreCliente").val(c.CardName).addClass("tiene-valor");
    $("#txtDireccion").val(c.Address);
    $("#txtNit").val(c.LicTradNum);
    $("#txtAgente").val(c.SlpName);
    $("#txtCorreo").val(c.Email);
    $("#txtMoneda").val(c.Currency);
    $("#hdnAgente").val(c.SlpName);

    Estado.clienteId = c.CardCode;
    Estado.agente    = c.SlpName;

    $("#dropdownClientes").hide().empty();
    SetBotonesActivos();
});

// Cerrar dropdown al click fuera
$(document).on("click", function (e) {
    if (!$(e.target).closest(".wrapper-cliente").length) {
        $("#dropdownClientes").hide();
    }
});

// ════════════════════════════════════════════════════════
// 3. TIPO DE PAGO → habilitar/deshabilitar campos
// ════════════════════════════════════════════════════════
$("#cboTipoPago").on("change", function () {
    var esEfectivo = $(this).val() === "EFECTIVO";
    $("#cboBanco").prop("disabled", esEfectivo).val("");
    $("#txtNoDocCobro").prop("disabled", esEfectivo).val("");
    $("#dtpFechaCobro").prop("disabled", esEfectivo).val("");
});

// ════════════════════════════════════════════════════════
// 4. TIPO DOCUMENTO → habilitar/deshabilitar campos
// ════════════════════════════════════════════════════════
$("#cboTipoDoc").on("change", function () {
    var tipo = $(this).val();
    var esAntOSaldo = (tipo === "ANTICIPO" || tipo === "SALDO PENDIENTE");

    $("#txtNoDocDoc").prop("disabled", esAntOSaldo).val("");
    $("#dtpFechaDoc").prop("disabled", esAntOSaldo).val("");
    $("#txtSerieFel").val("").prop("disabled", esAntOSaldo);
    $("#txtNumFel").val("").prop("disabled", esAntOSaldo);
    $("#cboMonedaDoc").val("").prop("disabled", esAntOSaldo);
    $("#txtTotalFact").val("");
    $("#txtPagado").val("");
    $("#txtMontoDoc").val("");

    // NUEVO: al elegir FACTURA o PEDIDO con cliente ya seleccionado,
    // abrimos solo el modal (datos desde HANA). Si prefieres solo lupa,
    // borra este if.
    if ((tipo === "FACTURA" || tipo === "PEDIDO") && Estado.clienteId) {
        $("#btnBuscarDoc").trigger("click");
    }
});

// ════════════════════════════════════════════════════════
// 5. AGREGAR COBRO
// ════════════════════════════════════════════════════════
$("#btnAgregarCobro").on("click", function () {
    var tipo   = $("#cboTipoPago").val();
    var banco  = $("#cboBanco").val();
    var nodoc  = $("#txtNoDocCobro").val().trim();
    var fecha  = $("#dtpFechaCobro").val();
    var monto  = parseFloat($("#txtMontoCobro").val()) || 0;
    var moneda = $("#cboMonedaCobro").val();

    if (!tipo || !moneda || monto <= 0) {
        toastr.warning("Tipo de pago, monto y moneda son obligatorios.");
        return;
    }
    if (Estado.monedaCobro && Estado.monedaCobro !== moneda) {
        toastr.error("Todos los cobros deben tener la misma moneda (" + Estado.monedaCobro + ").");
        return;
    }
    if (tipo !== "EFECTIVO" && (!banco || !nodoc)) {
        toastr.warning("Para " + tipo + " se requiere banco y número de documento.");
        return;
    }

    Estado.monedaCobro = moneda;
    $("#spanMonedaCobro").text(moneda);

    Estado.cobros.push({
        TipoCobro:   tipo,
        Banco:       tipo === "EFECTIVO" ? "" : banco,
        FechaDoc:    tipo === "EFECTIVO" ? "" : fecha,
        NoDocumento: tipo === "EFECTIVO" ? "" : nodoc,
        Monto:       monto,
        Moneda:      moneda
    });

    RenderizarTablaCobros();
    ActualizarTotales();
    LimpiarDetalleCobro();
});

// ════════════════════════════════════════════════════════
// 6. QUITAR COBRO
// ════════════════════════════════════════════════════════
$("#btnQuitarCobro").on("click", function () {
    var idx = $("#tbodyCobros tr.seleccionada").data("idx");
    if (idx === undefined) { toastr.info("Seleccione una fila para quitar."); return; }
    Estado.cobros.splice(idx, 1);
    if (Estado.cobros.length === 0) {
        Estado.monedaCobro = "";
        $("#spanMonedaCobro").text("—");
    }
    RenderizarTablaCobros();
    ActualizarTotales();
});

$(document).on("click", "#tbodyCobros tr", function () {
    $("#tbodyCobros tr").removeClass("seleccionada");
    $(this).addClass("seleccionada");
});

// ════════════════════════════════════════════════════════
// 7. MODAL DOCUMENTOS DISPONIBLES (lupa)
// ════════════════════════════════════════════════════════
$("#btnBuscarDoc").on("click", function () {
    var tipo = $("#cboTipoDoc").val();
    if (!Estado.empresa || !Estado.clienteId || !tipo) {
        toastr.warning("Seleccione empresa, cliente y tipo de documento primero.");
        return;
    }
    if (tipo === "ANTICIPO" || tipo === "SALDO PENDIENTE") {
        toastr.info("Para " + tipo + " no se busca un documento específico.");
        return;
    }

    $("#tbodyModalDocs").html('<tr><td colspan="9" class="text-center" style="padding:24px;"><i class="icon-spinner icon-spin icon-2x" style="color:#27ae60;"></i></td></tr>');
    $("#modalBuscarDoc").modal("show");

    $.get(URL_DOCS, {
        empresa: Estado.empresa,
        clienteId: Estado.clienteId,
        tipoDoc: tipo
    }, function (resp) {
        var tbody = $("#tbodyModalDocs");
        if (!resp.ok) {
            tbody.html('<tr><td colspan="9" class="text-center text-danger">' + resp.msg + '</td></tr>');
            return;
        }
        if (!resp.data || resp.data.length === 0) {
            tbody.html('<tr><td colspan="9" class="text-center" style="padding:20px; color:#aaa;">Sin documentos disponibles para este cliente</td></tr>');
            return;
        }

        tbody.empty();
        $.each(resp.data, function (_, d) {
            var saldoDoc = (parseFloat(d.MontoFact || 0) - parseFloat(d.Pagado || 0));
            tbody.append(
                '<tr>' +
                '<td><strong>' + (d.NoDocumento || '') + '</strong></td>' +
                '<td>' + FmtFecha(d.FechaDoc) + '</td>' +
                '<td class="text-right">' + FmtNum(d.MontoFact) + '</td>' +
                '<td class="text-right">' + FmtNum(d.Pagado) + '</td>' +
                '<td class="text-right" style="color:#1a5e35;font-weight:700;">' + FmtNum(saldoDoc) + '</td>' +
                '<td>' + (d.Moneda || '') + '</td>' +
                '<td>' + (d.FelSerie || '') + '</td>' +
                '<td>' + (d.FelNumero || '') + '</td>' +
                '<td><button class="btn btn-xs btn-success btn-selDoc" ' +
                'data-doc=\'' + JSON.stringify(d).replace(/'/g, "&#39;") + '\'>Seleccionar</button></td>' +
                '</tr>'
            );
        });
    });
});

// Seleccionar documento del modal
$(document).on("click", ".btn-selDoc", function () {
    var d = $(this).data("doc");
    if (!d) return;
    $("#txtNoDocDoc").val(d.NoDocumento);
    $("#dtpFechaDoc").val(FmtFecha(d.FechaDoc));
    $("#txtSerieFel").val(d.FelSerie  || "");
    $("#txtNumFel").val(d.FelNumero   || "");
    $("#txtTotalFact").val(FmtNum(d.MontoFact));
    $("#txtPagado").val(FmtNum(d.Pagado));
    $("#txtMontoDoc").val((parseFloat(d.MontoFact || 0) - parseFloat(d.Pagado || 0)).toFixed(2));
    $("#cboMonedaDoc").val(d.Moneda || "GTQ");
    $("#modalBuscarDoc").modal("hide");
});

// ════════════════════════════════════════════════════════
// 8. AGREGAR DOCUMENTO
// ════════════════════════════════════════════════════════
$("#btnAgregarDoc").on("click", function () {
    var tipo        = $("#cboTipoDoc").val();
    var nodoc       = $("#txtNoDocDoc").val().trim();
    var fecha       = $("#dtpFechaDoc").val();
    var monto       = parseFloat($("#txtMontoDoc").val()) || 0;
    var moneda      = $("#cboMonedaDoc").val();
    var esAntOSaldo = (tipo === "ANTICIPO" || tipo === "SALDO PENDIENTE");

    if (!tipo || monto <= 0) {
        toastr.warning("Tipo de documento y monto son obligatorios.");
        return;
    }
    if (!esAntOSaldo && !nodoc) {
        toastr.warning("Ingrese el número de documento.");
        return;
    }
    if (!esAntOSaldo && Estado.documentos.some(function (d) { return d.NoDocumento === nodoc; })) {
        toastr.warning("El documento " + nodoc + " ya está agregado.");
        return;
    }

    if (!Estado.monedaDoc) Estado.monedaDoc = moneda;
    $("#spanMonedaDoc").text(moneda || Estado.monedaDoc);

    Estado.documentos.push({
        TipoDoc:     tipo,
        NoDocumento: esAntOSaldo ? "" : nodoc,
        FechaDoc:    esAntOSaldo ? "" : fecha,
        Status:      "",
        Monto:       monto,
        Moneda:      moneda,
        MontoFact:   parseFloat($("#txtTotalFact").val()) || 0,
        Pagado:      parseFloat($("#txtPagado").val())    || 0,
        FelSerie:    $("#txtSerieFel").val().trim(),
        FelNumero:   $("#txtNumFel").val().trim()
    });

    RenderizarTablaDocumentos();
    ActualizarTotales();
    LimpiarDetalleDoc();
});

// ════════════════════════════════════════════════════════
// 9. QUITAR DOCUMENTO
// ════════════════════════════════════════════════════════
$("#btnQuitarDoc").on("click", function () {
    var idx = $("#tbodyDocs tr.seleccionada").data("idx");
    if (idx === undefined) { toastr.info("Seleccione una fila para quitar."); return; }
    Estado.documentos.splice(idx, 1);
    if (Estado.documentos.length === 0) {
        Estado.monedaDoc = "";
        $("#spanMonedaDoc").text("—");
    }
    RenderizarTablaDocumentos();
    ActualizarTotales();
});

$(document).on("click", "#tbodyDocs tr", function () {
    $("#tbodyDocs tr").removeClass("seleccionada");
    $(this).addClass("seleccionada");
});

// ════════════════════════════════════════════════════════
// 10. GUARDAR
// ════════════════════════════════════════════════════════
$("#btnGuardar").on("click", function () {
    if (!Estado.cobros.length)     { toastr.error("Agregue al menos un cobro.");    return; }
    if (!Estado.documentos.length) { toastr.error("Agregue al menos un documento."); return; }

    var tC    = Estado.cobros.reduce(function (s, c) { return s + c.Monto; }, 0);
    var tD    = Estado.documentos.reduce(function (s, d) { return s + d.Monto; }, 0);
    var saldo = tC - tD;

    if (Estado.monedaCobro !== Estado.monedaDoc && saldo !== 0) {
        if (!confirm("⚠ Monedas diferentes (Cobro: " + Estado.monedaCobro +
                     " / Doc: " + Estado.monedaDoc + ").\n¿Desea guardar de todas formas?")) return;
    }
    if (!confirm("¿Confirmar guardado del recibo?")) return;

    var payload = {
        IdEmpresa:     Estado.empresa,
        FechaRecibo:   $("#fechaRecibo").val(),
        IdCliente:     Estado.clienteId,
        NombreCliente: $("#txtNombreCliente").val(),
        Direccion:     $("#txtDireccion").val(),
        Nit:           $("#txtNit").val(),
        Agente:        $("#hdnAgente").val(),
        Correo:        $("#txtCorreo").val(),
        Moneda:        $("#txtMoneda").val(),
        RecFisico:     $("#txtRecFisico").val(),
        Cobros:        Estado.cobros,
        Documentos:    Estado.documentos
    };

    $("#btnGuardar").prop("disabled", true)
        .html('<i class="icon-spinner icon-spin"></i> Guardando...');

    $.ajax({
        url: URL_GUARDAR, type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (resp) {
            if (resp.ok) {
                toastr.success("✅ Recibo " + resp.idRecibo + " guardado correctamente.");
                Estado.idReciboGuardado = resp.idRecibo;
                $("#txtIdRecibo").val(resp.idRecibo);
                // Actualizar badge de status
                $("#badgeStatus").text("GUARDADO")
                    .removeClass("nuevo").addClass("guardado");
                SetBotonesPostGuardado();
                AbrirImpresion(resp.idRecibo, Estado.empresa);
            } else {
                toastr.error(resp.msg);
                $("#btnGuardar").prop("disabled", false)
                    .html('<i class="icon-save"></i> Guardar');
            }
        },
        error: function () {
            toastr.error("Error de conexión al guardar. Intente nuevamente.");
            $("#btnGuardar").prop("disabled", false)
                .html('<i class="icon-save"></i> Guardar');
        }
    });
});

// ════════════════════════════════════════════════════════
// 11. IMPRIMIR
// ════════════════════════════════════════════════════════
$("#btnImprimir").on("click", function () {
    AbrirImpresion(Estado.idReciboGuardado, Estado.empresa);
});
function AbrirImpresion(idRecibo, empresa) {
    window.open(URL_IMPRIMIR +
        "?idRecibo=" + encodeURIComponent(idRecibo) +
        "&empresa="  + encodeURIComponent(empresa), "_blank");
}

// ════════════════════════════════════════════════════════
// 12. BUSCAR RECIBO EXISTENTE
// ════════════════════════════════════════════════════════
$("#btnBuscarRecibo").on("click", function () {
    if (!Estado.empresa) { toastr.warning("Seleccione una empresa primero."); return; }
    $("#txtBuscarIdRecibo").val("");
    $("#msgBuscarRecibo").hide();
    $("#modalBuscarRecibo").modal("show");
});

$("#btnEjecutarBusqueda").on("click", function () {
    var id = $("#txtBuscarIdRecibo").val().trim();
    if (!id) return;

    $.get(URL_BUSCAR, { idRecibo: id, empresa: Estado.empresa }, function (resp) {
        if (!resp.ok) {
            $("#msgBuscarRecibo")
                .removeClass("alert-success").addClass("alert-danger")
                .text(resp.msg).show();
            return;
        }
        var r = resp.data;

        // Rellenar encabezado
        $("#txtIdRecibo").val(r.IdRecibo);
        Estado.clienteId = r.IdCliente;
        $("#txtBuscarCliente").val(r.IdCliente + "  —  " + r.NombreCliente);
        $("#txtNombreCliente").val(r.NombreCliente).addClass("tiene-valor");
        $("#txtDireccion").val(r.Direccion);
        $("#txtNit").val(r.Nit);
        $("#txtAgente").val(r.Agente);
        $("#hdnAgente").val(r.Agente);
        $("#txtCorreo").val(r.Correo);
        $("#txtMoneda").val(r.Moneda);
        $("#txtRecFisico").val(r.RecFisico);

        // Actualizar badge status
        var esGuardado = r.Status && r.Status !== "NUEVO";
        $("#badgeStatus").text(r.Status || "NUEVO")
            .removeClass("nuevo guardado")
            .addClass(esGuardado ? "guardado" : "nuevo");

        Estado.cobros              = r.Cobros     || [];
        Estado.documentos          = r.Documentos || [];
        Estado.idReciboGuardado    = r.IdRecibo;
        if (Estado.cobros.length)     Estado.monedaCobro = Estado.cobros[0].Moneda;
        if (Estado.documentos.length) Estado.monedaDoc   = Estado.documentos[0].Moneda;

        RenderizarTablaCobros();
        RenderizarTablaDocumentos();
        ActualizarTotales();
        SetBotonesPostGuardado();

        $("#modalBuscarRecibo").modal("hide");
        toastr.success("Recibo " + r.IdRecibo + " cargado.");
    });
});

// ════════════════════════════════════════════════════════
// 13. NUEVO y CANCELAR
// ════════════════════════════════════════════════════════
$("#btnNuevo").on("click", function () {
    LimpiarFormulario();
    SetBotonesActivos();
    Estado.modoActivo = true;
    $("#txtBuscarCliente").focus();
});
$("#btnCancelar").on("click", function () {
    LimpiarFormulario();
    SetBotonesInicio();
});

// ════════════════════════════════════════════════════════
// RENDERIZADO DE TABLAS
// ════════════════════════════════════════════════════════
function RenderizarTablaCobros() {
    var tbody = $("#tbodyCobros").empty();
    if (!Estado.cobros.length) {
        tbody.html('<tr class="tabla-vacia"><td colspan="6" class="text-center" style="padding:14px;">' +
                   '<i class="icon-inbox" style="font-size:18px;color:#ccc;"></i><br/>Sin cobros agregados</td></tr>');
        return;
    }
    $.each(Estado.cobros, function (i, c) {
        tbody.append(
            $('<tr style="cursor:pointer;"></tr>').data("idx", i).html(
                "<td><span class='label label-default'>" + c.TipoCobro + "</span></td>" +
                "<td>" + (c.Banco || "—")       + "</td>" +
                "<td>" + (c.FechaDoc || "—")    + "</td>" +
                "<td>" + (c.NoDocumento || "—") + "</td>" +
                '<td class="text-right"><strong>' + FmtNum(c.Monto) + "</strong></td>" +
                "<td><span class='label label-info'>" + c.Moneda + "</span></td>"
            )
        );
    });
}

function RenderizarTablaDocumentos() {
    var tbody = $("#tbodyDocs").empty();
    if (!Estado.documentos.length) {
        tbody.html('<tr class="tabla-vacia"><td colspan="8" class="text-center" style="padding:14px;">' +
                   '<i class="icon-inbox" style="font-size:18px;color:#ccc;"></i><br/>Sin documentos agregados</td></tr>');
        return;
    }
    $.each(Estado.documentos, function (i, d) {
        tbody.append(
            $('<tr style="cursor:pointer;"></tr>').data("idx", i).html(
                "<td><span class='label label-default'>" + d.TipoDoc + "</span></td>" +
                "<td><strong>" + (d.NoDocumento || "—") + "</strong></td>" +
                "<td>" + (d.FechaDoc || "—")  + "</td>" +
                '<td class="text-right"><strong>' + FmtNum(d.Monto) + "</strong></td>" +
                "<td><span class='label label-info'>" + d.Moneda + "</span></td>" +
                '<td class="text-right">' + FmtNum(d.MontoFact) + "</td>" +
                '<td class="text-right">' + FmtNum(d.Pagado)    + "</td>" +
                "<td>" + (d.FelSerie || "—") + "</td>"
            )
        );
    });
}

// ════════════════════════════════════════════════════════
// CÁLCULO DE TOTALES
// ════════════════════════════════════════════════════════
function ActualizarTotales() {
    var tC    = Estado.cobros.reduce(function (s, c) { return s + c.Monto; }, 0);
    var tD    = Estado.documentos.reduce(function (s, d) { return s + d.Monto; }, 0);
    var saldo = tC - tD;

    $("#spanTotalCobros").text(FmtNum(tC));
    $("#spanTotalDocs").text(FmtNum(tD));
    $("#spanMonedaCobro").text(Estado.monedaCobro || "—");
    $("#spanMonedaDoc").text(Estado.monedaDoc     || "—");

    $("#spanSaldo").text(FmtNum(saldo))
        .removeClass("saldo-ok saldo-error")
        .addClass(saldo === 0 ? "saldo-ok" : "saldo-error");

    // Sincronizar campos del encabezado
    $("#txtMontoRec").val(FmtNum(tC));
    $("#txtTotalDoc").val(FmtNum(tD));
    $("#txtSaldo").val(FmtNum(saldo));

    // Colorear campo saldo del encabezado
    AplicarColorSaldo();
}

function AplicarColorSaldo() {
    var s = parseFloat($("#txtSaldo").val()) || 0;
    $("#txtSaldo").css("color", s === 0 ? "#1a5e35" : "#922b21");
}

// ════════════════════════════════════════════════════════
// LIMPIAR
// ════════════════════════════════════════════════════════
function LimpiarFormulario() {
    Estado.clienteId          = "";
    Estado.agente             = "";
    Estado.monedaCobro        = "";
    Estado.monedaDoc          = "";
    Estado.cobros             = [];
    Estado.documentos         = [];
    Estado.idReciboGuardado   = "";

    $("#txtIdRecibo, #txtRecFisico, #txtBuscarCliente").val("");
    $("#txtNombreCliente").val("").removeClass("tiene-valor");
    $("#txtDireccion, #txtNit, #txtAgente, #txtCorreo, #txtMoneda").val("");
    $("#txtMontoRec, #txtTotalDoc, #txtSaldo").val("");
    $("#txtStatus").val("NUEVO");
    $("#hdnAgente").val("");
    $("#badgeStatus").text("NUEVO").removeClass("guardado").addClass("nuevo");

    $("#spanTotalCobros, #spanTotalDocs").text("0.00");
    $("#spanSaldo").text("0.00").removeClass("saldo-ok saldo-error");
    $("#spanMonedaCobro, #spanMonedaDoc").text("—");

    RenderizarTablaCobros();
    RenderizarTablaDocumentos();
    LimpiarDetalleCobro();
    LimpiarDetalleDoc();
}

function LimpiarDetalleCobro() {
    $("#cboTipoPago, #cboBanco, #cboMonedaCobro").val("");
    $("#txtNoDocCobro, #dtpFechaCobro, #txtMontoCobro").val("");
    $("#cboBanco, #txtNoDocCobro, #dtpFechaCobro").prop("disabled", false);
}

function LimpiarDetalleDoc() {
    $("#cboTipoDoc, #cboMonedaDoc").val("");
    $("#txtNoDocDoc, #dtpFechaDoc, #txtSerieFel, #txtNumFel").val("");
    $("#txtTotalFact, #txtPagado, #txtMontoDoc").val("");
    $("#txtNoDocDoc, #dtpFechaDoc, #txtSerieFel, #txtNumFel, #cboMonedaDoc").prop("disabled", false);
}

// ════════════════════════════════════════════════════════
// CONTROL DE BOTONES
// ════════════════════════════════════════════════════════
function SetBotonesInicio() {
    $("#btnGuardar, #btnCancelar, #btnImprimir").prop("disabled", true);
    $("#btnNuevo, #btnBuscarRecibo").prop("disabled", false);
    $("#btnGuardar").html('<i class="icon-save"></i> Guardar');
}
function SetBotonesActivos() {
    $("#btnGuardar, #btnCancelar").prop("disabled", false);
    $("#btnNuevo, #btnBuscarRecibo").prop("disabled", true);
    $("#btnImprimir").prop("disabled", true);
}
function SetBotonesPostGuardado() {
    $("#btnGuardar").prop("disabled", true).html('<i class="icon-save"></i> Guardar');
    $("#btnCancelar").prop("disabled", true);
    $("#btnNuevo, #btnBuscarRecibo, #btnImprimir").prop("disabled", false);
}

// ════════════════════════════════════════════════════════
// UTILIDADES
// ════════════════════════════════════════════════════════
function FmtNum(n) { return parseFloat(n || 0).toFixed(2); }

function FmtFecha(iso) {
    if (!iso) return "";
    if (typeof iso === "string" && iso.indexOf("/Date(") === 0) {
        var ms = parseInt(iso.replace(/\/Date\((\d+).*/, "$1"));
        var d  = new Date(ms);
        return d.getFullYear() + "-" +
               ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
               ("0" + d.getDate()).slice(-2);
    }
    return iso.substring(0, 10);
}

// Inicialización
SetBotonesInicio();
    </script>
}