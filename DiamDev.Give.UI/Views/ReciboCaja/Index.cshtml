// ════════════════════════════════════════════════════════
// 14. ANULAR RECIBO (confirmación reforzada en 3 pasos:
//     advertencia → motivo obligatorio → confirm final)
// ════════════════════════════════════════════════════════
var MIN_MOTIVO_ANULACION = 10;   // espejo del BLL

$("#btnAnular").on("click", function () {
    if (!Estado.idReciboGuardado) {
        toastr.warning("Cargue o guarde un recibo primero.");
        return;
    }
    $("#spanReciboAnular").text(Estado.idReciboGuardado);
    $("#txtMotivoAnulacion").val("");
    $("#lblContadorMotivo").text("0");
    $("#btnConfirmarAnular").prop("disabled", true)
        .html('<i class="icon-ban-circle"></i> Anular definitivamente');
    $("#modalAnular").modal("show");
    setTimeout(function () { $("#txtMotivoAnulacion").focus(); }, 400);
});

// El botón solo se habilita cuando el motivo alcanza el mínimo
$("#txtMotivoAnulacion").on("input", function () {
    var texto = $(this).val();
    $("#lblContadorMotivo").text(texto.length);
    $("#btnConfirmarAnular").prop("disabled",
        texto.trim().length < MIN_MOTIVO_ANULACION);
});

$("#btnConfirmarAnular").on("click", function () {
    var motivo = $("#txtMotivoAnulacion").val().trim();
    if (motivo.length < MIN_MOTIVO_ANULACION) {
        toastr.warning("El motivo debe tener al menos " + MIN_MOTIVO_ANULACION + " caracteres.");
        return;
    }

    if (!confirm("⚠ ÚLTIMA CONFIRMACIÓN\n\nSe anulará el recibo " +
    Estado.idReciboGuardado + " de forma PERMANENTE.\n\nMotivo: " +
    motivo + "\n\n¿Continuar?")) return;

    var $btn = $(this).prop("disabled", true)
        .html('<i class="icon-spinner icon-spin"></i> Anulando...');

    $.post(URL_ANULAR, {
        idRecibo: Estado.idReciboGuardado,
        empresa: Estado.empresa,
        motivo: motivo
    }, function (resp) {
        if (resp.ok) {
            toastr.success(resp.msg);
            $("#modalAnular").modal("hide");
            PintarBadgeStatus("X");
            $("#btnAnular").prop("disabled", true);
        } else {
            toastr.error(resp.msg);
            $btn.prop("disabled", false)
                .html('<i class="icon-ban-circle"></i> Anular definitivamente');
        }
    }).fail(function () {
        toastr.error("Error de conexión al anular. Intente nuevamente.");
        $btn.prop("disabled", false)
            .html('<i class="icon-ban-circle"></i> Anular definitivamente');
    });
});

// El botón solo se habilita si el usuario escribe el ID exacto
$("#txtConfirmarAnulacion").on("input", function () {
    var coincide = $(this).val().trim().toUpperCase() ===
        (Estado.idReciboGuardado || "").toUpperCase();
    $("#btnConfirmarAnular").prop("disabled", !coincide);
});

// ════════════════════════════════════════════════════════
// RENDERIZADO DE TABLAS
// ════════════════════════════════════════════════════════
function RenderizarTablaCobros() {
    var tbody = $("#tbodyCobros").empty();
    if (!Estado.cobros.length) {
        tbody.html('<tr class="tabla-vacia"><td colspan="7" class="text-center" style="padding:14px;">' +
            '<i class="icon-inbox" style="font-size:18px;color:#ccc;"></i><br/>Sin cobros agregados</td></tr>');
        return;
    }
    $.each(Estado.cobros, function (i, c) {
        var filaEdit = (Estado.cobroEditIndex === i) ? " seleccionada" : "";
        tbody.append(
            $('<tr style="cursor:pointer;" class="' + filaEdit.trim() + '"></tr>').data("idx", i).html(
                "<td><span class='label label-default'>" + c.TipoCobro + "</span></td>" +
                "<td>" + (c.Banco || "—") + "</td>" +
                "<td>" + (FmtFecha(c.FechaDoc) || "—") + "</td>" +
                "<td>" + (c.NoDocumento || "—") + "</td>" +
                '<td class="text-right"><strong>' + FmtMoneda(c.Monto) + "</strong></td>" +
                "<td><span class='label label-info'>" + c.Moneda + "</span></td>" +
                '<td class="text-center">' +
                '<button class="btn btn-xs btn-warning btn-editCobro" title="Editar" data-idx="' + i + '">' +
                '<i class="icon-pencil"></i></button>' +
                '</td>'
            )
        );
    });
}

function RenderizarTablaDocumentos() {
    var tbody = $("#tbodyDocs").empty();
    if (!Estado.documentos.length) {
        tbody.html('<tr class="tabla-vacia"><td colspan="9" class="text-center" style="padding:14px;">' +
                   '<i class="icon-inbox" style="font-size:18px;color:#ccc;"></i><br/>Sin documentos agregados</td></tr>');
        return;
    }
    $.each(Estado.documentos, function (i, d) {
        var filaEdit = (Estado.docEditIndex === i) ? " seleccionada" : "";
        tbody.append(
            $('<tr style="cursor:pointer;" class="' + filaEdit.trim() + '"></tr>').data("idx", i).html(
                "<td><span class='label label-default'>" + d.TipoDoc + "</span></td>" +
                "<td><strong>" + (d.NoDocumento || "—") + "</strong></td>" +
                "<td>" + (FmtFecha(d.FechaDoc) || "—")  + "</td>" +
                '<td class="text-right"><strong>' + FmtMoneda(d.Monto) + "</strong></td>" +
                "<td><span class='label label-info'>" + d.Moneda + "</span></td>" +
                '<td class="text-right">' + FmtMoneda(d.MontoFact) + "</td>" +
                '<td class="text-right">' + FmtMoneda(d.Pagado) + "</td>" +
                "<td>" + (d.FelSerie || "—") + "</td>" +
                '<td class="text-center">' +
                    '<button class="btn btn-xs btn-warning btn-editDoc" title="Editar" data-idx="' + i + '">' +
                    '<i class="icon-pencil"></i></button>' +
                '</td>'
            )
        );
    });
}

// ════════════════════════════════════════════════════════
// CÁLCULO DE TOTALES
// ════════════════════════════════════════════════════════
function ActualizarTotales() {
    var tc = Estado.tipoCambio || 0;

    // Sumar cobros en ambas monedas (cada línea convertida con la regla de oro)
    var cobrosGtq = 0, cobrosUsd = 0;
    Estado.cobros.forEach(function (c) {
        var m = MontosDuales(c.Monto, c.Moneda, tc);
        cobrosGtq += m.gtq; cobrosUsd += m.usd;
    });

    // Sumar documentos en ambas monedas
    var docsGtq = 0, docsUsd = 0;
    Estado.documentos.forEach(function (d) {
        var m = MontosDuales(d.Monto, d.Moneda, tc);
        docsGtq += m.gtq; docsUsd += m.usd;
    });

    var saldoGtq = cobrosGtq - docsGtq;
    var saldoUsd = cobrosUsd - docsUsd;

    // Pintar la barra (Q grande, $ chico)
    $("#spanTotalCobros").text("Q " + FmtNum(cobrosGtq));
    $("#spanTotalCobrosUsd").text("$ " + FmtNum(cobrosUsd));
    $("#spanTotalDocs").text("Q " + FmtNum(docsGtq));
    $("#spanTotalDocsUsd").text("$ " + FmtNum(docsUsd));

    $("#spanSaldo").text("Q " + FmtNum(saldoGtq))
        .removeClass("saldo-ok saldo-error")
        .addClass(Math.abs(saldoGtq) < 0.01 ? "saldo-ok" : "saldo-error");
    $("#spanSaldoUsd").text("$ " + FmtNum(saldoUsd));


    // Los totales del encabezado se eliminaron de la UI; ahora viven solo en
    // la barra de totales inferior (#spanTotalCobros / #spanTotalDocs / #spanSaldo),
    // que ya se actualizó arriba. Nada más que reflejar aquí.

    // Reflejar también en los campos del encabezado (en GTQ, la base)
    // $("#txtMontoRec").val(FmtNum(cobrosGtq));
    // $("#txtTotalDoc").val(FmtNum(docsGtq));
    // $("#txtSaldo").val(FmtNum(saldoGtq));

    // AplicarColorSaldo();
}

