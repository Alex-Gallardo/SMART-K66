<!-- ══════════════════════════════════════════════
     JAVASCRIPT — al final del .cshtml
     (NO en per project convention)
══════════════════════════════════════════════ -->
@section Scripts{
    <script>
// ─── Mapa de colores por empresa ─────────────────────────────────────
var EMPRESA_COLORES = {
    GRACO: { clase: "graco", color: "#27ae60", nombre: "Graco Pack"       },
    FAES:  { clase: "faes",  color: "#c0392b", nombre: "Fabrica Escocesa" },
    BOLIK: { clase: "bolik", color: "#2c3e50", nombre: "Industrias Bolik" }
};

// ─── Estado global ────────────────────────────────────────────────────
var Estado = {
    empresa: "",
    agente: "",     // agente DEL CLIENTE (SlpName) — se graba en AGENTE
    clienteId: "",
    monedaCobro: "",
    monedaDoc: "",
    idReciboGuardado: "",
    modoActivo: false,
    cobros: [],
    documentos: [],
    docEditIndex: null,   // índice de la fila en edición (null = alta nueva)
    encabezadoEditable: false,   // true = operador SALA DE VENTAS: encabezado capturable
    cobroEditIndex: null,   // índice del cobro en edición (null = alta nueva)
    tipoCambio: 0,      // TC del día, traído al elegir empresa

    // ── Operador (Usuario_Empresa) ──
    codigoUsuario: "",     // Codigo elegido tal cual ("12-RODOLFO", "JORGE")
    agenteOperador: "",     // texto parseado ("RODOLFO") → filtra typeahead de clientes
    deptoOperador: ""      // MISMO texto parseado → DEPTO de la serie (feedback UI;
    // la resolución real la hace el servidor al guardar)
};

// ─── URLs base ────────────────────────────────────────────────────────
var URL_CLIENTES = "@Url.Action("BuscarClientes",   "ReciboCaja")";
var URL_DOCS     = "@Url.Action("ObtenerDocumentos","ReciboCaja")";
var URL_GUARDAR  = "@Url.Action("Guardar",          "ReciboCaja")";
var URL_BUSCAR   = "@Url.Action("BuscarRecibo",     "ReciboCaja")";
var URL_IMPRIMIR = "@Url.Action("Imprimir",         "ReciboCaja")";
var URL_TIPOCAMBIO = "@Url.Action("ObtenerTipoCambioDia", "ReciboCaja")";
var URL_ANULAR = "@Url.Action("Anular", "ReciboCaja")";

// ─── URL del endpoint de empresas del usuario ─────────────────────────
var URL_EMPRESAS = "@Url.Action("GetEmpresasUsuario", "ReciboCaja")";

// ════════════════════════════════════════════════════════
// TIPOS DE DOCUMENTO SIN REFERENCIA DOCUMENTAL
// Espejo de TiposDocumentoRecibo.EsSinDocumento() (Entities).
// ANTICIPO / DIFERENCIA / SALDO PENDIENTE no apuntan a una factura de
// SAP: no llevan No. Documento, fecha ni FEL. Solo MONTO y MONEDA.
//
// ⚠ Si algún día se agrega un tipo nuevo, hay que tocar DOS listas:
//    esta y la de TiposDocumentoRecibo.cs. Es el precio de que el front
//    no pueda leer C#. La del servidor es la que manda: si se
//    desincronizan, la UI mentirá pero la BD quedará correcta.
// ════════════════════════════════════════════════════════
var TIPOS_DOC_SIN_REFERENCIA = ["ANTICIPO", "SALDO PENDIENTE", "DIFERENCIA"];

function EsTipoSinDocumento(tipo) {
    return TIPOS_DOC_SIN_REFERENCIA.indexOf(
        (tipo || "").trim().toUpperCase()) !== -1;
}

// Único lugar que decide qué campos del panel de documentos son
// capturables. Lo llaman el change del combo (alta) y el modo edición,
// para que editar un ANTICIPO/DIFERENCIA muestre el mismo bloqueo que
// crearlo (antes no: al editar, los campos quedaban habilitados aunque
// el guardado los forzara a NULL igual — la UI mentía).
// Devuelve el booleano para que el llamador no tenga que recalcularlo.
function AplicarBloqueoTipoDoc(tipo) {
    var esSinDoc = EsTipoSinDocumento(tipo);

    $("#txtNoDocDoc, #dtpFechaDoc, #txtSerieFel, #txtNumFel")
        .prop("disabled", esSinDoc);

    // La lupa tampoco tiene sentido: no hay catálogo que buscar.
    $("#btnBuscarDoc").prop("disabled", esSinDoc)
        .attr("title", esSinDoc
            ? "Este tipo no referencia documentos de SAP"
            : "Buscar documento disponible");

    // MONEDA: SIEMPRE habilitada. Una DIFERENCIA puede ser GTQ o USD,
    // igual que un ANTICIPO — la elige el cajero.
    $("#cboMonedaDoc").prop("disabled", false);

    return esSinDoc;
}

// Buffer: empresas + códigos del usuario (respuesta de GetEmpresasUsuario)
var _empresasUsuario = [];

// ════════════════════════════════════════════════════════
// 0. CARGA INICIAL: empresas disponibles del usuario
// ════════════════════════════════════════════════════════
function CargarEmpresasUsuario() {
    $.get(URL_EMPRESAS, function (resp) {
        if (!resp.ok) { toastr.error(resp.msg || "No se pudieron cargar las empresas."); return; }

        _empresasUsuario = resp.data || [];

        var sel = $("#selEmpresa");
        sel.find("option:not([value=''])").remove();

        if (!_empresasUsuario.length) {
            toastr.warning("No tiene empresas de recibos asignadas.");
            return;
        }

        $.each(_empresasUsuario, function (_, e) {
            sel.append($("<option>", {
                value: e.Id,
                text: "🏭\u00A0 " + e.Nombre
            }));
        });

        if (_empresasUsuario.length === 1) {
            sel.val(_empresasUsuario[0].Id).trigger("change");
        }

        if (sel.hasClass("search-select") && $.fn.select2) {
            sel.trigger("change.select2");
        }
    });
}

// ════════════════════════════════════════════════════════
// 1. SELECCIÓN DE EMPRESA
// El formulario NO se muestra aquí: solo se puebla "Operar como".
// Quien decide desplegar el formulario es la selección de OPERADOR
// (con auto-selección si hay uno solo). Empresa sola ≠ listo para operar.
// ════════════════════════════════════════════════════════
$("#selEmpresa").on("change", function () {
    var emp = $(this).val();

    var $addon = $("#empresaAddon");
    $addon.removeClass("graco faes bolik");
    $(".panel-empresa").removeClass("graco faes bolik");

    // Cambio de empresa (o deselección): el formulario baja SIEMPRE.
    // Volverá a subir cuando haya un operador válido elegido.
    OcultarPanelRecibo();

    if (!emp) {
        $("#wrapCodigo").hide();
        Estado.empresa = "";
        Estado.codigoUsuario = "";
        Estado.agenteOperador = "";
        Estado.deptoOperador = "";
        PintarCardOperador(null);
        return;
    }

    var cfg = EMPRESA_COLORES[emp];
    CargarTipoCambio(emp);
    if (!cfg) return;

    $addon.addClass(cfg.clase);
    $(".panel-empresa").addClass(cfg.clase);
    $("#badgeEmpresa").text(cfg.nombre).removeClass("graco faes bolik").addClass(cfg.clase);

    Estado.empresa = emp;
    Estado.modoActivo = false;

    PoblarCodigos(emp);   // ← si hay 1 solo operador, esto termina mostrando el form
});

// ════════════════════════════════════════════════════════
// 1.5 OPERADORES DEL USUARIO ("Operar como")
// 1 operador  → se auto-selecciona.
// 2+ operadores → obligado a elegir antes de crear.
// Cambiar de operador REINICIA el recibo en captura (clientes,
// cobros, documentos, totales) porque cada operador ve SU cartera.
// ════════════════════════════════════════════════════════
function PoblarCodigos(emp) {
    var sel = $("#selCodigo");
    sel.find("option:not([value=''])").remove();
    Estado.codigoUsuario = "";
    Estado.agenteOperador = "";
    Estado.deptoOperador = "";
    PintarCardOperador(null);

    var e = null;
    for (var i = 0; i < _empresasUsuario.length; i++) {
        if (_empresasUsuario[i].Id === emp) { e = _empresasUsuario[i]; break; }
    }

    var codigos = (e && e.Codigos) || [];
    if (!codigos.length) {
        $("#wrapCodigo").hide();
        toastr.warning("No tiene operadores asignados en esta empresa. Contacte al administrador.");
        return;
    }

    $.each(codigos, function (_, c) {
        var sinDepto = !(c.Depto || "").length;
        sel.append(
            $("<option>", {
                value: c.Codigo,
                // Marcamos visualmente los operadores sin serie
                text: "👤\u00A0 " + c.Codigo + (sinDepto ? "  ⚠ (sin serie)" : "")
            }).data("info", c)
        );
    });

    $("#wrapCodigo").show();

    if (codigos.length === 1) {
        sel.val(codigos[0].Codigo).trigger("change");   // auto-selección
    } else {
        toastr.info("Tiene " + codigos.length + " operadores en esta empresa: elija con cuál operará.");
    }

    if (sel.hasClass("search-select") && $.fn.select2) {
        sel.trigger("change.select2");
    }
}

$("#selCodigo").on("change", function () {
    // ── CAMBIO DE OPERADOR = BORRÓN Y CUENTA NUEVA ──
    // Cada operador tiene su propia cartera de clientes y su propia serie:
    // nada de lo capturado con el operador anterior es válido para el nuevo.
    LimpiarFormulario();
    SetBotonesInicio();
    $("#dropdownClientes").hide().empty();

    var cod = $(this).val();
    if (!cod) {
        Estado.codigoUsuario = "";
        Estado.agenteOperador = "";
        Estado.deptoOperador = "";
        PintarCardOperador(null);
        OcultarPanelRecibo();   // sin operador no hay formulario
        Estado.encabezadoEditable = false;
        return;
    }

    var info = $(this).find("option:selected").data("info") || {};
    Estado.codigoUsuario = cod;
    Estado.agenteOperador = info.Agente || "";
    Estado.deptoOperador = (info.Depto || "").trim();

    PintarCardOperador(info);
    // Flag de venta de mostrador: viene calculado del BLL
    Estado.encabezadoEditable = (info.EncabezadoEditable === true);

    if (!Estado.deptoOperador) {
        // Operador sin serie: avisamos y el formulario NO se despliega.
        // (El guardado en servidor lo rechazaría igual; esto es UX temprana.)
        toastr.error("El operador '" + cod + "' no tiene serie/depto asignado. " +
            "No podrá emitir recibos con él. Contacte al administrador.");
        OcultarPanelRecibo();
        return;
    }

    // ── Empresa + operador válido: AHORA sí se despliega el formulario ──
    MostrarPanelRecibo();
});

// ════════════════════════════════════════════════════════
// Mostrar / ocultar el formulario del recibo.
// Única puerta de entrada/salida del panel: nadie más debe
// llamar slideDown/slideUp sobre #panelRecibo directamente.
// ════════════════════════════════════════════════════════
function MostrarPanelRecibo() {
    LimpiarFormulario();
    SetBotonesInicio();
    AplicarModoEncabezado(Estado.encabezadoEditable);
    $("#panelRecibo").slideDown(300);
    if (Estado.encabezadoEditable) {
        toastr.info("Operador SALA DE VENTAS: puede escribir los datos del cliente directamente en el encabezado.");
    }
}

function OcultarPanelRecibo() {
    $("#panelRecibo").slideUp(200);
    Estado.modoActivo = false;
}

// Pinta la tarjeta "Info usuario" con el operador activo y su SERIE.
// Muestra el NOMBRE parseado ("PABLO GAITAN"), no el código crudo
// ("15-PABLO GAITAN"): el número solo le importa a SAP, no al humano.
function PintarCardOperador(info) {
    if (!info) {
        $("#lblOperadorCodigo").text("");
        $("#lblOperadorSerie").text("—");
        return;
    }
    $("#lblOperadorCodigo").text(" · " + (info.Agente || info.Codigo));
    $("#lblOperadorSerie").text(info.Serie && info.Serie.length ? info.Serie : "— (sin serie)");
}

// ════════════════════════════════════════════════════════
// MODO ENCABEZADO EDITABLE (operador SALA DE VENTAS)
// editable=true  → cliente/dirección/NIT/agente/correo capturables.
// editable=false → readonly, derivados del typeahead (modo normal).
// El typeahead SIGUE funcionando en ambos modos: en editable sirve
// para precargar y luego corregir a mano.
// ════════════════════════════════════════════════════════
var CAMPOS_ENCABEZADO = "#txtNombreCliente, #txtDireccion, #txtNit, #txtAgente, #txtCorreo";

function AplicarModoEncabezado(editable) {
    if (editable) {
        $(CAMPOS_ENCABEZADO).prop("readonly", false).removeClass("f-readonly");
        $("#panelEncabezado").addClass("encabezado-libre");
        $("#badgeEdicionLibre").show();
    } else {
        $(CAMPOS_ENCABEZADO).prop("readonly", true).addClass("f-readonly");
        $("#panelEncabezado").removeClass("encabezado-libre");
        $("#badgeEdicionLibre").hide();
    }
}

// ════════════════════════════════════════════════════════
// TIPO DE CAMBIO — traer del día al elegir empresa
// ════════════════════════════════════════════════════════
function CargarTipoCambio(empresa) {
    $("#spanTipoCambio").text("...");
    $.get(URL_TIPOCAMBIO, { empresa: empresa }, function (resp) {
        if (resp.ok) {
            Estado.tipoCambio = parseFloat(resp.tipoCambio) || 0;
            $("#spanTipoCambio").text(Estado.tipoCambio.toFixed(4));
        } else {
            Estado.tipoCambio = 0;
            $("#spanTipoCambio").text("—");
            toastr.error("No se pudo traer el tipo de cambio: " + resp.msg);
        }
        ActualizarTotales();
    }).fail(function () {
        Estado.tipoCambio = 0;
        $("#spanTipoCambio").text("—");
        toastr.error("Error al consultar el tipo de cambio.");
    });
}

// ════════════════════════════════════════════════════════
// 2. BÚSQUEDA DE CLIENTE (typeahead con debounce)
// ════════════════════════════════════════════════════════
var timerCliente = null;

$("#txtBuscarCliente").on("input", function () {
    clearTimeout(timerCliente);
    var texto = $(this).val().trim();

    // Guarda de secuencia: sin operador elegido NO se busca.
    // (El formulario debería estar oculto, pero si algo se cuela,
    // esta es la barrera real del lado del cliente.)
    if (!Estado.codigoUsuario || !Estado.deptoOperador) {
        $("#dropdownClientes").hide().empty();
        toastr.warning("Seleccione primero el operador (campo \"Operar como\").");
        return;
    }

    if (texto.length < 2) {
        $("#dropdownClientes").hide().empty();
        return;
    }

    timerCliente = setTimeout(function () {
        $.get(URL_CLIENTES, {
            empresa: Estado.empresa,
            agente: Estado.agenteOperador,   // ← antes: Estado.agente
            filtro:  texto
        }, function (resp) {
            if (!resp.ok) { toastr.error(resp.msg); return; }

            var dd = $("#dropdownClientes").empty();
            if (!resp.data || resp.data.length === 0) {
                dd.append('<div class="item-cliente" style="color:#aaa; font-style:italic;">Sin resultados</div>');
            } else {
                $.each(resp.data, function (_, c) {
                    dd.append(
                        $('<div class="item-cliente"></div>')
                            .html('<span class="codigo">' + c.CardCode + '</span><span>' + c.CardName + '</span>')
                            .data("cliente", c)
                    );
                });
            }
            dd.show();
        });
    }, 350);
});

// Seleccionar cliente del dropdown
$(document).on("click", "#dropdownClientes .item-cliente", function () {
