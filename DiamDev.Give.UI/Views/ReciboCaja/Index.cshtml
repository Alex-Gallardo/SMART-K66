@model DiamDev.Give.UI.Models.ReciboCajaIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ════════════════════════════════════════════
       VARIABLES Y COLORES DE EMPRESA
       Se aplican dinámicamente vía JS
    ════════════════════════════════════════════ */
    :root {
        --c-graco: #27ae60;
        --c-faes: #c0392b;
        --c-bolik: #2c3e50;
        --c-default: #95a5a6;
    }

    /* ── SELECTOR DE EMPRESA ── */
    .empresa-addon {
        width: 46px;
        text-align: center;
        background: var(--c-default);
        color: #fff;
        font-size: 18px;
        transition: background 0.25s ease;
        border-right: none;
    }

        .empresa-addon.graco {
            background: var(--c-graco);
        }

        .empresa-addon.faes {
            background: var(--c-faes);
        }

        .empresa-addon.bolik {
            background: var(--c-bolik);
        }

    /* ── BORDE DINÁMICO DE PANELS (indica empresa activa) ── */
    .panel-empresa {
        border-top: 4px solid var(--c-default);
        transition: border-top-color 0.3s ease;
    }

        .panel-empresa.graco {
            border-top-color: var(--c-graco);
        }

        .panel-empresa.faes {
            border-top-color: var(--c-faes);
        }

        .panel-empresa.bolik {
            border-top-color: var(--c-bolik);
        }

    /* ── BADGE DE EMPRESA en heading ── */
    .badge-emp {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: #fff;
        background: var(--c-default);
        vertical-align: middle;
        transition: background 0.3s;
    }

        .badge-emp.graco {
            background: var(--c-graco);
        }

        .badge-emp.faes {
            background: var(--c-faes);
        }

        .badge-emp.bolik {
            background: var(--c-bolik);
        }

    /* ── BADGES DE STATUS ── */
    .badge-status {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

        .badge-status.nuevo {
            background: #ecf0f1;
            color: #7f8c8d;
            border: 1px solid #bdc3c7;
        }

        .badge-status.guardado {
            background: #d5f5e3;
            color: #1e8449;
            border: 1px solid #27ae60;
        }

        .badge-status.anulado {
            background: #fadbd8;
            color: #a93226;
            border: 1px solid #e74c3c;
        }

    /* ── BADGE DE SINCRONIZACIÓN CON SAP (Fase 4) ── */
    .badge-sync {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

        .badge-sync.operado {
            background: #d5f5e3;
            color: #1e8449;
            border: 1px solid #27ae60;
        }

        .badge-sync.pendiente {
            background: #fef9e7;
            color: #b9770e;
            border: 1px solid #f1c40f;
        }

        .badge-sync.anulado {
            background: #fadbd8;
            color: #a93226;
            border: 1px solid #e74c3c;
        }

        /* Descuadre con SAP: anulación parcial detectada por el sincronizador */
        .badge-sync.descuadre {
            background: #fdebd0;
            color: #ba4a00;
            border: 1px solid #e67e22;
            box-shadow: 0 0 0 2px #e74c3c inset;
            cursor: help;
        }

        /* Operado pero con descuadre de conciliación: halo ámbar de advertencia */
        .badge-sync.concil {
            box-shadow: 0 0 0 2px #f39c12 inset;
            cursor: help;
        }

        .badge-sync[title]:not([title=""]) {
            cursor: help;
        }

    /* ── CAMPO # RECIBO ── */
    #txtIdRecibo {
        font-family: 'Courier New', monospace;
        font-size: 15px;
        font-weight: 700;
        background: #f5f5f5 !important;
        text-align: center;
        letter-spacing: 2px;
        color: #2c3e50;
        border: 1px dashed #bdc3c7;
    }

    /* ── BÚSQUEDA DE CLIENTE ── */
    .wrapper-cliente {
        position: relative;
    }

    #txtBuscarCliente {
        border-left: 3px solid #3498db;
        transition: border-color 0.2s;
    }

        #txtBuscarCliente:focus {
            border-left-color: #2980b9;
        }

    #dropdownClientes {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        background: #fff;
        border: 1px solid #d0d3d4;
        border-top: none;
        border-radius: 0 0 4px 4px;
        max-height: 220px;
        overflow-y: auto;
        box-shadow: 0 6px 16px rgba(0,0,0,.12);
    }

        #dropdownClientes .item-cliente {
            padding: 9px 14px;
            cursor: pointer;
            border-bottom: 1px solid #f4f6f7;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            #dropdownClientes .item-cliente:hover {
                background: #eaf4fb;
            }

            #dropdownClientes .item-cliente .codigo {
                font-family: monospace;
                font-weight: 700;
                color: #2980b9;
                min-width: 90px;
            }

    /* ── CAMPO NOMBRE CLIENTE (verde cuando hay valor) ── */
    #txtNombreCliente.tiene-valor {
        background: #eafaf1 !important;
        border-color: #27ae60;
        font-weight: 600;
        color: #1a5e35;
    }

    /* ── LABELS COMPACTOS ESTILO MATERIAL ── */
    .flabel {
        display: block;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 700;
        color: #95a5a6;
        margin-bottom: 4px;
    }

        .flabel i {
            margin-right: 3px;
            color: #aab;
        }

    /* ── INPUTS Y SELECTS UNIFORMES ── */
    .f-control {
        height: 34px;
        font-size: 13px;
        padding: 4px 9px;
        border-radius: 4px;
    }

    select.f-control {
        height: 34px;
    }

    .fgroup {
        margin-bottom: 12px;
    }

    /* ── PANELES EN MODO EDICIÓN (resalta el panel activo) ── */
    .panel-docs.editando,
    .panel-cobros.editando {
        box-shadow: 0 0 0 2px #f39c12 inset;
    }

    /* ── PANELES DE DETALLE ── */
    .panel-cobros .panel-heading {
        background: #2471a3 !important;
        color: #fff;
    }

    .panel-docs .panel-heading {
        background: #1e8449 !important;
        color: #fff;
    }

        .panel-cobros .panel-heading i,
        .panel-docs .panel-heading i {
            margin-right: 6px;
        }

    /* ── TABLAS DE DETALLE ── */
    .tabla-detalle {
        font-size: 12px;
        margin-bottom: 0;
    }

        .tabla-detalle thead th {
            background: #f2f3f4;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .3px;
            color: #7f8c8d;
            padding: 6px 8px !important;
            white-space: nowrap;
            border-bottom: 2px solid #e0e0e0;
        }

        .tabla-detalle tbody td {
            padding: 6px 8px !important;
            vertical-align: middle !important;
        }

        .tabla-detalle tr.seleccionada {
            background: #d6eaf8 !important;
        }

    .tabla-vacia td {
        color: #bdc3c7;
        font-style: italic;
    }

    /* ── BARRA TOTALES ── */
    .barra-totales {
        background: #2c3e50;
        color: #ecf0f1;
        padding: 12px 20px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 0;
        height: 100%;
    }

    .total-item {
        text-align: center;
        padding: 0 14px;
    }

        .total-item + .total-item {
            border-left: 1px solid #3d5166;
        }

    .total-lbl {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #7f8c8d;
        display: block;
    }

    .total-val {
        font-size: 19px;
        font-weight: 700;
        color: #f1c40f;
        line-height: 1.1;
    }

        .total-val.saldo-ok {
            color: #2ecc71 !important;
        }

        .total-val.saldo-error {
            color: #e74c3c !important;
        }

    .total-sub {
        display: block;
        font-size: 11px;
        color: #7f8c8d;
        line-height: 1.2;
        margin-top: 1px;
    }

    .moneda-info {
        font-size: 11px;
        color: #7f8c8d;
        padding-left: 14px;
        border-left: 1px solid #3d5166;
        line-height: 1.8;
    }

    /* ── ÁREA DE BOTONES ── */
    .zona-botones {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        height: 100%;
        flex-wrap: wrap;
        margin: 12px 0;
    }

        .zona-botones .sep-btn {
            width: 1px;
            height: 28px;
            background: #ddd;
            flex-shrink: 0;
        }

    /* ── CARD INFO USUARIO ── */
    .usuario-card {
        background: #ecf0f1;
        border-radius: 6px;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
    }

    .usuario-avatar {
        width: 36px;
        height: 36px;
        background: #2c3e50;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        flex-shrink: 0;
    }

    .usuario-nombre {
        font-weight: 700;
        color: #2c3e50;
        line-height: 1.2;
    }

    .usuario-planta {
        font-size: 11px;
        color: #7f8c8d;
    }

    /* ── panelRecibo oculto hasta elegir empresa ── */
    #panelRecibo {
        display: none;
    }

    /* ── input readonly suave ── */
    .f-readonly {
        background-color: #f9f9f9 !important;
        cursor: default;
    }

    /* ── MODO ENCABEZADO EDITABLE (operador SALA DE VENTAS) ──
       Los campos normalmente derivados de SAP se vuelven capturables.
       Borde azul a la izquierda = "aquí puedes escribir". */
    .encabezado-libre #txtNombreCliente,
    .encabezado-libre #txtDireccion,
    .encabezado-libre #txtNit,
    .encabezado-libre #txtAgente,
    .encabezado-libre #txtCorreo {
        background: #fff !important;
        border-left: 3px solid #2980b9;
        cursor: text;
    }

    .badge-status.edicion-libre {
        background: #eaf0fb;
        color: #2471a3;
        border: 1px solid #2980b9;
    }

    /* ════════════════════════════════════════════
       MODAL BUSCAR DOCUMENTOS — rediseño
    ════════════════════════════════════════════ */
    #modalBuscarDoc .modal-content {
        border: none;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0,0,0,.25);
    }

    #modalBuscarDoc .modal-header {
        background: linear-gradient(135deg, #1e8449, #27ae60);
        border: none;
    }

    /* ── ANCHO DEL MODAL EN PC — doble candado ──
       Causa raíz: el plugin de modales del theme (Clip-One) le pone al
       .modal EXTERIOR un ancho inline fijo (~600px, estilo Bootstrap 2).
       Nuestro .modal-dialog al 95% era 95%... de esa jaula de 600px.
       Candado 1: liberar el .modal exterior (viewport completo, como BS3).
       Candado 2: el dialog al 95% con tope de 1200px, centrado. */
    @@media (min-width: 992px) {
        #modalBuscarDoc.modal {
            width: auto !important; /* anula el width inline del plugin */
            left: 0 !important; /* anula el left:50% del centrado viejo */
            right: 0 !important;
            margin-left: 0 !important; /* anula el margin-left negativo */
        }

            #modalBuscarDoc.modal .modal-dialog.modal-lg {
                width: 95% !important;
                max-width: 1200px !important;
                margin: 30px auto !important; /* centrado estándar BS3 */
            }
    }

    /* Barra de resumen (totales) */
    .doc-resumen {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        background: #f4f9f6;
        border: 1px solid #d4ede0;
        border-radius: 6px;
        padding: 10px 14px;
        margin-bottom: 12px;
    }

        .doc-resumen .resumen-item {
            flex: 1 1 auto;
            min-width: 120px;
        }

            .doc-resumen .resumen-item .lbl {
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: #7f8c8d;
                font-weight: 700;
                display: block;
            }

            .doc-resumen .resumen-item .val {
                font-size: 18px;
                font-weight: 700;
                color: #1e8449;
                line-height: 1.1;
            }

                .doc-resumen .resumen-item .val.sel {
                    color: #2471a3;
                }

        .doc-resumen .resumen-actions {
            flex: 0 0 auto;
            margin-left: auto;
        }

    /* Contenedor scrollable de la tabla */
    .doc-scroll {
        max-height: 48vh;
        overflow: auto;
        border: 1px solid #e6e6e6;
        border-radius: 6px;
    }

    /* Header sticky de la tabla del modal */
    #tablaModalDocs thead th {
        position: sticky;
        top: 0;
        z-index: 5;
        background: #2c3e50;
        color: #ecf0f1;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .3px;
        border-bottom: none;
        padding: 9px 10px !important;
        white-space: nowrap;
    }

    /* Encabezado "Fecha" ordenable: clickeable con flecha de dirección */
    #thFechaDocs {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

        #thFechaDocs:hover {
            background: #3d5166; /* un tono más claro que el header, feedback de hover */
        }

        #thFechaDocs .flecha-orden {
            display: inline-block;
            margin-left: 4px;
            font-size: 9px;
            color: #f1c40f; /* amarillo del theme: destaca sobre el header oscuro */
        }

    #tablaModalDocs tbody td {
        padding: 8px 10px !important;
        vertical-align: middle !important;
        font-size: 12.5px;
    }

    #tablaModalDocs tbody tr {
        cursor: pointer;
        transition: background .12s;
    }

        #tablaModalDocs tbody tr:hover {
            background: #eaf4fb;
        }

        #tablaModalDocs tbody tr.row-sel {
            background: #d6eaf8 !important;
        }

    #tablaModalDocs .col-saldo {
        font-weight: 700;
        color: #1a5e35;
    }

    /* Comprometido en recibos PENDIENTES (SQL): ámbar cuando hay monto */
    #tablaModalDocs .col-pendiente {
        font-weight: 700;
        color: #b9770e;
    }

        #tablaModalDocs .col-pendiente.sin-pend {
            color: #bdc3c7; /* gris suave cuando es 0: no distrae */
            font-weight: 400;
        }

    /* Disponible real (Saldo − Pendiente): rojo si quedó en 0 o negativo */
    #tablaModalDocs .col-disponible {
        font-weight: 700;
        color: #2471a3;
    }

        #tablaModalDocs .col-disponible.agotado {
            color: #a93226;
        }

    /* Fila sin saldo por confirmar (0 o negativo): atenuada y no seleccionable.
       El monto negativo queda visible en rojo a propósito: es señal de
       sobre-compromiso (recibos en tránsito > saldo de la factura). */
    #tablaModalDocs tbody tr.row-agotada {
        opacity: .55;
        cursor: not-allowed;
    }

        #tablaModalDocs tbody tr.row-agotada:hover {
            background: transparent;
        }

    #tablaModalDocs .chk-doc,
    #chkTodosDocs {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .fel-badge {
        font-family: monospace;
        font-size: 11px;
        color: #2471a3;
    }

    /* Responsive: en pantallas chicas el modal usa casi todo el ancho */
    @@media (max-width: 768px) {
        #modalBuscarDoc .modal-dialog {
            width: auto;
            margin: 10px;
        }

        .doc-resumen .resumen-item .val {
            font-size: 16px;
        }

        .doc-scroll {
            max-height: 55vh;
        }
    }

    /* ════════════════════════════════════════════
       PANEL SELECTOR (empresa + fecha + usuario)
       Layout flex propio para que funcione bien en mobile
    ════════════════════════════════════════════ */

    /* Heading: título arriba, subtítulo abajo en mobile */
    .sel-heading {
        background: #f7f9fa;
        border-bottom: 1px solid #eee;
    }

        .sel-heading .panel-title {
            color: #5d6d7e;
            font-size: 13px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px 8px;
            margin: 0;
        }

    .sel-title-main {
        font-weight: 700;
    }

    .sel-title-sub {
        color: #95a5a6;
        font-weight: 400;
    }

    /* Grid de campos: 3 zonas que se reacomodan solas */
    .selector-grid {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 14px 16px;
    }

        /* flex: grow shrink basis  → como flexGrow/flexShrink/flexBasis en JS */
        .selector-grid .sel-empresa {
            flex: 1 1 280px;
            min-width: 220px;
        }

        .selector-grid .sel-fecha {
            flex: 0 1 210px;
            min-width: 170px;
        }

        .selector-grid .sel-codigo {
            flex: 1 1 240px;
            min-width: 200px;
        }

        .selector-grid .sel-usuario {
            flex: 1 1 240px;
            min-width: 220px;
            margin-left: auto; /* empuja la tarjeta a la derecha en desktop */
        }

        .selector-grid .usuario-card {
            margin: 0; /* anulamos el margin-top:4px viejo */
            width: 100%;
        }

    /* ── MOBILE: una sola columna, todo a lo ancho ── */
    @@media (max-width: 767px) {
        .sel-heading .panel-title {
            font-size: 14px;
        }

        .sel-title-sub {
            flex-basis: 100%; /* el subtítulo salta a su propia línea */
            font-size: 11px;
        }

        .selector-grid > div {
            flex: 1 1 100% !important;
            min-width: 0 !important;
            margin-left: 0 !important; /* mata el margin-left:auto en mobile */
        }
    }

    /* ════════════════════════════════════════════
       FIX MOBILE: header del encabezado
       Apila: título+empresa arriba, badges abajo en su propia
       fila con wrap. Los badges largos envuelven texto en vez
       de desbordar sobre el cuerpo.
    ════════════════════════════════════════════ */
    @@media (max-width: 767px) {
        /* Solucion al desface del Heading en mobile */
        #panelEncabezado .panel-heading {
            height: auto;
        }
            /* El contenedor del heading SIEMPRE en columna en mobile.
           (Antes había un flex-direction:row !important que peleaba
           con esta regla y ganaba — causa raíz del solapamiento.) */
            #panelEncabezado .panel-heading > div.panelTitleContainer {
                display: flex;
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 8px;
            }
        /* Título: "Encabezado del Recibo" + badge de empresa en fila,
           envolviendo si no caben. */
        #panelEncabezado .title-recibo {
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center !important;
        }
        /* Fila de badges (sync + status): ancho completo, con wrap.
           Cada badge baja de línea si no cabe, en vez de desbordar. */
        #panelEncabezado .panel-heading .badges-recibo {
            flex-wrap: wrap;
            justify-content: flex-start;
            width: 100%;
        }
        /* El badge de sync trae textos largos ("PENDIENTE (ANULADO
           EN SAP)"): permitir que el TEXTO envuelva dentro del badge. */
        #panelEncabezado .badge-sync,
        #panelEncabezado .badge-status {
            white-space: normal;
            line-height: 1.35;
            text-align: left;
            max-width: 100%;
        }
        /* Aire entre el heading y el "# Recibo" del cuerpo. */
        #panelEncabezado .panel-body {
            padding-top: 16px !important;
        }
    }

    /* ════════════════════════════════════════════
       FIX MOBILE: barra de totales
       En pantallas chicas los 4 bloques se apilan en
       lugar de desbordar el ancho de la pantalla.
    ════════════════════════════════════════════ */
    @@media (max-width: 767px) {
        .barra-totales {
            flex-wrap: wrap; /* permite que los bloques bajen de línea */
            gap: 4px 0;
            padding: 12px 14px;
            height: auto; /* deja de forzar altura completa */
        }

        .total-item {
            flex: 1 1 33%; /* 3 totales por fila, repartidos parejos */
            padding: 6px 4px;
        }
            /* El separador vertical entre totales molesta al envolver:
            lo quitamos en mobile y usamos el espaciado del gap. */
            .total-item + .total-item {
                border-left: none;
            }

        .moneda-info {
            flex: 1 1 100%; /* T. Cambio / Mon. Base ocupan su propia fila */
            border-left: none; /* sin línea lateral en mobile */
            border-top: 1px solid #3d5166; /* separador horizontal arriba */
            padding-left: 0;
            padding-top: 8px;
            margin-top: 4px;
            text-align: center;
        }
    }
</style>

<!--
    PERMISOS DE ROLES
    Cambia los  _arroba por arrobas normales

     _arroba if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.ReciboCaja.Graco"))
    {
        <option value="GRACO">🏭&nbsp; Graco Pack</option>
    }
     _arroba if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.ReciboCaja.Faes"))
    {
     _arroba   <option value="FAES">🏭&nbsp; Fabrica Escocesa</option>
    }
     _arroba if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.ReciboCaja.Bolik"))
    {
        <option value="BOLIK">🏭&nbsp; Industrias Bolik</option>
    }
-->
<!-- ══════════════════════════════════════════════
     SECCIÓN 1: EMPRESA + FECHA
     Layout flex propio (responsive, mobile-friendly)
══════════════════════════════════════════════ -->
<div class="panel panel-default panel-empresa" id="panelSelector">
    <div class="panel-heading sel-heading">
        <h4 class="panel-title">
            <i class="clip-archive"></i>
            <span class="sel-title-main">Recibos de Caja</span>
            <small class="sel-title-sub">Seleccione empresa y operador para comenzar</small>
        </h4>
    </div>
    <div class="panel-body" style="padding:16px 18px;">
        <div class="selector-grid">

            <!-- Empresa -->
            <div class="sel-empresa">
                <span class="flabel"><i class="icon-building"></i> Empresa</span>
                <div class="input-group">
                    <span class="input-group-addon empresa-addon" id="empresaAddon">
                        <i class="icon-building"></i>
                    </span>
                    <select id="selEmpresa" class="form-control f-control search-select">
                        <option value="">— Seleccione empresa —</option>
                        <!-- Las opciones se cargan vía CargarEmpresasUsuario() -->
                    </select>
                </div>
            </div>

            <!-- Código / Operador (Usuario_Empresa) -->
            <div class="sel-codigo" id="wrapCodigo" style="display:none;">
                <span class="flabel"><i class="icon-user"></i> Operar como</span>
                <div class="input-group">
                    <span class="input-group-addon" style="background:#eaf0fb; color:#2980b9;">
                        <i class="icon-user"></i>
                    </span>
                    <select id="selCodigo" class="form-control f-control search-select">
                        <option value="">— Seleccione código —</option>
                    </select>
                </div>
            </div>

            <!-- Fecha del recibo -->
            <div class="sel-fecha">
                <span class="flabel"><i class="icon-calendar"></i> Fecha del Recibo</span>
                <div class="input-group">
                    <span class="input-group-addon" style="background:#eaf0fb; color:#2980b9;">
                        <i class="icon-calendar"></i>
                    </span>
                    <input type="text" id="fechaRecibo"
                           class="form-control f-control date-picker"
                           data-date-format="yyyy-mm-dd"
                           data-date-viewmode="years"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           readonly="readonly"
                           disabled />
                </div>
            </div>

            <!-- Info usuario -->
            <div class="sel-usuario">
                <div class="usuario-card">
                    <div class="usuario-avatar">
                        <i class="icon-user"></i>
                    </div>
                    <div>
                        <div class="usuario-nombre">
                            @Model.UsuarioActual
                            <span id="lblOperadorCodigo" style="color:#2980b9; font-weight:600;"></span>
                        </div>
                        <div class="usuario-planta">
                            <i class="icon-tag" style="font-size:10px;"></i>
                            Serie: <strong id="lblOperadorSerie">—</strong>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     SECCIÓN 2: FORMULARIO DE RECIBO
     (aparece al seleccionar empresa)
══════════════════════════════════════════════ -->
<div id="panelRecibo">
    <!-- ── ENCABEZADO DEL RECIBO ── -->
    <div class="panel panel-default panel-empresa" id="panelEncabezado">
        <div class="panel-heading" style="background:#f7f9fa; border-bottom:1px solid #eee; padding:10px 15px;">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;" class="panelTitleContainer">
                <h4 class="panel-title title-recibo" style="margin:0; font-size:14px; color:#5d6d7e; display:flex; align-items:center; flex-wrap:wrap; gap:6px;">
                    <span class="sel-title-main">Encabezado del Recibo</span>
                    <span id="badgeEmpresa" class="badge-emp">—</span>
                </h4>
                <span class="badges-recibo" style="display:flex; align-items:center; gap:6px;">
                    <span id="badgeEdicionLibre" class="badge-status edicion-libre"
                          style="display:none;"
                          title="Operador SALA DE VENTAS: los datos del cliente se capturan manualmente y se guardan tal como se escriban.">
                        ✏️ ENCABEZADO EDITABLE
                    </span>
                    <span id="badgeSync" class="badge-sync" style="display:none;">—</span>
                    <span id="badgeStatus" class="badge-status nuevo">NUEVO</span>
                </span>
            </div>
        </div>
        <div class="panel-body" style="padding: 14px 18px;">

            <!-- ── ALERTA DE DESCUADRE (Fase 5) ── -->
            <div id="alertaDescuadre" class="alert alert-danger"
                 style="display:none; margin:0 0 14px; border-left:4px solid #e74c3c;">
                <strong><i class="icon-warning-sign"></i> Descuadre con SAP</strong>
                <!-- <div id="alertaDescuadreDetalle"style="margin-top:5px; font-size:12.5px; font-family:monospace;"></div> -->
                <div style="margin-top:6px; font-size:12px;">
                    Parte del pago de este recibo fue <strong>anulado en SAP</strong> y el monto
                    aún no ha sido re-aplicado por Créditos. La <strong>
                        impresión está
                        bloqueada
                    </strong>. El sincronizador liberará el recibo automáticamente
                    cuando los montos vuelvan a cuadrar.
                </div>
            </div>

            <!-- Fila A: Identificadores + Totales rápidos -->
            <!-- Fila A: Identificadores (los totales se ven en la barra inferior) -->
            <div class="row">
                <div class="col-md-3 col-sm-6">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-tag"></i> # Recibo</span>
                        <input type="text" id="txtIdRecibo"
                               class="form-control f-control f-readonly"
                               readonly placeholder="Automático" />
                        <!-- Campos ocultos de estado -->
                        <input type="hidden" id="hdnEmpresa" />
                        <input type="hidden" id="hdnAgente" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-file-text"></i> Rec. Físico</span>
                        <input type="text" id="txtRecFisico"
                               class="form-control f-control"
                               maxlength="20" placeholder="Nro. físico..." />
                    </div>
                </div>

                <!-- Moneda del recibo: NO se muestra (vive en la barra de totales),
                pero SÍ se envía al backend en el payload del guardado. -->
                <input type="hidden" id="txtMoneda" />
            </div>

            <div style="border-top:1px solid #f0f0f0; margin: 4px 0 12px;"></div>

            <!-- Fila B: Búsqueda de cliente -->
            <div class="row">
                <div class="col-md-5">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-user"></i> Cliente (código o nombre)</span>
                        <div class="wrapper-cliente input-group">
                            <span class="input-group-addon"
                                  style="background:#eaf0fb; color:#2980b9;">
                                <i class="icon-search"></i>
                            </span>
                            <input type="text" id="txtBuscarCliente"
                                   class="form-control f-control"
                                   placeholder="Escriba código o nombre para buscar..."
                                   autocomplete="off" />
                            <div id="dropdownClientes"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-user"></i> Nombre Cliente</span>
                        <input type="text" id="txtNombreCliente"
                               class="form-control f-control f-readonly"
                               readonly placeholder="—" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-barcode"></i> NIT</span>
                        <input type="text" id="txtNit"
                               class="form-control f-control f-readonly"
                               readonly placeholder="—" />
                    </div>
                </div>
            </div>

            <!-- Fila C: Datos adicionales cliente -->
            <div class="row">
                <div class="col-md-5">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-map-marker"></i> Dirección</span>
                        <input type="text" id="txtDireccion"
                               class="form-control f-control f-readonly"
                               readonly placeholder="—" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="fgroup">
                        <span class="flabel"><i class="icon-user"></i> Agente</span>
                        <input type="text" id="txtAgente"
                               class="form-control f-control f-readonly"
                               readonly placeholder="—" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="fgroup" style="margin-bottom:0;">
                        <span class="flabel"><i class="icon-envelope"></i> Correo</span>
                        <input type="text" id="txtCorreo"
                               class="form-control f-control f-readonly"
                               readonly placeholder="—" />
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── DETALLES: COBROS | DOCUMENTOS ── -->
    <div class="row">

        <!-- ═══ IZQUIERDA: COBROS ═══ -->
        <div class="col-md-6">
            <div class="panel panel-default panel-cobros" id="panelCobros">
                <div class="panel-heading" style="padding:10px 14px;">
                    <strong style="font-size:13px;">
                        <i class="icon-money"></i> Detalle de Cobros
                    </strong>
                </div>
                <div class="panel-body" style="padding:14px 16px;">

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fgroup">
                                <span class="flabel">Tipo de Pago</span>
                                <select id="cboTipoPago" class="form-control f-control search-select">
                                    <option value="">— Seleccionar —</option>
                                    <option value="EFECTIVO">💵&nbsp; EFECTIVO</option>
                                    <option value="CHEQUE">🏦&nbsp; CHEQUE</option>
                                    <option value="TRANSFERENCIA">🔄&nbsp; TRANSFERENCIA</option>
                                    <option value="DEPOSITO">💳&nbsp; DEPOSITO</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fgroup">
                                <span class="flabel">Banco</span>
                                <select id="cboBanco" class="form-control f-control search-select">
                                    <option value="">— Seleccionar —</option>
                                    <option value="AGROMERCANTIL">🏛️&nbsp; AGROMERCANTIL</option>
                                    <option value="BANRURAL">🏛️&nbsp; BANRURAL</option>
                                    <option value="BANTRAB">🏛️&nbsp; BANTRAB</option>
                                    <option value="BAM">🏛️&nbsp; BAM</option>
                                    <option value="BAM DOLAR">🏛️&nbsp; BAM DOLAR</option>
                                    <option value="BAC">🏛️&nbsp; BAC</option>
                                    <option value="BAC DOLAR">🏛️&nbsp; BAC DOLAR</option>
                                    <option value="CHN">🏛️&nbsp; CHN</option>
                                    <option value="CITI BANK">🏛️&nbsp; CITI BANK</option>
                                    <option value="FICOHSA">🏛️&nbsp; FICOHSA</option>
                                    <option value="G&T CONTINENTAL">🏛️&nbsp; G&amp;T CONTINENTAL</option>
                                    <option value="INDUSTRIAL">🏛️&nbsp; INDUSTRIAL</option>
                                    <option value="INTERBANCO">🏛️&nbsp; INTERBANCO</option>
                                    <option value="OCEAN BAK">🏛️&nbsp; OCEAN BAK</option>
                                    <option value="OCCIDENTE">🏛️&nbsp; OCCIDENTE</option>
                                    <option value="PROMERICA">🏛️&nbsp; PROMERICA</option>
                                    <option value="REFORMADOR">🏛️&nbsp; REFORMADOR</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fgroup">
                                <span class="flabel"><i class="icon-file-text"></i> No. Documento</span>
                                <input type="text" id="txtNoDocCobro"
                                       class="form-control f-control"
                                       placeholder="Nro. de cheque / transf..." />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fgroup">
                                <span class="flabel"><i class="icon-calendar"></i> Fecha Documento</span>
                                <input type="text" id="dtpFechaCobro"
                                       class="form-control f-control date-picker"
                                       data-date-format="yyyy-mm-dd"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fgroup" style="margin-bottom:0;">
                                <span class="flabel"><i class="icon-money"></i> Monto</span>
                                <input type="number" id="txtMontoCobro"
                                       class="form-control f-control"
                                       step="0.01" min="0" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fgroup" style="margin-bottom:0;">
                                <span class="flabel">💱 Moneda</span>
                                <select id="cboMonedaCobro" class="form-control f-control search-select">
                                    <option value="">— Seleccionar —</option>
                                    <option value="GTQ">🇬🇹&nbsp; GTQ — Quetzal</option>
                                    <option value="USD">🇺🇸&nbsp; USD — Dólar</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top:12px; display:flex; gap:8px;">
                        <button class="btn btn-primary btn-sm" id="btnAgregarCobro" style="flex:1;">
                            <i class="icon-plus"></i> Agregar Cobro
                        </button>
                        <button class="btn btn-default btn-sm" id="btnCancelarEdicionCobro" style="display:none;">
                            <i class="icon-remove"></i> Cancelar edición
                        </button>
                        <button class="btn btn-danger btn-sm" id="btnQuitarCobro">
                            <i class="icon-minus"></i> Quitar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tabla de cobros -->
            <div class="panel panel-default">
                <div class="panel-body" style="padding:0; overflow-x:auto;">
                    <table class="table tabla-detalle">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Banco</th>
                                <th>Fecha</th>
                                <th>Documento</th>
                                <th class="text-right">Monto</th>
                                <th>Mon.</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyCobros">
                            <tr class="tabla-vacia">
                                <td colspan="7" class="text-center" style="padding:16px;">
                                    <i class="icon-inbox" style="font-size:20px; color:#ccc;"></i><br />
                                    Sin cobros agregados
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /col cobros -->
        <!-- ═══ DERECHA: DOCUMENTOS ═══ -->
        <div class="col-md-6">
            <div class="panel panel-default panel-docs" id="panelDocs">
                <div class="panel-heading" style="padding:10px 14px;">
                    <strong style="font-size:13px;">
                        <i class="icon-file-text"></i> Detalle de Documentos
                    </strong>
                </div>
                <div class="panel-body" style="padding:14px 16px;">

                    <div class="row">
                        <div class="col-sm-12">
                            <div class="fgroup">
                                <span class="flabel">Tipo de Documento</span>
                                <select id="cboTipoDoc" class="form-control f-control search-select">
                                    <option value="">— Seleccionar —</option>
                                    <option value="FACTURA">🧾&nbsp; FACTURA</option>
                                    <option value="PEDIDO">📦&nbsp; PEDIDO</option>
                                    <option value="ANTICIPO">💰&nbsp; ANTICIPO</option>
                                    <option value="DIFERENCIA">🧮&nbsp; DIFERENCIA</option>
                                    <!-- <option value="SALDO PENDIENTE">⏳&nbsp; SALDO PENDIENTE</option> -->
                                    <!-- <option value="NOTA DE CREDITO">📝&nbsp; NOTA DE CRÉDITO</option> -->
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="fgroup">
                                <span class="flabel"><i class="icon-file-text"></i> No. Documento</span>
                                <div class="input-group">
                                    <input type="text" id="txtNoDocDoc"
                                           class="form-control f-control"
                                           placeholder="Escriba o busque 🔍" />
                                    <span class="input-group-btn">
                                        <button class="btn btn-default btn-sm" id="btnBuscarDoc"
                                                title="Buscar documento disponible"
                                                style="height:34px;">
                                            <i class="icon-search"></i>
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="fgroup">
                                <span class="flabel"><i class="icon-calendar"></i> Fecha Documento</span>
                                <input type="text" id="dtpFechaDoc"
                                       class="form-control f-control date-picker"
                                       data-date-format="yyyy-mm-dd"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="fgroup">
                                <span class="flabel">Serie FEL</span>
                                <input type="text" id="txtSerieFel"
                                       class="form-control f-control"
                                       placeholder="Serie..." />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="fgroup">
                                <span class="flabel">Núm. FEL</span>
                                <input type="text" id="txtNumFel"
                                       class="form-control f-control"
                                       placeholder="Número..." />
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="fgroup">
                                <span class="flabel">Total Factura</span>
                                <input type="text" id="txtTotalFact"
                                       class="form-control f-control f-readonly"
                                       readonly placeholder="0.00"
                                       style="color:#7d6608; font-weight:600;" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-4">
                            <div class="fgroup" style="margin-bottom:0;">
                                <span class="flabel"><i class="icon-money"></i> Monto a Cobrar</span>
                                <input type="number" id="txtMontoDoc"
                                       class="form-control f-control"
                                       step="0.01" min="0" placeholder="0.00" />
                            </div>
                        </div>
                        <!-- Ya Pagado: OCULTO en la UI pero debe existir en el DOM.
    El JS lo lee al agregar el documento (docObj.Pagado) y lo
    convierte al cambiar moneda. Estaba comentado y por eso
    todo doc agregado desde el panel grababa PAGADO = 0. -->
                        <input type="hidden" id="txtPagado" />
                        <div class="col-sm-8">
                            <div class="fgroup" style="margin-bottom:0;">
                                <span class="flabel">💱 Moneda</span>
                                <select id="cboMonedaDoc" class="form-control f-control search-select">
                                    <option value="">— Seleccionar —</option>
                                    <option value="GTQ">🇬🇹&nbsp; GTQ — Quetzal</option>
                                    <option value="USD">🇺🇸&nbsp; USD — Dólar</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top:12px; display:flex; gap:8px;">
                        <button class="btn btn-success btn-sm" id="btnAgregarDoc" style="flex:1;">
                            <i class="icon-plus"></i> Agregar Documento
                        </button>
                        <button class="btn btn-default btn-sm" id="btnCancelarEdicionDoc" style="display:none;">
                            <i class="icon-remove"></i> Cancelar edición
                        </button>
                        <button class="btn btn-danger btn-sm" id="btnQuitarDoc">
                            <i class="icon-minus"></i> Quitar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tabla de documentos -->
            <div class="panel panel-default">
                <div class="panel-body" style="padding:0; overflow-x:auto;">
                    <table class="table tabla-detalle">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Documento</th>
                                <th>Fecha</th>
                                <th class="text-right">Monto</th>
                                <th>Mon.</th>
                                <th class="text-right">Total F.</th>
                                <th class="text-right">Pagado</th>
                                <th>Serie FEL</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDocs">
                            <tr class="tabla-vacia">
                                <td colspan="9" class="text-center" style="padding:16px;">
                                    <i class="icon-inbox" style="font-size:20px; color:#ccc;"></i><br />
                                    Sin documentos agregados
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /col documentos -->

    </div><!-- /row detalles -->
    <!-- ── BARRA TOTALES + BOTONES ── -->
    <div class="panel panel-default" style="border-top:3px solid #2c3e50;">
        <div class="panel-body" style="padding:12px 16px;">
            <div class="row" style="display:flex; align-items:stretch; flex-wrap:wrap;">

                <!-- Totales -->
                <div class="col-md-7" style="display:flex; align-items:center;">
                    <div class="barra-totales" style="width:100%;">
                        <div class="total-item">
                            <span class="total-lbl">💰 Cobros</span>
                            <span class="total-val" id="spanTotalCobros">0.00</span>
                            <span class="total-sub" id="spanTotalCobrosUsd">$ 0.00</span>
                        </div>
                        <div class="total-item">
                            <span class="total-lbl">📄 Documentos</span>
                            <span class="total-val" id="spanTotalDocs">0.00</span>
                            <span class="total-sub" id="spanTotalDocsUsd">$ 0.00</span>
                        </div>
                        <div class="total-item">
                            <span class="total-lbl">⚖️ Saldo</span>
                            <span class="total-val" id="spanSaldo">0.00</span>
                            <span class="total-sub" id="spanSaldoUsd">$ 0.00</span>
                        </div>
                        <div class="moneda-info">
                            <div><i class="icon-money"></i> T. Cambio: <strong id="spanTipoCambio">—</strong></div>
                            <div>Mon. Base: <strong>GTQ</strong></div>
                        </div>
                    </div>
                </div>

                <!-- Botones organizados por función -->
                <div class="col-md-5" style="display:flex; align-items:center;">
                    <div class="zona-botones" style="width:100%;">

                        <!-- Grupo 1: Navegar / reset -->
                        <button id="btnNuevo" class="btn btn-default btn-sm">
                            <i class="icon-plus-sign"></i> Nuevo
                        </button>
                        <button id="btnBuscarRecibo" class="btn btn-info btn-sm">
                            <i class="icon-search"></i> Buscar
                        </button>

                        <div class="sep-btn"></div>

                        <!-- Grupo 2: Acciones principales -->
                        <button id="btnGuardar" class="btn btn-primary" disabled
                                style="font-weight:600;">
                            <i class="icon-save"></i> Guardar
