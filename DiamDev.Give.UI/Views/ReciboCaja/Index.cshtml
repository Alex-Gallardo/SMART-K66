// ════════════════════════════════════════════════════════
// 3. TIPO DE PAGO → habilitar/deshabilitar campos
// ════════════════════════════════════════════════════════
$("#cboTipoPago").on("change", function () {
    var esEfectivo = $(this).val() === "EFECTIVO";
    $("#cboBanco").prop("disabled", esEfectivo).val("");
    $("#txtNoDocCobro").prop("disabled", esEfectivo).val("");
    $("#dtpFechaCobro").prop("disabled", esEfectivo).val("");
});

// ════════════════════════════════════════════════════════
// 3.5 CAMBIO DE MONEDA → convertir montos del panel
// Guardamos la moneda previa en data("monedaPrev") para saber
// la dirección de la conversión. Los seteos programáticos usan
// change.select2, que NO dispara estos handlers (a propósito).
// ════════════════════════════════════════════════════════
$("#cboMonedaCobro").on("change", function () {
    var nueva = $(this).val();
    var previa = $(this).data("monedaPrev") || "";
    $(this).data("monedaPrev", nueva);

    if (!previa || !nueva || previa === nueva) return;
    if (!(Estado.tipoCambio > 0)) {
        toastr.warning("No hay tipo de cambio del día: el monto no se convirtió.");
        return;
    }
    var v = ConvertirMonto($("#txtMontoCobro").val(), previa, nueva, Estado.tipoCambio);
    if (v !== null) $("#txtMontoCobro").val(v.toFixed(2));
});

$("#cboMonedaDoc").on("change", function () {
    var nueva = $(this).val();
    var previa = $(this).data("monedaPrev") || "";
    $(this).data("monedaPrev", nueva);

    if (!previa || !nueva || previa === nueva) return;
    if (!(Estado.tipoCambio > 0)) {
        toastr.warning("No hay tipo de cambio del día: los montos no se convirtieron.");
        return;
    }
    // Convierte los tres campos de dinero del panel
    ["#txtMontoDoc", "#txtTotalFact", "#txtPagado"].forEach(function (sel) {
        var v = ConvertirMonto($(sel).val(), previa, nueva, Estado.tipoCambio);
        if (v !== null) $(sel).val(v.toFixed(2));
    });
});

// ════════════════════════════════════════════════════════
// 4. TIPO DOCUMENTO → habilitar/deshabilitar campos
// ════════════════════════════════════════════════════════
$("#cboTipoDoc").on("change", function () {
    // Si estamos en modo edición, NO limpiamos ni reabrimos el modal.
    // (Esto evita que cargar el tipo al editar borre los campos o abra el modal.)
    if (Estado.docEditIndex !== null) return;

    var tipo = $(this).val();

    // Bloqueo de campos: una sola función, una sola regla.
    AplicarBloqueoTipoDoc(tipo);

    // Limpieza de campos (alta nueva)
    $("#txtNoDocDoc").val("");
    $("#dtpFechaDoc").val("");
    $("#txtSerieFel").val("");
    $("#txtNumFel").val("");

    $("#cboMonedaDoc").val("");
    $("#cboMonedaDoc").data("monedaPrev", "");
    if ($("#cboMonedaDoc").hasClass("search-select") && $.fn.select2) {
        // change.select2 = repintar lo visual SIN disparar el handler de
        // conversión de la sección 3.5 (regla de la casa)
        $("#cboMonedaDoc").trigger("change.select2");
    }

    $("#txtTotalFact").val("");
    $("#txtPagado").val("");
    $("#txtMontoDoc").val("");

    // Al elegir FACTURA o PEDIDO con cliente ya seleccionado, abrimos el modal.
    if ((tipo === "FACTURA" || tipo === "PEDIDO") && Estado.clienteId) {
        $("#btnBuscarDoc").trigger("click");
    }
});

// ════════════════════════════════════════════════════════
// 5. AGREGAR / ACTUALIZAR COBRO
// ════════════════════════════════════════════════════════
        $("#btnAgregarCobro").on("click", function () {
            var tipo = $("#cboTipoPago").val();
            var banco = $("#cboBanco").val();
            var nodoc = $("#txtNoDocCobro").val().trim();
            var fecha = $("#dtpFechaCobro").val();
            var monto = parseFloat($("#txtMontoCobro").val()) || 0;
            var moneda = $("#cboMonedaCobro").val();
            var editando = (Estado.cobroEditIndex !== null);

            if (!tipo || !moneda || monto <= 0 ) {
        toastr.warning("Tipo de pago, monto, fecha y moneda son obligatorios.");
        return;
    }
    // Moneda consistente: se ignora la propia fila cuando estamos editando
    // (así se puede corregir la moneda del ÚNICO cobro capturado).
    if (Estado.monedaCobro && Estado.monedaCobro !== moneda) {
        var hayOtros = false;
        for (var j = 0; j < Estado.cobros.length; j++) {
            if (j !== Estado.cobroEditIndex) { hayOtros = true; break; }
        }
        if (hayOtros) {
            toastr.error("Todos los cobros deben tener la misma moneda (" + Estado.monedaCobro + ").");
            return;
        }
    }
    if (tipo !== "EFECTIVO" && (!banco || !nodoc)) {
        toastr.warning("Para " + tipo + " se requiere banco y número de documento.");
        return;
    }

    var cobroObj = {
        TipoCobro: tipo,
        Banco: tipo === "EFECTIVO" ? "" : banco,
        FechaDoc: tipo === "EFECTIVO" ? "" : fecha,
        NoDocumento: tipo === "EFECTIVO" ? "" : nodoc,
        Monto: monto,
        Moneda: moneda
    };

    if (editando) {
        // ── ACTUALIZAR la fila existente ──
        Estado.cobros[Estado.cobroEditIndex] = cobroObj;
        toastr.success("Cobro actualizado.");
        SalirModoEdicionCobro();
    } else {
        // ── ALTA nueva ──
        Estado.cobros.push(cobroObj);
    }

    // La moneda vigente se RECALCULA del arreglo (fuente de verdad),
    // no se acumula: cubre el caso de editar el único cobro y cambiarle
    // la moneda, donde la variable vieja quedaría desactualizada.
    Estado.monedaCobro = Estado.cobros.length ? Estado.cobros[0].Moneda : "";
    $("#spanMonedaCobro").text(Estado.monedaCobro || "—");

    RenderizarTablaCobros();
    ActualizarTotales();
    LimpiarDetalleCobro();
});

// Botón "Cancelar edición" (cobros) → descarta cambios, vuelve a modo alta
$("#btnCancelarEdicionCobro").on("click", function () {
    SalirModoEdicionCobro();
    LimpiarDetalleCobro();
    toastr.info("Edición cancelada.");
});

// Sale del modo edición de cobros: restaura el botón a "Agregar Cobro"
function SalirModoEdicionCobro() {
    Estado.cobroEditIndex = null;
    $("#btnAgregarCobro").html('<i class="icon-plus"></i> Agregar Cobro')
        .removeClass("btn-warning").addClass("btn-primary");
    $("#btnCancelarEdicionCobro").hide();
    $("#panelCobros").removeClass("editando");
    $("#tbodyCobros tr").removeClass("seleccionada");
}

// Carga un cobro de la tabla al panel editable, respetando la regla
// EFECTIVO (banco/fecha/doc deshabilitados). Se setea el tipo con .val()
// SIN disparar el handler de la sección 3 (que limpiaría los campos);
// el estado disabled lo aplicamos aquí a mano.
function CargarCobroEnPanel(c) {
    if (!c) return;
    var esEfectivo = c.TipoCobro === "EFECTIVO";

    $("#cboTipoPago").val(c.TipoCobro);
    $("#cboBanco").val(c.Banco || "").prop("disabled", esEfectivo);
    $("#txtNoDocCobro").val(c.NoDocumento || "").prop("disabled", esEfectivo);
    $("#dtpFechaCobro").val(c.FechaDoc || "").prop("disabled", esEfectivo);
    $("#txtMontoCobro").val(FmtNum(c.Monto));   // FmtNum: SIN comas, es un input
    $("#cboMonedaCobro").val(c.Moneda || "");
    $("#cboMonedaCobro").data("monedaPrev", c.Moneda || "");

    if ($.fn.select2) {
        $("#cboTipoPago, #cboBanco, #cboMonedaCobro")
            .filter(".search-select").trigger("change.select2");
    }
}

// Click en el lápiz de un cobro → MODO EDICIÓN
$(document).on("click", ".btn-editCobro", function (e) {
    e.stopPropagation();  // no dispara el click de selección de fila
    var idx = parseInt($(this).data("idx"), 10);
    var c = Estado.cobros[idx];
    if (!c) return;

    Estado.cobroEditIndex = idx;
    CargarCobroEnPanel(c);

    $("#btnAgregarCobro").html('<i class="icon-ok"></i> Actualizar Cobro')
        .removeClass("btn-primary").addClass("btn-warning");
    $("#btnCancelarEdicionCobro").show();
    $("#panelCobros").addClass("editando");

    $("#tbodyCobros tr").removeClass("seleccionada");
    $(this).closest("tr").addClass("seleccionada");

    toastr.info("Editando cobro de " + c.TipoCobro + ". Ajuste y presione Actualizar.");
});

// ════════════════════════════════════════════════════════
// 6. QUITAR COBRO
// ════════════════════════════════════════════════════════
$("#btnQuitarCobro").on("click", function () {
    var idx = $("#tbodyCobros tr.seleccionada").data("idx");
    if (idx === undefined) { toastr.info("Seleccione una fila para quitar."); return; }

    // Si quitamos la fila en edición, salimos del modo edición
    if (Estado.cobroEditIndex === idx) {
        SalirModoEdicionCobro();
        LimpiarDetalleCobro();
    }

    Estado.cobros.splice(idx, 1);
    Estado.monedaCobro = Estado.cobros.length ? Estado.cobros[0].Moneda : "";
    $("#spanMonedaCobro").text(Estado.monedaCobro || "—");

    // Reajustar el índice de edición si quedó desfasado por el splice
    if (Estado.cobroEditIndex !== null && idx < Estado.cobroEditIndex) {
        Estado.cobroEditIndex--;
    }
    RenderizarTablaCobros();
    ActualizarTotales();
});

$(document).on("click", "#tbodyCobros tr", function () {
    $("#tbodyCobros tr").removeClass("seleccionada");
    $(this).addClass("seleccionada");
});

// ════════════════════════════════════════════════════════
// 7. MODAL DOCUMENTOS DISPONIBLES (multi-selección + totales)
// ════════════════════════════════════════════════════════

// Buffer con los documentos que devolvió HANA en la última búsqueda.
var _docsModal = [];
// Orden de la columna Fecha: true = más recientes primero (default,
// igual que el ORDER BY DocDate DESC del backend).
var _ordenFechaDesc = true;

// ════════════════════════════════════════════════════════
// Render de la tabla del modal a partir de _docsModal.
// Extraído a función para poder re-pintar al reordenar sin
// duplicar el markup. Preserva las selecciones por NoDocumento
// (los índices cambian al ordenar; el número de documento no).
// ════════════════════════════════════════════════════════
function PintarTablaModalDocs() {
    var tbody = $("#tbodyModalDocs");

    // 1. Guardar qué documentos estaban marcados (por su clave natural)
    var marcados = {};
    $("#tbodyModalDocs .chk-doc:checked").each(function () {
        var d = _docsModal[parseInt($(this).data("idx"), 10)];
        if (d) marcados[d.NoDocumento] = true;
    });

    // 2. Ordenar el buffer por fecha (FmtFecha da "yyyy-mm-dd":
    //    comparación de strings = comparación cronológica)
    _docsModal.sort(function (a, b) {
        var fa = FmtFecha(a.FechaDoc), fb = FmtFecha(b.FechaDoc);
        if (fa === fb) return 0;
        return (_ordenFechaDesc ? (fa > fb ? -1 : 1) : (fa > fb ? 1 : -1));
    });

    // 3. Actualizar la flecha del encabezado
    $("#flechaOrdenFecha").text(_ordenFechaDesc ? "▼" : "▲");

    // 4. Pintar las filas
    tbody.empty();
    var saldoTotal = 0;

    $.each(_docsModal, function (i, d) {
        var saldoDoc = (parseFloat(d.MontoFact || 0) - parseFloat(d.Pagado || 0));
        var pendiente = parseFloat(d.MontoPendiente || 0);
        var disponible = saldoDoc - pendiente;      // "Saldo por confirmar"
        var agotado = disponible <= 0.009;       // 0 o negativo: nada cobrable
        var sel = !agotado && marcados[d.NoDocumento] === true;
        saldoTotal += saldoDoc;

        tbody.append(
            '<tr data-idx="' + i + '"' +
            ' class="' + (agotado ? 'row-agotada' : (sel ? 'row-sel' : '')) + '"' +
            (agotado ? ' title="Sin saldo por confirmar: el monto ya está comprometido en recibos en tránsito. Revise los recibos pendientes de este documento."' : '') +
            '>' +
            '<td style="text-align:center;">' +
            '<input type="checkbox" class="chk-doc" data-idx="' + i + '" ' +
            'data-disp="' + disponible + '"' +
            (agotado ? ' disabled' : '') + (sel ? ' checked' : '') + ' />' +
            '</td>' +
            '<td><strong>' + (d.NoDocumento || '') + '</strong></td>' +
            '<td>' + FmtFecha(d.FechaDoc) + '</td>' +
            '<td class="text-right">' + FmtNum(d.MontoFact) + '</td>' +
            '<td class="text-right">' + FmtNum(d.Pagado) + '</td>' +
            '<td class="text-right col-saldo" data-saldo="' + saldoDoc + '">' + FmtNum(saldoDoc) + '</td>' +
            '<td class="text-right col-pendiente' + (pendiente > 0 ? '' : ' sin-pend') + '"' +
            (d.PendienteRecibos
                ? ' title="Comprometido en: ' + d.PendienteRecibos + '"'
                : '') + '>' +
            FmtNum(pendiente) +
            (d.PendienteRecibos && d.PendienteRecibos.indexOf("DESCUADRE") !== -1
                ? ' <span style="color:#e74c3c;" title="Incluye recibo(s) con DESCUADRE en SAP">⚠</span>'
                : '') +
            '</td>' +
            '<td class="text-right col-disponible' + (agotado ? ' agotado' : '') + '">' +
            FmtNum(disponible) + '</td>' +
            '<td><span class="label label-info">' + (d.Moneda || '') + '</span></td>' +
            '<td><span class="fel-badge">' + (d.FelSerie || '—') + '</span></td>' +
            '<td><span class="fel-badge">' + (d.FelNumero || '—') + '</span></td>' +
            '</tr>'
        );
    });

    // 5. Resumen y estado de controles
    $("#resTotalDocs").text(_docsModal.length);
    $("#resSaldoTotal").text(FmtMoneda(saldoTotal));
    ActualizarSeleccionDocs();
    SincronizarChkTodos();
}

// Click en el encabezado "Fecha" → alternar orden y re-pintar
$(document).on("click", "#thFechaDocs", function () {
    if (!_docsModal.length) return;   // tabla vacía: nada que ordenar
    _ordenFechaDesc = !_ordenFechaDesc;
    PintarTablaModalDocs();
});

$("#btnBuscarDoc").on("click", function () {
    var tipo = $("#cboTipoDoc").val();
    if (!Estado.empresa || !Estado.clienteId || !tipo) {
        toastr.warning("Seleccione empresa, cliente y tipo de documento primero.");
        return;
    }
    // Guarda de servidor-de-pobre: aunque el botón esté disabled, un
    // trigger("click") programático llegaría igual hasta acá.
    if (EsTipoSinDocumento(tipo)) {
        toastr.info("Para " + tipo + " no se busca un documento específico: " +
            "solo indique monto y moneda.");
        return;
    }

    // Reset UI del modal
    _docsModal = [];
    _ordenFechaDesc = true;   // ← NUEVO: cada búsqueda arranca en "más recientes"
    $("#chkTodosDocs").prop("checked", false);
    $("#btnAgregarSeleccionados").prop("disabled", true);
    $("#resTotalDocs").text("0");
    $("#resSaldoTotal").text(FmtMoneda(0));
    $("#resSaldoSel").html(FmtMoneda(0) + ' <small style="font-size:11px;color:#7f8c8d;">(0)</small>');
    $("#barAnticipos").hide();   // ← NUEVO: cada búsqueda arranca sin barra

    $("#tbodyModalDocs").html(
        '<tr><td colspan="11" class="text-center" style="padding:28px;">' +
        '<i class="icon-spinner icon-spin icon-2x" style="color:#27ae60;"></i>' +
        '<div style="margin-top:8px;color:#7f8c8d;">Consultando documentos...</div></td></tr>');
    $("#modalBuscarDoc").modal("show");

    $.get(URL_DOCS, {
        empresa: Estado.empresa,
        clienteId: Estado.clienteId,
        tipoDoc: tipo
    }, function (resp) {
        var tbody = $("#tbodyModalDocs");

        if (!resp.ok) {
            tbody.html('<tr><td colspan="11" class="text-center text-danger" style="padding:20px;">' + resp.msg + '</td></tr>');
            return;
        }
        if (!resp.data || resp.data.length === 0) {
            tbody.html('<tr><td colspan="11" class="text-center" style="padding:24px; color:#aaa;">Sin documentos disponibles para este cliente</td></tr>');
            return;
        }

        _docsModal = resp.data;
        PintarTablaModalDocs();
        PintarBarAnticipos(resp.anticipos);   // ← NUEVO

        ActualizarSeleccionDocs();
    });
});

// Click en la fila → togglear su checkbox (salvo filas agotadas)
$(document).on("click", "#tbodyModalDocs tr[data-idx]", function (e) {
    if ($(e.target).is(".chk-doc")) return;
    var chk = $(this).find(".chk-doc");
    if (chk.is(":disabled")) return;   // sin saldo por confirmar: no seleccionable
    chk.prop("checked", !chk.prop("checked")).trigger("change");
});

// Cambio en un checkbox individual
$(document).on("change", ".chk-doc", function () {
    var $tr = $(this).closest("tr");
    $tr.toggleClass("row-sel", $(this).prop("checked"));
    ActualizarSeleccionDocs();
    SincronizarChkTodos();
});

// "Seleccionar todos" — solo marca las filas CON saldo por confirmar
$(document).on("change", "#chkTodosDocs", function () {
    var marcar = $(this).prop("checked");
    $("#tbodyModalDocs .chk-doc:not(:disabled)").each(function () {
        $(this).prop("checked", marcar)
            .closest("tr").toggleClass("row-sel", marcar);
    });
    ActualizarSeleccionDocs();
});

// Recalcula el resumen de seleccionados y habilita el botón.
// Suma el SALDO POR CONFIRMAR (data-disp), que es lo que realmente
// se cargará como monto al agregar los documentos.
function ActualizarSeleccionDocs() {
    var dispSel = 0, n = 0;
    $("#tbodyModalDocs .chk-doc:checked").each(function () {
        dispSel += parseFloat($(this).data("disp")) || 0;
        n++;
    });
    $("#resSaldoSel").html(FmtMoneda(dispSel) +
        ' <small style="font-size:11px;color:#7f8c8d;">(' + n + ')</small>');
    $("#btnAgregarSeleccionados").prop("disabled", n === 0);
}

// Mantiene el "seleccionar todos" coherente (ignora las agotadas)
function SincronizarChkTodos() {
    var total = $("#tbodyModalDocs .chk-doc:not(:disabled)").length;
    var marcados = $("#tbodyModalDocs .chk-doc:checked").length;
    $("#chkTodosDocs").prop("checked", total > 0 && marcados === total);
}

// Agregar seleccionados:
//   1 documento  → lo carga al panel editable (el usuario ajusta el monto)
//   2+ documentos → cobro masivo directo a la tabla (monto = saldo)
$("#btnAgregarSeleccionados").on("click", function () {
    var tipo = $("#cboTipoDoc").val();
    var indices = [];
    $("#tbodyModalDocs .chk-doc:checked").each(function () {
        indices.push(parseInt($(this).data("idx"), 10));
    });
    if (!indices.length) { toastr.info("No hay documentos seleccionados."); return; }

    // ── 1 SOLO documento: cargar al panel editable ──
    if (indices.length === 1) {
        CargarDocEnPanel(_docsModal[indices[0]]);
        $("#modalBuscarDoc").modal("hide");
        toastr.info("Documento cargado. Ajuste el monto y presione Agregar Documento.");
        return;
    }

    // ── 2+ documentos: cobro masivo ──
    var agregados = 0, duplicados = 0, distintaMoneda = 0;

    indices.forEach(function (idx) {
        var d = _docsModal[idx];
        if (!d) return;

        var moneda = d.Moneda || "GTQ";
        var saldo = parseFloat(d.MontoFact || 0) - parseFloat(d.Pagado || 0);
        var disponible = saldo - parseFloat(d.MontoPendiente || 0);
        if (disponible <= 0) return;   // defensivo: no debería llegar (checkbox disabled)

        var yaExiste = Estado.documentos.some(function (x) {
            return x.NoDocumento === d.NoDocumento;
        });
        if (yaExiste) { duplicados++; return; }

        if (Estado.monedaDoc && Estado.monedaDoc !== moneda) { distintaMoneda++; return; }
        if (!Estado.monedaDoc) Estado.monedaDoc = moneda;

        Estado.documentos.push({
            TipoDoc: tipo,
            NoDocumento: d.NoDocumento,
            FechaDoc: FmtFecha(d.FechaDoc),
            Status: "",
            Monto: Math.round(disponible * 100) / 100,   // ← Saldo por confirmar, no el saldo bruto
            Moneda: moneda,
            MontoFact: parseFloat(d.MontoFact || 0),
            Pagado: parseFloat(d.Pagado || 0),
            FelSerie: d.FelSerie || "",
            FelNumero: d.FelNumero || ""
        });
        agregados++;
    });

    $("#spanMonedaDoc").text(Estado.monedaDoc || "—");
    RenderizarTablaDocumentos();
    ActualizarTotales();

    if (agregados) toastr.success(agregados + " documento(s) agregado(s).");
    if (duplicados) toastr.warning(duplicados + " ya estaban agregados (omitidos).");
    if (distintaMoneda) toastr.error(distintaMoneda + " omitido(s) por moneda distinta a " + Estado.monedaDoc + ".");

    $("#modalBuscarDoc").modal("hide");
});

// Carga un documento en el panel editable "Detalle de Documentos".
// Reutilizado por: selección única en el modal, y edición de fila.
// - Desde el modal (objeto HANA crudo, sin 'Monto'): precarga el
//   SALDO POR CONFIRMAR (saldo − recibos en tránsito), clampado a 0.
// - Desde editar fila (objeto de Estado.documentos): respeta el 'Monto' guardado.
function CargarDocEnPanel(d) {
    if (!d) return;
    var saldo = parseFloat(d.MontoFact || 0) - parseFloat(d.Pagado || 0);
    var disponible = saldo - parseFloat(d.MontoPendiente || 0);
    if (disponible < 0) disponible = 0;   // negativo: nada que precargar
    // (la validación monto<=0 impide agregarlo)

    $("#txtNoDocDoc").val(d.NoDocumento);
    $("#dtpFechaDoc").val(FmtFecha(d.FechaDoc));
    $("#txtSerieFel").val(d.FelSerie || "");
    $("#txtNumFel").val(d.FelNumero || "");
    $("#txtTotalFact").val(FmtNum(d.MontoFact));
    $("#txtPagado").val(FmtNum(d.Pagado));
    $("#txtMontoDoc").val(FmtNum(d.Monto != null ? d.Monto : disponible));
    $("#cboMonedaDoc").val(d.Moneda || "GTQ");
    $("#cboMonedaDoc").data("monedaPrev", d.Moneda || "GTQ");

    if ($("#cboMonedaDoc").hasClass("search-select") && $.fn.select2) {
        $("#cboMonedaDoc").trigger("change.select2");
    }
}

// ════════════════════════════════════════════════════════
// 8. AGREGAR / ACTUALIZAR DOCUMENTO
// ════════════════════════════════════════════════════════
$("#btnAgregarDoc").on("click", function () {
    var tipo = $("#cboTipoDoc").val();
    var nodoc = $("#txtNoDocDoc").val().trim();
    var fecha = $("#dtpFechaDoc").val();
    var monto = parseFloat($("#txtMontoDoc").val()) || 0;
    var moneda = $("#cboMonedaDoc").val();
    var esSinDoc = EsTipoSinDocumento(tipo);   // ← ANTICIPO / DIFERENCIA / SALDO PEND.
    var editando = (Estado.docEditIndex !== null);

    if (!tipo || monto <= 0) {
        toastr.warning("Tipo de documento y monto son obligatorios.");
        return;
    }
    if (!esSinDoc && !nodoc) {
        toastr.warning("Ingrese el número de documento.");
        return;
    }
    // Duplicado: ignoramos la propia fila cuando estamos editando.
    // Los tipos sin documento quedan fuera del chequeo a propósito:
    // su NoDocumento es "" y se podrían capturar VARIAS diferencias
    // en el mismo recibo (una por moneda, por ejemplo).
    var dupIdx = -1;
    for (var i = 0; i < Estado.documentos.length; i++) {
        if (Estado.documentos[i].NoDocumento === nodoc) { dupIdx = i; break; }
    }
    if (!esSinDoc && dupIdx !== -1 && dupIdx !== Estado.docEditIndex) {
        toastr.warning("El documento " + nodoc + " ya está agregado.");
        return;
    }
    // Validación de moneda consistente (solo si hay otros docs distintos a esta fila)
    if (Estado.monedaDoc && Estado.monedaDoc !== moneda) {
        var hayOtros = false;
        for (var j = 0; j < Estado.documentos.length; j++) {
            if (j !== Estado.docEditIndex) { hayOtros = true; break; }
        }
        if (hayOtros) {
            toastr.error("Todos los documentos deben tener la misma moneda (" + Estado.monedaDoc + ").");
            return;
        }
    }

    var docObj = {
        TipoDoc: tipo,
        NoDocumento: esSinDoc ? "" : nodoc,
        FechaDoc: esSinDoc ? "" : fecha,
        Status: "",
        Monto: monto,
        Moneda: moneda,
        MontoFact: parseFloat($("#txtTotalFact").val()) || 0,
        Pagado: parseFloat($("#txtPagado").val()) || 0,
        FelSerie: $("#txtSerieFel").val().trim(),
        FelNumero: $("#txtNumFel").val().trim()
    };

    if (editando) {
        // ── ACTUALIZAR la fila existente ──
        Estado.documentos[Estado.docEditIndex] = docObj;
        if (!Estado.monedaDoc) Estado.monedaDoc = moneda;
        toastr.success("Documento actualizado.");
        SalirModoEdicionDoc();
    } else {
        // ── ALTA nueva ──
        if (!Estado.monedaDoc) Estado.monedaDoc = moneda;
        Estado.documentos.push(docObj);
    }

    $("#spanMonedaDoc").text(Estado.monedaDoc || moneda || "—");

    if (!Estado.documentos.length) Estado.monedaDoc = "";

    RenderizarTablaDocumentos();
    ActualizarTotales();
    LimpiarDetalleDoc();
});

// Botón "Cancelar edición" → descarta cambios y vuelve a modo alta
$("#btnCancelarEdicionDoc").on("click", function () {
    SalirModoEdicionDoc();
    LimpiarDetalleDoc();
    toastr.info("Edición cancelada.");
});

// Sale del modo edición: restaura el botón a "Agregar Documento"
function SalirModoEdicionDoc() {
    Estado.docEditIndex = null;
    $("#btnAgregarDoc").html('<i class="icon-plus"></i> Agregar Documento')
        .removeClass("btn-warning").addClass("btn-success");
    $("#btnCancelarEdicionDoc").hide();
    $("#panelDocs").removeClass("editando");
    $("#tbodyDocs tr").removeClass("seleccionada");
}

// ════════════════════════════════════════════════════════
// 9. QUITAR DOCUMENTO
// ════════════════════════════════════════════════════════
$("#btnQuitarDoc").on("click", function () {
    var idx = $("#tbodyDocs tr.seleccionada").data("idx");
    if (idx === undefined) { toastr.info("Seleccione una fila para quitar."); return; }

    // Si quitamos la fila que estábamos editando, salimos del modo edición
    if (Estado.docEditIndex === idx) {
        SalirModoEdicionDoc();
        LimpiarDetalleDoc();
    }

    Estado.documentos.splice(idx, 1);
    if (Estado.documentos.length === 0) {
        Estado.monedaDoc = "";
        $("#spanMonedaDoc").text("—");
    }
    // Reajustar el índice de edición si quedó desfasado por el splice
    if (Estado.docEditIndex !== null && idx < Estado.docEditIndex) {
        Estado.docEditIndex--;
    }
    RenderizarTablaDocumentos();
    ActualizarTotales();
});

$(document).on("click", "#tbodyDocs tr", function () {
    $("#tbodyDocs tr").removeClass("seleccionada");
    $(this).addClass("seleccionada");
});

// Click en el lápiz → cargar la fila en el panel en MODO EDICIÓN
$(document).on("click", ".btn-editDoc", function (e) {
    e.stopPropagation();  // no dispara el click de selección de fila
    var idx = parseInt($(this).data("idx"), 10);
    var d = Estado.documentos[idx];
    if (!d) return;

    // Activar modo edición ANTES de tocar el combo (para que el change no limpie)
    Estado.docEditIndex = idx;

    // Reflejar el tipo en el combo (el handler de la sección 4 hace return
    // porque docEditIndex != null, así que no limpia ni reabre el modal)
    $("#cboTipoDoc").val(d.TipoDoc);
    if ($("#cboTipoDoc").hasClass("search-select") && $.fn.select2) {
        $("#cboTipoDoc").trigger("change.select2");
    }

    // ← NUEVA: el change hizo return, así que el bloqueo lo aplicamos a mano.
    // Sin esto, editar una DIFERENCIA mostraba No.Documento/Fecha/FEL editables.
    AplicarBloqueoTipoDoc(d.TipoDoc);

    // Cargar los valores al panel (respeta el Monto que el usuario ya tenía)
    CargarDocEnPanel(d);

    // Cambiar el botón a modo "Actualizar" + mostrar "Cancelar edición"
    $("#btnAgregarDoc").html('<i class="icon-ok"></i> Actualizar Documento')
        .removeClass("btn-success").addClass("btn-warning");
    $("#btnCancelarEdicionDoc").show();
    $("#panelDocs").addClass("editando");

    // Resaltar la fila en edición
    $("#tbodyDocs tr").removeClass("seleccionada");
    $(this).closest("tr").addClass("seleccionada");

    toastr.info("Editando documento " + (d.NoDocumento || "") + ". Ajuste y presione Actualizar.");
});

// ════════════════════════════════════════════════════════
// 10. GUARDAR
// ════════════════════════════════════════════════════════
$("#btnGuardar").on("click", function () {
    if (!Estado.codigoUsuario) { toastr.error("Seleccione el operador con el que emitirá."); return; }
    if (!Estado.deptoOperador) { toastr.error("El operador seleccionado no tiene serie/depto asignado."); return; }
    if (!Estado.cobros.length)     { toastr.error("Agregue al menos un cobro.");    return; }
    if (!Estado.documentos.length) { toastr.error("Agregue al menos un documento."); return; }
    if (Estado.encabezadoEditable && !$("#txtNombreCliente").val().trim()) {
        toastr.error("Escriba el nombre del cliente en el encabezado.");
        $("#txtNombreCliente").focus();
        return;
    }

    var tC    = Estado.cobros.reduce(function (s, c) { return s + c.Monto; }, 0);
    var tD    = Estado.documentos.reduce(function (s, d) { return s + d.Monto; }, 0);
    var saldo = tC - tD;

    if (Estado.monedaCobro !== Estado.monedaDoc && saldo !== 0) {
        if (!confirm("⚠ Monedas diferentes (Cobro: " + Estado.monedaCobro +
                     " / Doc: " + Estado.monedaDoc + ").\n¿Desea guardar de todas formas?")) return;
    }
    if (!confirm("¿Confirmar guardado del recibo?")) return;

    var payload = {
        IdEmpresa:     Estado.empresa,
        FechaRecibo:   $("#fechaRecibo").val(),
        IdCliente:     Estado.clienteId,
        NombreCliente: $("#txtNombreCliente").val(),
        Direccion:     $("#txtDireccion").val(),
        Nit:           $("#txtNit").val(),
        // Modo normal: agente del cliente elegido en el typeahead (hidden).
        // Modo SALA DE VENTAS: lo que el usuario escribió en el campo visible.
        Agente: Estado.encabezadoEditable ? $("#txtAgente").val() : $("#hdnAgente").val(),
        Correo:        $("#txtCorreo").val(),
        Moneda:        $("#txtMoneda").val(),
        RecFisico:     $("#txtRecFisico").val(),
        CodigoUsuario: Estado.codigoUsuario,   // ← NUEVO
        Cobros:        Estado.cobros,
        Documentos: Estado.documentos,
        TipoCambio: Estado.tipoCambio,
    };

    $("#btnGuardar").prop("disabled", true)
        .html('<i class="icon-spinner icon-spin"></i> Guardando...');

    $.ajax({
        url: URL_GUARDAR, type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (resp) {
            if (resp.ok) {
                toastr.success("✅ Recibo " + resp.idRecibo + " guardado correctamente.");
                Estado.idReciboGuardado = resp.idRecibo;
                $("#txtIdRecibo").val(resp.idRecibo);
                $("#badgeStatus").text("GUARDADO")
                    .removeClass("nuevo").addClass("guardado");
                SetBotonesPostGuardado();
                AbrirImpresion(resp.idRecibo, Estado.empresa);
            } else {
                toastr.error(resp.msg);
                $("#btnGuardar").prop("disabled", false)
                    .html('<i class="icon-save"></i> Guardar');
            }
        },
        error: function () {
            toastr.error("Error de conexión al guardar. Intente nuevamente.");
            $("#btnGuardar").prop("disabled", false)
                .html('<i class="icon-save"></i> Guardar');
        }
    });
});

