@model DiamDev.Give.Entities.Reparacion

@{
    ViewBag.Title = "Editar Reparación";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Editar Reparaci&oacute;n
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Editar Reparaci&oacute;n</h2>
                <p>
                    Editar una reparaci&oacute;n.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="ReparacionId" name="ReparacionId" value="@Html.Raw(Model.ReparacionId)" />
                        <input type="hidden" id="AgenciaId" name="AgenciaId" value="@Html.Raw(Model.AgenciaId)" />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Agencia
                                </label>
                                <br />
                                <strong>
                                    @(Model.Agencia == null ? "No Disponible" : Model.Agencia.Nombre)
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Cliente
                                </label>
                                <br />
                                <strong>
                                    @(Model.Cliente == null ? "No Disponible" : Model.Cliente.Nombre)
                                </strong>
                            </div>                          
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha
                                </label>
                                <br />
                                <strong>
                                    @Model.Fecha.ToString("dd/MM/yyyy")
                                </strong>
                            </div>
                        </div>                        
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Verificar SERIAL/MAC/ID</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    SERIAL/MAC/ID<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.IMEI, new { @class = "form-control", @placeholder = "SERIAL/MAC/ID", autocomplete = "off", required = "required" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Reparaci&oacute;n</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Marca y Modelo<span class="symbol required"></span>
                                </label>
                                @Html.TextAreaFor(model => model.Marca, new { @class = "form-control", @placeholder = "Marca y Modelo", autocomplete = "off", required = "required" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Falla Reportada<span class="symbol required"></span>
                                </label>
                                @Html.TextAreaFor(model => model.Falla, new { @class = "form-control", @placeholder = "Falla Reportada", required = "required", autocomplete = "off" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Descripci&oacute;n
                                </label>
                                @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Golpes , Daños y estado fisico del dispositivo", autocomplete = "off" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Garant&iacute;a
                                </label>
                                @Html.TextAreaFor(model => model.Garantia, new { @class = "form-control", @placeholder = "Garantía", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Estimada de Entrega<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaEntrega" name="FechaEntrega" autocomplete="off" value="@Model.FechaEntrega.ToString("yyyy-MM-dd")" required>
                                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Posibles Evaluaciones</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Servicio
                                </label>
                                @Html.DropDownList("ServicioId", (SelectList)ViewBag.Servicios, "--Seleccione un Servicio--", new { @class = "form-control search-select" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label class="control-label">
                                    Nota
                                </label>
                                <input type="text" placeholder="Nota" class="form-control" id="Nota" name="Nota" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">
                                    Buen Estado
                                </label>
                                <div>
                                    <label class="radio-inline">
                                        <input type="radio" class="grey" value="true" checked="checked" name="servicio" id="ServicioSi">
                                        Estado Bueno
                                    </label>
                                    <label class="radio-inline">
                                        <input type="radio" class="grey" value="false" name="servicio" id="ServicioNo">
                                        Estado Malo
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
                            <table class="table table-hover" id="sample-table-1">
                                <thead>
                                    <tr>
                                        <th>Servicio</th>
                                        <th>Nota</th>
                                        <th>Buen Estado</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="reparacion_tbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i> Productos
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Barra
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                                    <span class="input-group-btn">
                                        <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="imagen">
                        <div class="row">
                            <div class="col-md-12">
                                <button type="button" class="btn btn-med-grey btn-block ladda-button" data-toggle="modal" data-target="#visualizar-imagen-producto-form" id="btn-visualizar">Visualizar Fotografía</button>
                            </div>
                        </div>
                        <br />
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Producto
                                </label>
                                <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" disabled="disabled" />
                                <input type="hidden" id="ProductoId" name="ProductoId" value="0" />
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Unidad
                                </label>
                                <select id="PresentacionId" name="PresentacionId" class="form-control search-select">
                                    <option value="0">--SELECCIONE UNA UNIDAD--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">
                                    Cantidad
                                </label>
                                <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">
                                    Existencia
                                </label>
                                <input type="number" placeholder="Existencia" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon">Q</span>
                                    <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <p style="text-align:right"><button id="btnNuevoProducto" name="btnNuevoProducto" class="demo btn btn-blue">Nuevo Producto</button></p>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio</th>
                                        <th>Sub-Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="producto_tbody">
                                    @if (Model.Piezas != null && Model.Piezas.Count() > 0)
                                    {
                                        foreach (var Detalle in Model.Piezas)
                                        {
                                            <tr>
                                                <td>
                                                    @(Detalle.Producto == null ? "No Disponible" : Detalle.Producto.Nombre)
                                                </td>
                                                <td>
                                                    @Detalle.Cantidad
                                                </td>
                                                <td>
                                                    @Detalle.Precio.ToString("C")
                                                </td>
                                                <td>
                                                    @string.Format("{0:C}", Detalle.Cantidad * Detalle.Precio)
                                                </td>
                                                <td>
                                                    <a href="@Detalle.ProductoId" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td>
                                                <div style="text-align:left; font-size:large; font-weight:bold;">
                                                    Total:
                                                </div>
                                            </td>
                                            <td colspan="4">
                                                <div style="text-align: right;font-size:large; font-weight:bold;">
                                                    @string.Format("{0:C}", Model.Piezas.Sum(x => x.Cantidad * x.Precio))
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <strong>No contiene productos</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Precio Reparaci&oacute;n</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Precio<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-addon">Q</span>
                                    @Html.TextBoxFor(model => model.Costo, new { @class = "form-control", @placeholder = "Precio de la Reparación", autocomplete = "off", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <h2><i class="icon-edit-sign teal"></i>Políticas</h2>
                            <hr>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">
                            Política
                        </label>
                        @Html.DropDownList("PoliticaId", (SelectList)ViewBag.Politicas, "--Seleccione una Politica--", new { @class = "form-control search-select" })
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-politica">Agregar</button></p>
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Política</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="politica_tbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="javascript:window.history.back();">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<div id="visualizar-imagen-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Fotografia</h4>
    </div>
    <div class="modal-body">
        <center>
            <img alt="" id="fotografia" src="@Url.Content("~/Content/assets/images/producto-sin-foto.jpg")" style="height:50%; width:50%" class="img-responsive" />
        </center>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-imagen-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>
<div id="seleccionar-producto-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Producto</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover" id="sample-table-1">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="producto_seleccionado_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-producto" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="reparacion_tr_template">
        <tr>
            <td>{{servicio}}</td>
            <td>{{nota}}</td>
            <td>{{estado}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="servicioIds" value="{{servicio_id}}" />
                <input type="hidden" name="notaIds" value="{{nota_id}}" />
                <input type="hidden" name="estadoIds" value="{{estado_id}}" />
            </td>
        </tr>
    </script>
    <script type="text/html" id="politica_tr_template">
        <tr>
            <td>{{politica}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="politicaIdIds" value="{{politica_id}}" />
                <input type="hidden" name="politicaIds" value="{{politica}}" />
            </td>
        </tr>
    </script>

    <script type="text/javascript">

    var vCodBarra = "";

    var vAumentaCantidad = 0;

    var servicioSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.servicioIds))');
    var notaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.notaIds))');
    var estadoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.estadoIds))');

    var politicaIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.politicaIdIds))');
    var politicaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.politicaIds))');

    $(function () {
        //Se oculta el boton de visualizar imagen
        $('#imagen').css("display", "none");

        $('#producto_tbody').delegate("a", "click", function (e) {
            e.preventDefault();

            eliminar = confirm("¿Deseas eliminar este registro?");
            if (eliminar) {
                $.ajax({
                    url: '@Url.Action("EliminarPieza", "Reparacion")',
                    data: { 'reparacionId': $("#ReparacionId").val(), 'agenciaId': $("#AgenciaId").val(), 'productoId': $(this).attr("href") },
                    traditional: true,
                    async: false,
                    type: 'POST',
                    success: function (resultData) {
                        if (resultData !== null) {
                            if (resultData.Operacion) {
                                toastr.success('La pieza se elimino exitosamente');
                            }
                            else {
                                toastr.error('Ocurrió un error, al eliminar la pieza');
                            }

                            window.location.href = '@Url.Action("Editar", "Reparacion")';
                        }
                        else {
                            toastr.error('Ocurrió un error, al eliminar la pieza');
                        }
                    }
                });
            }
        });

        $('#PresentacionId').change(function (evt) {
            if ($('#ProductoId').val() === "") {
                error("Seleccionar un producto");
                return;
            }

            if ($('#PresentacionId').val() === "") {
                error("Seleccionar una presentacion");
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerProducto", "Producto")',
                traditional: true,
                async: false,
                data: { 'agenciaId': $('#AgenciaId').val(), 'productoId': $('#ProductoId').val(), 'presentacionId': $('#PresentacionId').val(), 'empleado': false },
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            $('#Existencia').val(resultData.Data.Existencia);
                            $('#PrecioActual').val(resultData.Data.PrecioActual);
                            $('#Cantidad').focus();

                            if (parseFloat(resultData.Data.Existencia) === 0) {

                                document.getElementById('Existencia').style.backgroundColor = "#F78181";
                            }
                            else {
                                document.getElementById('Existencia').removeAttribute("style");
                            }
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                    }
                }
            });
        });

        $("#btnNuevoProducto").click(function (evt) {
            evt.preventDefault();

            var producto_id = $('#ProductoId').val();
            var producto = $('#Producto').val();

            if (producto_id === "" || producto === "") {
                error("Seleccione un producto");
                return;
            }

            var cantidad = $("#Cantidad").val();

            if (cantidad === "") {
                error("Ingrese la cantidad del producto");
                return;
            }

            var precio = $("#PrecioActual").val();

            if (precio === "") {
                error("Ingrese el precio del producto");
                return;
            }

            var existencia_id = parseInt($("#Existencia").val());
            cantidad = parseInt(cantidad);

            if (cantidad <= 0) {
                error("La cantidad ingresada no puede ser 0");
                return;
            }

            if (cantidad > existencia_id) {
                error("La cantidad ingresada es mayor a la existencia");
                return;
            }

            var modelo =
            {
                'ReparacionId': $("#ReparacionId").val(),
                'ProductoId': producto_id,
                'Cantidad': cantidad,
                'Precio': precio
            };

            $.ajax({
                url: '@Url.Action("NuevoProducto", "Reparacion")',
                data: { 'modelo': modelo },
                async: false,
                type: 'POST',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            toastr.success('El nuevo producto se guardó exitosamente');
                        }
                        else {
                            toastr.error('Ocurrió un error, al guardar el nuevo producto');
                        }

                        window.location.href = '@Url.Action("Editar", "Reparacion")';
                        }
                        else
                        {
                            toastr.error('Ocurrió un error, al guardar el nuevo producto');
                        }
                    }
                });
            });

            function error(texto)
            {
                toastr.error(texto);
            }

            function cargaServicio(servicio_id, servicio, nota_id, estado_id)
            {
                var plantilla = $('#reparacion_tr_template').html();

                var modelo =
                {
                    servicio_id: servicio_id,
                    servicio: servicio,
                    nota_id: nota_id,
                    nota: nota_id,
                    estado_id: estado_id,
                    estado: estado_id
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#reparacion_tbody').append(filaHtml);
            }

            function cargaPolitica(politica_id, politica)
            {
                var plantilla = $('#politica_tr_template').html();

                var modelo =
                {
                    politica_id: politica_id,
                    politica: politica
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#politica_tbody').append(filaHtml);
            }

            renderizarServiciosIniciales();
            renderizarPoliticasIniciales();

            $('#btn-agregar').click(function (e) {
                e.preventDefault();

                var servicio_id = $('#ServicioId').val();
                var servicio = $('#ServicioId option:selected').text();

                if (servicio_id === "" || servicio === "") {
                    error("Seleccione un servicio");
                    return;
                }

                var nota_id = $('#Nota').val();

                var estado = $('input[name=servicio]:checked', '#formaprincipal').val();
                var estado_id = 'Estado Malo';

                if (estado === "true" || estado === true)
                {
                    estado_id = 'Estado Bueno';
                }

                cargaServicio(servicio_id, servicio, nota_id, estado_id);

                $("#ServicioId").val(0);
                $("#Nota").val('');
                $("#ServicioSi").attr('checked', true);
                $("#ServicioId").focus();
            });

            $('#btn-agregar-politica').click(function (e)
            {
                e.preventDefault();

                var politica_id = $('#PoliticaId').val();
                var politica = $('#PoliticaId option:selected').text();

                if (politica_id === "" || politica === "") {
                    error("Seleccione una política");
                    return;
                }

                cargaPolitica(politica_id, politica);

                $("#PoliticaId").val(0)
                $("#PoliticaId").focus();
            });

            $('#reparacion_tbody').delegate("a", "click", function (e) {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            $('#politica_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            function renderizarServiciosIniciales() {
                if (servicioSeleccionados == null) {
                    return;
                }

                // recorremos los servicios que haya ingresado el usuario
                for (var i = 0; i < servicioSeleccionados.length; i++) {
                    var servicio_id = servicioSeleccionados[i];
                    var servicio = $('#ServicioId option[value=' + servicio_id + ']').text();

                    var nota_id = notaSeleccionados[i];
                    var estado = estadoSeleccionados[i];

                    var estado_id = 'Estado Malo';

                    if (estado === "true" || estado === true || estado === "Estado Bueno") {
                        estado_id = 'Estado Bueno';
                    }

                    cargaServicio(servicio_id, servicio, nota_id, estado_id);
                }
            }

            function renderizarPoliticasIniciales()
            {
                if (politicaIdSeleccionados == null)
                {
                    return;
                }

                // recorremos las politicas que haya ingresado el usuario
                for (var i = 0; i < politicaIdSeleccionados.length; i++)
                {
                    var politica_id = politicaIdSeleccionados[i];
                    var politica = politicaSeleccionados[i];

                    cargaPolitica(politica_id, politica);
                }
            }

            $("#Barra").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("ConsultaProductoAutocomplementar", "Producto")',
                        type: "POST",
                        dataType: "json",
                        data: { search: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Nombre, value: item.Nombre };
                            }))
                        }
                    })
                },
                messages:
                {
                    noResults: "", results: ""
                }
            });

            $('#formaprincipal').keydown(function (evt) {
                if ($('#Barra').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    cargaBusquedaProducto(evt)
                }
                else if ($('#Cantidad').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    if ($('#Cantidad').val() === "") {
                        error("Ingresar cantidad de producto");
                        $('#Cantidad').focus();
                        return;
                    }

                    $('#DescuentoActual').focus();
                }
                else if ($('#DescuentoActual').is(":focus") && (evt.which || evt.keyCode) == 13) {
                    evt.preventDefault();
                    if ($('#DescuentoActual').val() === "") {
                        error("Ingresar descuento del producto");
                        $('#DescuentoActual').focus();
                        return;
                    }

                    $('#btn-agregar').focus();
                }
            });

            /*
            Evento click para el boton de busqueda de productos */
            $('#btnBarra').click(function (evt) {
                cargaBusquedaProducto(evt);
            });

            /*
         Evento click para el boton de visualizar imagen de productos */
            $('#btn-visualizar').click(function (evt) {
                if ($('#ProductoId').val() === "") {

                    error("Ingresar codigo de barra");
                    $('#Barra').focus();

                    return;
                }

                $.ajax({
                    url: '@Url.Action("ObtenerFotografiaProducto", "Producto")',
                    traditional: true,
                    data: { 'productoId': $('#ProductoId').val() },
                    async: false,
                    type: 'GET',
                    success: function (resultData) {
                        if (resultData !== null) {
                            if (resultData.Operacion) {
                                $("#visualizar-imagen-producto-form").find("#fotografia").attr("src", resultData.Data);
                            }
                        }
                    }
                });

            });

            $('#producto_seleccionado_tbody').delegate("a", "click", function (e) {
                e.preventDefault();

                $('#btn-close-up-seleccionar-producto').click();
                var productoReferencia = $(this).attr("href");
                var productoActual = productoReferencia.split(",");

                var modelo =
                 {
                     'ProductoId': productoActual[0],
                     'Nombre': productoActual[1]
                 };

                cargaProductoSeleccionado(modelo);
            });

            /*
            Función para la busqueda de productos */
            function cargaBusquedaProducto(evt) {
                evt.preventDefault();

                if ($('#Barra').val() === "") {
                    error("Ingresar codigo de barra");
                    $('#Barra').focus();
                    return;
                }

                if (vCodBarra === $('#Barra').val()) {
                    vAumentaCantidad = parseInt($('#Cantidad').val()) + 1;
                    $('#Cantidad').val(vAumentaCantidad);
                }
                else {
                    $('#Cantidad').val(1);
                }

                var barraActual = $('#Barra').val();
                barraActual = barraActual.replace(" ", "_");

                $.ajax({
                    url: '@Url.Action("ObtenerProductoxTextoLibre", "Producto")',
                    traditional: true,
                    data: { 'search': barraActual },
                    async: false,
                    type: 'GET',
                    success: function (resultData) {
                        if (resultData !== null) {
                            if (resultData.Operacion) {
                                if (resultData.Data.length === 1) {
                                    cargaProductoSeleccionado(resultData.Data[0]);
                                }
                                else if (resultData.Data.length > 1) {
                                    var fila = "";
                                    for (var i = 0; i < resultData.Data.length; i++) {
                                        fila += "<tr><td>" + resultData.Data[i].ProductoId + "</td>";
                                        fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                        fila += "<td><a href='" + resultData.Data[i].ProductoId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                    }

                                    $("#seleccionar-producto-form").modal();
                                    $("#seleccionar-producto-form").find("#producto_seleccionado_tbody").html(fila);
                                }
                            }
                            else {
                                toastr.error('La barra del producto ingresada no es correcta');
                                $('#Barra').val("");
                                $('#Barra').focus();
                            }
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                });
            }

            function cargaProductoSeleccionado(producto) {
                //Se activa el boton de visualizar fotografia
                $('#imagen').css("display", "block");

                $('#Producto').val(producto.Nombre);
                $('#ProductoId').val(producto.ProductoId);

                var PresentacionSelect = $("#PresentacionId");
                PresentacionSelect.empty();
                PresentacionSelect.append('<option value="0">--Seleccione una Unidad--</option>');

                $.ajax({
                    url: '@Url.Action("ObtenerPresentacionPorProducto", "Producto_Ingreso")',
                    data: { 'id': $('#ProductoId').val() },
                    traditional: true,
                    async: false,
                    type: 'GET',
                    success: function (data) {
                        var unidadActualId = 0;
                        $.each(data, function (j) {
                            unidadActualId = data[j]['Value'];
                            PresentacionSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                        });

                        //Se selecciona por default la primera unidad
                        $("#PresentacionId").val(unidadActualId).trigger("change");
                    }
                });

                $('#Barra').focus();
                vCodBarra = $('#Barra').val();
            }

        });
    </script>
}