@model DiamDev.Give.Entities.Reparacion

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Agencias</h2>
        <hr>
    </div>
</div>
<div class="form-group">
    <label class="control-label">
        Agencia<span class="symbol required"></span>
    </label>
    @Html.DropDownList("AgenciaId", (SelectList)ViewBag.Agencias, "--Seleccione una Agencia--", new { @class = "form-control search-select required" })
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="BuscarCliente" name="BuscarCliente" autocomplete="off" placeholder="Buscar Cliente...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBuscarCliente">Buscar</button>
                    <a href="#new-cliente-form" data-toggle="modal" class="demo btn btn-blue" style="margin-bottom: -1px;">
                        <i class="clip-plus-circle"></i>
                    </a>
                </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente<span class="symbol required"></span>
            </label>
            <input type="text" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" autocomplete="off" disabled="disabled" required />
            <input type="hidden" id="ClienteId" name="ClienteId" value="0" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Verificar SERIAL/MAC/ID</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                SERIAL/MAC/ID<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.IMEI, new { @class = "form-control", @placeholder = "SERIAL/MAC/ID", autocomplete = "off", required = "required" })
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Reparaci&oacute;n</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Marca y Modelo<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Marca, new { @class = "form-control", @placeholder = "Marca y Modelo", autocomplete = "off", required = "required" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Falla Reportada<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Falla, new { @class = "form-control", @placeholder = "Falla Reportada", required = "required", autocomplete = "off" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Descripci&oacute;n
            </label>
            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Golpes , Daños y estado fisico del dispositivo", autocomplete = "off" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Garant&iacute;a
            </label>
            @Html.TextAreaFor(model => model.Garantia, new { @class = "form-control", @placeholder = "Garantía", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Fecha Estimada de Entrega<span class="symbol required"></span>
            </label>
            <div class="input-group">
                <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaEntrega" name="FechaEntrega" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Posibles Evaluaciones</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Servicio
            </label>
            @Html.DropDownList("ServicioId", (SelectList)ViewBag.Servicios, "--Seleccione un Servicio--", new { @class = "form-control search-select" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-8">
        <div class="form-group">
            <label class="control-label">
                Nota
            </label>
            <input type="text" placeholder="Nota" class="form-control" id="Nota" name="Nota" autocomplete="off" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Buen Estado
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="true" checked="checked" name="servicio" id="ServicioSi">
                    Estado Bueno
                </label>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="false" name="servicio" id="ServicioNo">
                    Estado Malo
                </label>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Servicio</th>
                    <th>Nota</th>
                    <th>Buen Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="reparacion_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Documentos</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-imagen">Agregar</button></p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Archivo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tbl-archivos">
                @if (Model != null)
                {
                    if (Model.Imagenes != null && Model.Imagenes.Count() > 0)
                    {
                        foreach (var Detalle in Model.Imagenes)
                        {
                            <tr>
                                <td colspan="2">
                                    @Detalle.Nombre
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Productos
</h2>
<hr>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Barra
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBarra">Buscar</button>
                </span>
            </div>
        </div>
    </div>
</div>
<div id="imagen">
    <div class="row">
        <div class="col-md-12">
            <button type="button" class="btn btn-med-grey btn-block ladda-button" data-toggle="modal" data-target="#visualizar-imagen-producto-form" id="btn-visualizar">Visualizar Fotografía</button>
        </div>
    </div>
    <br />
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Producto
            </label>
            <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" disabled="disabled" />
            <input type="hidden" id="ProductoId" name="ProductoId" value="0" />
        </div>
        <div class="form-group">
            <label class="control-label">
                Unidad
            </label>
            <select id="PresentacionId" name="PresentacionId" class="form-control search-select">
                <option value="0">--SELECCIONE UNA UNIDAD--</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Existencia
            </label>
            <input type="number" placeholder="Existencia" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Precio
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" disabled="disabled" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-producto">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Sub-Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="producto_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Precio Reparaci&oacute;n</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Precio<span class="symbol required"></span>
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                @Html.TextBoxFor(model => model.CostoServicio, new { @class = "form-control", @placeholder = "Precio de la Reparación", autocomplete = "off", required = "required" })
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Políticas</h2>
        <hr>
    </div>
</div>
<div class="form-group">
    <label class="control-label">
        Política
    </label>
    @Html.DropDownList("PoliticaId", (SelectList)ViewBag.Politicas, "--Seleccione una Politica--", new { @class = "form-control search-select" })
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-politica">Agregar</button></p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Política</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="politica_tbody"></tbody>
        </table>
    </div>
</div>