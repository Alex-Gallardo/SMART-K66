@{
    ViewBag.Title = "Historial de Entrega";
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Historial de Entrega
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)"></a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Historial de Entrega</h2>
                <hr />
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Inicial <span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text"
                                           data-date-format="yyyy-mm-dd"
                                           data-date-viewmode="years"
                                           class="form-control date-picker"
                                           id="FechaInicial"
                                           name="FechaInicial"
                                           autocomplete="off"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required tabindex="1" />
                                    <span class="input-group-addon">
                                        <i class="icon-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Final <span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text"
                                           data-date-format="yyyy-mm-dd"
                                           data-date-viewmode="years"
                                           class="form-control date-picker"
                                           id="FechaFinal"
                                           name="FechaFinal"
                                           autocomplete="off"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required tabindex="2" />
                                    <span class="input-group-addon">
                                        <i class="icon-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Tienda <span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("CentroId", (SelectList)ViewBag.Centros,
                                    "--Seleccione una Tienda--",
                                    new { @class = "form-control search-select required" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <button data-style="slide-down"
                                    class="btn btn-med-grey btn-block ladda-button"
                                    id="Aceptar" type="button">
                                <span class="ladda-label">Generar</span>
                                <span class="ladda-spinner"></span>
                            </button>
                        </div>
                        <div class="col-md-6">
                            <a class="btn btn-med-grey btn-block"
                               href="@Url.Action("Index", "Reporte")">
                                Regresar <i class="icon-prev"></i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<table width="100%" height="100%">
    <tr>
        <td>
            <iframe id="myReport" width="100%" height="800px"></iframe>
        </td>
    </tr>
</table>

@section Scripts {
    <script type="text/javascript">
        $(function () {
            $("#myReport").hide();

            $("#Aceptar").on("click", function () {
                var FechaInicial = $("#FechaInicial").val();
                var FechaFinal   = $("#FechaFinal").val();
                var CentroId     = $("#CentroId").val();

                if (CentroId === "" || CentroId === null) {
                    toastr.error('Debe seleccionar una tienda');
                    return;
                }

                GenerarReporte(FechaInicial, FechaFinal, CentroId);
                $("#myReport").show();
            });
        });

        function GenerarReporte(FechaInicial, FechaFinal, CentroId) {
            // ⚠️ ReportID debe coincidir con el nombre exacto del .rdlc que crees
            document.getElementById("myReport").src =
                "@Url.Content("~/Reports/ReportViewer.aspx?ReportID=ReportHistorialEntrega")"
                + "&FechaInicial=" + FechaInicial
                + "&FechaFinal="   + FechaFinal
                + "&CentroId="     + CentroId;
        }
    </script>
}