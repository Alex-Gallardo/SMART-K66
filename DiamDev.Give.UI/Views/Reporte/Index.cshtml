@{
    ViewBag.Title = "Reportes";
}

<h2><i class="icon-edit-sign teal"></i> Reportes</h2>
<hr />

@* ════════════════════════════════════════════════════════════
     COLLAPSE 1 — INVENTARIOS
     Cards con data-empresa-id son ocultadas por JS si el usuario
     no tiene acceso a esa empresa en Usuario_Empresa.
    ════════════════════════════════════════════════════════════ *@
@if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Menu.Reporte_Inventario"))
{
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseInventario">
            <h4 class="panel-title">
                <i class="icon-folder-open teal"></i>
                <strong> Inventario</strong>
                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseInventario" class="panel-collapse collapse">
            <div class="panel-body">

                @* INVENTARIO BOLIK — visible solo si usuario tiene Empresa_Id 20210705001 *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Bolik"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705001">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-red"></i>
                                <h2>Inventario Bolik</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirInventario('@Url.Action("InventarioBolik", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @* INVENTARIO GRACO — visible solo si usuario tiene Empresa_Id 20210705004 *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Graco"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705004">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-yellow"></i>
                                <h2>Inventario Graco</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirInventario('@Url.Action("InventarioGraco", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @* INVENTARIO ESCOCESA — Escocesa no está en el sistema Usuario_Empresa,
                    se controla solo por permiso Razor (sin filtro JS de empresa) *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Escocesa"))
                {
                    <div class="col-md-3">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-blue"></i>
                                <h2>Inventario Escocesa</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirInventario('@Url.Action("InventarioEscocesa", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

@* ════════════════════════════════════════════════════════════
     COLLAPSE 2 — VENTAS
    ════════════════════════════════════════════════════════════ *@
@if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Menu.Reporte_Ventas"))
{
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseVentas">
            <h4 class="panel-title">
                <i class="clip-stats teal"></i>
                <strong> Ventas</strong>
                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseVentas" class="panel-collapse collapse">
            <div class="panel-body">

                @* DETALLE FACTURAS — el select de empresa en el modal
                    se filtra dinámicamente en JS según empresas del usuario *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Ventas_Detalle_Factura"))
                {
                    <div class="col-md-3" id="cardDetalleFacturas">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-teal"></i>
                                <h2>Detalle Facturas</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirDetalleFacturas('@Url.Action("DetalleFacturas", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

@* ════════════════════════════════════════════════════════════
     COLLAPSE 3 — CXC
    ════════════════════════════════════════════════════════════ *@
@if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Menu.Reporte_CXC"))
{
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseCXC">
            <h4 class="panel-title">
                <i class="clip-archive teal"></i>
                <strong> CXC</strong>
                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseCXC" class="panel-collapse collapse">
            <div class="panel-body">

                @* ESTADO DE CUENTA — sin filtro de empresa *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.CXC_Estado_De_Cuenta"))
                {
                    <div class="col-md-3">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-teal"></i>
                                <h2>Estado De Cuenta</h2>
