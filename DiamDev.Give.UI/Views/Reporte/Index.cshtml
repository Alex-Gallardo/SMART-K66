@{
    ViewBag.Title = "Reportes";
}

@* ════════════════════════════════════════════════════════════
     ESTILOS — Rediseño UI/UX (solo presentación)
     No modifica IDs, clases funcionales ni lógica existente.
    ════════════════════════════════════════════════════════════ *@
<style>
    /* ── Tokens de la página ─────────────────────────────── */
    .rpt-page {
        --rpt-teal: #169f98;
        --rpt-dark: #2c3e50;
        --rpt-border: #e4e9ee;
        --rpt-bg: #f7f9fb;
    }

    /* ── Encabezado + toolbar ────────────────────────────── */
    .rpt-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 6px;
    }

        .rpt-header h2 {
            margin: 0 0 4px 0;
            font-weight: 600;
            color: #2c3e50;
            letter-spacing: -0.5px;
        }

        .rpt-header .rpt-subtitulo {
            color: #95a5a6;
            font-size: 13px;
            margin: 0;
        }

    .rpt-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .rpt-buscador {
        position: relative;
        min-width: 260px;
    }

        .rpt-buscador .icon-search {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #b0bec5;
            pointer-events: none;
        }

        .rpt-buscador input {
            height: 36px;
            padding-left: 34px;
            border: 1px solid #dce3e9;
            border-radius: 18px;
            font-size: 13px;
            width: 100%;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

            .rpt-buscador input:focus {
                outline: none;
                border-color: #169f98;
                box-shadow: 0 0 0 3px rgba(22, 159, 152, 0.12);
            }

    #rptToggleTodo {
        height: 36px;
        border-radius: 18px;
        font-size: 12px;
        padding: 0 16px;
        border: 1px solid #dce3e9;
        background: #fff;
        color: #607d8b;
        transition: all .15s ease;
    }

        #rptToggleTodo:hover {
            border-color: #169f98;
            color: #169f98;
        }

    /* ── Paneles de sección (collapse) ───────────────────── */
    .rpt-page .panel.panel-default {
        border: 1px solid #e4e9ee;
        border-radius: 8px;
        box-shadow: 0 1px 3px rgba(44, 62, 80, 0.05);
        overflow: hidden;
        margin-bottom: 16px;
        transition: box-shadow .2s ease;
    }

        .rpt-page .panel.panel-default:hover {
            box-shadow: 0 3px 10px rgba(44, 62, 80, 0.08);
        }

    .rpt-page .panel-heading {
        background: #fff;
        border-bottom: 1px solid transparent;
        border-left: 4px solid #169f98;
        padding: 14px 18px;
        transition: background .15s ease;
    }

        .rpt-page .panel-heading:hover {
            background: #f7fafb;
        }

        .rpt-page .panel-heading.rpt-open {
            border-bottom-color: #e4e9ee;
            background: #fbfdfe;
        }

    .rpt-page .panel-title {
        font-size: 15px;
        color: #2c3e50;
        display: block;
    }

        .rpt-page .panel-title > i:first-child {
            margin-right: 6px;
            font-size: 16px;
        }
    /* Chevron animado */
    .rpt-page .panel-heading .icon-angle-down {
        transition: transform .25s ease;
        color: #b0bec5;
        font-size: 18px;
    }

    .rpt-page .panel-heading.rpt-open .icon-angle-down {
        transform: rotate(180deg);
        color: #169f98;
    }
    /* Contador de reportes por sección */
    .rpt-count {
        background: #eef2f5;
        color: #78909c;
        font-weight: 600;
        font-size: 11px;
        margin-right: 12px;
        margin-top: 1px;
        min-width: 22px;
    }

    .rpt-page .panel-body {
        background: #f7f9fb;
        padding: 18px 14px 6px 14px;
    }
    /* Mensaje "sin resultados" al filtrar */
    .rpt-page .panel.rpt-sin-resultados .panel-body::after {
        content: "Ningún reporte coincide con la búsqueda en esta sección.";
        display: block;
        text-align: center;
        color: #b0bec5;
        font-size: 13px;
        font-style: italic;
        padding: 10px 0 18px 0;
    }

    /* ── Cards de reporte ────────────────────────────────── */
    .rpt-page .core-box {
        background: #fff;
        border: 1px solid #e4e9ee;
        border-top: 3px solid #169f98; /* fallback si no hay empresa */
        border-radius: 8px;
        padding: 16px 16px 14px 16px;
        margin-bottom: 16px;
        min-height: 132px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .rpt-page .core-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(44, 62, 80, 0.12);
        }

        .rpt-page .core-box .heading {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

            .rpt-page .core-box .heading h2 {
                font-size: 14px;
                font-weight: 600;
                color: #37474f;
                margin: 0;
                line-height: 1.35;
                letter-spacing: 0;
            }

        .rpt-page .core-box .circle-icon {
            flex-shrink: 0;
            width: 42px;
            height: 42px;
            line-height: 42px;
            font-size: 17px;
            border-radius: 50%;
            text-align: center;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
        }
        /* "Ver Reporte" como botón pill */
        .rpt-page .core-box .view-more {
            align-self: flex-start;
            font-size: 12px;
            font-weight: 600;
            color: #169f98;
            border: 1px solid rgba(22, 159, 152, 0.35);
            border-radius: 14px;
            padding: 5px 14px;
            text-decoration: none;
            transition: background .15s ease, color .15s ease;
        }

            .rpt-page .core-box .view-more:hover,
            .rpt-page .core-box:hover .view-more {
                background: #169f98;
                color: #fff;
                text-decoration: none;
            }

            .rpt-page .core-box .view-more i {
                font-size: 10px;
                margin-left: 4px;
            }

    /* ── Acento de color por empresa (via data-empresa-id) ─
       Cubre ambas variantes de markup:
       .card-empresa en la col  ó  .card-empresa en el core-box */
    .card-empresa[data-empresa-id="20210705001"] .core-box,
    .core-box.card-empresa[data-empresa-id="20210705001"] {
        border-top-color: #e7505a; /* Bolik */
    }

    .card-empresa[data-empresa-id="20210705003"] .core-box,
    .core-box.card-empresa[data-empresa-id="20210705003"] {
        border-top-color: #c0392b; /* Faes  */
    }

    .card-empresa[data-empresa-id="20210705004"] .core-box,
    .core-box.card-empresa[data-empresa-id="20210705004"] {
        border-top-color: #27ae60; /* Graco */
    }

    /* Ocultamiento por búsqueda (independiente de .hide() de permisos) */
    .rpt-filtered {
        display: none !important;
    }

    /* ── Modales ─────────────────────────────────────────── */
    .rpt-page-modals .modal-content,
    .modal .modal-content {
        border: none;
        border-radius: 10px;
        box-shadow: 0 12px 40px rgba(20, 35, 50, 0.25);
        overflow: hidden;
    }

    .modal .modal-header {
        background: #fbfdfe;
        border-bottom: 3px solid #169f98;
        padding: 14px 20px;
    }

    .modal .modal-title {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
    }

        .modal .modal-title i {
            margin-right: 6px;
        }

    .modal .modal-body {
        padding: 20px 20px 8px 20px;
    }

    .modal .control-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: #78909c;
    }

    .modal .form-control {
        border-radius: 5px;
        border-color: #dce3e9;
        box-shadow: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .modal .form-control:focus {
            border-color: #169f98;
            box-shadow: 0 0 0 3px rgba(22, 159, 152, 0.12);
        }

    .modal hr {
        border-top-color: #eef2f5;
    }

    .modal .modal-footer {
        background: #fbfdfe;
        border-top: 1px solid #eef2f5;
        padding: 12px 20px;
    }

    .modal .btn {
        border-radius: 5px;
        font-size: 13px;
    }

    .modal .btn-primary {
        background: #169f98;
        border-color: #169f98;
        font-weight: 600;
        padding-left: 18px;
        padding-right: 18px;
    }

        .modal .btn-primary:hover,
        .modal .btn-primary:focus {
            background: #11837d;
            border-color: #11837d;
        }

    .modal .btn-default {
        color: #78909c;
    }

    /* ── Responsive + accesibilidad ──────────────────────── */
    @@media (max-width: 767px) {
        .rpt-header {
            flex-direction: column;
            align-items: stretch;
        }

        .rpt-buscador {
            min-width: 0;
            flex: 1;
        }

        .rpt-page .core-box {
            min-height: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .rpt-page * {
            transition: none !important;
        }
    }
</style>

<div class="rpt-page">

    @* ── Encabezado + buscador + expandir/colapsar ───────── *@
    <div class="rpt-header">
        <div>
            <h2><i class="icon-edit-sign teal"></i> Reportes</h2>
            <p class="rpt-subtitulo">Selecciona una sección y genera el reporte en PDF</p>
        </div>
        <div class="rpt-toolbar">
            <div class="rpt-buscador">
                <i class="icon-search"></i>
                <input type="text" id="rptBuscar" class="form-control"
                       placeholder="Buscar reporte... (ej: cartera, backorder)"
                       autocomplete="off" />
            </div>
            <button type="button" id="rptToggleTodo" class="btn">
                <i class="icon-resize-full"></i> <span>Expandir todo</span>
            </button>
        </div>
    </div>
    <hr />

    @* ════════════════════════════════════════════════════════════
         COLLAPSE 1 — INVENTARIOS
        ════════════════════════════════════════════════════════════ *@
    @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Menu.Reporte_Inventario"))
    {
        <div class="panel panel-default">
            <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseInventario">
                <h4 class="panel-title">
                    <i class="icon-folder-open teal"></i>
                    <strong> Inventario</strong>
                    <span class="pull-right"><i class="icon-angle-down"></i></span>
                    <span class="badge rpt-count pull-right"></span>
                </h4>
            </div>
            <div id="collapseInventario" class="panel-collapse collapse">
                <div class="panel-body">

                    @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Bolik"))
                    {
                        <div class="col-md-3 card-empresa" data-empresa-id="20210705001">
                            <div class="core-box">
                                <div class="heading">
                                    <i class="clip-archive circle-icon circle-red"></i>
                                    <h2>Inventario Bolik</h2>
                                </div>
                                <a href="javascript:void(0)"
                                   onclick="pedirInventario('@Url.Action("InventarioBolik", "Reporte")')"
                                   class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                            </div>
                        </div>
                    }

                    @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Escocesa"))
                    {
                        <div class="col-md-3">
                            <div class="core-box card-empresa" data-empresa-id="20210705003">
                                <div class="heading">
                                    <i class="clip-archive circle-icon circle-bricky"></i>
                                    <h2>Inventario Escocesa</h2>
                                </div>
                                <a href="javascript:void(0)"
                                   onclick="pedirInventario('@Url.Action("InventarioEscocesa", "Reporte")')"
                                   class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                            </div>
                        </div>
                    }

                    @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Graco"))
                    {
                        <div class="col-md-3 card-empresa" data-empresa-id="20210705004">
                            <div class="core-box">
                                <div class="heading">
                                    <i class="clip-archive circle-icon circle-green"></i>
                                    <h2>Inventario Graco</h2>
                                </div>
                                <a href="javascript:void(0)"
                                   onclick="pedirInventario('@Url.Action("InventarioGraco", "Reporte")')"
                                   class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                            </div>
                        </div>
                    }
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
    }

