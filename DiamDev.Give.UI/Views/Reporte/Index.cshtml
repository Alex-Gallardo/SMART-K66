    @* ── MODAL: Solo Agente (Crystal) ── *@
<div class="modal fade" id="modalAgenteCrystal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-user teal"></i>
                    <span id="modalAgenteCrystalTitulo">Reporte por Agente</span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">Código de Agente</label>
                    <input type="text" id="crystalAgente" class="form-control"
                           placeholder="Ej: ACODEX" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerAgenteCrystal">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>

