                                <i class="clip-stack-2 circle-icon circle-teal"></i>
                                <h2>Pedidos No Sincronizados</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="abrirCrystalDirecto('@Url.Action("PedidosNoSincronizados","Reporte")')"
                               class="view-more">
