    /**
     * Estado Pedido — puebla Empresa (todas las del usuario) y
     * Agente (filtrando según empresa seleccionada en tiempo real)
     */
    function pedirRuta(urlBase) {
        _urlCrystalBase = urlBase;

        // Poblar empresas del usuario
        poblarSelectEmpresasAbrev($("#rutaEmpresa"));

        // Poblar agentes con todos los del usuario (cross-empresa)
        var selAgente = $("#rutaAgente");
        selAgente.empty();
        if (_userEmpresaInfo) {
            var vistos = {};
            $.each(_userEmpresaInfo.Agentes, function (i, a) {
                if (a.AgenteNombre && !vistos[a.AgenteNombre]) {
                    vistos[a.AgenteNombre] = true;
                    selAgente.append($("<option>", { value: a.AgenteNombre, text: a.AgenteNombre }));
                }
            });
        }

        $("#rutaVehiculo, #rutaNoRuta, #rutaDocumento").val("");
        $("#modalRuta").modal("show");
        setTimeout(function () { $("#rutaEmpresa").focus(); }, 400);
    }

        /**
     * Despachos en Ruta — patrón igual que Backorder.
     * La empresa ya está fija en el .rpt de cada card; el modal
     * solo pide Agente + filtros opcionales.
     */
    function pedirDespachos(urlBase, titulo, empresaId) {
        _urlDespachosBase = urlBase;
        _empresaIdDespachos = empresaId ? empresaId.toString() : null;

        $("#modalDespachosTitulo").text(titulo || "Despachos en Ruta");

        // Poblar agentes filtrados por empresa del card (igual que Backorder)
        poblarSelectAgentes($("#despachosAgente"), _empresaIdDespachos, "#despachosAgenteHelp");

        // Limpiar campos opcionales
        $("#despachosCliente, #despachosPedido, #despachosIdDocumento").val("");

        $("#modalDespachos").modal("show");
        setTimeout(function () { $("#despachosAgente").focus(); }, 400);
    }

    /**
     * Actualiza el select de Agente en el modal Despachos
     * según la Empresa seleccionada en ese mismo modal.
     */
    function actualizarAgentesDespachos() {
        if (!_userEmpresaInfo) return;

        // Encontrar el empresaId que corresponde al valor Crystal seleccionado
        var desVal = $("#despachosEmpresa").val();
        var empresaId = null;

        // Actualizacion de Empresas
        var cristalVal = desVal == 'GRACO' ? "FABRICA GRACOPACK DE CENTROAMERICA, S.A." : desVal == 'BOLIK' ? "INDUSTRIAS BOLIK, S.A." : "FABRICA ESCOCESA, S.A."
        // debugger

        $.each(Object.keys(EMP_CRYSTAL), function (i, id) {
            if (EMP_CRYSTAL[id] === cristalVal) { empresaId = id; return false; }
        });

        var sel = $("#despachosAgente");
        sel.empty();
        $("#despachosAgenteHelp").text("");

        if (empresaId) {
            var agentes = _userEmpresaInfo.Agentes.filter(function (a) {
                return a.EmpresaId === empresaId;
            });
            if (agentes.length === 0) {
                $("#despachosAgenteHelp").text("(sin agentes para esta empresa)");
            } else {
                $.each(agentes, function (i, a) {
                    if (a.AgenteNombre) {
                        sel.append($("<option>", { value: a.AgenteNombre, text: a.AgenteNombre }));
                    }
                });
                if (agentes.length === 1) sel.val(agentes[0].AgenteNombre);
            }
        }
    }


    // ═══════════════════════════════════════════════════════════════════
    //  MEJORAS UI/UX — solo presentación (NO altera datos ni lógica)
    //  Todo lo de abajo es aditivo: si se borra este bloque, la página
    //  sigue funcionando exactamente igual que antes.
    // ═══════════════════════════════════════════════════════════════════

    /** Determina si un card está oculto por permisos (.hide()) o por búsqueda (.rpt-filtered) */
    function rptCardOculta($box) {
        var $col = $box.closest("[class*='col-']");
        var $wrap = $col.length ? $col : $box;
        var estiloCol = ($wrap.attr("style") || "");
        var estiloBox = ($box.attr("style") || "");
        return $wrap.hasClass("rpt-filtered") || $box.hasClass("rpt-filtered") ||
               estiloCol.indexOf("display: none") !== -1 ||
               estiloBox.indexOf("display: none") !== -1;
    }

    /** Actualiza el badge contador de cada sección */
    function rptActualizarContadores() {
        $(".rpt-page .panel.panel-default").each(function () {
            var visibles = 0;
            $(this).find(".panel-body .core-box").each(function () {
                if (!rptCardOculta($(this))) visibles++;
            });
            $(this).find(".rpt-count").text(visibles);
        });
    }

    $(document).ready(function () {

        // 1. Chevron animado: rota al abrir/cerrar la sección
        $(".rpt-page .panel-collapse")
            .on("shown.bs.collapse", function () {
                $(this).prev(".panel-heading").addClass("rpt-open");
            })
            .on("hidden.bs.collapse", function () {
                $(this).prev(".panel-heading").removeClass("rpt-open");
            });

        // 2. Card completa clickeable: delega al link "Ver Reporte"
        $(document).on("click", ".rpt-page .core-box", function (e) {
            if ($(e.target).closest("a").length) return;   // el link ya lo maneja
            var link = $(this).find("a.view-more").get(0);
            if (link) link.click();
        });

        // 3. Buscador de reportes en vivo
        $("#rptBuscar").on("input", function () {
            var q = $(this).val().toLowerCase().trim();

            $(".rpt-page .panel-body .core-box").each(function () {
                var texto = $(this).find("h2").text().toLowerCase();
                var $col  = $(this).closest("[class*='col-']");
                var $obj  = $col.length ? $col : $(this);
                $obj.toggleClass("rpt-filtered", !!q && texto.indexOf(q) === -1);
            });

            // Con búsqueda activa, abrir todas las secciones para ver resultados
            if (q) $(".rpt-page .panel-collapse").collapse("show");

            // Marcar secciones sin coincidencias
            $(".rpt-page .panel.panel-default").each(function () {
                var visibles = 0;
                $(this).find(".panel-body .core-box").each(function () {
                    if (!rptCardOculta($(this))) visibles++;
                });
                $(this).toggleClass("rpt-sin-resultados", !!q && visibles === 0);
            });

            rptActualizarContadores();
        });

        // 4. Expandir / Colapsar todas las secciones
        var _rptExpandido = false;
        $("#rptToggleTodo").on("click", function () {
            _rptExpandido = !_rptExpandido;
            $(".rpt-page .panel-collapse").collapse(_rptExpandido ? "show" : "hide");
            $(this).find("span").text(_rptExpandido ? "Colapsar todo" : "Expandir todo");
            $(this).find("i").attr("class", _rptExpandido ? "icon-resize-small" : "icon-resize-full");
        });

        // 5. Contadores iniciales (antes de que llegue el AJAX de empresas;
        //    cargarInfoEmpresaUsuario los refresca al terminar)
        rptActualizarContadores();
    });

    </script>
