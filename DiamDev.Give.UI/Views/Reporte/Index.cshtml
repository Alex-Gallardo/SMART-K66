@{
    ViewBag.Title = "Reportes";
}

<h2><i class="icon-edit-sign teal"></i> Reportes</h2>
<hr />

<div class="row">

    @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario"))
    {
        <div class="col-md-3">
            <div class="core-box">
                <div class="heading">
                    <i class="clip-archive circle-icon circle-teal"></i>
                    <h2>Inventario</h2>
                </div>
                <a href="@Url.Action("Inventario", "Reporte")" class="view-more">
                    Ver Reporte <i class="clip-arrow-right-2"></i>
