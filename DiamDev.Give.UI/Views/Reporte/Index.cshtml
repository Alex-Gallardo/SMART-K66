            @* ── Sub-carpeta: Inventarios ── *@
            <h5 style="color:#777; border-bottom:1px solid #eee; padding-bottom:5px">
                <i class="icon-folder-open"></i> Inventarios
            </h5>
            <div class="row" style="margin-bottom:15px">
                <div class="col-md-3">
                    <div class="core-box">
                        <div class="heading">
                            <i class="clip-archive circle-icon circle-teal"></i>
                            <h2>Inventario General</h2>
