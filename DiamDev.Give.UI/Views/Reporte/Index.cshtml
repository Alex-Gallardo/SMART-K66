                        Agente <small class="text-muted" id="dfEmpresaAgenteHelp"></small>
                    </label>
                    <select id="dfEmpresaAgente" class="form-control"></select>
                </div>
                <hr style="margin:8px 0" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Inicial <span class="text-danger">*</span></label>
                            <input type="text" id="dfEmpresaFechaInicial" class="form-control date-picker"
                                   data-date-format="yyyy-mm-dd"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Final <span class="text-danger">*</span></label>
                            <input type="text" id="dfEmpresaFechaFinal" class="form-control date-picker"
                                   data-date-format="yyyy-mm-dd"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Código Cliente <span class="text-danger">*</span></label>
                            <input type="text" id="dfEmpresaCliente" class="form-control" placeholder="Ej: CL0001" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Código Artículo <small class="text-muted">(opcional)</small></label>
                            <input type="text" id="dfEmpresaCodigo" class="form-control" placeholder="Ej: ART-001" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label">Nombre Artículo <small class="text-muted">(opcional)</small></label>
                    <input type="text" id="dfEmpresaProducto" class="form-control" placeholder="Ej: DOMO" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerDFEmpresa">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>


@* ════════════════════════════════════════════════════════════
     JAVASCRIPT
    ════════════════════════════════════════════════════════════ *@
@section Scripts {
    <script type="text/javascript">

    // ── ESTADO GLOBAL ────────────────────────────────────────────────────────
    var _userEmpresaInfo       = null;
    var _urlCrystalBase        = "";
    var _urlBackorderBase      = "";
    var _urlEstadoCuentaBase   = "";
    var _urlDFEmpresaBase      = "";
    var _urlDespachosBase      = "";
    var _empresaIdBackorder    = null;
    var _empresaIdEstadoCuenta = null;
    var _empresaIdDFEmpresa    = null;

    var EMP_BOLIK = "20210705001";
    var EMP_FAES  = "20210705003";
    var EMP_GRACO = "20210705004";

    // Nombres de empresa que espera Crystal Reports como parámetro.
    // ⚠️ Verifica que estos valores coincidan con lo que filtra cada .rpt.
    // Si Estado Pedido o Despachos usan un formato distinto, ajusta aquí.
    var EMP_CRYSTAL = {};
    EMP_CRYSTAL[EMP_BOLIK] = "INDUSTRIAS BOLIK, S.A.";
    EMP_CRYSTAL[EMP_FAES]  = "FABRICA ESCOCESA, S.A.";
    EMP_CRYSTAL[EMP_GRACO] = "FABRICA GRACOPACK DE CENTROAMERICA, S.A.";

    var EMP_DISPLAY = {};
    EMP_DISPLAY[EMP_BOLIK] = "Bolik";
    EMP_DISPLAY[EMP_FAES]  = "Faes";
    EMP_DISPLAY[EMP_GRACO] = "Graco";

    // ════════════════════════════════════════════════════════
    //  DOCUMENT READY
    // ════════════════════════════════════════════════════════
    $(document).ready(function () {

        cargarInfoEmpresaUsuario();

        // ── Inventario ───────────────────────────────────────
        $("#btnVerInventario").on("click", function () {
            var cod = $("#codigoProducto").val().trim();
            var nom = $("#nombreProducto").val().trim();
            var url = _urlCrystalBase + "?";
            if (cod) url += "Codigo_Producto=" + encodeURIComponent(cod) + "&";
            if (nom) url += "Producto_Name="   + encodeURIComponent(nom) + "&";
            url = url.replace(/[&?]$/, "");
            $("#modalInventario").modal("hide");
            window.open(url, "_blank");
        });

        // ── Backorder ────────────────────────────────────────
        $("#btnVerBackorder").on("click", function () {
            var ag = $("#boAgente").val();
            var cl = $("#boCliente").val().trim();
            var pr = $("#boProducto").val().trim();
            var pd = $("#boPedido").val().trim();
            var url = _urlBackorderBase + "?";
            url += "agente=" + encodeURIComponent(ag) + "&";
            if (cl) url += "cliente="  + encodeURIComponent(cl) + "&";
            if (pr) url += "producto=" + encodeURIComponent(pr) + "&";
            if (pd) url += "pedido="   + encodeURIComponent(pd) + "&";
            url = url.replace(/[&?]$/, "");
            $("#modalBackorder").modal("hide");
            window.open(url, "_blank");
        });

        // ── Estado de Cuenta ─────────────────────────────────
        $("#btnVerEstadoCuenta").on("click", function () {
            var ag = $("#ecAgente").val();
            var fi = $("#ecFechaInicial").val().trim();
            var ff = $("#ecFechaFinal").val().trim();
            var cl = $("#ecCliente").val().trim();
            if (!fi || !ff) { toastr.error("Selecciona ambas fechas"); return; }
            if (fi > ff) { toastr.error("Fecha inicial mayor que fecha final"); return; }
            if (!cl)    { toastr.error("Codigo de cliente obligatorio"); return; }
            var url = _urlEstadoCuentaBase
                + "?fechaInicial=" + encodeURIComponent(fi)
                + "&fechaFinal="   + encodeURIComponent(ff);
            url += "&agente=" + encodeURIComponent(ag);
            if (cl) url += "&cliente=" + encodeURIComponent(cl);
            $("#modalEstadoCuenta").modal("hide");
            window.open(url, "_blank");
        });

        // ── Detalle Facturas por empresa ──────────────────────
        $("#btnVerDFEmpresa").on("click", function () {
            var ag = $("#dfEmpresaAgente").val();
            var fi = $("#dfEmpresaFechaInicial").val().trim();
            var ff = $("#dfEmpresaFechaFinal").val().trim();
            var cl = $("#dfEmpresaCliente").val().trim();
            var cd = $("#dfEmpresaCodigo").val().trim();
            var pr = $("#dfEmpresaProducto").val().trim();
            if (!fi || !ff) { toastr.error("Selecciona ambas fechas"); return; }
            if (fi > ff)    { toastr.error("Fecha inicial mayor que fecha final"); return; }
            var url = _urlDFEmpresaBase
                + "?fechaInicial=" + encodeURIComponent(fi)
                + "&fechaFinal="   + encodeURIComponent(ff);
            url += "&agente=" + encodeURIComponent(ag);
            if (cl) url += "&cliente="  + encodeURIComponent(cl);
            if (cd) url += "&codigo="   + encodeURIComponent(cd);
            if (pr) url += "&producto=" + encodeURIComponent(pr);
            $("#modalDetalleFacturasEmpresa").modal("hide");
            window.open(url, "_blank");
        });

        // ── Estado Pedido (ahora incluye Empresa) ─────────────
        $("#btnVerRuta").on("click", function () {
            var emp = $("#rutaEmpresa").val();
            var ag  = $("#rutaAgente").val();
            var fi  = $("#rutaFechaInicial").val().trim();
            var ff  = $("#rutaFechaFinal").val().trim();
            var vh  = $("#rutaVehiculo").val().trim();
            var nr  = $("#rutaNoRuta").val().trim();
            var dc  = $("#rutaDocumento").val().trim();
            if (!fi || !ff) { toastr.error("Las fechas son obligatorias"); return; }
            if (fi > ff)    { toastr.error("Fecha inicial mayor que fecha final"); return; }
            var url = _urlCrystalBase
                + "?fechaInicial=" + encodeURIComponent(fi)
                + "&fechaFinal="   + encodeURIComponent(ff);
            url += "&empresa=" + encodeURIComponent(emp);
            url += "&agente="  + encodeURIComponent(ag);
            if (vh) url += "&vehiculo="  + encodeURIComponent(vh);
            if (nr) url += "&noRuta="    + encodeURIComponent(nr);
            if (dc) url += "&documento=" + encodeURIComponent(dc);
            $("#modalRuta").modal("hide");
            window.open(url, "_blank");
        });

        // ── Despachos en Ruta Día (nuevo modal) ──────────────
        $("#btnVerDespachos").on("click", function () {
            var emp = $("#despachosEmpresa").val();
            var ag  = $("#despachosAgente").val();
            var url = _urlDespachosBase
                + "?empresa=" + encodeURIComponent(emp)
                + "&agente="  + encodeURIComponent(ag);
            $("#modalDespachos").modal("hide");
            window.open(url, "_blank");
        });

    }); // ── FIN document.ready ───────────────────────────────


    // ════════════════════════════════════════════════════════
    //  FUNCIONES GLOBALES
    // ════════════════════════════════════════════════════════

    function cargarInfoEmpresaUsuario() {
        $.getJSON('@Url.Action("GetUserEmpresaInfo", "Reporte")', function (data) {
            _userEmpresaInfo = data;
            aplicarVisibilidadReportes();
        }).fail(function () {
            console.warn("[ReporteIndex] No se pudo cargar info de empresas del usuario.");
        });
    }

    // ── Visibilidad ──────────────────────────────────────────
    function tieneAccesoEmpresa(empresaIdStr) {
        if (!_userEmpresaInfo) return true;
        return _userEmpresaInfo.Agentes.some(function (a) {
            return a.EmpresaId === empresaIdStr;
        });
    }

    function aplicarVisibilidadReportes() {
        $(".card-empresa[data-empresa-id]").each(function () {
            var id = $(this).data("empresa-id").toString();
            if (!tieneAccesoEmpresa(id)) {
                $(this).hide();
            }
        });
    }

    // ── Helper: puebla select de agentes por empresa ─────────
    function poblarSelectAgentes(sel, empresaId, helpSpanId) {
        sel.empty();
        if (helpSpanId) $(helpSpanId).text("");
        if (!_userEmpresaInfo) return;
        var agentes = _userEmpresaInfo.Agentes.filter(function (a) {
            return a.EmpresaId === empresaId.toString();
        });
        if (agentes.length === 0) {
            if (helpSpanId) $(helpSpanId).text("(sin agentes registrados)");
        } else {
            $.each(agentes, function (i, a) {
                if (a.AgenteNombre) {
                    sel.append($("<option>", { value: a.AgenteNombre, text: a.AgenteNombre }));
                }
            });
            if (agentes.length === 1 && agentes[0].AgenteNombre) {
                sel.val(agentes[0].AgenteNombre);
            }
        }
    }

    /**
     * Puebla un select con las empresas a las que el usuario tiene acceso.
     * El value de cada option es el nombre Crystal que espera el .rpt (EMP_CRYSTAL).
     * ⚠️ Si el .rpt espera un valor distinto, ajusta EMP_CRYSTAL arriba.
     */
    function poblarSelectEmpresas(sel) {
        sel.empty();
        if (!_userEmpresaInfo) return;
        var vistas = {};
        $.each(_userEmpresaInfo.Agentes, function (i, a) {
            if (a.EmpresaId && !vistas[a.EmpresaId]) {
                vistas[a.EmpresaId] = true;
                var cristalVal  = EMP_CRYSTAL[a.EmpresaId]  || a.EmpresaNombre;
                var displayName = EMP_DISPLAY[a.EmpresaId] || a.EmpresaNombre;
                sel.append($("<option>", { value: cristalVal, text: displayName }));
            }
        });
       }

    function poblarSelectEmpresasAbrev(sel) {
        sel.empty();
        if (!_userEmpresaInfo) return;
        var vistas = {};
        $.each(_userEmpresaInfo.Agentes, function (i, a) {
            if (a.EmpresaId && !vistas[a.EmpresaId]) {
                vistas[a.EmpresaId] = true;
                var cristalVal = a.EmpresaId == '20210705001' ? 'BOLIK' : a.EmpresaId == '20210705003' ? 'FAES' : a.EmpresaId== '20210705004'?'GRACO':a.EmpresaNombre
                var displayName = EMP_DISPLAY[a.EmpresaId] || a.EmpresaNombre;
                sel.append($("<option>", { value: cristalVal, text: displayName }));
            }
        });
    }

    // ── Apertura de modales ──────────────────────────────────

    function pedirInventario(urlBase, titulo) {
        _urlCrystalBase = urlBase;
        $("#modalInventarioTitulo").text(titulo || "Inventarios");
        $("#codigoProducto, #nombreProducto").val("");
        $("#modalInventario").modal("show");
        setTimeout(function () { $("#codigoProducto").focus(); }, 400);
    }

    function pedirBackorder(urlBase, titulo, empresaId) {
        _urlBackorderBase   = urlBase;
        _empresaIdBackorder = empresaId ? empresaId.toString() : null;
        $("#modalBackorderTitulo").text(titulo || "Backorder");
        poblarSelectAgentes($("#boAgente"), _empresaIdBackorder, "#boAgenteHelp");
        $("#boCliente, #boProducto, #boPedido").val("");
        $("#modalBackorder").modal("show");
        setTimeout(function () { $("#boAgente").focus(); }, 400);
    }

    function pedirEstadoCuenta(urlBase, titulo, empresaId) {
        _urlEstadoCuentaBase   = urlBase;
        _empresaIdEstadoCuenta = empresaId ? empresaId.toString() : null;
        $("#modalEstadoCuentaTitulo").text(titulo || "Estado de Cuenta");
        poblarSelectAgentes($("#ecAgente"), _empresaIdEstadoCuenta, "#ecAgenteHelp");
        $("#ecCliente").val("");
        $("#modalEstadoCuenta").modal("show");
        setTimeout(function () { $("#ecAgente").focus(); }, 400);
    }

    function pedirDetalleFacturasEmpresa(urlBase, titulo, empresaId) {
        _urlDFEmpresaBase   = urlBase;
        _empresaIdDFEmpresa = empresaId ? empresaId.toString() : null;
        $("#modalDFEmpresaTitulo").text(titulo || "Detalle Facturas");
        poblarSelectAgentes($("#dfEmpresaAgente"), _empresaIdDFEmpresa, "#dfEmpresaAgenteHelp");
        $("#dfEmpresaCliente, #dfEmpresaCodigo, #dfEmpresaProducto").val("");
        $("#modalDetalleFacturasEmpresa").modal("show");
        setTimeout(function () { $("#dfEmpresaAgente").focus(); }, 400);
    }

    /**
     * Estado Pedido — puebla Empresa (todas las del usuario) y
     * Agente (filtrando según empresa seleccionada en tiempo real)
     */
    function pedirRuta(urlBase) {
        _urlCrystalBase = urlBase;

        // Poblar empresas del usuario
        poblarSelectEmpresasAbrev($("#rutaEmpresa"));

        // Poblar agentes con todos los del usuario (cross-empresa)
        var selAgente = $("#rutaAgente");
        selAgente.empty();
        if (_userEmpresaInfo) {
            var vistos = {};
            $.each(_userEmpresaInfo.Agentes, function (i, a) {
                if (a.AgenteNombre && !vistos[a.AgenteNombre]) {
                    vistos[a.AgenteNombre] = true;
                    selAgente.append($("<option>", { value: a.AgenteNombre, text: a.AgenteNombre }));
                }
            });
        }

        $("#rutaVehiculo, #rutaNoRuta, #rutaDocumento").val("");
        $("#modalRuta").modal("show");
        setTimeout(function () { $("#rutaEmpresa").focus(); }, 400);
    }

    /**
     * Despachos en Ruta Día — nuevo modal con Empresa + Agente.
     * La empresa seleccionada filtra los agentes disponibles.
     */
    function pedirDespachos(urlBase) {
        _urlDespachosBase = urlBase;

        // Poblar empresas
        poblarSelectEmpresasAbrev($("#despachosEmpresa"));

        // Poblar agentes de la primera empresa por defecto
        // var primeraEmpresa = $("#despachosEmpresa option:first").data ? null : null;
        // Se poblarán los agentes según la empresa seleccionada
        actualizarAgentesDespachos();

        // Al cambiar empresa, actualizar agentes disponibles
        $("#despachosEmpresa").off("change.despachos").on("change.despachos", function () {
            actualizarAgentesDespachos();
        });

        $("#modalDespachos").modal("show");
        setTimeout(function () { $("#despachosEmpresa").focus(); }, 400);
    }

    /**
     * Actualiza el select de Agente en el modal Despachos
     * según la Empresa seleccionada en ese mismo modal.
     */
    function actualizarAgentesDespachos() {
        if (!_userEmpresaInfo) return;

        // Encontrar el empresaId que corresponde al valor Crystal seleccionado
        var desVal = $("#despachosEmpresa").val();
        var empresaId = null;

        // Actualizacion de Empresas
        var cristalVal = desVal == 'GRACO' ? "FABRICA GRACOPACK DE CENTROAMERICA, S.A." : desVal == 'BOLIK' ? "INDUSTRIAS BOLIK, S.A." : "FABRICA ESCOCESA, S.A."
        // debugger

        $.each(Object.keys(EMP_CRYSTAL), function (i, id) {
            if (EMP_CRYSTAL[id] === cristalVal) { empresaId = id; return false; }
        });

        var sel = $("#despachosAgente");
        sel.empty();
        $("#despachosAgenteHelp").text("");

        if (empresaId) {
            var agentes = _userEmpresaInfo.Agentes.filter(function (a) {
                return a.EmpresaId === empresaId;
            });
            if (agentes.length === 0) {
                $("#despachosAgenteHelp").text("(sin agentes para esta empresa)");
            } else {
                $.each(agentes, function (i, a) {
                    if (a.AgenteNombre) {
                        sel.append($("<option>", { value: a.AgenteNombre, text: a.AgenteNombre }));
                    }
                });
                if (agentes.length === 1) sel.val(agentes[0].AgenteNombre);
            }
        }
    }

    </script>
}