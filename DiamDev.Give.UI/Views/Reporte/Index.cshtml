                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseCrystal" class="panel-collapse collapse in">
            <div class="panel-body">

                @* ── Pedidos SAP ── *@
                <h5 style="color:#777;border-bottom:1px solid #eee;padding-bottom:5px">
                    <i class="icon-folder-open"></i> Pedidos SAP
                </h5>
