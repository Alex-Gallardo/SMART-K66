                               onclick="pedirCarteraClientes('@Url.Action("CarteraClientesFaes", "Reporte")', 'Cartera de Clientes Faes', '20210705003')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>

