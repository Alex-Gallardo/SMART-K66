@{
    ViewBag.Title = "Reportes";
}

<h2><i class="icon-edit-sign teal"></i> Reportes</h2>
<hr />

@* ════════════════════════════════════════════════════════════
    COLLAPSE 1 — INVENTARIOS
    ════════════════════════════════════════════════════════════ *@
<div class="panel panel-default">
    <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseInventario">
        <h4 class="panel-title">
            <i class="icon-folder-open teal"></i>
            <strong> Inventario</strong>
            <span class="pull-right"><i class="icon-angle-down"></i></span>
        </h4>
    </div>
    <div id="collapseInventario" class="panel-collapse collapse">
        <div class="panel-body">

        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
    COLLAPSE 2 — VENTAS
    ════════════════════════════════════════════════════════════ *@
<div class="panel panel-default">
    <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseVentas">
        <h4 class="panel-title">
            <i class="clip-stats teal"></i>
            <strong> Ventas</strong>
            <span class="pull-right"><i class="icon-angle-down"></i></span>
        </h4>
    </div>
    <div id="collapseVentas" class="panel-collapse collapse">
        <div class="panel-body">

        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
    COLLAPSE 3 — CXC
    ════════════════════════════════════════════════════════════ *@
<div class="panel panel-default">
    <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseCXC">
        <h4 class="panel-title">
            <i class="clip-archive teal"></i>
            <strong> CXC</strong>
            <span class="pull-right"><i class="icon-angle-down"></i></span>
        </h4>
    </div>
    @*<div id="collapseCXC" class="panel-collapse collapse in">*@
    <div id="collapseCXC" class="panel-collapse collapse ">
        <div class="panel-body">
            <div class="col-md-3">
                <div class="core-box">
                    <div class="heading">
                        <i class="clip-archive circle-icon circle-teal"></i>
                        <h2>Estado De Cuenta</h2>
                    </div>
                    <a href="javascript:void(0)"
                       onclick="pedirFechasYCliente('@Url.Action("EstadoDeCuenta","Reporte")', 'Estado de Cuenta')"
                       class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>


    @* ════════════════════════════════════════════════════════════
        COLLAPSE 4 — DISTRIBUCION
        ════════════════════════════════════════════════════════════ *@
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseDistibucion">
            <h4 class="panel-title">
                <i class="icon-truck teal"></i>
                <strong> Distribución</strong>
                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseDistibucion" class="panel-collapse collapse">
            <div class="panel-body">

                @* BACKORDER *@
                <div class="col-md-3">
                    <div class="core-box">
                        <div class="heading">
                            <i class="clip-stats circle-icon circle-teal"></i>
                            <h2>Backorder</h2>
                        </div>
                        <a href="javascript:void(0)"
                           onclick="abrirCrystalDirecto('@Url.Action("Backorder","Reporte")')"
                           class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                    </div>
                </div>

                @* ESTADO DE PEDIDO ES (REVISION DE RUTAS) *@
                <div class="col-md-3">
                    <div class="core-box">
                        <div class="heading">
                            <i class="clip-archive circle-icon circle-teal "></i>
                            <h2>Estado Pedido</h2>
                        </div>
                        <a href="javascript:void(0)"
                           onclick="pedirRuta('@Url.Action("RevisionRutas","Reporte")', 'Revisión de Rutas')"
                           class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                    </div>
                </div>

                @* ESTADO DE PEDIDO ES (REVISION DE RUTAS) *@
                <div class="col-md-3">
                    <div class="core-box">
                        <div class="heading">
                            <i class="clip-truck circle-icon circle-green"></i>
                            <h2>Ruta</h2>
                        </div>
                        <a href="javascript:void(0)"
                           onclick="abrirCrystalDirecto('@Url.Action("DespachosEnRutaDia","Reporte")', 'Despachos En Ruta Dia')"
                           class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* ── MODAL: Solo Agente (Crystal) ── *@
    <div class="modal fade" id="modalAgenteCrystal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="icon-user teal"></i>
                        <span id="modalAgenteCrystalTitulo">Reporte por Agente</span>
                    </h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="control-label">Código de Agente</label>
                        <input type="text" id="crystalAgente" class="form-control"
                               placeholder="Ej: ACODEX" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnVerAgenteCrystal">
                        <i class="icon-file-pdf-alt"></i> Ver PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ── MODAL: Pedidos No Sincronizados (Cliente + Pedido) ── *@
    <div class="modal fade" id="modalPedido" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="icon-stack-2 teal"></i>
                        <span id="modalPedidoTitulo">Pedidos No Sincronizados</span>
                    </h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="control-label">
                            Código Cliente <small class="text-muted">(vacío = todos)</small>
                        </label>
                        <input type="text" id="pedidoCliente" class="form-control"
                               placeholder="Ej: CL0001" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">
                            Número de Pedido <small class="text-muted">(vacío = todos)</small>
                        </label>
                        <input type="text" id="pedidoNumero" class="form-control"
                               placeholder="Ej: 80001234" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnVerPedido">
                        <i class="icon-file-pdf-alt"></i> Ver PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ── MODAL: Revisión de Rutas (6 campos) ── *@
    <div class="modal fade" id="modalRuta" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="icon-truck teal"></i> Revisión de Rutas
                    </h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">Fecha Inicial <span class="text-danger">*</span></label>
                                <input type="text" id="rutaFechaInicial" class="form-control date-picker"
                                       data-date-format="yyyy-mm-dd" placeholder="yyyy-mm-dd"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">Fecha Final <span class="text-danger">*</span></label>
                                <input type="text" id="rutaFechaFinal" class="form-control date-picker"
                                       data-date-format="yyyy-mm-dd" placeholder="yyyy-mm-dd"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Vehículo <small class="text-muted">(vacío = todos)</small>
                                </label>
                                <input type="text" id="rutaVehiculo" class="form-control"
                                       placeholder="Ej: P-123ABC" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    No. Ruta <small class="text-muted">(vacío = todas)</small>
                                </label>
                                <input type="text" id="rutaNoRuta" class="form-control"
                                       placeholder="Ej: 5" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Agente <small class="text-muted">(vacío = todos)</small>
                                </label>
                                <input type="text" id="rutaAgente" class="form-control"
                                       placeholder="Ej: ACODEX" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Documento <small class="text-muted">(vacío = todos)</small>
                                </label>
                                <input type="text" id="rutaDocumento" class="form-control"
                                       placeholder="Ej: FAC-001" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnVerRuta">
                        <i class="icon-file-pdf-alt"></i> Ver PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════
        MODAL — Filtros para reportes Crystal Reports
        ════════════════════════════════════════════════════════════ *@
    <div class="modal fade" id="modalCrystal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="icon-bar-chart teal"></i>
                        <span id="modalCrystalTitulo">Generar Reporte</span>
                    </h4>
                </div>
                <div class="modal-body">

                    <div class="form-group">
                        <label class="control-label">Fecha Inicial</label>
                        <input type="text" id="crystalFechaInicial"
                               class="form-control date-picker"
                               data-date-format="yyyy-mm-dd"
                               placeholder="yyyy-mm-dd"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Fecha Final</label>
                        <input type="text" id="crystalFechaFinal"
                               class="form-control date-picker"
                               data-date-format="yyyy-mm-dd"
                               placeholder="yyyy-mm-dd"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    @* Solo visible cuando el reporte necesita CardCode *@
                    <div id="filaCrystalCardCode" class="form-group" style="display:none">
                        <label class="control-label">
                            Código Cliente SAP
                            <small class="text-muted">(vacío = todos)</small>
                        </label>
                        <input type="text" id="crystalCardCode"
                               class="form-control"
                               placeholder="Ej: CL0001" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default"
                            data-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-primary"
                            id="btnVerCrystal">
                        <i class="icon-file-pdf-alt"></i> Ver PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════
        JAVASCRIPT — Funciones para SSRS + Crystal Reports
        Nota: va directo aquí, NO en @section Scripts
        ════════════════════════════════════════════════════════════ *@
    @section Scripts {
        <script type="text/javascript">

            var _urlReporteActual = "";
            var _urlCrystalBase = "";

            // ── SSRS ────────────────────────────────────────────────────────────
            function abrirReporte(url) { window.open(url, "_blank"); }

            function pedirAgente(url) {
                _urlReporteActual = url;
                $("#inputIdAgente").val("");
                $("#modalAgente").modal("show");
                setTimeout(function () { $("#inputIdAgente").focus(); }, 500);
            }
            $("#btnVerReporte").on("click", function () {
                var id = $("#inputIdAgente").val().trim();
                if (!id) { toastr.error("Ingrese un ID de agente válido"); return; }
                $("#modalAgente").modal("hide");
                window.open(_urlReporteActual + "&IdAgente=" + id, "_blank");
            });
            $("#inputIdAgente").on("keypress", function (e) {
                if (e.which === 13) $("#btnVerReporte").click();
            });

            // ── CRYSTAL: directo ────────────────────────────────────────────────
            function abrirCrystalDirecto(url) { window.open(url, "_blank"); }

            // ── CRYSTAL: Solo fechas ────────────────────────────────────────────
            function pedirFechasCrystal(urlBase, titulo) {
                _urlCrystalBase = urlBase;
                $("#modalCrystalTitulo").text(titulo || "Generar Reporte");
                $("#filaCrystalCardCode").hide();
                $("#modalCrystal").modal("show");
                setTimeout(function () { $("#crystalFechaInicial").focus(); }, 400);
            }

            // ── CRYSTAL: Fechas + Cliente (Estado de Cuenta) ────────────────────
            function pedirFechasYCliente(urlBase, titulo) {
                _urlCrystalBase = urlBase;
                $("#modalCrystalTitulo").text(titulo || "Generar Reporte");
                $("#filaCrystalCardCode").show();
                $("#crystalCardCode").val("");
                $("#modalCrystal").modal("show");
                setTimeout(function () { $("#crystalFechaInicial").focus(); }, 400);
            }
            $("#btnVerCrystal").on("click", function () {
                var fi = $("#crystalFechaInicial").val().trim();
                var ff = $("#crystalFechaFinal").val().trim();
                var cc = $("#crystalCardCode").val().trim();
                if (!fi || !ff) { toastr.error("Selecciona ambas fechas"); return; }
                if (fi > ff) { toastr.error("Fecha inicial mayor que fecha final"); return; }
                var url = _urlCrystalBase
                    + "?fechaInicial=" + encodeURIComponent(fi)
                    + "&fechaFinal=" + encodeURIComponent(ff);
                if (cc) url += "&cardCode=" + encodeURIComponent(cc);
                $("#modalCrystal").modal("hide");
                window.open(url, "_blank");
            });

            // ── CRYSTAL: Solo Agente (Backorder Agentes) ────────────────────────
            function pedirAgenteCrystal(urlBase, titulo) {
                _urlCrystalBase = urlBase;
                $("#modalAgenteCrystalTitulo").text(titulo || "Reporte por Agente");
                $("#crystalAgente").val("");
                $("#modalAgenteCrystal").modal("show");
                setTimeout(function () { $("#crystalAgente").focus(); }, 400);
            }
            $("#btnVerAgenteCrystal").on("click", function () {
                var ag = $("#crystalAgente").val().trim();
                if (!ag) { toastr.error("Ingrese el código de agente"); return; }
                $("#modalAgenteCrystal").modal("hide");
                window.open(_urlCrystalBase + "?agente=" + encodeURIComponent(ag), "_blank");
            });
            $("#crystalAgente").on("keypress", function (e) {
                if (e.which === 13) $("#btnVerAgenteCrystal").click();
            });

            // ── CRYSTAL: Pedidos No Sincronizados (Cliente + Pedido) ───────────
            function pedirPedido(urlBase, titulo) {
                _urlCrystalBase = urlBase;
                $("#modalPedidoTitulo").text(titulo || "Pedidos");
                $("#pedidoCliente").val("");
                $("#pedidoNumero").val("");
                $("#modalPedido").modal("show");
                setTimeout(function () { $("#pedidoCliente").focus(); }, 400);
            }
            $("#btnVerPedido").on("click", function () {
                var cl = $("#pedidoCliente").val().trim();
                var pd = $("#pedidoNumero").val().trim();
                var url = _urlCrystalBase + "?";
                if (cl) url += "cliente=" + encodeURIComponent(cl) + "&";
                if (pd) url += "pedido=" + encodeURIComponent(pd) + "&";
                url = url.replace(/[&?]$/, ""); // quitar & o ? final
                $("#modalPedido").modal("hide");
                window.open(url, "_blank");
            });

            // ── CRYSTAL: Revisión de Rutas (6 campos) ──────────────────────────
            function pedirRuta(urlBase, titulo) {
                _urlCrystalBase = urlBase;
                $("#modalRuta .modal-title span").text(titulo || "Revisión de Rutas");
                $("#rutaVehiculo, #rutaNoRuta, #rutaAgente, #rutaDocumento").val("");
                $("#modalRuta").modal("show");
                setTimeout(function () { $("#rutaFechaInicial").focus(); }, 400);
            }
            $("#btnVerRuta").on("click", function () {
                var fi = $("#rutaFechaInicial").val().trim();
                var ff = $("#rutaFechaFinal").val().trim();
                var vh = $("#rutaVehiculo").val().trim();
                var nr = $("#rutaNoRuta").val().trim();
                var ag = $("#rutaAgente").val().trim();
                var dc = $("#rutaDocumento").val().trim();

                if (!fi || !ff) { toastr.error("Las fechas son obligatorias"); return; }
                if (fi > ff) { toastr.error("Fecha inicial mayor que fecha final"); return; }

                var url = _urlCrystalBase
                    + "?fechaInicial=" + encodeURIComponent(fi)
                    + "&fechaFinal=" + encodeURIComponent(ff);
                if (vh) url += "&vehiculo=" + encodeURIComponent(vh);
                if (nr) url += "&noRuta=" + encodeURIComponent(nr);
                if (ag) url += "&agente=" + encodeURIComponent(ag);
                if (dc) url += "&documento=" + encodeURIComponent(dc);

                $("#modalRuta").modal("hide");
                window.open(url, "_blank");
            });

        </script>
    }
