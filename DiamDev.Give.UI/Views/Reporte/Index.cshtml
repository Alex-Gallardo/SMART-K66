@* ════════════════════════════════════════════════════════════
    MODAL — Ingreso de ID de Agente
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalAgente" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-user teal"></i> Ingresar ID de Agente
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">ID Agente</label>
                    <input type="text"
                           id="inputIdAgente"
                           class="form-control"
                           placeholder="Ej: ACODEX"
                           min="1" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnVerReporte">
                    <i class="icon-ok"></i> Ver Reporte
                </button>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
    MODAL — Filtros para reportes Crystal Reports
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalCrystal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-bar-chart teal"></i>
                    <span id="modalCrystalTitulo">Generar Reporte</span>
                </h4>
            </div>
            <div class="modal-body">

                <div class="form-group">
                    <label class="control-label">Fecha Inicial</label>
                    <input type="text" id="crystalFechaInicial"
                           class="form-control date-picker"
                           data-date-format="yyyy-mm-dd"
                           placeholder="yyyy-mm-dd"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label class="control-label">Fecha Final</label>
                    <input type="text" id="crystalFechaFinal"
                           class="form-control date-picker"
                           data-date-format="yyyy-mm-dd"
                           placeholder="yyyy-mm-dd"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                @* Solo visible cuando el reporte necesita CardCode *@
                <div id="filaCrystalCardCode" class="form-group" style="display:none">
                    <label class="control-label">
                        Código Cliente SAP
                        <small class="text-muted">(vacío = todos)</small>
                    </label>
                    <input type="text" id="crystalCardCode"
                           class="form-control"
                           placeholder="Ej: CL0001" />
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default"
                        data-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary"
                        id="btnVerCrystal">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
    IFRAME — donde se muestra el reporte seleccionado
    ════════════════════════════════════════════════════════════ *@
<div id="contenedorReporte" style="display:none; margin-top:20px">
    <hr />
    <h4 id="tituloReporte" style="color:#555"></h4>
    <table width="100%" height="100%">
        <tr>
            <td>
                <iframe id="iframeReporte"
                        width="100%"
                        height="800px"
                        frameborder="0">
                </iframe>
            </td>
        </tr>
    </table>
</div>

@* ════════════════════════════════════════════════════════════
    JAVASCRIPT — Funciones para SSRS + Crystal Reports
    Nota: va directo aquí, NO en @section Scripts
    ════════════════════════════════════════════════════════════ *@
@section Scripts {
    <script type="text/javascript">

        // ─── Variables de estado ────────────────────────────────────────
        var _urlReporteActual = "";     // SSRS
        var _urlCrystalBase = "";     // Crystal con filtros

        // ═══════════════════════════════════════════════════════════════
        // SSRS
        // ═══════════════════════════════════════════════════════════════
        function abrirReporte(url) { window.open(url, "_blank"); }

        function pedirAgente(url) {
            _urlReporteActual = url;
            $("#inputIdAgente").val("");
            $("#modalAgente").modal("show");
            setTimeout(function () { $("#inputIdAgente").focus(); }, 500);
        }

        $("#btnVerReporte").on("click", function () {
            var id = $("#inputIdAgente").val().trim();
            if (!id) { toastr.error("Ingrese un ID de agente válido"); return; }
            $("#modalAgente").modal("hide");
            window.open(_urlReporteActual + "&IdAgente=" + id, "_blank");
        });

        $("#inputIdAgente").on("keypress", function (e) {
            if (e.which === 13) $("#btnVerReporte").click();
        });

        // ═══════════════════════════════════════════════════════════════
        // CRYSTAL REPORTS — Sin parámetros (abre PDF directo)
        // ═══════════════════════════════════════════════════════════════
        function abrirCrystalDirecto(url) {
            window.open(url, "_blank");
        }

        // ═══════════════════════════════════════════════════════════════
        // CRYSTAL REPORTS — Solo fechas (Revisión de Rutas, etc.)
        // ═══════════════════════════════════════════════════════════════
        function pedirFechasCrystal(urlBase, titulo) {
            _urlCrystalBase = urlBase;
            $("#modalCrystalTitulo").text(titulo || "Generar Reporte");
            $("#filaCrystalCardCode").hide();   // ocultamos campo CardCode
            $("#modalCrystal").modal("show");
            setTimeout(function () { $("#crystalFechaInicial").focus(); }, 400);
        }

        // ═══════════════════════════════════════════════════════════════
        // CRYSTAL REPORTS — Fechas + CardCode (Estado de Cuenta)
        // ═══════════════════════════════════════════════════════════════
        function pedirFechasYCliente(urlBase, titulo) {
            _urlCrystalBase = urlBase;
            $("#modalCrystalTitulo").text(titulo || "Generar Reporte");
            $("#filaCrystalCardCode").show();   // mostramos campo CardCode
            $("#crystalCardCode").val("");
            $("#modalCrystal").modal("show");
            setTimeout(function () { $("#crystalFechaInicial").focus(); }, 400);
        }

        // Botón "Ver PDF" en el modal Crystal
        $("#btnVerCrystal").on("click", function () {
            var fi = $("#crystalFechaInicial").val().trim();
            var ff = $("#crystalFechaFinal").val().trim();
            var cc = $("#crystalCardCode").val().trim();

            if (!fi || !ff) {
                toastr.error("Selecciona ambas fechas"); return;
            }
            if (fi > ff) {
                toastr.error("Fecha inicial mayor que fecha final"); return;
            }

            var url = _urlCrystalBase
                + "?fechaInicial=" + encodeURIComponent(fi)
                + "&fechaFinal=" + encodeURIComponent(ff);

            if (cc) url += "&cardCode=" + encodeURIComponent(cc);

            $("#modalCrystal").modal("hide");
            window.open(url, "_blank");
        });

    </script>
}