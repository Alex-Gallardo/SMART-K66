@{
    ViewBag.Title = "Reportes";
}

<h2><i class="icon-edit-sign teal"></i> Reportes</h2>
<hr />

@* ════════════════════════════════════════════════════════════
     COLLAPSE 1 — INVENTARIOS
    ════════════════════════════════════════════════════════════ *@
@if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Menu.Reporte_Inventario"))
{
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseInventario">
            <h4 class="panel-title">
                <i class="icon-folder-open teal"></i>
                <strong> Inventario</strong>
                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseInventario" class="panel-collapse collapse">
            <div class="panel-body">

                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Bolik"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705001">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-red"></i>
                                <h2>Inventario Bolik</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirInventario('@Url.Action("InventarioBolik", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Graco"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705004">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-yellow"></i>
                                <h2>Inventario Graco</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirInventario('@Url.Action("InventarioGraco", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Inventario_Escocesa"))
                {
                    <div class="col-md-3">
                        <div class="core-box card-empresa" data-empresa-id="20210705003">
                            <div class="heading">
                                <i class="clip-archive circle-icon circle-blue"></i>
                                <h2>Inventario Escocesa</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirInventario('@Url.Action("InventarioEscocesa", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

