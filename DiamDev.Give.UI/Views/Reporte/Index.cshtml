@* ════════════════════════════════════════════════════════════
     COLLAPSE 4 — DISTRIBUCIÓN
    ════════════════════════════════════════════════════════════ *@
@if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Menu.Reporte_Distribucion"))
{
    <div class="panel panel-default">
        <div class="panel-heading" style="cursor:pointer" data-toggle="collapse" data-target="#collapseDistibucion">
            <h4 class="panel-title">
                <i class="icon-truck teal"></i>
                <strong> Distribución</strong>
                <span class="pull-right"><i class="icon-angle-down"></i></span>
            </h4>
        </div>
        <div id="collapseDistibucion" class="panel-collapse collapse">
            <div class="panel-body">

                @* BACKORDER BOLIK — empresa 20210705001, pasa empresaId al modal *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Distribucion_Backorder_Bolik"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705001">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-data circle-icon circle-teal"></i>
                                <h2>Backorder Bolik</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirBackorder('@Url.Action("BackorderAgenteBolik", "Reporte")', 'Backorder Bolik', '20210705001')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @* BACKORDER GRACO — empresa 20210705004 *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Distribucion_Backorder_Graco"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705004">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-data circle-icon circle-teal"></i>
                                <h2>Backorder Graco</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirBackorder('@Url.Action("BackorderAgenteGraco", "Reporte")', 'Backorder Graco', '20210705004')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @* BACKORDER FAES — empresa 20210705003 *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Distribucion_Backorder_Faes"))
                {
                    <div class="col-md-3 card-empresa" data-empresa-id="20210705003">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-data circle-icon circle-teal"></i>
                                <h2>Backorder Faes</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirBackorder('@Url.Action("BackorderAgenteFaes", "Reporte")', 'Backorder Faes', '20210705003')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @* ESTADO PEDIDO — datos de SQL Server, sin filtro de empresa *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Distribucion_Estado_Pedido"))
                {
                    <div class="col-md-3">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-stats circle-icon circle-red"></i>
                                <h2>Estado Pedido</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="pedirRuta('@Url.Action("EstadoPedido", "Reporte")', 'Estado Pedido')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

                @* RUTAS — sin filtro de empresa (reporte general HANA) *@
                @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Reporte.Distribucion_Ruta"))
                {
                    <div class="col-md-3">
                        <div class="core-box">
                            <div class="heading">
                                <i class="clip-truck circle-icon circle-green"></i>
                                <h2>Ruta</h2>
                            </div>
                            <a href="javascript:void(0)"
                               onclick="abrirCrystalDirecto('@Url.Action("DespachosEnRutaDia", "Reporte")')"
                               class="view-more">Ver Reporte <i class="clip-arrow-right-2"></i></a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}


@* ════════════════════════════════════════════════════════════
     MODAL — INVENTARIO (Código + Nombre Producto)
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalInventario" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-stack-2 teal"></i>
                    <span id="modalInventarioTitulo">Inventarios</span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">Código Producto <small class="text-muted">(vacío = todos)</small></label>
                    <input type="text" id="codigoProducto" class="form-control" placeholder="Ej: XCODEX" />
                </div>
                <div class="form-group">
                    <label class="control-label">Nombre Producto <small class="text-muted">(vacío = todos)</small></label>
                    <input type="text" id="nombreProducto" class="form-control" placeholder="Ej: Lapicero" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerInventario">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
     MODAL — ESTADO PEDIDO / RUTAS (6 campos, SQL Server)
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalRuta" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-truck teal"></i> Estado Pedido
                </h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Inicial <span class="text-danger">*</span></label>
                            <input type="text" id="rutaFechaInicial" class="form-control date-picker"
                                   data-date-format="yyyy-mm-dd"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Final <span class="text-danger">*</span></label>
                            <input type="text" id="rutaFechaFinal" class="form-control date-picker"
                                   data-date-format="yyyy-mm-dd"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Vehículo <small class="text-muted">(vacío = todos)</small></label>
                            <input type="text" id="rutaVehiculo" class="form-control" placeholder="Ej: P-123ABC" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">No. Ruta <small class="text-muted">(vacío = todas)</small></label>
                            <input type="text" id="rutaNoRuta" class="form-control" placeholder="Ej: 5" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Agente <small class="text-muted">(vacío = todos)</small></label>
                            <input type="text" id="rutaAgente" class="form-control" placeholder="Ej: ACODEX" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Documento <small class="text-muted">(vacío = todos)</small></label>
                            <input type="text" id="rutaDocumento" class="form-control" placeholder="Ej: FAC-001" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerRuta">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
     MODAL — BACKORDER
     NUEVO: select de Agente poblado dinámicamente desde
            GetUserEmpresaInfo según la empresa del reporte.
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalBackorder" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="clip-data teal"></i>
                    <span id="modalBackorderTitulo">Backorder</span>
                </h4>
            </div>
            <div class="modal-body">

                @* ── AGENTE — se llena en JS con los agentes del usuario para esta empresa *@
                <div class="form-group">
                    <label class="control-label">
                        Agente
                        <small class="text-muted" id="boAgenteHelp"></small>
                    </label>
                    <select id="boAgente" class="form-control">
                        <option value="*">-- Todos --</option>
                    </select>
                </div>

                <hr style="margin:8px 0" />

                @* ── FILTROS OPCIONALES *@
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Cliente <small class="text-muted">(vacío = todos)</small></label>
                            <input type="text" id="boCliente" class="form-control" placeholder="Ej: CL0001" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Producto <small class="text-muted">(vacío = todos)</small></label>
                            <input type="text" id="boProducto" class="form-control" placeholder="Ej: ART-001" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label">No. Pedido <small class="text-muted">(vacío = todos)</small></label>
                    <input type="text" id="boPedido" class="form-control" placeholder="Ej: 12345" />
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerBackorder">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
     MODAL — DETALLE FACTURAS
     NUEVO: opción FAES agregada. Las opciones se filtran en JS.
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalDetalleFacturas" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-doc-text-inv teal"></i> Detalle Facturas
                </h4>
            </div>
            <div class="modal-body">

                @* data-empresa-id en cada <option> permite al JS filtrar por acceso del usuario *@
                <div class="form-group">
                    <label class="control-label">Empresa <span class="text-danger">*</span></label>
                    <select id="dfEmpresa" class="form-control">
                        <option value="SBOBOLIK" data-empresa-id="20210705001">Bolik</option>
                        <option value="SBOESCOCESA" data-empresa-id="20210705003">Escocesa</option>
                        <option value="SBO_GRACO" data-empresa-id="20210705004">Graco</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Inicial <span class="text-danger">*</span></label>
                            <input type="text" id="dfFechaInicial" class="form-control date-picker"
                                   data-date-format="yyyy-mm-dd"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Final <span class="text-danger">*</span></label>
                            <input type="text" id="dfFechaFinal" class="form-control date-picker"
                                   data-date-format="yyyy-mm-dd"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Código Cliente <small class="text-muted">(opcional)</small></label>
                            <input type="text" id="dfCliente" class="form-control" placeholder="Ej: CL0001" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Código Artículo <small class="text-muted">(opcional)</small></label>
                            <input type="text" id="dfCodigo" class="form-control" placeholder="Ej: ART-001" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label">Nombre Artículo <small class="text-muted">(opcional)</small></label>
                    <input type="text" id="dfProducto" class="form-control" placeholder="Ej: DOMO" />
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerDetalleFacturas">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
     MODAL — Crystal Reports fechas genéricas (Estado de Cuenta, etc.)
    ════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalCrystal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="icon-bar-chart teal"></i>
                    <span id="modalCrystalTitulo">Generar Reporte</span>
                </h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">Fecha Inicial</label>
                    <input type="text" id="crystalFechaInicial" class="form-control date-picker"
                           data-date-format="yyyy-mm-dd"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label class="control-label">Fecha Final</label>
                    <input type="text" id="crystalFechaFinal" class="form-control date-picker"
                           data-date-format="yyyy-mm-dd"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div id="filaCrystalCardCode" class="form-group" style="display:none">
                    <label class="control-label">Código Cliente SAP <small class="text-muted">*</small></label>
                    <input type="text" id="crystalCardCode" class="form-control" placeholder="Ej: CL0001" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnVerCrystal">
                    <i class="icon-file-pdf-alt"></i> Ver PDF
                </button>
            </div>
        </div>
    </div>
</div>


@* ════════════════════════════════════════════════════════════
     JAVASCRIPT — Al final del archivo, FUERA de @section Scripts
     (el proyecto tiene problemas con @section Scripts en algunos layouts)
    ════════════════════════════════════════════════════════════ *@
<script type="text/javascript">

    // ╔══════════════════════════════════════════════════════╗
    // ║  ESTADO GLOBAL                                       ║
    // ╚══════════════════════════════════════════════════════╝
    var _userEmpresaInfo    = null;   // respuesta de GetUserEmpresaInfo
    var _urlCrystalBase     = "";
    var _urlBackorderBase   = "";
    var _urlDetalleFacturas = "";
    var _empresaIdBackorder = null;   // string "20210705001" / "20210705003" / "20210705004"

    // Constantes de empresa — coinciden con los Empresa_Id de Usuario_Empresa
    // Usamos STRING para evitar pérdida de precisión en comparaciones JS
    var EMP_BOLIK = "20210705001";
    var EMP_FAES  = "20210705003";
    var EMP_GRACO = "20210705004";

    // ╔══════════════════════════════════════════════════════╗
    // ║  CARGA INICIAL                                       ║
    // ╚══════════════════════════════════════════════════════╝
    $(document).ready(function () {
        cargarInfoEmpresaUsuario();
    });

    /**
     * Llama al endpoint GetUserEmpresaInfo y guarda el resultado
     * en _userEmpresaInfo para que toda la página lo use.
     * Es como hacer un fetch() en TypeScript y guardar en un estado global.
     */
    function cargarInfoEmpresaUsuario() {
        $.getJSON('@Url.Action("GetUserEmpresaInfo", "Reporte")', function (data) {
            _userEmpresaInfo = data;
            aplicarVisibilidadReportes();
            filtrarEmpresasDetalleFacturas();
            debugger
        }).fail(function () {
            // Si la llamada falla por cualquier razón, dejamos todo visible
            // para no bloquear al usuario sin motivo.
            console.warn("[ReporteIndex] No se pudo cargar info de empresas del usuario.");
        });
    }

    // ╔══════════════════════════════════════════════════════╗
    // ║  VISIBILIDAD POR EMPRESA                             ║
    // ╚══════════════════════════════════════════════════════╝

    /**
     * Devuelve true si el usuario tiene acceso a la empresaId dada.
     * param {string} empresaIdStr  Ej: "20210705001"
     */
    function tieneAccesoEmpresa(empresaIdStr) {
        if (!_userEmpresaInfo) return true; // sin datos: no bloquear
        return _userEmpresaInfo.Agentes.some(function (a) {
            return a.EmpresaId === empresaIdStr;
        });
    }

    /**
     * Recorre todos los elementos con clase .card-empresa y data-empresa-id
     * y los oculta si el usuario no tiene acceso.
     * Equivalente a un v-if de Vue: el elemento existe en el DOM pero se oculta.
     */
    function aplicarVisibilidadReportes() {
        $(".card-empresa[data-empresa-id]").each(function () {
            // jQuery auto-castea data-empresa-id a número, lo volvemos string para comparar
            var id = $(this).data("empresa-id").toString();
            if (!tieneAccesoEmpresa(id)) {
                $(this).hide();
            }
        });
    }

    /**
     * Filtra las <option> del select de empresa en el modal de Detalle Facturas.
     * Opciones con data-empresa-id vacío (Escocesa) siempre se muestran.
     * Si después del filtro solo queda 1 opción, la auto-selecciona.
     */
    function filtrarEmpresasDetalleFacturas() {
        if (!_userEmpresaInfo) return;

        $("#dfEmpresa option").each(function () {
            var empId = $(this).attr("data-empresa-id");
            // empId vacío ("") = empresa sin filtro de Usuario_Empresa → siempre visible
            if (empId && empId !== "" && !tieneAccesoEmpresa(empId)) {
                $(this).remove();
            }
        });

        // Auto-selecciona si queda solo 1 opción
        var opciones = $("#dfEmpresa option");
        if (opciones.length === 1) {
            $("#dfEmpresa").val(opciones.first().val());
        }

        // Si no quedan opciones → ocultar el card completo de Detalle Facturas
        if (opciones.length === 0 && $("#cardDetalleFacturas").length) {
            $("#cardDetalleFacturas").hide();
        }
    }

    // ╔══════════════════════════════════════════════════════╗
    // ║  FUNCIONES DE APERTURA DE REPORTES                   ║
    // ╚══════════════════════════════════════════════════════╝

    // ── Sin parámetros ────────────────────────────────────────────────────────
    function abrirCrystalDirecto(url) {
        window.open(url, "_blank");
    }

    // ── Inventario (Código + Nombre Producto) ─────────────────────────────────
    function pedirInventario(urlBase, titulo) {
        _urlCrystalBase = urlBase;
        $("#modalInventarioTitulo").text(titulo || "Inventarios");
        $("#codigoProducto, #nombreProducto").val("");
        $("#modalInventario").modal("show");
        setTimeout(function () { $("#codigoProducto").focus(); }, 400);
    }

    $("#btnVerInventario").on("click", function () {
        var cod = $("#codigoProducto").val().trim();
        var nom = $("#nombreProducto").val().trim();
        var url = _urlCrystalBase + "?";
        if (cod) url += "Codigo_Producto=" + encodeURIComponent(cod) + "&";
        if (nom) url += "Producto_Name="   + encodeURIComponent(nom) + "&";
        url = url.replace(/[&?]$/, "");
        $("#modalInventario").modal("hide");
        window.open(url, "_blank");
    });

    // ── Backorder (Agente + filtros opcionales) ───────────────────────────────
    /**
     * param {string} urlBase       URL de la action del controller
     * param {string} titulo        Título para el modal
     * param {string} empresaId     String "20210705001" / "20210705003" / "20210705004"
     */
    function pedirBackorder(urlBase, titulo, empresaId) {
        _urlBackorderBase   = urlBase;
        _empresaIdBackorder = empresaId ? empresaId.toString() : null;

        $("#modalBackorderTitulo").text(titulo || "Backorder");

        // ── Poblar select de agentes para esta empresa ────────────────────────
        var sel = $("#boAgente");
        sel.empty().append('<option value="*">-- Todos --</option>');
        $("#boAgenteHelp").text("");

        if (_userEmpresaInfo && _empresaIdBackorder) {
            var agentes = _userEmpresaInfo.Agentes.filter(function (a) {
                return a.EmpresaId === _empresaIdBackorder;
            });

            if (agentes.length === 0) {
                // Caso: el usuario está registrado en la empresa pero no tiene
                // ningún agente asociado — situación de datos incompletos.
                $("#boAgenteHelp").text("(sin agentes registrados)");
            } else {
                $.each(agentes, function (i, a) {
                    if (a.AgenteNombre) {
                        sel.append($("<option>", {
                            value: a.AgenteNombre,
                            text:  a.AgenteNombre
                        }));
                    }
                });

                // Si el usuario tiene un solo agente para esta empresa,
                // lo preseleccionamos para ahorrar un click.
                if (agentes.length === 1 && agentes[0].AgenteNombre) {
                    sel.val(agentes[0].AgenteNombre);
                }
            }
        }

        // Limpiar filtros opcionales
        $("#boCliente, #boProducto, #boPedido").val("");
        $("#modalBackorder").modal("show");
        setTimeout(function () { sel.focus(); }, 400);
    }

    $("#btnVerBackorder").on("click", function () {
        var ag = $("#boAgente").val();       // "*" o nombre del agente
        var cl = $("#boCliente").val().trim();
        var pr = $("#boProducto").val().trim();
        var pd = $("#boPedido").val().trim();

        var url = _urlBackorderBase + "?";
        // Siempre mandamos agente (incluso "*") para que el controller lo reciba
        url += "agente=" + encodeURIComponent(ag) + "&";
        if (cl) url += "cliente="  + encodeURIComponent(cl) + "&";
        if (pr) url += "producto=" + encodeURIComponent(pr) + "&";
        if (pd) url += "pedido="   + encodeURIComponent(pd) + "&";
        url = url.replace(/[&?]$/, "");

        $("#modalBackorder").modal("hide");
        window.open(url, "_blank");
    });

    // ── Crystal fechas genéricas ──────────────────────────────────────────────
    function pedirFechasCrystal(urlBase, titulo) {
        _urlCrystalBase = urlBase;
        $("#modalCrystalTitulo").text(titulo || "Generar Reporte");
        $("#filaCrystalCardCode").hide();
        $("#crystalCardCode").val("");
        $("#modalCrystal").modal("show");
        setTimeout(function () { $("#crystalFechaInicial").focus(); }, 400);
    }

    // ── Crystal fechas + CardCode (Estado de Cuenta) ──────────────────────────
    function pedirFechasYCliente(urlBase, titulo) {
        _urlCrystalBase = urlBase;
        $("#modalCrystalTitulo").text(titulo || "Generar Reporte");
        $("#filaCrystalCardCode").show();
        $("#crystalCardCode").val("");
        $("#modalCrystal").modal("show");
        setTimeout(function () { $("#crystalFechaInicial").focus(); }, 400);
    }

    $("#btnVerCrystal").on("click", function () {
        var fi = $("#crystalFechaInicial").val().trim();
        var ff = $("#crystalFechaFinal").val().trim();
        var cc = $("#crystalCardCode").val().trim();
        if (!fi || !ff) { toastr.error("Selecciona ambas fechas"); return; }
        if (fi > ff)    { toastr.error("Fecha inicial mayor que fecha final"); return; }
        var url = _urlCrystalBase
            + "?fechaInicial=" + encodeURIComponent(fi)
            + "&fechaFinal="   + encodeURIComponent(ff);
        if (cc) url += "&cardCode=" + encodeURIComponent(cc);
        $("#modalCrystal").modal("hide");
        window.open(url, "_blank");
    });

    // ── Estado Pedido / Rutas (6 campos) ─────────────────────────────────────
    function pedirRuta(urlBase, titulo) {
        _urlCrystalBase = urlBase;
        $("#rutaVehiculo, #rutaNoRuta, #rutaAgente, #rutaDocumento").val("");
        $("#modalRuta").modal("show");
        setTimeout(function () { $("#rutaFechaInicial").focus(); }, 400);
    }

    $("#btnVerRuta").on("click", function () {
        var fi = $("#rutaFechaInicial").val().trim();
        var ff = $("#rutaFechaFinal").val().trim();
        var vh = $("#rutaVehiculo").val().trim();
        var nr = $("#rutaNoRuta").val().trim();
        var ag = $("#rutaAgente").val().trim();
        var dc = $("#rutaDocumento").val().trim();
        if (!fi || !ff) { toastr.error("Las fechas son obligatorias"); return; }
        if (fi > ff)    { toastr.error("Fecha inicial mayor que fecha final"); return; }
        var url = _urlCrystalBase
            + "?fechaInicial=" + encodeURIComponent(fi)
            + "&fechaFinal="   + encodeURIComponent(ff);
        if (vh) url += "&vehiculo="  + encodeURIComponent(vh);
        if (nr) url += "&noRuta="    + encodeURIComponent(nr);
        if (ag) url += "&agente="    + encodeURIComponent(ag);
        if (dc) url += "&documento=" + encodeURIComponent(dc);
        $("#modalRuta").modal("hide");
        window.open(url, "_blank");
    });

    // ── Detalle Facturas ──────────────────────────────────────────────────────
    function pedirDetalleFacturas(urlBase) {
        _urlDetalleFacturas = urlBase;
        $("#dfCliente, #dfCodigo, #dfProducto").val("");
        $("#modalDetalleFacturas").modal("show");
        setTimeout(function () { $("#dfFechaInicial").focus(); }, 400);
    }

    $("#btnVerDetalleFacturas").on("click", function () {
        var emp = $("#dfEmpresa").val();
        var fi  = $("#dfFechaInicial").val().trim();
        var ff  = $("#dfFechaFinal").val().trim();
        var cl  = $("#dfCliente").val().trim();
        var cd  = $("#dfCodigo").val().trim();
        var pr  = $("#dfProducto").val().trim();
        if (!fi || !ff) { toastr.error("Selecciona ambas fechas"); return; }
        if (fi > ff)    { toastr.error("Fecha inicial mayor que fecha final"); return; }
        var url = _urlDetalleFacturas
            + "?empresa="      + encodeURIComponent(emp)
            + "&fechaInicial=" + encodeURIComponent(fi)
            + "&fechaFinal="   + encodeURIComponent(ff);
        if (cl) url += "&cliente="  + encodeURIComponent(cl);
        if (cd) url += "&codigo="   + encodeURIComponent(cd);
        if (pr) url += "&producto=" + encodeURIComponent(pr);
        $("#modalDetalleFacturas").modal("hide");
        window.open(url, "_blank");
    });

</script>