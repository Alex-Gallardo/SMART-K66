
@{
    ViewBag.Title = "Inventario IDs x Tienda y Producto";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Inventario IDs x Tienda y Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i>Inventario IDs x Tienda y Producto</h2>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Tienda<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("CentroId", (SelectList)ViewBag.Centros, "--Seleccione una Tienda--", new { @class = "form-control search-select required" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Producto<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("ProductoId", (SelectList)ViewBag.Productos, "--Seleccione un Producto--", new { @class = "form-control search-select required" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" id="Aceptar" type="button" tabindex="2">
                                    <span class="ladda-label"> Generar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Inventario_IDs_x_Tienda_Producto", "Reporte")" tabindex="3">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<table width="100%" height="100%">
    <tr>
        <td>
            <iframe id="myReport" width="100%" height="800px"></iframe>
        </td>
    </tr>
</table>

@section Scripts
{
    <script type="text/javascript">

        $(function ()
        {
            $("#myReport").hide();

            $("#Aceptar").on("click", function ()
            {
                var CentroId = $("#CentroId").val();
                var ProductoId = $("#ProductoId").val();

                if (CentroId === "")
                {
                    toastr.error('Debe seleccionar una tienda');
                    return;
                }

                ObtenerInventario(CentroId, ProductoId);

                $("#myReport").show();

            });
        });

        function ObtenerInventario(CentroId, ProductoId)
        {
            document.getElementById("myReport").src = "@Url.Content("~/Reports/ReportViewer.aspx?ReportID=ReportInventarioIDsxTiendaYProducto")&CentroId=" + CentroId + "&ProductoId=" + ProductoId;
        }

    </script>
}




