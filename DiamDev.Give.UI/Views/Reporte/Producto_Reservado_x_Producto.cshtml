@{
    ViewBag.Title = "Producto Reservado x Producto";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Producto Reservado x Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i>Producto Reservado x Producto</h2>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }                           
                        </div>                       
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Inicial<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaInicial" name="FechaInicial" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Final<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaFinal" name="FechaFinal" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">   
                            <div class="form-group">
                                <label class="control-label">
                                    Tienda<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("CentroId", (SelectList)ViewBag.Centros, "--Seleccione una Tienda--", new { @class = "form-control search-select required" })
                            </div> 
                            <div class="form-group">
                                <label class="control-label">
                                    Estado(Operado)<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("EstadoId", (SelectList)ViewBag.Estados, "--Seleccione un Estado--", new { @class = "form-control search-select required" })
                            </div>                       
                            <div class="form-group">
                                <label class="control-label">
                                    Categoria<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("CategoriaId", (SelectList)ViewBag.Categorias, "--Seleccione una Categoria--", new { @class = "form-control search-select required" })
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Producto<span class="symbol required"></span>
                                </label>
                                <select id="ProductoId" name="ProductoId" class="form-control search-select required">
                                    <option value="0">--Seleccione un Producto--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" id="Aceptar" type="button">
                                    <span class="ladda-label"> Generar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Producto_Reservado_x_Producto", "Reporte")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<table width="100%" height="100%">
    <tr>
        <td>
            <iframe id="myReport" width="100%" height="800px"></iframe>
        </td>
    </tr>
</table>

@section Scripts
{
    <script type="text/javascript">

        $(function ()
        {
            $("#myReport").hide();

            $("#CategoriaId").change(function ()
            {
                if ($("#CategoriaId").val() !== "")
                {
                    var ProductoSelect = $("#ProductoId");
                    ProductoSelect.empty();
                    ProductoSelect.append('<option value="0">--Seleccione un Producto--</option>');

                    $.ajax({
                        url: '@Url.Action("ObtenerProductoxCategoriaId", "Producto")',
                        data: { 'id': $('#CategoriaId').val() },
                        traditional: true,
                        async: false,
                        type: 'GET',
                        success: function (data)
                        {                           
                            $.each(data, function (j)
                            {   
                                ProductoSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                            });
                        }
                    });
                }
            });

            $("#Aceptar").on("click", function ()
            {
                var FechaInicial = $("#FechaInicial").val();
                var FechaFinal = $("#FechaFinal").val();
                var EstadoId = $("#EstadoId").val();
                var CentroId = $("#CentroId").val();
                var CategoriaId = $("#CategoriaId").val();
                var ProductoId = $("#ProductoId").val();

                if (FechaInicial === "")
                {
                    toastr.error('Debe ingresar la fecha inicial');
                    return;
                }

                if (FechaFinal === "")
                {
                    toastr.error('Debe ingresar la fecha final');
                    return;
                }

                if (EstadoId === "")
                {
                    toastr.error('Debe seleccionar un estado');
                    return;
                }

                if (CentroId === "")
                {
                    toastr.error('Debe seleccionar una tienda');
                    return;
                }
               
                ObtenerVentas(FechaInicial, FechaFinal, EstadoId, CentroId, CategoriaId, ProductoId);

                $("#myReport").show();

            });

        });

        function ObtenerVentas(FechaInicial, FechaFinal, EstadoId, CentroId, CategoriaId, ProductoId)
        {
            document.getElementById("myReport").src = "@Url.Content("~/Reports/ReportViewer.aspx?ReportID=ReportProductoReservado")&FechaInicial=" + FechaInicial + "&FechaFinal=" + FechaFinal + "&EstadoId=" + EstadoId + "&CentroId=" + CentroId + "&CategoriaId=" + CategoriaId + "&ProductoId=" + ProductoId;
        }

    </script>
}

