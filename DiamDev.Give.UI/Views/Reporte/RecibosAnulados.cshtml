
@{
    ViewBag.Title = "Recibos Anulados";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Recibos Anulados
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i>Recibos Anulados</h2>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Sucursal <span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("CentroId", (SelectList)ViewBag.Centros, "--Seleccione una Agencia--", new { @class = "form-control search-select required" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Inicial<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaInicial" name="FechaInicial" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required tabindex="1">
                                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha Final<span class="symbol required"></span>
                                </label>
                                <div class="input-group">
                                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaFinal" name="FechaFinal" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required tabindex="2">
                                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                                </div>
                            </div>
                        </div>
                    </div>
                        <div class="row">
                            <p>
                                <div class="col-md-6">
                                    <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" id="Aceptar" type="button" tabindex="2">
                                        <span class="ladda-label"> Generar </span>
                                        <span class="ladda-spinner"></span>
                                        <span class="ladda-progress" style="width: 0px;"></span>
                                    </button>
                                </div>
                            </p>
                            <p>
                                <div class="col-md-6">
                                    <a class="btn btn-med-grey btn-block" href="@Url.Action("RecibosAnulados", "Reporte")" tabindex="3">
                                        Regresar <i class="icon-prev"></i>
                                    </a>
                                </div>
                            </p>
                        </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<table width="100%" height="100%">
    <tr>
        <td>
            <iframe id="myReport" width="100%" height="800px"></iframe>
        </td>
    </tr>
</table>

@section Scripts
{
    <script type="text/javascript">

        $(function ()
        {
            $("#myReport").hide();

            $("#Aceptar").on("click", function ()
            {
                var CentroId = $("#CentroId").val();
                var FechaInicial = $("#FechaInicial").val();
                var FechaFinal = $("#FechaFinal").val();

                if (CentroId !== "")
                {
                    ObtenerInventario(CentroId,FechaInicial,FechaFinal);
                }
                else
                {
                    toastr.error('Debe seleccionar una agencia');
                    return;
                }

                $("#myReport").show();

            });
        });

        function ObtenerInventario(CentroId,FechaInicial,FechaFinal)
        {
            document.getElementById("myReport").src = "@Url.Content("~/Reports/ReportViewer.aspx?ReportID=ReportRecibosAnulados")&AgenciaId=" + CentroId + "&FechaInicial=" + FechaInicial + "&FechaFinal=" + FechaFinal;
        }

    </script>
}




