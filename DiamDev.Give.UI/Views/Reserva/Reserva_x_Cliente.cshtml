@model IEnumerable<DiamDev.Give.Entities.Reserva>

@{
    ViewBag.Title = "Reserva x Cliente Listado";
}

<form action="" method="get" id="formaprincipal" name="formaprincipal">
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">
                    Cliente
                </label>
                <div class="input-group">
                    <input type="text" class="form-control" id="BuscarCliente" name="BuscarCliente" autocomplete="off" placeholder="Buscar Cliente..." autofocus>
                    <span class="input-group-btn">
                        <button class="btn btn-secondary" type="button" id="btnBuscarCliente">Buscar</button>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label">
                    Cliente<span class="symbol required"></span>
                </label>
                <input type="text" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" autocomplete="off" disabled="disabled" required />
            </div>
        </div>
    </div>
</form>
<form action="" method="get">
    <div class="row">
        <div class="col-md-12">
            <input type="hidden" id="cliente" name="cliente" value="0" />
            <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                <span class="ladda-label"> Buscar </span>
                <span class="ladda-spinner"></span>
                <span class="ladda-progress" style="width: 0px;"></span>
            </button>
        </div>
    </div>
</form>
<br />
@if (Model.Count() > 0)
{
    <div class="row">
        <div class="col-md-12">
            <button id="btnExcelReserva" data-style="slide-down" onclick="GenerarListado();" target="_blank" class="btn btn-primary btn-block ladda-button" type="button">
                <span class="ladda-label"> Generar Excel de Reservas</span>
                <span class="ladda-spinner"></span>
                <span class="ladda-progress" style="width: 0px;"></span>
            </button>
        </div>
    </div>
    <br />
}
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Reserva
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#Reserva</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>#Telefono</th>
                            <th>Operado</th>
                            <th>Anulado</th>
                            <th>Producto(s)</th>
                            <th>Total</th>
                            <th>Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Reserva in Model)
                        {
                            <tr>
                                <td>@Reserva.ReservaId</td>
                                <td>@Reserva.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@(Reserva.Cliente == null ? "No Disponible" : Reserva.Cliente.Nombre)</td>
                                <td>@(string.IsNullOrWhiteSpace(Reserva.Telefono) ? "No Disponible" : Reserva.Telefono)</td>
                                <td>@(Reserva.Operado == true ? "Sí" : "No")</td>
                                <td>@(Reserva.Anulada == true ? "Sí" : "No")</td>
                                <td>@(string.IsNullOrWhiteSpace(Reserva.Productos) ? "No Disponible" : Reserva.Productos)</td>
                                <td>@(Reserva.Detalles.Count == 0 ? "Q0.00" : Reserva.Detalles.Sum(x => x.Cantidad * x.Precio).ToString("C"))</td>
                                <td>@(Reserva.Pagos.Count == 0 ? Reserva.Detalles.Sum(x => x.Cantidad * x.Precio).ToString("C") : (Reserva.Detalles.Sum(x => x.Cantidad * x.Precio) - Reserva.Pagos.Sum(x => x.Valor)).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="seleccionar-cliente-form" class="modal fade" tabindex="-1" data-width="500" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Seleccionar Cliente</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cliente_seleccionado_tbody"></tbody>
            </table>
        </div>
    </div>
    <div class="modal-footer">
        <button id="btn-close-up-seleccionar-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        var vCliente = "";

        function GenerarListado()
        {
            window.location.href = '@Url.Action("Excel", "Reserva")?ClienteId=' + $("#cliente").val();
        }

        var clienteIds = "@Html.Raw(ViewBag.ClienteIds)";

      $(document).ready(function ()
      {
          if (clienteIds !== "0")
          {
              var modelo =
              {
                  'ClienteId': clienteIds
              };

              cargaClienteSeleccionado(modelo);
          }

            $("#BuscarCliente").autocomplete({
             source: function (request, response)
             {
                $.ajax({
                    url: '@Url.Action("ConsultaCliente", "Cliente")',
                    type: "POST",
                    dataType: "json",
                    data: { search: request.term },
                    success: function (data)
                    {
                        response($.map(data, function (item)
                        {
                            return { label: item.Nombre, value: item.Nombre };
                        }))
                    }
                })
            },
            messages:
            {
                noResults: "", results: ""
            }
            });

            $('#formaprincipal').keydown(function (evt)
            {
                if ($('#BuscarCliente').is(":focus") && (evt.which || evt.keyCode) == 13)
                {
                    cargaBusquedaCliente(evt)
                }
            });

            $('#btnBuscarCliente').click(function (evt)
            {
                cargaBusquedaCliente(evt);
            });

            function cargaBusquedaCliente(evt)
            {
                evt.preventDefault();

                if ($('#BuscarCliente').val() === "")
                {
                    error("Ingresar Nit o Nombre del Cliente");
                    $('#BuscarCliente').focus();
                    return;
                }

                var clienteActual = $('#BuscarCliente').val();
                clienteActual = clienteActual.replace(" ", "_");

                $.ajax({
                    url: '@Url.Action("ObtenerClientexTextoLibre", "Cliente")',
                    traditional: true,
                    data: { 'search': clienteActual },
                    async: false,
                    type: 'GET',
                    success: function (resultData)
                    {
                        if (resultData !== null)
                        {
                            if (resultData.Operacion)
                            {
                                if (resultData.Data.length === 1)
                                {
                                    cargaClienteSeleccionado(resultData.Data[0]);
                                }
                                else if (resultData.Data.length > 1)
                                {
                                    var fila = "";
                                    for (var i = 0; i < resultData.Data.length; i++) {
                                        fila += "<tr><td>" + resultData.Data[i].ClienteId + "</td>";
                                        fila += "<td>" + resultData.Data[i].Nombre + "</td>";
                                        fila += "<td><a href='" + resultData.Data[i].ClienteId + "," + resultData.Data[i].Nombre + "' title='Seleccionar' class='btn btn-seleccionar'><i class='clip-checkmark'></i></a></td></tr>";
                                    }

                                    $("#seleccionar-cliente-form").modal();
                                    $("#seleccionar-cliente-form").find("#cliente_seleccionado_tbody").html(fila);
                                }
                            }
                            else
                            {
                                toastr.error('El cliente ingresado no es correcto');
                            }
                        }
                        else
                        {
                            toastr.error('Ocurrió un error, al visualizar al cliente');
                            $('#BuscarCliente').val("");
                            $('#BuscarCliente').focus();
                        }
                    }
                });
            }

            $('#cliente_seleccionado_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();

                $('#btn-close-up-seleccionar-cliente').click();
                var clienteReferencia = $(this).attr("href");
                var clienteActual = clienteReferencia.split(",");

                var modelo =
                 {
                     'ClienteId': clienteActual[0],
                     'Nombre': clienteActual[1]
                 };

                cargaClienteSeleccionado(modelo);
            });

            function cargaClienteSeleccionado(cliente)
            {
                var clienteSeleccionado = obtenerClientexID(cliente.ClienteId);
                idclienteseleccionado = cliente.ClienteId;
                $('#NombreCliente').val(clienteSeleccionado.Nombre);
                $('#cliente').val(clienteSeleccionado.ClienteId);

                vCliente = $('#BuscarCliente').val();
            }

            function obtenerClientexID(id)
            {
                var cliente = null;
                var clientedirec = null;

                $.ajax({
                    url: '@Url.Action("ObtenerPorID", "Cliente")?id=' + id,
                    async: false,
                    type: 'GET',
                    success: function (data)
                    {
                        if (!data.Operacion)
                        {
                            toastr.error('Ocurrió un error, al obtener datos del cliente');
                            return;
                        }

                        cliente = data.Data;
                    },
                    fail: function (data)
                    {
                        toastr.error('Ocurrió un error, al obtener datos del cliente');
                    }
                });

                return cliente;
            }
       });
    </script>
}



