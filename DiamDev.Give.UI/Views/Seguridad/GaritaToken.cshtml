@{Layout="~/Views/Shared/_GaritaLayout.cshtml";ViewBag.Title="Verificar acceso";}
<section class="search-card" style="max-width:560px;margin:42px auto"><span class="step">ACCESO A GARITA</span><h1>Verifica tu acceso</h1><p>Escribe el código enviado a tu teléfono. Vence en 5 minutos.</p>
@using(Html.BeginForm("GaritaToken","Seguridad",FormMethod.Post)){@Html.AntiForgeryToken()@Html.ValidationSummary(false)<label for="codigo">Código de 6 dígitos</label><input id="codigo" name="codigo" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus /><button type="submit" class="confirm-button" style="margin-top:18px">Entrar a garita</button>}
<a href="@Url.Action("Login","Seguridad")">Volver al inicio de sesión</a></section>
