@model DiamDev.Give.UI.Models.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <title>Smart K66</title>
    <!-- start: META -->
    <meta charset="utf-8" />
    <!--[if IE]><meta http-equiv='X-UA-Compatible' content="IE=edge,IE=9,IE=8,chrome=1" /><![endif]-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta content="SmartK66" name="description" />
    <meta content="RAGATEC" name="author" />
    <!-- end: META -->
    <!--Plantillas CSS-->
    <link href="~/Content/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" media="screen" />
    <link href="~/Content/assets/plugins/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/assets/fonts/style.css" rel="stylesheet" />
    <link href="~/Content/assets/css/main.css" rel="stylesheet" />
    <link href="~/Content/assets/css/main-responsive.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/iCheck/skins/all.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/perfect-scrollbar/src/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/Content/assets/css/theme_dark.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/toastr.min.css" rel="stylesheet" />
    <!--[if IE 7]>
    <link rel="stylesheet" href="assets/plugins/font-awesome/css/font-awesome-ie7.min.css">
    <![endif]-->
    <!--Fin de Plantillas CSS-->
    <style>

         /* =======================================================
        FONDO LOGIN
        ======================================================= */

         body.login-background {
             min-height: 100vh;
             background: radial-gradient( circle at center, #0b6ea8 0%, #04507d 35%, #01385c 65%, #002845 100% );
             background-attachment: fixed;
         }

        body.login-custom {
            min-height: 100vh !important;
            /* Fondo radial */
            background: radial-gradient( circle at center, #0d6ea8 0%, #04537f 35%, #00365a 65%, #00213a 100% ) !important;
            background-attachment: fixed;
        }

         /* =======================================================
        CONTENEDOR
        ======================================================= */

         .login-container {
             margin-top: 20px;
         }

         /* =======================================================
        LOGO
        ======================================================= */

         .logo-k66 {
             text-align: center;
             margin-bottom: 25px;
         }

             .logo-k66 img {
                 width: 240px;
                 max-width: 100%;
                 transition: all .3s ease;
             }

                 .logo-k66 img:hover {
                     transform: scale(1.03);
                 }

         /* =======================================================
        TARJETA LOGIN
        ======================================================= */

        .box-login {
            background: rgba(255,255,255,.95);
            border-radius: 12px !important;
            padding: 25px 30px !important;
            border: none;
            box-shadow: 0 10px 35px rgba(0,0,0,.25);
            animation: fadeInLogin .8s ease;
        }

         @@keyframes fadeInLogin {
             from {
                 opacity: 0;
                 transform: translateY(15px);
             }

             to {
                 opacity: 1;
                 transform: translateY(0);
             }
         }

         /* =======================================================
        TITULO
        ======================================================= */

         .box-login h3 {
             font-size: 38px;
             font-weight: 300;
             margin-bottom: 15px;
             color: #00365a;
         }

         /* =======================================================
        INPUTS
        ======================================================= */

        .box-login .form-control {
            height: 46px;
            border-radius: 10px;
            border: 1px solid #d5dce3;
            box-shadow: none;
            font-size: 16px;
        }

             .box-login .form-control:focus {
                 border-color: #0b6ea8;
                 box-shadow: 0 0 0 3px rgba(11,110,168,.15);
             }

        }

        .input-icon > .icon-c{
            line-height: 0 !important;
            top: 16px !important;
            background-color: red;
        }

        .input-icon > [class*="icon-"] {
            top: 6px !important;
        }
            /* =======================================================
        BOTON LOGIN
        ======================================================= */

            .submitbtn {
             border-radius: 8px;
             padding: 10px 24px;
             font-size: 16px;
             transition: all .25s ease;
         }

             .submitbtn:hover {
                 transform: translateY(-2px);
                 box-shadow: 0 6px 15px rgba(0,0,0,.20);
             }

         /* =======================================================
        COPYRIGHT
        ======================================================= */

         .copyright {
             margin-top: 20px;
             color: rgba(255,255,255,.85);
             font-size: 13px;
             text-align: center;
         }

         /* =======================================================
        NAVBAR
        ======================================================= */

         .navbar-inverse {
             background: rgba(0,0,0,.15);
             border: none;
             backdrop-filter: blur(5px);
         }
    </style>

    <link rel="shortcut icon" href="~/favicon.ico" />
</head>
<body class="login example2 login-custom" >
    <div class="navbar navbar-inverse navbar-fixed-top">
        <!-- start: TOP NAVIGATION CONTAINER -->
        <div class="container">
            <div class="navbar-header">
                <!-- start: RESPONSIVE MENU TOGGLER -->
                <button data-target=".navbar-collapse" data-toggle="collapse" class="navbar-toggle" type="button">
                    <span class="clip-list-2"></span>
                </button>
                <!-- end: RESPONSIVE MENU TOGGLER -->
                <!-- start: LOGO -->
                <a class="navbar-brand" href="@Url.Action("Login", "Seguridad")">
                    Smart K66
                </a>
                <!-- end: LOGO -->
            </div>
            <div class="navbar-tools">
                <!-- start: TOP NAVIGATION MENU -->
                <ul class="nav navbar-right">
                    <!-- start: TO-DO DROPDOWN -->
                    <!-- end: TO-DO DROPDOWN-->
                    <!-- start: NOTIFICATION DROPDOWN -->
                    <!-- end: NOTIFICATION DROPDOWN -->
                    <!-- start: MESSAGE DROPDOWN -->
                    <!-- end: MESSAGE DROPDOWN -->
                    <!-- start: USER DROPDOWN 
                    <li class="dropdown current-user">
                        <a class="navbar-brand" href="@Url.Action("Pedido", "Inicio")">
                            Pedido
                        </a>
                    </li>-->
                    <!-- end: USER DROPDOWN -->
                </ul>
                <!-- end: TOP NAVIGATION MENU --> 
            </div>
        </div>
        <!-- end: TOP NAVIGATION CONTAINER -->
    </div>    
    <div class="main-login col-sm-4 col-sm-offset-4  login-container" >    
          <div class="logo logo-k66">
            <img src="~/Content/assets/images/logo.png"  alt="Grupo K66" />
        </div>
        <!-- start: LOGIN BOX -->
        <div class="box-login">
            <center><h3>Login</h3></center>
            <p style="text-align: center;">
                Ingrese su usuario y contraseña para ingresar.
            </p>
            @using (Html.BeginForm("Login", "Seguridad", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-login", id = "formaprincipal" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "errorHandler alert alert-danger" })

                <div class="errorHandler alert alert-danger no-display">
                    <i class="icon-remove-sign"></i> Posee algunos errores, por favor verifique.
                </div>
                <fieldset style="padding-top: 1em;">
                    <div class="form-group">
                        <span class="input-icon">
                            <input type="text" class="form-control" autofocus placeholder="Usuario" id="Usuario" name="Usuario" required autocomplete="off" />
                            <i class="icon-user icon-c" ></i>
                        </span>
                    </div>
                    <div class="form-group form-actions">
                        <span class="input-icon">
                            <input type="password" class="form-control password" placeholder="Contraseña" id="Password" name="Password" required />
                            <i class="icon-lock icon-c"></i>
                        </span>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-bricky pull-right submitbtn">
                            Ingresar <i class="icon-circle-arrow-right"></i>
                        </button>
                    </div>
                </fieldset>
            }
        </div>
        <!-- end: LOGIN BOX -->
        <!-- start: COPYRIGHT -->
        <div class="copyright">
            @DateTime.Now.Year © - GRUPO K66
        </div>
        <!-- end: COPYRIGHT -->
    </div>
    <!--Inicio de Script-->
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Content/assets/plugins/jquery-ui/jquery-ui-1.10.2.custom.min.js"></script>
    <script src="~/Content/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/blockUI/jquery.blockUI.js"></script>
    <script src="~/Content/assets/plugins/iCheck/jquery.icheck.min.js"></script>
    <script src="~/Content/assets/plugins/perfect-scrollbar/src/jquery.mousewheel.js"></script>
    <script src="~/Content/assets/plugins/perfect-scrollbar/src/perfect-scrollbar.js"></script>
    <script src="~/Content/assets/js/main.js"></script>
    <!-- start: JAVASCRIPTS REQUIRED FOR THIS PAGE ONLY -->
    <script src="~/Content/assets/plugins/jquery-validation/dist/jquery.validate.min.js"></script>   
    <script src="~/Content/assets/js/login.js"></script>
    <!-- end: JAVASCRIPTS REQUIRED FOR THIS PAGE ONLY -->
    <script type="text/javascript">
        $(function () {
            Main.init();
            Login.init();
        });
    </script>
    <script src="~/Scripts/ladda.min.js"></script>
    <script src="~/Scripts/spin.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#formaprincipal").submit(function (e) {
                var form = $("#formaprincipal");
                form.validate();
                if (form.valid()) {
                    $("#loading").fadeIn();
                    var opts = {
                        lines: 12, // The number of lines to draw
                        length: 7, // The length of each line
                        width: 4, // The line thickness
                        radius: 10, // The radius of the inner circle
                        color: '#000', // #rgb or #rrggbb
                        speed: 1, // Rounds per second
                        trail: 60, // Afterglow percentage
                        shadow: false, // Whether to render a shadow
                        hwaccel: false // Whether to use hardware acceleration
                    };
                    var target = document.getElementById('loading');
                    var spinner = new Spinner(opts).spin(target);
                }
                else {
                    e.preventDefault();
                }
            });
        }
        );
    </script>   

    <!--Fin del Inicio de Script-->

    <div id="loading">
        <div id="loadingcontent">
            <p id="loadingspinner">
                Autenticando...
            </p>
        </div>
    </div>

</body>
</html>
