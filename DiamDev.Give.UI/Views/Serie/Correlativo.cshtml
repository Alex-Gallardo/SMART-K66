@model DiamDev.Give.Entities.CorrelativoModel

@{
    ViewBag.Title = "Correlativo de Serie";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nuevo Correlativo de Serie
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nuevo Correlativo de Serie</h2>
                <p>
                    Crea un nuevo correlativo de serie.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i> Series
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Serie<span class="symbol required"></span>
                                </label>
                                @Html.DropDownList("SerieId", (SelectList)ViewBag.Series, "--Seleccione una Serie--", new { @class = "form-control search-select required" })
                            </div>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i> Agencias
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">
                                    Agencia<span class="symbol required"></span>
                                </label>
                                <select id="AgenciaId" name="AgenciaId" class="form-control search-select required">
                                    <option value="0">--Seleccione una Agencia--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i> Correlativo
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Factura Inicial<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.FacturaInicial, new { @class = "form-control", @placeholder = "No. Factura Inicial", required = "required", autocomplete = "off" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">
                                    Factura Final<span class="symbol required"></span>
                                </label>
                                @Html.TextBoxFor(model => model.FacturaFinal, new { @class = "form-control", @placeholder = "No. Factura Final", required = "required", autocomplete = "off" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Correlativo", "Serie")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        $(function ()
        {            
            cargaAgencias($("#SerieId").val());

            function error(texto)
            {
                toastr.error(texto);
            }

            if ('@TempData["Serie_Correlativo-Success"]' == "OK")
            {
                toastr.success('El nuevo correlativo se guardó exitosamente');
            }

            $('#SerieId').change(function (evt)
            {
                cargaAgencias($("#SerieId").val());
            });

            function cargaAgencias(serie)
            {
                if (serie !== null)
                {
                    var AgenciaSelect = $("#AgenciaId");
                    AgenciaSelect.empty();
                    AgenciaSelect.append('<option value="0">--Seleccione una Agencia--</option>');

                    $.ajax({
                        url: '@Url.Action("ObtenerAgenciasxSerie", "Serie")',
                        data: { 'id': serie },
                        traditional: true,
                        type: 'GET',
                        success: function (data)
                        {
                            $.each(data, function (j)
                            {
                                AgenciaSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                            });
                        }
                    });
                }
            }
        });
    </script>
}