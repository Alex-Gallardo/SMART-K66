@{
    Layout = null;
    var rutaId = ViewBag.GaritaRutaId as string;
    var esDetalle = !string.IsNullOrEmpty(rutaId);
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#123c55" />
    <title>@ViewBag.Title · Garita · Smart K66</title>
    <script>(function(){try{var manual=sessionStorage.getItem('garita-theme');var dark=manual?manual==='dark':(new Date().getHours()<6||new Date().getHours()>=18);document.documentElement.setAttribute('data-theme',dark?'dark':'light');}catch(e){}})();</script>
    <link rel="stylesheet" href="@Url.Content("~/Content/garita.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/garita-refresh.css")" />
</head>
<body class="garita-shell @(esDetalle ? "garita-shell-detail" : null)">
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="topbar @(esDetalle ? "topbar-detail" : null)">
        @if (esDetalle)
        {
            <a class="search-back-link" href="@ViewBag.GaritaUrlRutas" aria-label="Volver al listado de rutas">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m11 5-7 7 7 7M4 12h16" />
                </svg>
                volver
            </a>
            <h1 id="garita-route-title">Ruta @rutaId</h1>
        }
        else
        {
            <a class="brand" href="@Url.Content("~/Garita/Index")">
                <span class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m5 12 4 4L19 6" />
                    </svg>
                </span>
                <span><strong>SMART K66</strong><small>Garita · @User.Identity.Name</small></span>
            </a>
        }
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar entre modo claro y oscuro" aria-pressed="false">
            <span class="theme-day" aria-hidden="true">☀️</span><span class="theme-night" aria-hidden="true">🌙</span>
        </button>
    </header>
    <main id="contenido" tabindex="-1">@RenderBody()</main>
    <footer class="garita-footer"><a href="tel:137" aria-label="Llamar a Distribución al 137"><span aria-hidden="true">📞</span> ¿Alguna diferencia? Llamar a Distribución · 137</a></footer>
    <script src="@Url.Content("~/Scripts/garita-ui.js")"></script>
    @RenderSection("scripts",required:false)
</body>
</html>
