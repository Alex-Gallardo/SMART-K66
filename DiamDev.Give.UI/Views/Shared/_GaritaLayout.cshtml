@{
    Layout = null;
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123c55" />
    <title>@ViewBag.Title · Garita · Smart K66</title>
    <script>(function(){try{var manual=sessionStorage.getItem('garita-theme');var dark=manual?manual==='dark':(new Date().getHours()<6||new Date().getHours()>=18);document.documentElement.setAttribute('data-theme',dark?'dark':'light');}catch(e){}})();</script>
    <link rel="stylesheet" href="@Url.Content("~/Content/garita.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/garita-refresh.css")" />
</head>
<body>
    <svg xmlns="http://www.w3.org/2000/svg" class="visually-hidden" aria-hidden="true">
        <symbol id="garita-truck" viewBox="0 0 24 24"><path d="M2 5h12v12H2zM14 9h4l3 4v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></symbol>
        <symbol id="garita-person" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
        <symbol id="garita-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
        <symbol id="garita-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 2v6M17 2v6M3 10h18"/></symbol>
        <symbol id="garita-building" viewBox="0 0 24 24"><path d="M4 21V5l8-3 8 3v16M9 8h1m4 0h1m-6 4h1m4 0h1m-5 9v-5h4v5"/></symbol>
        <symbol id="garita-qr" viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM19 14h2M19 18v3M14 21h3"/></symbol>
        <symbol id="garita-camera" viewBox="0 0 24 24"><path d="M3 7h4l2-3h6l2 3h4v13H3z"/><circle cx="12" cy="13" r="4"/></symbol>
        <symbol id="garita-box" viewBox="0 0 24 24"><path d="m3 6 9-4 9 4v12l-9 4-9-4zM3 6l9 4 9-4M12 10v12"/></symbol>
    </svg>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="topbar"><a class="brand" href="@Url.Content("~/Garita/Index")"><span class="brand-icon" aria-hidden="true">✓</span><span><strong>SMART K66</strong><small>Garita · @User.Identity.Name</small></span></a><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar entre modo claro y oscuro" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.1A8.8 8.8 0 0 1 9.9 3.5 8.8 8.8 0 1 0 20.5 14.1Z"/></svg><span class="visually-hidden">Cambiar tema</span></button></header>
    <main id="contenido">@RenderBody()</main>
    <footer><a href="tel:137" aria-label="Llamar a Distribución al 137"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 2.9 3.5 5.2c-1 1-1.2 2.3-.7 3.8 2.1 6.5 6.3 10.7 12.8 12.8 1.5.5 2.8.3 3.8-.7l2.3-3.1-4.4-3.1-2.1 1.8c-2.3-1.2-4.2-3.1-5.4-5.4l1.8-2.1-3.1-4.4Z"/></svg> ¿Alguna diferencia? Llamar a Distribución · 137</a></footer>
    <script src="@Url.Content("~/Scripts/garita-ui.js")"></script>
    @RenderSection("scripts",required:false)
</body>
</html>
