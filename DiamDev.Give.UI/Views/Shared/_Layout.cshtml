<body class="app-shell">
    <a class="app-skip-link" href="#main-content">Saltar al contenido principal</a>
    <!-- start: HEADER -->
    <div class="navbar navbar-inverse navbar-fixed-top app-navbar">
        <!-- start: TOP NAVIGATION CONTAINER -->
        <div class="container app-navbar-container">
            <div class="navbar-header">
                <!-- start: RESPONSIVE MENU TOGGLER -->
                <button data-target="#app-sidebar" data-toggle="collapse" class="navbar-toggle" type="button"
                        aria-label="Abrir menu principal" aria-controls="app-sidebar" aria-expanded="false">
                    <span class="clip-list-2"></span>
                </button>
                <!-- end: RESPONSIVE MENU TOGGLER -->
                <!-- start: LOGO -->
                <a class="navbar-brand app-brand" href="@Url.Action("Dashboard", "Inicio")">
                    <img class="app-brand-logo" src="@Url.Content("~/Content/assets/images/logo.png")"
                         alt="Grupo K66" />
                    <span class="app-brand-copy">
                        <span class="app-brand-name">Smart K66</span>
                        <span class="app-brand-context">@agenciaNombre</span>
                    </span>
                </a>
                <!-- end: LOGO -->
            </div>
            <div class="navbar-tools">
                <!-- start: TOP NAVIGATION MENU -->
                <ul class="nav navbar-right">
                    <!-- start: TO-DO DROPDOWN -->
                  
                    <!-- end: TO-DO DROPDOWN-->
                    <!-- start: NOTIFICATION DROPDOWN -->
                  
                    <!-- end: NOTIFICATION DROPDOWN -->
                    <!-- start: MESSAGE DROPDOWN -->
                   
                    <!-- end: MESSAGE DROPDOWN -->
                    <!-- start: USER DROPDOWN -->
                    <li class="dropdown current-user">
                        <a data-toggle="dropdown" class="dropdown-toggle app-user-menu" href="#"
                           aria-haspopup="true" aria-expanded="false">
                            <span class="app-user-avatar" aria-hidden="true">@usuarioInicial</span>
                            <span class="app-user-copy">
                                <span class="app-user-label">Usuario</span>
                                <span class="username">@usuarioNombre</span>
                            </span>
                            <i class="clip-chevron-down"></i>
                        </a>
                        <ul class="dropdown-menu app-user-dropdown" role="menu">
                            @Html.Partial("_LoginPartial")
                        </ul>
                    </li>
                    <!-- end: USER DROPDOWN -->
                </ul>
                <!-- end: TOP NAVIGATION MENU -->
            </div>
        </div>
        <!-- end: TOP NAVIGATION CONTAINER -->
    </div>
    <!-- end: HEADER -->
    <!-- start: MAIN CONTAINER -->
    <div class="main-container app-main-container">
        <div class="navbar-content">
            <!-- start: SIDEBAR -->
            <div class="main-navigation navbar-collapse collapse app-sidebar" id="app-sidebar"
                 aria-label="Navegacion principal">
                <!-- start: MAIN MENU TOGGLER BUTTON -->
                <button type="button" class="navigation-toggler" aria-label="Contraer menu lateral"
                        aria-expanded="true">
                    <i class="clip-chevron-left"></i>
                    <i class="clip-chevron-right"></i>
                </button>
                <!-- end: MAIN MENU TOGGLER BUTTON -->
                <!-- start: MAIN NAVIGATION MENU -->
                <ul class="main-navigation-menu">
                    <li class="active open app-menu-home">
                        <a class="app-menu-link" href="@Url.Action("Dashboard", "Inicio")">
                            <i class="clip-home-3" aria-hidden="true"></i>
                            <span class="title">Inicio</span><span class="selected"></span>
                        </a>
                    </li>
                    @{Html.RenderAction("Menu", "Seguridad");}
                </ul>
                <!-- end: MAIN NAVIGATION MENU -->
            </div>
            <!-- end: SIDEBAR -->
            <button type="button" class="app-sidebar-backdrop" aria-label="Cerrar menu principal"
                    aria-hidden="true" tabindex="-1"></button>
        </div>
        <!-- start: PAGE -->
        <main class="main-content" id="main-content" tabindex="-1">
            <!-- start: PANEL CONFIGURATION MODAL FORM -->
            <div class="modal fade" id="panel-config" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                                &times;
                            </button>
                            <h4 class="modal-title">Panel Configuration</h4>
                        </div>
                        <div class="modal-body">
                            Here will be a configuration form
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">
                                Close
                            </button>
                            <button type="button" class="btn btn-primary">
                                Save changes
                            </button>
                        </div>
                    </div>
                    <!-- /.modal-content -->
                </div>
                <!-- /.modal-dialog -->
            </div>
            <!-- /.modal -->
            <!-- end: SPANEL CONFIGURATION MODAL FORM -->
            <div class="container app-content-container">
                <!-- start: PAGE HEADER -->
                <div class="row">
                    <div class="col-sm-12">
                        <!-- start: STYLE SELECTOR BOX -->
                        <div id="style_selector">
                         
                        </div>
                        <!-- end: STYLE SELECTOR BOX -->
                        <!-- start: PAGE TITLE & BREADCRUMB -->
                        <div class="app-page-heading">
                            <ol class="breadcrumb app-breadcrumb">
                                <li>
                                    <i class="clip-home-3" aria-hidden="true"></i>
                                    <a href="@Url.Action("Dashboard", "Inicio")">
                                        Inicio
                                    </a>
                                </li>
                                <li class="active">
                                    @Session["Encabezado"]
                                </li>
                            </ol>
                            <div class="page-header app-page-header">
                                <h1>@Session["Encabezado"] <small>@Session["SubEncabezado"]</small></h1>
                            </div>
                        </div>
                        <!-- end: PAGE TITLE & BREADCRUMB -->
                    </div>
                </div>
                <!-- end: PAGE HEADER -->
                <!-- start: PAGE CONTENT -->
                <noscript>El navegador debe soportar javascript!</noscript>
                @RenderBody()
                <!-- end: PAGE CONTENT-->
            </div>
        </main>
        <!-- end: PAGE -->
    </div>

<!-- start: FOOTER -->
<div class="footer clearfix app-footer">
    <div class="footer-inner">
        <span>@DateTime.Now.Year © GRUPO K66</span>
    </div>
    <div class="footer-items">
        <button type="button" class="go-top" aria-label="Volver al inicio de la pagina">
            <i class="clip-chevron-up" aria-hidden="true"></i>
        </button>
    </div>
</div>
<!-- end: FOOTER -->

<div id="loading" role="status" aria-live="polite">
    <div id="loadingcontent">
        <p id="loadingspinner">
            Procesando...
        </p>
    </div>
</div>
