<!DOCTYPE html>
@{
    var usuarioNombre = Convert.ToString(Session["Nombre"]);
    var usuarioInicial = string.IsNullOrWhiteSpace(usuarioNombre)
        ? "U"
        : usuarioNombre.Trim().Substring(0, 1).ToUpperInvariant();
    var agenciaNombre = DiamDev.Give.UI.App_Start.CustomHelper.getAgenciaNombre();
}
