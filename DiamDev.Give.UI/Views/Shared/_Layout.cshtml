<script type="text/javascript">

    $(function ()
    {
        $("principal").each(function ()
        {
            $(this).val() = "";
        });
    });

    $(function ()
    {
        Main.init();
        FormElements.init();
    });

    $(function ()
    {
        $(document).ready(function ()
        {
            loadIngresos();

            var timeDelay = 15000;           
            setTimeout(loadIngresos, timeDelay);

            function loadIngresos()
            {
                $.ajax({
                    url: '@Url.Action("ObtenerIngresosPendientes", "Producto_Ingreso")',
                    type: 'GET',
                    success: function (resultData)
                    {
                        if (resultData !== null)
                        {
                            if (resultData.Operacion == true)
                            {
                                $("#lblContadorIngresos").html(resultData.Data.CantidadIngresos);
                                $("#lblContadorIngresosxID").html(resultData.Data.CantidadIngresosxID);
                                $("#lblContadorPedidosSinOperar").html(resultData.Data.CantidadPedidosSinOperar);
                                $("#lblContadorRecibosSinDespachar").html(resultData.Data.CantidadRecibosSinDespachar);
                                $("#lblContadorFacturasSinDespachar").html(resultData.Data.CantidadFacturasSinDespachar);
                                $("#lblContadorCuentaxCobrar").html(resultData.Data.CantidadCuentaxCobrar);
                                $("#lblContadorRecibosEnvasexRecibir").html(resultData.Data.CantidadEnvasesxRecibir);
                                $("#lblContadorPedidosReciboCotizacion").html(resultData.Data.CantidadPedidosCotizacion);
                                $("#lblContadorPedidosFacturaCotizacion").html(resultData.Data.CantidadPedidosCotizacion);
                            }
                        }
                    },
                    complete: function (data)
                    {
                        setTimeout(loadIngresos, 15000);
                    }
                });
            }

            loadReparacionComentarios();

            var timeDelay = 15000;
            setTimeout(loadReparacionComentarios, timeDelay);

            function loadReparacionComentarios()
            {
                $.ajax({
                    url: '@Url.Action("ObtenerComentariosPendientes", "Reparacion")',
                    type: 'GET',
                    success: function (resultData) {
                        if (resultData !== null) {
                            if (resultData.Operacion == true) {
                                $("#lblContadorReparacionComentarioNuevos").html(resultData.Data);
                            }
                        }
                    },
                    complete: function (data)
                    {
                        setTimeout(loadReparacionComentarios, 15000);
                    }
                });
            }
        });
    });
   
</script>

<script src="~/Scripts/ladda.min.js"></script>
<script src="~/Scripts/spin.min.js"></script>
<script type="text/javascript">
    $(function () {         
            $("#formaprincipal").submit(function (e) {
                var form = $("#formaprincipal");
                form.validate();
                if (form.valid()) {
                    $("#loading").fadeIn();
                    var opts = {
                        lines: 12, // The number of lines to draw
                        length: 7, // The length of each line
                        width: 4, // The line thickness
                        radius: 10, // The radius of the inner circle
                        color: '#000', // #rgb or #rrggbb
                        speed: 1, // Rounds per second
                        trail: 60, // Afterglow percentage
                        shadow: false, // Whether to render a shadow
                        hwaccel: false // Whether to use hardware acceleration
                    };
                    var target = document.getElementById('loading');
                    var spinner = new Spinner(opts).spin(target);
                }
                else {
                    e.preventDefault();
                }
            });
        }
    );
</script>

@RenderSection("scripts", required: false)

