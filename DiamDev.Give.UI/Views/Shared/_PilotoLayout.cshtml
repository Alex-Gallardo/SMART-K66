<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#10283f" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewBag.Title · Smart K66</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/pilotos.css")" />
</head>
<body>
    <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <symbol id="i-route" viewBox="0 0 24 24"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="19" r="2"/><path d="M6 7v8a4 4 0 0 0 4 4h6M8 5h8a4 4 0 0 1 0 8h-5"/></symbol>
        <symbol id="i-truck" viewBox="0 0 24 24"><path d="M3 5h11v12H3zM14 9h4l3 4v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-13 4h2m4 0h2"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol>
        <symbol id="i-back" viewBox="0 0 24 24"><path d="M20 12H4m6-6-6 6 6 6"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="i-x" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
        <symbol id="i-exit" viewBox="0 0 24 24"><path d="M9 4H4v16h5m4-12 4 4-4 4m-5-4h13"/></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2"/></symbol>
        <symbol id="i-box" viewBox="0 0 24 24"><path d="m3 7 9-4 9 4v10l-9 4-9-4Zm0 0 9 4 9-4m-9 4v10M7 5l9 4"/></symbol>
        <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v1"/></symbol>
    </svg>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="pilot-header">
        <div class="header-inner">
            <a class="brand" href="@Url.Action("Index", "Piloto")" aria-label="Smart K66, mis rutas"><span class="brand-mark">K66</span><span class="brand-copy">SMART K66<small>Pilotos</small></span></a>
            @if (User.Identity.IsAuthenticated)
            {
                <details class="account-menu">
                    <summary><svg class="icon" aria-hidden="true"><use href="#i-user" /></svg><span>Cuenta</span></summary>
                    <div class="account-panel"><span class="eyebrow">SESIÓN INICIADA</span><strong>@User.Identity.Name</strong>
                        @using (Html.BeginForm("LogOff", "Seguridad", FormMethod.Post)) {
                            @Html.AntiForgeryToken()
                            <button class="button-secondary" type="submit"><svg class="icon" aria-hidden="true"><use href="#i-exit" /></svg>Cerrar sesión</button>
                        }
                    </div>
                </details>
            }
        </div>
    </header>
    <main id="contenido" class="pilot-main">
        @if (ViewBag.PruebasSoloLectura == true)
        {
            <div class="mode-bar"><span><svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg><strong>Solo consulta</strong></span><span>Cierre desactivado</span></div>
        }
        @RenderBody()
    </main>
    <footer class="pilot-footer">SMART K66 <span aria-hidden="true">·</span> Distribución</footer>
    <script src="@Url.Content("~/Scripts/pilotos.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
