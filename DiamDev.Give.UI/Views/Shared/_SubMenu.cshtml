@model IEnumerable<DiamDev.Give.Entities.Menu>

@if (Model != null)
{
    foreach (var item in Model)
    {
        <li>

            @if (string.IsNullOrWhiteSpace(item.Action) && string.IsNullOrWhiteSpace(item.Controller))
            {
                <a href="javascript:void(0)">
                    <span class="title"> @(item.Titulo) </span><i class="icon-arrow"></i>                   
                    <span class="selected"></span>
                </a>
            }
            else
            {
                <a href="@Url.Action(item.Action, item.Controller)">
                    <span class="title">@item.Titulo</span>
                    @if (item.MenuId == -5)
                    {
                        <span class="badge" id="lblContadorIngresos">0</span>
                    }
                    else if (item.MenuId == -4)
                    {
                        <span class="badge" id="lblContadorIngresosxID">0</span>
                    }
                    else if (item.MenuId == 0)
                    {
                        <span class="badge" id="lblContadorPedidosSinOperar">0</span>
                    }
                    else if (item.MenuId == 3)
                    {
                        <span class="badge" id="lblContadorPedidosReciboCotizacion">0</span>
                    }
                    else if (item.MenuId == 4)
                    {
                        <span class="badge" id="lblContadorRecibosSinDespachar">0</span>
                    }
                    else if (item.MenuId == 6)
                    {
                        <span class="badge" id="lblContadorPedidosFacturaCotizacion">0</span>
                    }
                    else if (item.MenuId == 7)
                    {
                        <span class="badge" id="lblContadorFacturasSinDespachar">0</span>
                    }
                    else if (item.MenuId == 8)
                    {
                        <span class="badge" id="lblContadorCuentaxCobrar">0</span>
                    }
                    else if (item.MenuId == 113)
                    {
                        <span class="badge" id="lblContadorRecibosEnvasexRecibir">0</span>
                    }
                    else if (item.MenuId == 126)
                    {
                        <span class="badge" id="lblContadorReparacionComentarioNuevos">0</span>
                    }
                </a>
            }           

            @if (item.Items != null)
            {
                <ul class="sub-menu">
                    @Html.Partial("_SubMenu", item.Items)
                </ul>
            }
            
        </li>
    }
}
