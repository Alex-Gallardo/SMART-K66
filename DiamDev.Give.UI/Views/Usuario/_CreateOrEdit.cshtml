@model DiamDev.Give.Entities.Usuario

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Nombre<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre del Usuario", required = "required", autocomplete = "off", autofocus = "autofocus" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Usuario<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Login, new { @class = "form-control", @placeholder = "Usuario", required = "required", autocomplete = "off" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Usuario Activo
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="true" @ViewBag.ActivoSi name="activo" id="ActivoSi">
                    Sí
                </label>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="false" @ViewBag.ActivoNo name="activo" id="ActivoNo">
                    No
                </label>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Password<span class="symbol required"></span>
            </label>
            @Html.PasswordFor(model => model.Password, new { @class = "form-control", @placeholder = "Password", required = "required" })
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Usar Token
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="true" @ViewBag.TokenSi name="token" id="TokenSi">
                    Sí
                </label>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="false" @ViewBag.TokenNo name="token" id="TokenNo">
                    No
                </label>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                #Celular<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Celular, new { @class = "form-control", @placeholder = "#Celular", required = "required", autocomplete = "off" })
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Departamentos</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Departamento/Consulta<span class="symbol required"></span>
            </label>
            @Html.DropDownList("DepartamentoId", (SelectList)ViewBag.Departamentos, "--Seleccione un Departamento--", new { @class = "form-control search-select required" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Roles</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Rol
            </label>
            @Html.DropDownList("RolId", (SelectList)ViewBag.Roles, "--Seleccione un Rol--", new { @class = "form-control search-select" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Rol</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="rol_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Agencias</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Agencia
            </label>
            @Html.DropDownList("AgenciaId", (SelectList)ViewBag.Agencias, "--Seleccione una Agencia--", new { @class = "form-control search-select" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-agencia">Agregar</button></p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Agencia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="agencia_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Empresas</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Empresa
            </label>
            @Html.DropDownList("EmpresaId", (SelectList)ViewBag.Empresas, "--Seleccione una Empresa--", new { @class = "form-control search-select" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Codigo de Integracion
            </label>
            <select class="form-control" id="ColaboradorId">
                <option value="">--Seleccione Colaborador</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Serie Sap<span class="symbol required"></span>
            </label>
            <input type="text" class="form-control" id="serieSap" name="serieSap" autocomplete="off" placeholder="Serie Sap...">
            @* @Html.TextBoxFor(model => model.serie_sap, new { @class = "form-control", @placeholder = "Serie Sap para Pedidos", autocomplete = "off", autofocus = "autofocus" })*@
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-empresa">Agregar</button></p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Empresa</th>
                    <th>Codigo Integracion</th>
                    <th>Serie Sap</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="empresa_tbody"></tbody>
        </table>
    </div>
</div>