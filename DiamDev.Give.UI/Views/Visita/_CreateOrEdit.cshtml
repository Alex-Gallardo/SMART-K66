@model DiamDev.Give.Entities.Visita

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Empresas</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        @if (Model != null)
         {
            if (Model.Empresas != null && Model.Empresas.Count() > 0)
            {
                <ul class="list-group checked-list-box">
                    @foreach (var e in Model.Empresas)
                    {
                        <li class="list-group-item">
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="checkbox-inline">
                                        <input type="checkbox" class="square-black" id="@string.Format("chk{0}", e.EmpresaId)" name="empresasIds" value="@e.EmpresaId" />
                                        @e.Nombre
                                    </label>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
         }
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Tipos de Visita</h2>
        <hr>
    </div>
</div>
<div class="form-group">
    <label class="control-label">
        Tipo de Visita<span class="symbol required"></span>
    </label>
    @Html.DropDownList("TipoVisitaId", (SelectList)ViewBag.Tipos, "--Seleccione un Tipo de Visita--", new { @class = "form-control search-select required" })
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="BuscarCliente" name="BuscarCliente" autocomplete="off" placeholder="Buscar Cliente...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button" id="btnBuscarCliente">Buscar</button>
                    <a href="#new-cliente-form" data-toggle="modal" class="demo btn btn-blue" style="margin-bottom: -1px;">
                        <i class="clip-plus-circle"></i>
                    </a>
                </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente<span class="symbol required"></span>
            </label>
            <input type="text" placeholder="Cliente" class="form-control" id="NombreCliente" name="NombreCliente" autocomplete="off" disabled="disabled" required />
            <input type="hidden" id="IDK66" name="IDK66" value="" />
            <input type="hidden" id="Nit" name="Nit" value="" />
            <input type="hidden" id="Nombre" name="Nombre" value="" />
            <input type="hidden" id="Direccion" name="Direccion" value="" />            
        </div>
        <div class="form-group">
            <label class="control-label">
                Dirección
            </label>
            <input type="text" placeholder="Dirección" class="form-control" id="DireccionCliente" name="DireccionCliente" autocomplete="off" disabled="disabled" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Observaciones
            </label>
            @Html.TextAreaFor(model => model.Observaciones, new { @class = "form-control", @placeholder = "Observaciones", autocomplete = "off" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Coordenadas</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Latitud<span class="symbol required"></span>
            </label>
            <input type="number" class="form-control" id="LatitudK66" value="0" disabled="disabled" />
            <input type="hidden" id="Latitud" name="Latitud" value="0" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Longitud<span class="symbol required"></span>
            </label>
            <input type="number" class="form-control" id="LongitudK66" value="0" disabled="disabled" />
            <input type="hidden" id="Longitud" name="Longitud" value="0" />
        </div>
    </div>
</div>