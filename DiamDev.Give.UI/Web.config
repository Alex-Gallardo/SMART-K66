		<!--Configuracion SAP HANA-->
		<add key="HANA_Server"    value="192.168.192.200:30015" />
		<!-- ALINEADO al endpoint validado (igual que el sincronizador) -->
		<add key="HANA_Database"  value="SBO_GRACO" />
		<!-- cosmético: solo aparece en mensajes de error, NO en la conexión -->
		<add key="HANA_TenantDB"  value="NDB" />
		<!-- tenant HANA real (este sí entra en la conexión) -->
		<add key="HANA_User"      value="SYSTEM" />
		<add key="HANA_Password"  value="7*Oa7!D5ulu0" />
		<add key="HANA_DSN"       value="BEAS_HANA" />
		<add key="HANA_Driver"    value="HDBODBC" />

		<!-- Mapeo empresa → schema HANA. PRUEBAS = TEST_*.
         CUTOVER a producción: cambiar a SBO_GRACO / SBOESCOCESA / SBOBOLIK. -->
		<add key="HanaSchema.GRACO" value="SBO_GRACO" />
		<add key="HanaSchema.FAES"  value="SBOESCOCESA" />
		<add key="HanaSchema.BOLIK" value="SBOBOLIK" />
