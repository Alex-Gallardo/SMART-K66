		<!-- Dias de gap antes de notificar-->
		<add key="DashboardDiasEnvejecido" value="3" />
		<!-- Roles que ven TODO el dashboard de recibos (sin filtro por Usuario_Empresa).
        Separados por coma, sin espacios obligatorios. Vacío = nadie es global. -->
		<add key="DashboardRolesGlobales" value="CREDITOS,ADMINISTRACION,DESARROLLO,GERENCIA" />
		<!-- Operadores cuyo encabezado de recibo se captura a mano.
         Nombres EXACTOS (sin el prefijo numérico), separados por coma.
         Si esta clave no existe, se usa el default del código. -->
		<add key="RecibosOperadoresEncabezadoEditable" value="SALA DE VENTAS,GERENCIA" />

	</appSettings>
	<!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

