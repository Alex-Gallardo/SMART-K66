@model DiamDev.Give.Entities.Configuracion

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Configuracion Padre
            </label>
            @Html.DropDownList("ConfiguracionPadreId", (SelectList)ViewBag.Padres, "--Seleccione una Configuracion Padre--", new { @class = "form-control search-select" })
        </div>        
        <div class="form-group">
            <label class="control-label">
                Nombre<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @placeholder = "Nombre de la Configuracion", required = "required", autocomplete = "off" })
        </div>        
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Identificador<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Identificador, new { @class = "form-control", @placeholder = "Identificador de la Configuracion", required = "required", autocomplete = "off" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Valor<span class="symbol required"></span>
            </label>
            @Html.TextBoxFor(model => model.Valor, new { @class = "form-control", @placeholder = "Valor de la Configuracion", required = "required", autocomplete = "off" })
        </div>
    </div>
</div>
