@model DiamDev.Give.Entities.Diario

@{
    ViewBag.Title = "Detalle del Diario";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Diario
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">              
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="DiarioId" name="DiarioId" value="@Html.Raw(Model.DiarioId)" />
                    </div>                    
                    <div class="row">
                        <div class="col-md-12"> 
                            <div class="form-group">
                                <label class="control-label">
                                    Descripci&oacute;n
                                </label>
                                <br />
                                <strong>
                                    @Model.Descripcion
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    Fecha
                                </label>
                                <br />
                                <strong>
                                    @Model.FechaDocumento.ToString("dd/MM/yyyy")
                                </strong>
                            </div>
                            <div class="form-group">
                                <label class="control-label">
                                    No. Partida
                                </label>
                                <br />
                                <strong>
                                    @Model.PartidaId
                                </strong>
                            </div>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Agencias
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Agencia</th>                                      
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Agencias != null && Model.Agencias.Count() > 0)
                                    {
                                        foreach (var Agencia in Model.Agencias)
                                        {
                                            <tr>
                                                <td>
                                                    @(Agencia.Agencia == null ? "No Disponible" : Agencia.Agencia.Nombre)
                                                </td>                                              
                                            </tr>
                                        }                                        
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="1">
                                                <strong>No contiene agencias</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <h2>
                        <i class="icon-edit-sign teal"></i>
                        <label class="control-label">
                            Cuentas
                        </label>
                    </h2>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Cuenta</th>
                                        <th>Debe</th>
                                        <th>Haber</th>                                       
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Detalles != null && Model.Detalles.Count() > 0)
                                    {
                                        foreach (var Detalle in Model.Detalles)
                                        {
                                            <tr>
                                                <td>
                                                    @(Detalle.Cuenta == null ? "No Disponible" : Detalle.Cuenta.Nombre)
                                                </td>                                               
                                                <td>
                                                    @Detalle.Debe.ToString("C")
                                                </td>
                                                <td>
                                                    @Detalle.Haber.ToString("C")
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td>
                                                <div style="text-align:left; font-size:large; font-weight:bold;">
                                                    Total:
                                                </div>
                                            </td>
                                            <td>
                                                <div style="text-align: left;font-size:large; font-weight:bold;">
                                                    @string.Format("{0:C}", Model.Detalles.Sum(x => x.Debe))
                                                </div>
                                            </td>
                                            <td>
                                                <div style="font-size:large; font-weight:bold;">
                                                    @string.Format("{0:C}", Model.Detalles.Sum(x => x.Haber))
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3">
                                                <strong>No contiene cuentas</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Diario")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>

            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

