@model DiamDev.Give.Entities.Diario

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Descripci&oacute;n del Diario</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Descripci&oacute;n<span class="symbol required"></span>
            </label>
            @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", @placeholder = "Descripción del Folio", required = "required", autocomplete = "off" })
        </div>                 
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Fecha<span class="symbol required"></span>
            </label>
            <div class="input-group">
                <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaDocumento" name="FechaDocumento" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Agencias</h2>
        <hr>
    </div>
</div>
<div class="form-group">
    <label class="control-label">
        Agencia
    </label>
    @Html.DropDownList("AgenciaId", (SelectList)ViewBag.Agencias, "--Seleccione una Agencia--", new { @class = "form-control search-select" })
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-agencia">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Agencia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="agencia_tbody"></tbody>
        </table>
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Cuentas
</h2>
<hr>
<div class="row">
    <div class="col-md-12">      
        <div class="form-group">
            <label class="control-label">
                Cuenta
            </label>
           @Html.DropDownList("CuentaId", (SelectList)ViewBag.Cuentas, "--Seleccione una Cuenta Contable--", new { @class = "form-control search-select" })
        </div>
        <div class="form-group">
            <label class="control-label">
                Saldo
            </label>
            <select id="SaldoId" name="SaldoId" class="form-control search-select">
                <option value="0">--Seleccione un Saldo--</option>
                <option value="1">Debe</option>
                <option value="2">Haber</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Valor
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="number" placeholder="Valor" class="form-control" id="Valor" name="Valor" autocomplete="off" />
            </div>
        </div>
    </div>        
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Cuenta</th>                    
                    <th>Debe</th>
                    <th>Haber</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cuenta_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-4">
            <div id="Total_Debe" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
        <div class="col-md-4">
            <div id="Total_Haber" style="font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
</div>
