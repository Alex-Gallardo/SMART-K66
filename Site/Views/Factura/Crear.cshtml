@model DiamDev.Give.Entities.Factura

@{
    ViewBag.Title = "Nueva Factura";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nueva Factura
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nueva Factura</h2>
                <p>
                    Crea una nueva factura.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>
                        <input type="hidden" id="AgenciaId" name="AgenciaId" value="@Html.Raw(DiamDev.Give.UI.App_Start.CustomHelper.getAgenciaId())" />
                    </div>
                    @Html.Partial("_CreateOrEdit")
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Factura")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

<div id="new-cliente-form" class="modal fade" tabindex="-1" data-focus-on="input:first" data-width="760" style="display: none;">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
            &times;
        </button>
        <h4 class="modal-title">Nuevo Cliente</h4>
    </div>
    <div class="modal-body">
        @Html.Partial("~/Views/Cliente/_CreateOrEdit.cshtml", new DiamDev.Give.Entities.Cliente() { Direccion = "CIUDAD" })
    </div>
    <div class="modal-footer">
        <button id="btn-save-up-cliente" class="btn btn-primary">Guardar</button>
        <button id="btn-close-up-cliente" class="btn" data-dismiss="modal" aria-hidden="true">Cerrar</button>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="producto_tr_template">
        <tr>
            <td>{{producto}}</td>
            <td>{{presentacion}}</td>
            <td>{{cantidad}}</td>
            <td>Q{{precio}}</td>
            <td>Q{{sub_total}}</td> 
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="productoIds" value="{{producto_id}}" />
                <input type="hidden" name="nombreProductoIds" value="{{producto}}" />
                <input type="hidden" name="presentacionIds" value="{{presentacion_id}}" />
                <input type="hidden" name="nombrePresentacionIds" value="{{presentacion}}" />
                <input type="hidden" name="cantidadIds" value="{{cantidad_id}}" />
                <input type="hidden" name="precioIds" value="{{precio_id}}" />
            </td>
        </tr>
    </script>
    <script type="text/html" id="forma_tr_template">
        <tr>
            <td>{{forma}}</td>
            <td>Q{{pagar}}</td>
            <td>{{nota}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="formaIds" value="{{forma_id}}" />
                <input type="hidden" name="pagarIds" value="{{pagar_id}}" />
                <input type="hidden" name="notaIds" value="{{nota_id}}" />
            </td>
        </tr>
    </script>  

    <script type="text/javascript">

        var productoIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.productoIds))');
        var productoSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombreProductoIds))');
        var presentacionIdSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.presentacionIds))');
        var presentacionSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.nombrePresentacionIds))');
        var cantidadSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.cantidadIds))');
        var precioSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.precioIds))');

        var formaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.formaIds))');
        var pagarSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.pagarIds))');
        var notaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.notaIds))');

        $(function ()
        {
        //Se selecciona por default al cliente: Consumidor Final
        $("#ClienteId").val("20170115001").trigger("change");

        function error(texto) {
            toastr.error(texto);
        }

        function cargaProducto(producto_id, producto, presentacion_id, presentacion, cantidad_id, precio_id) {
            var plantilla = $('#producto_tr_template').html();

            var modelo =
            {
                producto_id: producto_id,
                producto: producto,
                presentacion_id: presentacion_id,
                presentacion: presentacion,
                cantidad_id: cantidad_id,
                cantidad: cantidad_id,
                precio_id: precio_id,
                precio: precio_id,
                sub_total: cantidad_id * precio_id
            };

            var filaHtml = Mustache.render(plantilla, modelo);

            // agregamos la nueva fila a la tabla.
            $('#producto_tbody').append(filaHtml);
        }

        function cargaForma(forma_id, forma, pagar_id, nota_id)
        {
            var plantilla = $('#forma_tr_template').html();

            var modelo =
            {
                forma_id: forma_id,
                forma: forma,
                pagar_id: pagar_id,
                pagar: pagar_id,
                nota_id: nota_id,
                nota: nota_id
            };

            var filaHtml = Mustache.render(plantilla, modelo);

            // agregamos la nueva fila a la tabla.
            $('#forma_tbody').append(filaHtml);
        }

        renderizarProductosIniciales();
        renderizarFormasIniciales();

        $('#btn-agregar').click(function (e)
        {
            e.preventDefault();

            var producto_id = $('#ProductoId').val();
            var producto = $('#Producto').val();

            if (producto_id === "" || producto === "")
            {
                error("Seleccione un producto");
                return;
            }

            var presentacion_id = $('#PresentacionId').val();
            var presentacion = $('#PresentacionId option:selected').text();

            if (presentacion_id === "" || presentacion === "")
            {
                error("Seleccione una presentacion");
                return;
            }

            var cantidad_id = $('#Cantidad').val();

            if (cantidad_id === "")
            {
                error("Ingrese la cantidad del producto");
                return;
            }

            var precio_id = $('#PrecioActual').val();
            precio_id = parseFloat(precio_id);

            if (precio_id === 0)
            {
                error("Ingrese el precio del producto");
                return;
            }

            var existencia_id = parseFloat($('#Existencia').val());
            cantidad_id = parseFloat(cantidad_id);

            if (cantidad_id <= 0)
            {
                error("La cantidad ingresada no puede ser 0");
                return;
            }

            if (cantidad_id > existencia_id)
            {
                error("La cantidad ingresada es mayor a la existencia");
                return;
            }

            cargaProducto(producto_id, producto, presentacion_id, presentacion, cantidad_id, precio_id);
            totalizarProducto();

            $("#ProductoId").val(0);
            $("#Cantidad").val(1);
            $("#Existencia").val(0);
            $("#PrecioActual").val(0);
            $("#Producto").val("");
            $("#Barra").val("");
            $("#Barra").focus();
        });

        $('#btn-agregar-forma').click(function (e)
        {
            e.preventDefault();

            var forma_id = $('#PagoId').val();
            var forma = $('#PagoId option:selected').text();

            if (forma_id === "" || forma === "")
            {
                error("Seleccione una forma de pago");
                return;
            }

            var cantidad_id = $('#Cantidad_Pagar').val();

            if (cantidad_id === "")
            {
                error("Ingrese la cantidad a cancelar");
                return;
            }

            var nota_id = $('#Nota').val();

            cargaForma(forma_id, forma, cantidad_id, nota_id);
            totalizarPagar();

            $("#PagoId").val(0);
            $("#Cantidad_Pagar").val(0);
            $("#PagoId").focus();
        });

        $('#producto_tbody').delegate("a", "click", function (e)
        {
            e.preventDefault();
            $(this).parent().parent().remove();

            totalizarProducto();
        });

        $('#forma_tbody').delegate("a", "click", function (e)
        {
            e.preventDefault();
            $(this).parent().parent().remove();

            totalizarPagar();
        });

        function renderizarProductosIniciales()
        {
            if (productoIdSeleccionados == null)
            {
                return;
            }

            // recorremos los productos que haya ingresado el usuario
            for (var i = 0; i < productoIdSeleccionados.length; i++)
            {
                var producto_id = productoIdSeleccionados[i];
                var producto = productoSeleccionados[i];

                var presentacion_id = presentacionIdSeleccionados[i];
                var presentacion = presentacionSeleccionados[i];

                var cantidad_id = cantidadSeleccionados[i];
                var precio_id = precioSeleccionados[i];

                cargaProducto(producto_id, producto, presentacion_id, presentacion, cantidad_id, precio_id);
            }

            totalizarProducto();
        }

        function renderizarFormasIniciales()
        {
            if (formaSeleccionados == null)
            {
                return;
            }

            // recorremos las formas de pago que haya ingresado el usuario
            for (var i = 0; i < formaSeleccionados.length; i++)
            {
                var forma_id = formaSeleccionados[i];
                var forma = $('#PagoId option[value=' + forma_id + ']').text();

                var cantidad_id = pagarSeleccionados[i];
                var nota_id = notaSeleccionados[i];

                cargaForma(forma_id, forma, cantidad_id, nota_id);
            }

            totalizarPagar();
        }

        function totalizarProducto()
        {
            var cantidadArray = new Array();
            $('input[name=cantidadIds]').each(function ()
            {
                cantidadArray.push(parseFloat($(this).val()));
            });

            var precioArray = new Array();
            $('input[name=precioIds]').each(function ()
            {
                precioArray.push(parseFloat($(this).val()));
            });

            var total = 0;

            if (cantidadArray.length > 0 && precioArray.length > 0)
            {
                for (var i = 0; i < cantidadArray.length; i++)
                {
                    total += cantidadArray[i] * precioArray[i];
                }

                $('#Total').html('Q' + total.toFixed(2));
                $('#Cantidad_Pagar').val(total.toFixed(2));
            }
            else {
                $('#Total').html('Q' + total.toFixed(2));
                $('#Cantidad_Pagar').val(total.toFixed(2));
            }
        }

        function totalizarPagar()
        {
            var pagarArray = new Array();
            $('input[name=pagarIds]').each(function () {
                pagarArray.push(parseFloat($(this).val()));
            });

            var total = 0;
            var total_producto = 0;

            if (pagarArray.length > 0) {
                if (pagarArray.length > 0) {
                    for (var i = 0; i < pagarArray.length; i++) {
                        total_producto += pagarArray[i];
                    }

                    total = total_producto;

                    $('#Total_Pagar').html('Q' + parseFloat(total).toFixed(2));
                }
                else {
                    $('#Total_Pagar').html('Q' + parseFloat(total).toFixed(2));
                }
            }
            else {
                $('#Total_Pagar').html('Q' + parseFloat(total).toFixed(2));
            }
        }

        $("#btn-save-up-cliente").click(function ()
        {
            var Nit = $("#new-cliente-form").find("#Nit").val();
            var Nombre = $("#new-cliente-form").find("#Nombre").val();
            var Direccion = $("#new-cliente-form").find("#Direccion").val();
            var DPI = $("#new-cliente-form").find("#DPI").val();
            var NoTelefono = $("#new-cliente-form").find("#NoTelefono").val();
            var EmailCliente = $("#new-cliente-form").find("#EmailCliente").val();
            var Vip = false;
            var Activo = true;

            if (Nit === "") {
                error("El nit es requerido");
                return;
            }

            if (Nombre === "") {
                error("El nombre es requerido");
                return;
            }

            if (Direccion === "") {
                error("La dirección es requerida");
                return;
            }

            if (EmailCliente === "") {
                error("El correo electrónico es requerido");
                return;
            }

            var modelo =
           {
               'Nit': Nit,
               'Nombre': Nombre,
               'Direccion': Direccion,
               'DPI': DPI,
               'NoTelefono': NoTelefono,
               'EmailCliente': EmailCliente,
               'Descuento': 0,
               'Vip': Vip,
               'Activo': Activo
           };

            $.ajax({
                url: '@Url.Action("NuevoCliente", "Cliente")',
                data: { 'modelo': modelo },
                async: false,
                type: 'POST',
                success: function (data) {
                    if (data.Operacion) {
                        $('#btn-close-up-cliente').click();
                        toastr.success('El nuevo cliente se guardó exitosamente');

                        //Se agrega al nuevo cliente ingresado por el usuario
                        $('#ClienteId').append($("<option></option>").attr("value", data.Cliente).text(Nombre));

                        //Selecciona el ultimo cliente ingresado
                        $("#ClienteId").val(data.Cliente).trigger("change");
                    }
                    else {
                        toastr.error('Ocurrió un error, al guardar al nuevo cliente');
                    }
                }
            });

        });

        $('#PresentacionId').change(function (evt)
        {
            if ($('#ProductoId').val() === "")
            {
                error("Seleccionar un producto");
                return;
            }

            if ($('#PresentacionId').val() === "")
            {
                error("Seleccionar una presentacion");
                return;
            }

            var empleado = $('#EmpleadoSi').is(":checked");
           
            $.ajax({
                url: '@Url.Action("ObtenerProducto", "Producto")',
                traditional: true,
                async: false,
                data: { 'agenciaId': $('#AgenciaId').val(), 'productoId': $('#ProductoId').val(), 'presentacionId': $('#PresentacionId').val(), 'empleado': empleado },
                type: 'GET',
                success: function (resultData) {
                    if (resultData !== null) {
                        if (resultData.Operacion) {
                            $('#Existencia').val(resultData.Data.Existencia);
                            $('#PrecioActual').val(resultData.Data.PrecioActual);
                            $('#Cantidad').focus();
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el producto');
                    }
                }
            });
        });

        $('#SerieId').change(function (evt)
        {
            if ($('#SerieId').val() === "") {
                error("Seleccionar una serie");
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerFacturaActual", "Factura")',
                traditional: true,
                data: { 'serieId': $('#SerieId').val() },
                async: false,
                type: 'GET',
                success: function (resultData)
                {
                    if (resultData !== null)
                    {
                        if (resultData.Operacion)
                        {
                            $('#NoFacturaA').val(resultData.Data.Factura);
                            $('#NoFactura').val(resultData.Data.Factura);
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el no. de factura');
                        }
                    }
                    else {
                        toastr.error('Ocurrió un error, al visualizar el no. de factura');
                    }
                }
            });
        });

        $('#new-cliente-form').keydown(function (evt) {
            if ($('#Nit').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#Nombre').focus();
            }
            else if ($('#Nombre').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#Direccion').focus();
            }
            else if ($('#Direccion').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#DPI').focus();
            }
            else if ($('#DPI').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#NoTelefono').focus();
            }
            else if ($('#NoTelefono').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $('#EmailCliente').focus();
            }
            else if ($('#EmailCliente').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                $("#new-cliente-form").find("#btn-save-up-cliente").focus();
            }
        });

        $('#formaprincipal').keydown(function (evt)
        {
            if ($('#Barra').is(":focus") && (evt.which || evt.keyCode) == 13)
            {
                evt.preventDefault();
                if ($('#Barra').val() === "")
                {
                    error("Ingresar codigo de barra");
                    $('#Barra').focus();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ObtenerProductoxBarra", "Producto")',
                    traditional: true,
                    data: { 'barra': $('#Barra').val() },
                    async: false,
                    type: 'GET',
                    success: function (resultData)
                    {
                        if (resultData !== null)
                        {
                            if (resultData.Operacion)
                            {
                                $('#Producto').val(resultData.Data.Nombre);
                                $('#ProductoId').val(resultData.Data.ProductoId);

                                var PresentacionSelect = $("#PresentacionId");
                                PresentacionSelect.empty();
                                PresentacionSelect.append('<option value="0">--Seleccione una Unidad--</option>');

                                $.ajax({
                                    url: '@Url.Action("ObtenerPresentacionPorProducto", "Producto_Ingreso")',
                                    data: { 'id': $('#ProductoId').val() },
                                    traditional: true,
                                    async: false,
                                    type: 'GET',
                                    success: function (data)
                                    {
                                        $.each(data, function (j)
                                        {
                                            PresentacionSelect.append($("<option></option>").attr("value", data[j]['Value']).text(data[j]['Text']));
                                        });

                                        //Se selecciona por default a la unidad de medida: Unidad
                                        $("#PresentacionId").val("20170114001").trigger("change");
                                    }
                                });

                                $('#Cantidad').focus();
                            }
                            else
                            {
                                toastr.error('La barra del producto ingresada no es correcta');
                                $('#Barra').val("");
                                $('#Barra').focus();
                            }
                        }
                        else {
                            toastr.error('Ocurrió un error, al visualizar el producto');
                            $('#Barra').val("");
                            $('#Barra').focus();
                        }
                    }
                });
            }
            else if ($('#Cantidad').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                if ($('#Cantidad').val() === "") {
                    error("Ingresar cantidad de producto");
                    $('#Cantidad').focus();
                    return;
                }
                $('#PrecioActual').focus();
            }
            else if ($('#PrecioActual').is(":focus") && (evt.which || evt.keyCode) == 13) {
                evt.preventDefault();
                if ($('#PrecioActual').val() === "") {
                    error("Ingresar precio del producto");
                    $('#PrecioActual').focus();
                    return;
                }
                $('#btn-agregar').focus();
            }
        });
    });

    </script>  
}

