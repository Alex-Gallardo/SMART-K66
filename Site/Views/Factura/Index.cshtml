@model IEnumerable<DiamDev.Give.Entities.Factura>

@{
    ViewBag.Title = "Factura Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Factura")">
        Nueva
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<form action="" method="get" class="form-inline">     
    <div class="row">        
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Inicial<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaInicial" name="FechaInicial" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label">
                    Fecha Final<span class="symbol required"></span>
                </label>
                <div class="input-group">
                    <input type="text" data-date-format="yyyy-mm-dd" data-date-viewmode="years" class="form-control date-picker" id="FechaFinal" name="FechaFinal" autocomplete="off" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="this.form.submit();" required>
                    <span class="input-group-addon"> <i class="icon-calendar"></i> </span>
                </div>
            </div>
        </div>
    </div>
</form>
<br />
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Factura
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover" id="sample-table-1">
                    <thead>
                        <tr>                            
                            <th>Factura</th>
                            <th>Fecha</th>                           
                            <th>Cliente</th>                           
                            <th>Productos</th>                           
                            <th>Total</th>   
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Factura in Model)
                        {
                            <tr>
                                <td>@(string.Format("{0} - {1}", Factura.Serie.Nombre, Factura.NoFactura))</td>
                                <td>@Factura.Fecha.ToString("dd/MM/yyyy")</td>                               
                                <td>@(Factura.Cliente == null ? "No Disponible" : Factura.Cliente.Nombre)</td>                            
                                <td>@(Factura.Detalles == null ? 0 : (Factura.Anulada ? 0 : Factura.Detalles.Count()))</td>
                                <td>@(Factura.Detalles == null ? "Q0.00" : (Factura.Anulada ? "Q0.00" : Factura.Detalles.Sum(x => x.Cantidad * x.Precio).ToString("C")))</td>
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                        @if (!Factura.Anulada)
                                        {
                                            <a href="@Url.Action("Anular", "Factura", new { id = Factura.FacturaId })" class="btn btn-bricky tooltips" data-placement="top" data-original-title="Anular Factura"><i class="clip-close"></i></a>
                                        }
                                        <a href="@Url.Action("Detalle", "Factura", new { id = Factura.FacturaId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle de la Factura"><i class="clip-stack-empty"></i></a>
                                        @if (!Factura.Anulada)
                                        {
                                            <a href="@Url.Action("Boleta", "Factura", new { id = Factura.FacturaId })" target="_blank" class="btn btn-teal tooltips" data-placement="top" data-original-title="Ver Factura"><i class="clip-file-pdf"></i></a>
                                        }
                                    </div>
                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                        <div class="btn-group">
                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                <i class="icon-cog"></i> <span class="caret"></span>
                                            </a>
                                            <ul role="menu" class="dropdown-menu pull-right">
                                                @if (!Factura.Anulada)
                                                {
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Anular", "Factura", new { id = Factura.FacturaId })">
                                                            <i class="clip-close"></i> Anular Factura
                                                        </a>
                                                    </li>
                                                }
                                                <li role="presentation">
                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Factura", new { id = Factura.FacturaId })">
                                                        <i class="clip-stack-empty"></i> Detalle de la Factura
                                                    </a>
                                                </li>
                                                @if (!Factura.Anulada)
                                                {
                                                    <li role="presentation">
                                                        <a role="menuitem" tabindex="-1" href="@Url.Action("Boleta", "Factura", new { id = Factura.FacturaId })" target="_blank">
                                                            <i class="clip-file-pdf"></i> Ver Factura
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        $(document).ready(function ()
        {
            if ('@TempData["Factura-Success"]' == "OK")
            {
                toastr.success('La factura se guardó exitosamente');
            }
            else if ('@TempData["Factura_Anular-Success"]' == "OK")
            {
                toastr.success('La factura fue anulada exitosamente');
            }
        });
    </script>
}




