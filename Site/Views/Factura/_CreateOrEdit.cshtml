@model DiamDev.Give.Entities.Factura

<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Clientes</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Cliente<span class="symbol required"></span>
            </label>
            <div class="input-group">
                @Html.DropDownList("ClienteId", (SelectList)ViewBag.Clientes, "--SELECCIONE UN CLIENTE--", new { @class = "form-control search-select required", autofocus = "autofocus" })
                <div class="input-group-btn">
                    <a href="#new-cliente-form" data-toggle="modal" class="demo btn btn-blue" style="margin-bottom: -3px;">
                        <i class="clip-plus-circle"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Vendedores</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Vendedor<span class="symbol required"></span>
            </label>
            @Html.DropDownList("VendedorId", (SelectList)ViewBag.Vendedores, "--SELECCIONE UN VENDEDOR--", new { @class = "form-control search-select required" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Colaborador(a)</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Colaborador(a)
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="true" @ViewBag.EmpleadoSi name="empleado" id="EmpleadoSi">
                    Sí
                </label>
                <label class="radio-inline">
                    <input type="radio" class="grey" value="false" @ViewBag.EmpleadoNo name="empleado" id="EmpleadoNo">
                    No
                </label>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <h2><i class="icon-edit-sign teal"></i>Factura</h2>
        <hr>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                Serie<span class="symbol required"></span>
            </label>
            @Html.DropDownList("SerieId", (SelectList)ViewBag.Series, "--SELECCIONE UNA SERIE--", new { @class = "form-control search-select required" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label">
                No. Factura<span class="symbol required"></span>
            </label>
            <input type="number" placeholder="No. de la Factura" class="form-control" id="NoFacturaA" name="NoFacturaA" autocomplete="off" required disabled="disabled" />
            <input type="hidden" id="NoFactura" name="NoFactura" value="" />
        </div>
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Productos
</h2>
<hr>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                % Descuento
            </label>
            <input id="Descuento" name="Descuento" type="text" value="0" />
        </div>
    </div>
</div>  
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Barra
            </label>
            <div class="input-group">
                <input type="text" class="form-control" id="Barra" name="Barra" autocomplete="off" placeholder="Buscar Producto...">
                <span class="input-group-btn">
                    <button class="btn btn-secondary" type="button">Buscar</button>
                </span>
            </div>
        </div>       
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Producto
            </label>
            <input type="text" placeholder="Producto" class="form-control" id="Producto" name="Producto" autocomplete="off" disabled="disabled" />
            <input type="hidden" id="ProductoId" name="ProductoId" value="0" />
        </div>
        <div class="form-group">
            <label class="control-label">
                Unidad
            </label>
            <select id="PresentacionId" name="PresentacionId" class="form-control search-select">
                <option value="0">--SELECCIONE UNA UNIDAD--</option>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad" name="Cantidad" value="1" autocomplete="off" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Existencia
            </label>
            <input type="number" placeholder="Existencia" class="form-control" id="Existencia" name="Existencia" autocomplete="off" disabled="disabled" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Precio
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="text" placeholder="Precio de Venta" class="form-control" id="PrecioActual" name="PrecioActual" value="0" autocomplete="off" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Unidad</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Sub-Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="producto_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Total" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
</div>
<h2>
    <i class="icon-edit-sign teal"></i> Forma de Pago
</h2>
<hr>
<div class="row">
    <div class="col-md-8">
        <div class="form-group">
            <label class="control-label">
                Forma
            </label>
            @Html.DropDownList("PagoId", (SelectList)ViewBag.Formas, "--SELECCIONE UNA FORMA DE PAGO--", new { @class = "form-control search-select" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">
                Cantidad
            </label>
            <div class="input-group">
                <span class="input-group-addon">Q</span>
                <input type="number" placeholder="Cantidad" class="form-control" id="Cantidad_Pagar" name="Cantidad_Pagar" autocomplete="off" />
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">
                Nota
            </label>
            <input type="text" placeholder="Nota" class="form-control" id="Nota" name="Nota" autocomplete="off" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <p style="text-align:right"><button type="button" class="demo btn btn-blue" id="btn-agregar-forma">Agregar</button></p>
        <table class="table table-hover" id="sample-table-1">
            <thead>
                <tr>
                    <th>Forma</th>
                    <th>Cantidad</th>
                    <th>Nota</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="forma_tbody"></tbody>
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4">
            <div style="text-align:left; font-size:large; font-weight:bold;">
                Total:
            </div>
        </div>
        <div class="col-md-8">
            <div id="Total_Pagar" style="text-align: right;font-size:large; font-weight:bold;">
                Q0.00
            </div>
        </div>
    </div>
</div>
