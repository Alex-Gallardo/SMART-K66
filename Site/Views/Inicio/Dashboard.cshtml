
@{
    ViewBag.Title = "Dashboard";
}

<div class="row">
    @if (DiamDev.Give.UI.App_Start.CustomHelper.Permiso("Control.Factura.Ver_Listado"))
    {
        <div class="col-md-3">
            <div class="core-box">
                <div class="heading">
                    <i class="clip-atom-3 circle-icon circle-bricky"></i>
                    <h2>Facturas</h2>
                </div>
                <a href="@Url.Action("Index", "Factura")" class="view-more">
                    Ver Detalle <i class="clip-arrow-right-2"></i>
                </a>
            </div>
