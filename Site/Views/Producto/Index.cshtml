@model PagedList.IPagedList<DiamDev.Give.Entities.Producto>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Producto Listado";
}

<div>
    <a class="btn btn-light-grey" href="@Url.Action("Crear", "Producto")">
        Nuevo
        <i class="icon-circle-arrow-right"></i>
    </a>
</div>
<br />
<div class="row">
    <div class="col-md-12">
        <form action="" method="get" class="form-inline">
            <div class="input-group well">
                <input type="text" class="form-control" id="search" name="search" placeholder="Buscar.." value="@Html.Raw(ViewBag.Search)" autocomplete="off" style="margin-bottom: 1px;">
                <span class="input-group-btn">
                    <button class="btn btn-primary" type="button">
                        <i class="clip-search-3"></i> Buscar
                    </button>
                </span>
            </div>
        </form>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <!-- start: BASIC TABLE PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Producto
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <table class="table table-hover" id="sample-table-1">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Categoria</th>
                            <th>Marca</th>
                            <th>Unidad</th>
                            <th>Activo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Producto in Model)
                        {
                            <tr>
                                <td>@Producto.Codigo</td>
                                <td>@Producto.Nombre</td>
                                <td>@(Producto.Categoria == null ? "No Disponible" : Producto.Categoria.Nombre)</td>
                                <td>@(Producto.Marca == null ? "No Disponible" : Producto.Marca.Nombre)</td>
                                <td>@(Producto.Unidad == null ? "No Disponible" : Producto.Unidad.Nombre)</td>
                                <td>@(Producto.Activo ? "Sí" : "No")</td>
                                <td class="center">
                                    <div class="visible-md visible-lg hidden-sm hidden-xs">
                                        <a href="@Url.Action("Editar", "Producto", new { id = Producto.ProductoId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Editar"><i class="icon-edit"></i></a>
                                        <a href="@Url.Action("Detalle", "Producto", new { id = Producto.ProductoId })" class="btn btn-teal tooltips" data-placement="top" data-original-title="Detalle del Producto"><i class="clip-stack-empty"></i></a>
                                    </div>
                                    <div class="visible-xs visible-sm hidden-md hidden-lg">
                                        <div class="btn-group">
                                            <a class="btn btn-primary dropdown-toggle btn-sm" data-toggle="dropdown" href="#">
                                                <i class="icon-cog"></i> <span class="caret"></span>
                                            </a>
                                            <ul role="menu" class="dropdown-menu pull-right">
                                                <li role="presentation">
                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Editar", "Producto", new { id = Producto.ProductoId })">
                                                        <i class="icon-edit"></i> Editar
                                                    </a>
                                                </li>
                                                <li role="presentation">
                                                    <a role="menuitem" tabindex="-1" href="@Url.Action("Detalle", "Producto", new { id = Producto.ProductoId })">
                                                        <i class="clip-stack-empty"></i> Detalle del Producto
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- end: BASIC TABLE PANEL -->
    </div>
</div>

Pagina @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) de @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index", new { search = ViewBag.Search, page }))

@section Scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            if ('@TempData["Producto-Success"]' == "OK")
            {
                toastr.success('El producto se guardó exitosamente');
            }
        });
    </script>
}



