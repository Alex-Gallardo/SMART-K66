@model DiamDev.Give.Entities.Serie

@{
    ViewBag.Title = "Nueva Serie";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nueva Serie
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nueva Serie</h2>
                <p>
                    Crea una nueva serie.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>                        
                    </div>
                    @Html.Partial("_CreateOrEdit")                    
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Serie")">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>
    <script type="text/html" id="agencia_tr_template">
        <tr>
            <td>{{agencia}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="agenciaIds" value="{{agencia_id}}" />
            </td>
        </tr>
    </script>

    <script type="text/javascript">

        var agenciaSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.agenciaIds))');

        $(function ()
        {
            function error(texto)
            {
                toastr.error(texto);
            }

            function cargaAgencia(agencia_id, agencia)
            {
                var plantilla = $('#agencia_tr_template').html();

                var modelo =
                {
                    agencia_id: agencia_id,
                    agencia: agencia
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#agencia_tbody').append(filaHtml);
            }

            renderizarAgenciasIniciales();

            $('#btn-agregar').click(function (e)
            {
                e.preventDefault();

                var agencia_id = $('#AgenciaId').val();
                var agencia = $('#AgenciaId option:selected').text();

                if (agencia_id === "" || agencia === "")
                {
                    error("Seleccione una agencia");
                    return;
                }

                cargaAgencia(agencia_id, agencia);

                $("#AgenciaId").val(0);
                $("#AgenciaId").focus();
            });

            $('#agencia_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            function renderizarAgenciasIniciales()
            {
                if (agenciaSeleccionados == null)
                {
                    return;
                }

                // recorremos las agencias que haya ingresado el usuario
                for (var i = 0; i < agenciaSeleccionados.length; i++)
                {
                    var agencia_id = agenciaSeleccionados[i];
                    var agencia = $('#AgenciaId option[value=' + agencia_id + ']').text();

                    cargaAgencia(agencia_id, agencia);
                }
            }

        });
    </script>
}