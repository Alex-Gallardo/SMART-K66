@model DiamDev.Give.Entities.Usuario

@{
    ViewBag.Title = "Nuevo Usuario";
}

<div class="row">
    <div class="col-md-12">
        <!-- start: FORM VALIDATION 1 PANEL -->
        <div class="panel panel-default">
            <div class="panel-heading">
                <i class="icon-external-link-sign"></i>
                Nuevo Usuario
                <div class="panel-tools">
                    <a class="btn btn-xs btn-link panel-collapse collapses" href="javascript:void(0)">
                    </a>
                    <a class="btn btn-xs btn-link panel-expand" href="javascript:void(0)">
                        <i class="icon-resize-full"></i>
                    </a>
                    <a class="btn btn-xs btn-link panel-close" href="javascript:void(0)">
                        <i class="icon-remove"></i>
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <h2><i class="icon-edit-sign teal"></i> Nuevo Usuario</h2>
                <p>
                    Crea un nuevo usuario.
                </p>
                <hr>
                <form action="" role="form" id="formaprincipal" name="formaprincipal" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                            {
                                <div class="alert alert-danger">
                                    <button class="close" data-dismiss="alert">×</button>
                                    <h4 class="alert-heading">Error</h4>
                                    @Html.ValidationSummary(false)
                                </div>
                            }
                        </div>                        
                    </div>
                    @Html.Partial("_CreateOrEdit")                    
                    <div class="row">
                        <p>
                            <div class="col-md-6">
                                <button data-style="slide-down" class="btn btn-med-grey btn-block ladda-button" type="submit" tabindex="13">
                                    <span class="ladda-label"> Aceptar </span>
                                    <span class="ladda-spinner"></span>
                                    <span class="ladda-progress" style="width: 0px;"></span>
                                </button>
                            </div>
                        </p>
                        <p>
                            <div class="col-md-6">
                                <a class="btn btn-med-grey btn-block" href="@Url.Action("Index", "Usuario")" tabindex="14">
                                    Regresar <i class="icon-prev"></i>
                                </a>
                            </div>
                        </p>
                    </div>
                </form>
            </div>
        </div>
        <!-- end: FORM VALIDATION 1 PANEL -->
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/mustache.js"></script>    
    <script type="text/html" id="rol_tr_template">
        <tr>
            <td>{{nombre}}</td>          
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="rolesIds" value="{{id}}" />               
            </td>
        </tr>
    </script>
    <script type="text/html" id="agencia_tr_template">
        <tr>
            <td>{{nombre}}</td>
            <td>
                <a href="javascript:void(0)" title="Eliminar" class="btn btn-eliminar"><i class="clip-remove"></i></a>
                <input type="hidden" name="agenciasIds" value="{{id}}" />
            </td>
        </tr>
    </script>

    <script type="text/javascript">

        var rolesSeleccionados = JSON.parse('@Html.Raw(Json.Encode(ViewBag.RolesIds))');
        var agenciasSeleccionadas = JSON.parse('@Html.Raw(Json.Encode(ViewBag.AgenciasIds))');

        $(function () {

            function error(texto)
            {
                toastr.error(texto);
            }

            function cargaRol(id,nombre)
            {
                var plantilla = $('#rol_tr_template').html();

                var modelo =
                {
                    id: id,
                    nombre: nombre
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#rol_tbody').append(filaHtml);
            }

            function cargaAgencia(id, nombre)
            {

                var plantilla = $('#agencia_tr_template').html();

                var modelo =
                {
                    id: id,
                    nombre: nombre
                };

                var filaHtml = Mustache.render(plantilla, modelo);

                // agregamos la nueva fila a la tabla.
                $('#agencia_tbody').append(filaHtml);
            }

            renderizarRolesIniciales();
            renderizarAgenciasIniciales();

            $('#btn-agregar').click(function (e)
            {
                e.preventDefault();

                var id = $('#RolId').val()
                var nombre = $('#RolId option:selected').text()

                if (id === "")
                {
                    error("Seleccione un rol");
                    return;
                }

                if (nombre === "")
                {
                    error("Seleccione un rol");
                    return;
                }

                cargaRol(id,nombre);

                $("#RolId").val(0);
                $("#RolId").focus();

            });

            $('#btn-agregar-agencia').click(function (e)
            {
                e.preventDefault();

                var id = $('#AgenciaId').val()
                var nombre = $('#AgenciaId option:selected').text()

                if (id === "")
                {
                    error("Seleccione una agencia");
                    return;
                }

                if (nombre === "")
                {
                    error("Seleccione una agencia");
                    return;
                }

                cargaAgencia(id, nombre);

                $("#AgenciaId").val(0);
                $("#AgenciaId").focus();

            });

            $('#rol_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            $('#agencia_tbody').delegate("a", "click", function (e)
            {
                e.preventDefault();
                $(this).parent().parent().remove();
            });

            function renderizarRolesIniciales()
            {

                if (rolesSeleccionados == null)
                {
                    return;
                }

                // recorremos los roles que haya ingresado el administrador
                for (var i = 0; i < rolesSeleccionados.length; i++)
                {

                    var id = rolesSeleccionados[i];
                    var nombre = $('#RolId option[value=' + id + ']').text()

                    cargaRol(id,nombre);
                }
            }

            function renderizarAgenciasIniciales()
            {

                if (agenciasSeleccionadas == null)
                {
                    return;
                }

                // recorremos las agencias que haya ingresado el administrador
                for (var i = 0; i < agenciasSeleccionadas.length; i++)
                {

                    var id = agenciasSeleccionadas[i];
                    var nombre = $('#AgenciaId option[value=' + id + ']').text()

                    cargaAgencia(id, nombre);
                }
            }

        });

    </script>
}




