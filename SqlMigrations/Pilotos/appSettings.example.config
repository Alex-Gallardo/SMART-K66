<!-- Copiar SOLO estas claves al appSettings del despliegue local.
     No reemplazar la seccion completa ni versionar conexiones/credenciales.
     Sin estas claves el modulo y el cierre tambien permanecen apagados. -->
<appSettings>
  <add key="Pilotos.Habilitado" value="false" />
  <add key="Pilotos.PermitirCierre" value="false" />
  <add key="Pilotos.TriggerSha256" value="" />
  <!-- Acceso temporal: usuario autenticado de POS, una placa y cierre bloqueado.
       Completar usuario/placa localmente y poner PruebasSoloLectura=true.
       No requiere rol PILOTO ni vinculos; desactivar al terminar las pruebas. -->
  <add key="Pilotos.PruebasSoloLectura" value="false" />
  <add key="Pilotos.UsuarioPrueba" value="" />
  <add key="Pilotos.PlacaPrueba" value="" />
</appSettings>
