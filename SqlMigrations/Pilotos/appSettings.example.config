<!-- Copiar SOLO estas tres claves al appSettings del despliegue local.
     No reemplazar la seccion completa ni versionar conexiones/credenciales.
     Sin estas claves el modulo y el cierre tambien permanecen apagados. -->
<appSettings>
  <add key="Pilotos.Habilitado" value="false" />
  <add key="Pilotos.PermitirCierre" value="false" />
  <add key="Pilotos.TriggerSha256" value="" />
</appSettings>
